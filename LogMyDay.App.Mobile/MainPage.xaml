<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="LogMyDay.App.Mobile.MainPage"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:LogMyDay.App.Mobile.Pages"
       Title="LogMyDay"
       FlyoutBehavior="Disabled">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="10,0">
            <Label Grid.Column="0" 
                   Text="LogMyDay" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   TextColor="White" />
            <Button Grid.Column="1"
                    Text="⚙️"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="40"
                    HeightRequest="40"
                    Clicked="OnSettingsClicked" />
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent Title="Home"
                      Icon="home.svg"
                      ContentTemplate="{DataTemplate local:HomePage}" />
        
        <ShellContent Title="Quick Activities"
                      Icon="flash.svg"
                      ContentTemplate="{DataTemplate local:QuickActivitiesPage}" />
    </TabBar>

</Shell>
