<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LogMyDay.App.Mobile.Pages.QuickActivitiesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:LogMyDay.App.Mobile.Converters"
             Title="Quick Activities">

    <ContentPage.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with Add Button -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" HorizontalOptions="FillAndExpand" 
                     Padding="16,10">
            <Button Text="+ Add" 
                    BackgroundColor="DodgerBlue" 
                    TextColor="White" 
                    CornerRadius="8"
                    Clicked="OnAddButtonClicked" 
                    HorizontalOptions="Center" />
        </StackLayout>

        <!-- Quick Activity Buttons List -->
        <ScrollView Grid.Row="1" Padding="16,0">
            <CollectionView x:Name="quickButtonsCollection" 
                            ItemsSource="{Binding QuickButtons}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4">
                            <Frame BackgroundColor="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                   CornerRadius="12"
                                   HasShadow="True"
                                   Padding="16,12"
                                   HeightRequest="80"
                                   MinimumHeightRequest="70"
                                   HorizontalOptions="FillAndExpand">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference quickButtonsCollection}, Path=BindingContext.UseButtonCommand}" 
                                                          CommandParameter="{Binding}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <!-- Button Content -->
                                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                                        <!-- Button Name -->
                                        <Label Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontAttributes="Bold"
                                               TextColor="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter=text}"
                                               HorizontalOptions="Start" 
                                               VerticalOptions="Center" />
                                        
                                        <!-- Value (if any) -->
                                        <Label Text="{Binding Value}" 
                                               FontSize="14" 
                                               TextColor="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter=text}"
                                               Opacity="0.8"
                                               HorizontalOptions="Start"
                                               IsVisible="{Binding Value, Converter={StaticResource StringToBoolConverter}}" />
                                    </StackLayout>
                                    
                                    <!-- Delete Button -->
                                    <Button Grid.Column="1"
                                            Text="✕"
                                            FontSize="16"
                                            BackgroundColor="Transparent"
                                            TextColor="Red"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Command="{Binding Source={x:Reference quickButtonsCollection}, Path=BindingContext.DeleteButtonCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                        <Label Text="No quick activities yet" 
                               FontSize="18" 
                               TextColor="Gray" 
                               HorizontalOptions="Center" />
                        <Label Text="Tap '+ Add' to create your first quick activity button" 
                               FontSize="14" 
                               TextColor="Gray" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </ScrollView>

        <!-- Status Message -->
        <Label Grid.Row="2" 
               x:Name="statusLabel"
               Text="{Binding StatusMessage}" 
               FontSize="14" 
               HorizontalOptions="Center" 
               Padding="16,8"
               TextColor="{Binding IsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter=text}"
               IsVisible="{Binding HasStatusMessage}" />
    </Grid>

</ContentPage>
