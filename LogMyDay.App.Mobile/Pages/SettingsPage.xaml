<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LogMyDay.App.Mobile.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Settings">

    <ScrollView Padding="20">
        <StackLayout Spacing="20">
            <!-- Server Settings Section -->
            <Frame BackgroundColor="LightBlue" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <StackLayout Spacing="15">
                    <Label Text="Server Configuration" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />
                    
                    <!-- Server URL -->
                    <StackLayout Spacing="5">
                        <Label Text="Server URL:" 
                               FontSize="16" 
                               FontAttributes="Bold" />
                        <Entry x:Name="serverUrlEntry"
                               Text="{Binding ServerUrl}"
                               Placeholder="https://your-server.com"
                               Keyboard="Url"
                               FontSize="14" />
                        <Label Text="The URL of your LogMyDay server instance"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                    
                    <!-- Username -->
                    <StackLayout Spacing="5">
                        <Label Text="Username:" 
                               FontSize="16" 
                               FontAttributes="Bold" />
                        <Entry x:Name="usernameEntry"
                               Text="{Binding Username}"
                               Placeholder="Your username"
                               FontSize="14" />
                        <Label Text="Your login username for the server"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                    
                    <!-- Password -->
                    <StackLayout Spacing="5">
                        <Label Text="Password:" 
                               FontSize="16" 
                               FontAttributes="Bold" />
                        <Entry x:Name="passwordEntry"
                               Text="{Binding Password}"
                               Placeholder="Your password"
                               IsPassword="True"
                               FontSize="14" />
                        <Label Text="Your login password for the server"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                    
                    <!-- Save Button -->
                    <Button Text="Save Settings"
                            BackgroundColor="DodgerBlue"
                            TextColor="White"
                            CornerRadius="8"
                            FontSize="16"
                            Command="{Binding SaveSettingsCommand}"
                            Margin="0,10,0,0" />
                </StackLayout>
            </Frame>
            
            <!-- App Information Section -->
            <Frame BackgroundColor="LightGray" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <StackLayout Spacing="10">
                    <Label Text="Application Information" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />
                    
                    <Label Text="LogMyDay Mobile" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                    
                    <Label Text="Version 1.0" 
                           FontSize="14" 
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                    
                    <Label Text="Personal activity logging on the go" 
                           FontSize="12" 
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
