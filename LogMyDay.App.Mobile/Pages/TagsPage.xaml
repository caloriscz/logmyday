<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LogMyDay.App.Mobile.Pages.TagsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Tags">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="#f8f9fa">
        
        <!-- Add New Tag Form -->
        <Frame Grid.Row="0" BackgroundColor="White" CornerRadius="0" Padding="20,15" HasShadow="False" Margin="0,0,0,2">
            <StackLayout Spacing="15">
                <Label Text="Add New Tag" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#333" />
                
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Entry x:Name="NewTagEntry"
                           Grid.Column="0"
                           Placeholder="Enter tag name..."
                           FontSize="16"
                           TextColor="#333"
                           BackgroundColor="#f8f9fa"
                           HeightRequest="45" />
                    <Button x:Name="AddTagButton"
                            Grid.Column="1"
                            Text="Add"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="#007bff"
                            TextColor="White"
                            WidthRequest="80"
                            HeightRequest="45"
                            CornerRadius="8"
                            Clicked="OnAddTagClicked" />
                </Grid>
            </StackLayout>
        </Frame>

        <!-- Header Section -->
        <StackLayout Grid.Row="1" BackgroundColor="White" Padding="20,15">
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <Label Text="Available Tags" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#333"
                       VerticalOptions="Center" 
                       HorizontalOptions="StartAndExpand" />
                <Button x:Name="RefreshButton"
                        Text="↻"
                        FontSize="20"
                        BackgroundColor="Transparent"
                        TextColor="#007bff"
                        WidthRequest="44"
                        HeightRequest="44"
                        Clicked="OnRefreshClicked" />
            </StackLayout>
            
            <!-- Search Bar -->
            <SearchBar x:Name="TagSearchBar"
                       Placeholder="Search tags..."
                       BackgroundColor="LightGray"
                       TextColor="#333"
                       PlaceholderColor="#666"
                       TextChanged="OnSearchTextChanged"
                       Margin="0,10,0,0" />
        </StackLayout>

        <!-- Tags List -->
        <RefreshView Grid.Row="2" 
                     x:Name="RefreshViewTags" 
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            
            <CollectionView x:Name="TagsCollectionView" 
                            ItemsSource="{Binding FilteredTags}"
                            BackgroundColor="Transparent"
                            SelectionMode="None">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="20,10" BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Tag Title and Details -->
                            <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Title}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#333"
                                       VerticalOptions="Center"
                                       HorizontalOptions="StartAndExpand" />
                                
                                <!-- Required Badge -->
                                <Frame IsVisible="{Binding IsRequired}"
                                       BackgroundColor="#dc3545"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       HasShadow="False">
                                    <Label Text="Required" 
                                           TextColor="White" 
                                           FontSize="10" 
                                           FontAttributes="Bold" />
                                </Frame>
                                
                                <!-- Repeatable Badge -->
                                <Frame IsVisible="{Binding IsRepeatable}"
                                       BackgroundColor="#28a745"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       HasShadow="False">
                                    <Label Text="Repeatable" 
                                           TextColor="White" 
                                           FontSize="10" 
                                           FontAttributes="Bold" />
                                </Frame>
                            </StackLayout>
                            
                            <!-- Tag Properties -->
                            <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="15" Margin="0,8,0,0">
                                <!-- Input Type -->
                                <StackLayout Orientation="Horizontal" Spacing="5">
                                    <Label Text="📝" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="{Binding InputTypeDisplay}" 
                                           FontSize="12" 
                                           TextColor="#6c757d" 
                                           VerticalOptions="Center" />
                                </StackLayout>
                                
                                <!-- Time Granularity -->
                                <StackLayout Orientation="Horizontal" Spacing="5">
                                    <Label Text="⏱️" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="{Binding TimeGranularityDisplay}" 
                                           FontSize="12" 
                                           TextColor="#6c757d" 
                                           VerticalOptions="Center" />
                                </StackLayout>
                                
                                <!-- Range Indicator -->
                                <StackLayout Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsRange}">
                                    <Label Text="📊" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="Range" 
                                           FontSize="12" 
                                           TextColor="#6c757d" 
                                           VerticalOptions="Center" />
                                </StackLayout>
                            </StackLayout>
                            
                            <!-- Separator Line -->
                            <BoxView Grid.Row="1" 
                                     Color="LightGray" 
                                     HeightRequest="1" 
                                     VerticalOptions="End" 
                                     Margin="0,15,0,-10" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="50">
                        <Label Text="🏷️" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               Margin="0,0,0,20" />
                        <Label Text="No tags found" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               TextColor="#6c757d" />
                        <Label Text="Tap refresh to load tags" 
                               FontSize="14" 
                               HorizontalOptions="Center" 
                               TextColor="#6c757d" 
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Loading/Error Status Bar -->
        <Frame Grid.Row="3" 
               x:Name="StatusFrame"
               BackgroundColor="#e9ecef"
               CornerRadius="0"
               Padding="20,15"
               IsVisible="False"
               HasShadow="False">
            <Label x:Name="StatusLabel" 
                   Text="Loading tags..." 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   TextColor="#495057" />
        </Frame>
    </Grid>
    
</ContentPage>
