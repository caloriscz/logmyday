<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LogMyDay.App.Mobile.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Login"
             BackgroundColor="#f8f9fa">

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0" Padding="20">
                
                <!-- Logo Section -->
                <StackLayout Spacing="20" Padding="0,60,0,40" HorizontalOptions="Center">
                    <Label Text="📊"
                           FontSize="60"
                           HorizontalOptions="Center" />
                    <Label Text="LogMyDay"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#333" />
                    <Label Text="Track your daily activities"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="#666" />
                </StackLayout>

                <!-- Login Form -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="25"
                       HasShadow="True"
                       Margin="0,0,0,20">
                    <StackLayout Spacing="20">
                        
                        <Label Text="Sign In"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#333" />

                        <!-- Server URL -->
                        <StackLayout Spacing="8">
                            <Label Text="Server URL" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#555" />
                            <Entry x:Name="serverUrlEntry"
                                   Text="{Binding ServerUrl}"
                                   Placeholder="https://logmyday.tadata.cz"
                                   FontSize="16"
                                   TextColor="#333"
                                   BackgroundColor="#f8f9fa"
                                   HorizontalTextAlignment="Start"
                                   HeightRequest="50" />
                            <Label Text="The server address for your LogMyDay instance"
                                   FontSize="13"
                                   TextColor="#888" />
                        </StackLayout>
                        
                        <!-- Username -->
                        <StackLayout Spacing="8">
                            <Label Text="Username" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#555" />
                            <Entry x:Name="usernameEntry"
                                   Text="{Binding Username}"
                                   Placeholder="Your username"
                                   FontSize="16"
                                   TextColor="#333"
                                   BackgroundColor="#f8f9fa"
                                   HorizontalTextAlignment="Start"
                                   HeightRequest="50" />
                        </StackLayout>
                        
                        <!-- Password -->
                        <StackLayout Spacing="8">
                            <Label Text="Password" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#555" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       x:Name="passwordEntry"
                                       Text="{Binding Password}"
                                       Placeholder="Your password"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       FontSize="16"
                                       TextColor="#333"
                                       BackgroundColor="#f8f9fa"
                                       HorizontalTextAlignment="Start"
                                       HeightRequest="50" />
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleText}"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        TextColor="#007bff"
                                        WidthRequest="60"
                                        HeightRequest="50"
                                        Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Grid>
                        </StackLayout>

                        <!-- Error Message -->
                        <Label x:Name="errorLabel"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"
                               TextColor="Red"
                               FontSize="14"
                               HorizontalOptions="Center" />

                        <!-- Login Button -->
                        <Button Text="Sign In"
                                BackgroundColor="#007bff"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="55"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotTesting}" />

                        <!-- Loading Indicator -->
                        <StackLayout IsVisible="{Binding IsTesting}" 
                                     HorizontalOptions="Center"
                                     Orientation="Horizontal"
                                     Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsTesting}"
                                               Color="#007bff"
                                               HeightRequest="20"
                                               WidthRequest="20" />
                            <Label Text="Signing in..."
                                   FontSize="14"
                                   TextColor="#666"
                                   VerticalOptions="Center" />
                        </StackLayout>

                    </StackLayout>
                </Frame>

                <!-- Footer -->
                <StackLayout Spacing="10" Padding="0,20">
                    <Label Text="Need an account? Contact your administrator"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="#666" />
                </StackLayout>

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
