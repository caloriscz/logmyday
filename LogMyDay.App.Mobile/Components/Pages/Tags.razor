@page "/tags"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Mobile.Services
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Tags> Logger
@implements IAsyncDisposable

<PageTitle>Tags - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <div class="max-w-7xl mx-auto px-6 py-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Activity Tags</h1>

        <!-- Tags List -->
        @if (tags == null)
        {
            <p class="text-gray-600 dark:text-gray-400"><em>Loading...</em></p>
        }
        else if (!tags.Any())
        {
            <div class="alert-info">
                <i class="bi bi-tags text-6xl text-gray-400 block text-center mb-3"></i>
                <h5 class="text-center text-lg font-semibold text-gray-900 dark:text-white">No Tags Yet</h5>
                <p class="text-center text-gray-600 dark:text-gray-400">Create tags to categorize and organize your activities.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto bg-white dark:bg-gray-800 rounded-lg shadow">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider" style="width: 60px;">Actions</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Title</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Granularity</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Required</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Repeatable</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Range</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var tag in tags)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <button @onclick="() => DeleteTag(tag.Id)"
                                        class="btn-danger text-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">@tag.Title</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">@GetInputTypeName(tag.TypeId)</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">@tag.TimeGranularity</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm">
                                    @if (tag.IsRequired)
                                    {
                                        <i class="bi bi-check-circle text-green-500"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle text-gray-400"></i>
                                    }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm">
                                    @if (tag.IsRepeatable)
                                    {
                                        <i class="bi bi-check-circle text-green-500"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle text-gray-400"></i>
                                    }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm">
                                    @if (tag.IsRange)
                                    {
                                        <i class="bi bi-check-circle text-green-500"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle text-gray-400"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="md:hidden space-y-3">
                @foreach (var tag in tags)
                {
                    <div class="card">
                        <div class="flex justify-between items-start mb-2">
                            <h6 class="font-semibold text-gray-900 dark:text-white">@tag.Title</h6>
                            <button @onclick="() => DeleteTag(tag.Id)"
                                class="btn-danger text-sm" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm text-gray-600 dark:text-gray-400">
                            <div>
                                <span class="font-medium">Type:</span> @GetInputTypeName(tag.TypeId)
                            </div>
                            <div>
                                <span class="font-medium">Granularity:</span> @tag.TimeGranularity
                            </div>
                            <div>
                                <span class="font-medium">Required:</span> 
                                @if (tag.IsRequired)
                                {
                                    <i class="bi bi-check-circle text-green-500"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-gray-400"></i>
                                }
                            </div>
                            <div>
                                <span class="font-medium">Repeatable:</span> 
                                @if (tag.IsRepeatable)
                                {
                                    <i class="bi bi-check-circle text-green-500"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-gray-400"></i>
                                }
                            </div>
                            <div>
                                <span class="font-medium">Range:</span> 
                                @if (tag.IsRange)
                                {
                                    <i class="bi bi-check-circle text-green-500"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-gray-400"></i>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Floating Action Button -->
<button type="button" class="fab" data-modal-show="addTagModal" title="Add Tag">
    <i class="bi bi-plus-lg"></i>
</button>

<!-- Add New Tag Modal - Full Screen Overlay -->
<div id="addTagModal" data-modal class="hidden fixed inset-0 z-50 bg-white dark:bg-slate-900 transition-opacity duration-300 opacity-0" aria-labelledby="addTagModalLabel">
    <div data-modal-content class="w-full h-full flex flex-col">
        <!-- Modal Header - Fixed at top -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
            <h5 class="text-xl font-semibold text-gray-900 dark:text-gray-100" id="addTagModalLabel">Add New Tag</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors p-3 -mr-2" data-modal-hide="addTagModal" aria-label="Close">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        
        <!-- Modal Body - Scrollable content -->
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm id="addTagForm" Model="newTag" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-red-600 dark:text-red-400 mb-4" />

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Title:</label>
                        <InputText @bind-Value="newTag.Tag" 
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                            placeholder="Enter tag name" required />
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Input Type:</label>
                        <InputSelect @bind-Value="newTag.TypeId" 
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                            <option value="">-- Select Type --</option>
                            <option value="1">Integer</option>
                            <option value="2">String</option>
                            <option value="3">Boolean</option>
                            <option value="4">Date</option>
                        </InputSelect>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Time Granularity:</label>
                        <InputSelect @bind-Value="newTag.TimeGranularity" 
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                            <option value="@TimeGranularity.Exact">Exact</option>
                            <option value="@TimeGranularity.Hourly">Hourly</option>
                            <option value="@TimeGranularity.Daily">Daily</option>
                            <option value="@TimeGranularity.Weekly">Weekly</option>
                            <option value="@TimeGranularity.Monthly">Monthly</option>
                            <option value="@TimeGranularity.Yearly">Yearly</option>
                        </InputSelect>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="newTag.IsRequired" 
                                class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" 
                                id="requiredCheck" />
                            <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="requiredCheck">
                                Required
                            </label>
                        </div>
                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="newTag.IsRepeatable" 
                                class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" 
                                id="repeatableCheck" />
                            <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="repeatableCheck">
                                Repeatable
                            </label>
                        </div>
                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="newTag.IsRange" 
                                class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" 
                                id="rangeCheck" />
                            <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="rangeCheck">
                                Range
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert-danger">
                            @errorMessage
                        </div>
                    }
                </EditForm>
            </div>
            
            <!-- Modal Footer - Fixed at bottom -->
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
                <div class="flex items-center justify-end gap-3">
                    <button type="button" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors text-base font-medium" data-modal-hide="addTagModal">Cancel</button>
                    <button type="submit" form="addTagForm" class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 active:bg-primary-800 transition-colors text-base font-medium shadow-sm">
                        Add Tag
                    </button>
                </div>
            </div>
        </div>
</div>

@code {
    private IList<LogMyDay.Shared.DTOs.TagResponse>? tags;
    private LogMyDay.Shared.DTOs.TagRequest newTag = new() { Tag = "" };
    private string? errorMessage;

    // Pull-to-refresh functionality
    private bool isRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        // Redirect to login if not authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        // Subscribe to refresh events
        RefreshService.RefreshRequested += OnRefreshRequested;

        await LoadTags();
    }

    public async ValueTask DisposeAsync()
    {
        // Unsubscribe from refresh events
        RefreshService.RefreshRequested -= OnRefreshRequested;
        await Task.CompletedTask;
    }

    private async void OnRefreshRequested(object? sender, EventArgs e)
    {
        if (isRefreshing) return;
        
        await RefreshTags();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tags");
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task RefreshTags()
    {
        isRefreshing = true;
        
        try
        {
            await LoadTags();
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _ = await ActivityApi.CreateTag(newTag);
            
            newTag = new() { Tag = "" };
            errorMessage = null;
            await LoadTags();

            // Close the modal after successful submission
            try
            {
                await JSRuntime.InvokeVoidAsync("hideModal", "addTagModal");
            }
            catch (InvalidOperationException)
            {
                // Ignore JavaScript interop errors during static rendering
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating tag");
            errorMessage = $"Error creating tag: {ex.Message}";
        }
    }

    private async Task DeleteTag(int id)
    {
        try
        {
            await ActivityApi.DeleteTag(id);
            await LoadTags();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting tag with ID {TagId}", id);
            errorMessage = $"Error deleting tag: {ex.Message}";
        }
    }

    private string GetInputTypeName(int? typeId)
    {
        return typeId switch
        {
            1 => "Integer",
            2 => "String",
            3 => "Boolean",
            4 => "Date",
            _ => "None"
        };
    }
}

