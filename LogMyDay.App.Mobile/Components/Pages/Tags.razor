@page "/tags"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Tags> Logger

<PageTitle>Tags - LogMyDay</PageTitle>

<MobileTopbar Title="Activity Tags" />

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <!-- Removed h1 as it's now in topbar -->
            </div>
        </div>

        <!-- Tags List -->
        <div class="col-md-12">
            @if (tags == null)
            {
                <p><em>Loading...</em></p>
            }
            else if (!tags.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-tags display-4 text-muted d-block text-center mb-3"></i>
                    <h5 class="text-center">No Tags Yet</h5>
                    <p class="text-center text-muted">Create tags to categorize and organize your activities.</p>
                </div>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 60px;">Actions</th>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Granularity</th>
                                <th>Required</th>
                                <th>Repeatable</th>
                                <th>Range</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tag in tags)
                            {
                                <tr>
                                    <td>
                                        <button @onclick="() => DeleteTag(tag.Id)"
                                            class="btn btn-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                    <td>@tag.Title</td>
                                    <td>@GetInputTypeName(tag.TypeId)</td>
                                    <td>@tag.TimeGranularity</td>
                                    <td>
                                        @if (tag.IsRequired)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (tag.IsRepeatable)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (tag.IsRange)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-md-none">
                    @foreach (var tag in tags)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="card-title mb-0">@tag.Title</h6>
                                    <button @onclick="() => DeleteTag(tag.Id)"
                                        class="btn btn-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <div class="row text-muted small">
                                    <div class="col-6 mb-1">
                                        <strong>Type:</strong> @GetInputTypeName(tag.TypeId)
                                    </div>
                                    <div class="col-6 mb-1">
                                        <strong>Granularity:</strong> @tag.TimeGranularity
                                    </div>
                                    <div class="col-4">
                                        <strong>Required:</strong> 
                                        @if (tag.IsRequired)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </div>
                                    <div class="col-4">
                                        <strong>Repeatable:</strong> 
                                        @if (tag.IsRepeatable)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </div>
                                    <div class="col-4">
                                        <strong>Range:</strong> 
                                        @if (tag.IsRange)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle text-muted"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<button class="fab" data-bs-toggle="modal" data-bs-target="#addTagModal" title="Add Tag">
    <i class="bi bi-plus-lg"></i>
</button>

<!-- Add New Tag Modal -->
<div class="modal fade" id="addTagModal" tabindex="-1" aria-labelledby="addTagModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTagModalLabel">Add New Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="newTag" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Title:</label>
                        <InputText @bind-Value="newTag.Tag" class="form-control"
                            placeholder="Enter tag name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Input Type:</label>
                        <InputSelect @bind-Value="newTag.TypeId" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="1">Integer</option>
                            <option value="2">String</option>
                            <option value="3">Boolean</option>
                            <option value="4">Date</option>
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Time Granularity:</label>
                        <InputSelect @bind-Value="newTag.TimeGranularity" class="form-select">
                            <option value="@TimeGranularity.Exact">Exact</option>
                            <option value="@TimeGranularity.Hourly">Hourly</option>
                            <option value="@TimeGranularity.Daily">Daily</option>
                            <option value="@TimeGranularity.Weekly">Weekly</option>
                            <option value="@TimeGranularity.Monthly">Monthly</option>
                            <option value="@TimeGranularity.Yearly">Yearly</option>
                        </InputSelect>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="newTag.IsRequired" class="form-check-input" id="requiredCheck" />
                                <label class="form-check-label" for="requiredCheck">
                                    Required
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="newTag.IsRepeatable" class="form-check-input" id="repeatableCheck" />
                                <label class="form-check-label" for="repeatableCheck">
                                    Repeatable
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="newTag.IsRange" class="form-check-input" id="rangeCheck" />
                                <label class="form-check-label" for="rangeCheck">
                                    Range
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            Add Tag
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private IList<LogMyDay.Shared.DTOs.TagResponse>? tags;
    private LogMyDay.Shared.DTOs.TagRequest newTag = new() { Tag = "" };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Redirect to login if not authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tags");
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            await ActivityApi.CreateTag(newTag);
            
            newTag = new() { Tag = "" };
            errorMessage = null;
            await LoadTags();

            // Close the modal after successful submission
            try
            {
                await JSRuntime.InvokeVoidAsync("eval",
                "bootstrap.Modal.getInstance(document.getElementById('addTagModal'))?.hide()");
            }
            catch (InvalidOperationException)
            {
                // Ignore JavaScript interop errors during static rendering
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating tag");
            errorMessage = $"Error creating tag: {ex.Message}";
        }
    }

    private async Task DeleteTag(int id)
    {
        try
        {
            await ActivityApi.DeleteTag(id);
            await LoadTags();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting tag with ID {TagId}", id);
            errorMessage = $"Error deleting tag: {ex.Message}";
        }
    }

    private string GetInputTypeName(int? typeId)
    {
        return typeId switch
        {
            1 => "Integer",
            2 => "String",
            3 => "Boolean",
            4 => "Date",
            _ => "None"
        };
    }
}
