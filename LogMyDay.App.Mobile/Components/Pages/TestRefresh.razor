@page "/test-refresh"
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="container-fluid p-3">
    <h2>Native Pull-to-Refresh Test</h2>
    <p>Pull down from the top to test native refresh functionality</p>
    
    <div style="min-height: 200vh; padding: 20px;">
        <div class="alert alert-info">
            <h4>Test Data</h4>
            <p><strong>Last Refreshed:</strong> @lastRefreshTime</p>
            <p><strong>Refresh Count:</strong> @refreshCount</p>
            <p><strong>Touch Events:</strong> @touchEventCount</p>
        </div>
        
        <div class="card">
            <div class="card-body">
                <h5>Instructions:</h5>
                <ul>
                    <li>Make sure you're at the top of the page</li>
                    <li>On mobile: Pull down from the top with your finger</li>
                    <li>You should see a native refresh indicator appear</li>
                    <li>When you release, the data should update via native RefreshView</li>
                </ul>
                
                <div class="mt-3">
                    <button class="btn btn-primary btn-sm" @onclick="HandleRefresh">
                        Manual Refresh Test
                    </button>
                    <small class="text-muted ms-2">Use this to test the refresh callback without touch gestures</small>
                </div>
            </div>
        </div>
        
        <!-- Long content to enable scrolling -->
        @for (int i = 1; i <= 50; i++)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h6>Test Item @i</h6>
                    <p class="card-text">This is test content item number @i. It's here to make the page scrollable so you can test the pull-to-refresh functionality.</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string lastRefreshTime = "Never";
    private int refreshCount = 0;
    private int touchEventCount = 0;
    
    protected override async Task OnInitializedAsync()
    {
        RefreshService.RefreshRequested += OnRefreshRequested;
        lastRefreshTime = DateTime.Now.ToString("HH:mm:ss");
    }

    private async void OnRefreshRequested(object? sender, EventArgs e)
    {
        await HandleRefresh();
    }
    
    private async Task HandleRefresh()
    {
        // Simulate some loading time
        await Task.Delay(1000);
        
        // Update the data
        refreshCount++;
        lastRefreshTime = DateTime.Now.ToString("HH:mm:ss");
        
        // Force UI update
        StateHasChanged();
        
        System.Diagnostics.Debug.WriteLine($"RefreshTest: Native refresh completed #{refreshCount} at {lastRefreshTime}");
    }
    
    public ValueTask DisposeAsync()
    {
        RefreshService.RefreshRequested -= OnRefreshRequested;
        return ValueTask.CompletedTask;
    }
}