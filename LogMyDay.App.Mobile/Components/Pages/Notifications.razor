@page "/notifications"
@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Mobile.Services
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">Notifications</h3>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary" @onclick="PreviousDay" title="Previous Day">
                        &lt;
                    </button>
                    <input type="date" class="form-control" @bind="selectedDate" @bind:after="LoadRequiredTags" />
                    <button class="btn btn-outline-secondary" @onclick="NextDay" title="Next Day">
                        &gt;
                    </button>
                    <button class="btn btn-outline-primary ms-2" @onclick="RefreshNotifications">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading notifications...</p>
                </div>
            }
            else if (unfilledRequiredTags?.Any() == true)
            {
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    You have <strong>@unfilledRequiredTags.Count</strong> required tag(s) that haven't been filled for @selectedDate.ToString("MMMM dd, yyyy").
                </div>

                <div class="row">
                    @foreach (var tag in unfilledRequiredTags)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0 text-warning">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            @tag.Title
                                        </h5>
                                        <span class="badge bg-warning text-dark">Required</span>
                                    </div>

                                    <div class="card-text">
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            Time Granularity: @tag.TimeGranularity
                                        </small>
                                        @if (tag.IsRepeatable)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                Repeatable
                                            </small>
                                        }
                                        @if (tag.IsRange)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi bi-arrows-expand me-1"></i>
                                                Range Values
                                            </small>
                                        }
                                    </div>

                                    <div class="mt-3">
                                        <button class="btn btn-sm btn-outline-primary w-100"
                                                @onclick="@(() => OpenAddActivityModal(tag.Id))">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Activity
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    Great! All required tags have been filled for @selectedDate.ToString("MMMM dd, yyyy").
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }
        </div>
    </div>
</div>

<!-- Shared Add Activity Modal -->
<AddActivityModal 
    ModalId="notificationsAddActivityModal"
    Activity="newActivity" 
    AvailableTags="allTags" 
    ErrorMessage="@errorMessage"
    @bind-AddAnotherAfterSave="addAnotherAfterSave"
    OnActivityCreated="OnActivityCreated"
    OnCanceled="OnModalCanceled"
    OnFormReset="OnFormReset" />

@code {
    private List<TagResponse>? unfilledRequiredTags;
    private IList<TagResponse>? allTags;
    private DateTime selectedDate = DateTime.Today;
    private bool isLoading = true;
    private string? errorMessage;
    
    // Modal-related properties
    private ActivityRequest newActivity = new();
    private bool addAnotherAfterSave = false;

    protected override async Task OnInitializedAsync()
    {
        RefreshService.RefreshRequested += OnRefreshRequested;
        await LoadRequiredTags();
        await LoadAllTags();
    }

    private async void OnRefreshRequested(object? sender, EventArgs e)
    {
        await RefreshNotifications();
    }

    private async Task LoadRequiredTags()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            unfilledRequiredTags = await ActivityApi.GetRequiredDailyTagsNotFilledForDate(selectedDate.ToString("yyyy-MM-dd"));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // AutoRetryAuthHandler will handle automatic retry and redirect to login if needed
            errorMessage = "Authentication expired. Please wait or try again.";
            unfilledRequiredTags = new List<TagResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading notifications: {ex.Message}";
            unfilledRequiredTags = new List<TagResponse>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAllTags()
    {
        try
        {
            allTags = await ActivityApi.GetTags();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // AutoRetryAuthHandler will handle automatic retry and redirect to login if needed
            errorMessage = "Authentication expired. Please wait or try again.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task RefreshNotifications()
    {
        await LoadRequiredTags();
    }

    private async Task OpenAddActivityModal(int tagId)
    {
        // Reset the activity form
        InitializeNewActivity(tagId);
        errorMessage = null;

        // Open the modal
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "new bootstrap.Modal(document.getElementById('notificationsAddActivityModal')).show()");
        }
        catch (InvalidOperationException)
        {
            // Ignore JavaScript interop errors during static rendering
        }
    }

    private void InitializeNewActivity(int? tagId = null)
    {
        // Set the DateStarted to the selected date, but keep the current time if it's today
        if (selectedDate.Date == DateTime.Today)
        {
            newActivity.DateStarted = DateTime.Now;
        }
        else
        {
            // For other dates, set to the beginning of the selected day
            newActivity.DateStarted = selectedDate.Date;
        }

        newActivity.PrimaryTagId = tagId;
        newActivity.Description = null;
        newActivity.DateFinished = null;
    }

    private async Task OnActivityCreated(ActivityRequest activity)
    {
        // Refresh the notifications list
        await LoadRequiredTags();

        // Reset the form if not adding another
        if (!addAnotherAfterSave)
        {
            InitializeNewActivity();
        }
        else
        {
            // Keep the selected tag and date, but reset description
            var keepTagId = activity.PrimaryTagId;
            var keepDate = activity.DateStarted;
            
            InitializeNewActivity(keepTagId);
            newActivity.DateStarted = keepDate;
        }

        errorMessage = null;
    }

    private Task OnModalCanceled()
    {
        InitializeNewActivity();
        errorMessage = null;
        return Task.CompletedTask;
    }

    private Task OnFormReset()
    {
        // Handle form errors - will be called when validation or API errors occur
        errorMessage = "Error saving activity. Please try again.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        RefreshService.RefreshRequested -= OnRefreshRequested;
        return ValueTask.CompletedTask;
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadRequiredTags();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        await LoadRequiredTags();
    }
}
