@page "/notifications"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Notifications
@using LogMyDay.App.Mobile.Services
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Notifications - LogMyDay</PageTitle>

<MobileTopbar Title="Notifications" />

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12 mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row gap-3">
                <div>
                    <h5 class="mb-1">Scheduled reminders</h5>
                    <small class="text-muted">Reminders run locally on your device using the notification rules you configure for each tag.</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-primary" @onclick="RefreshNotifications" title="Refresh">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Refresh
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 mb-0">Checking your notification rules…</p>
                </div>
            }
            else if (notifications.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    You haven&apos;t configured any notifications yet. Open a tag in the Tags page to add your first reminder.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var notification in notifications)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="card-title mb-1">@GetTagLabel(notification)</h5>
                                            <small class="text-muted">Notification ID: @notification.Id</small>
                                        </div>
                                        @if (notification.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Paused</span>
                                        }
                                    </div>

                                    <p class="text-body-secondary mb-3">@GetNotificationMessage(notification)</p>

                                    <dl class="row mb-0 small">
                                        <dt class="col-5">Time window</dt>
                                        <dd class="col-7">@FormatWindow(notification)</dd>

                                        <dt class="col-5">Reminder cadence</dt>
                                        <dd class="col-7">@FormatCadence(notification)</dd>

                                        <dt class="col-5">Created</dt>
                                        <dd class="col-7">@FormatCreated(notification.DateCreated)</dd>
                                    </dl>

                                    <div class="mt-3 mt-auto">
                                        <button class="btn btn-outline-primary w-100" @onclick="() => OpenAddActivityModal(notification.TagId)">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Log activity for this tag
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }
        </div>
    </div>
</div>

<!-- Shared Add Activity Modal -->
<AddActivityModal 
    ModalId="notificationsAddActivityModal"
    Activity="newActivity" 
    AvailableTags="allTags" 
    ErrorMessage="@errorMessage"
    @bind-AddAnotherAfterSave="addAnotherAfterSave"
    OnActivityCreated="OnActivityCreated"
    OnCanceled="OnModalCanceled"
    OnFormReset="OnFormReset" />

@code {
    private List<NotificationResponse> notifications = new();
    private IList<TagResponse>? allTags;
    private bool isLoading = true;
    private string? errorMessage;

    // Modal-related properties
    private ActivityRequest newActivity = new();
    private bool addAnotherAfterSave;

    protected override async Task OnInitializedAsync()
    {
        RefreshService.RefreshRequested += OnRefreshRequested;
        InitializeNewActivity();

        await Task.WhenAll(LoadAllTags(), LoadNotificationsAsync());
    }

    private async void OnRefreshRequested(object? sender, EventArgs e)
    {
        await RefreshNotifications();
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var apiNotifications = await ActivityApi.GetNotifications();
            notifications = (apiNotifications ?? Array.Empty<NotificationResponse>())
                .OrderByDescending(n => n.IsActive)
                .ThenBy(n => GetTagLabel(n), StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(n => n.NotBeforeTime ?? TimeSpan.Zero)
                .ToList();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication expired. Please wait or try again.";
            notifications = new List<NotificationResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading notifications: {ex.Message}";
            notifications = new List<NotificationResponse>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAllTags()
    {
        try
        {
            allTags = await ActivityApi.GetTags();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication expired. Please wait or try again.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task RefreshNotifications()
    {
        await LoadNotificationsAsync();
    }

    private async Task OpenAddActivityModal(int tagId)
    {
        InitializeNewActivity(tagId);
        errorMessage = null;

        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "new bootstrap.Modal(document.getElementById('notificationsAddActivityModal')).show()");
        }
        catch (InvalidOperationException)
        {
            // Ignore JavaScript interop errors during static rendering
        }
    }

    private void InitializeNewActivity(int? tagId = null)
    {
        newActivity = new ActivityRequest
        {
            DateStarted = DateTime.Now,
            PrimaryTagId = tagId,
            Description = null,
            DateFinished = null
        };
    }

    private async Task OnActivityCreated(ActivityRequest activity)
    {
        await LoadNotificationsAsync();

        if (!addAnotherAfterSave)
        {
            InitializeNewActivity();
        }
        else
        {
            var keepTagId = activity.PrimaryTagId;
            InitializeNewActivity(keepTagId);
        }

        errorMessage = null;
    }

    private Task OnModalCanceled()
    {
        InitializeNewActivity();
        errorMessage = null;
        return Task.CompletedTask;
    }

    private Task OnFormReset()
    {
        errorMessage = "Error saving activity. Please try again.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        RefreshService.RefreshRequested -= OnRefreshRequested;
        return ValueTask.CompletedTask;
    }

    private static string GetTagLabel(NotificationResponse notification)
    {
        if (!string.IsNullOrWhiteSpace(notification.TagName))
        {
            return notification.TagName;
        }

        return $"Tag #{notification.TagId}";
    }

    private static string GetNotificationMessage(NotificationResponse notification)
    {
        if (!string.IsNullOrWhiteSpace(notification.NotificationText))
        {
            return notification.NotificationText;
        }

        return NotificationScheduleCalculator.BuildDefaultMessage(notification);
    }

    private static string FormatWindow(NotificationResponse notification)
    {
        var start = FormatTime(notification.NotBeforeTime);
        var end = FormatTime(notification.NotAfterTime);

        if (!notification.NotBeforeTime.HasValue && !notification.NotAfterTime.HasValue)
        {
            return "Any time";
        }

        return $"{start} - {end}";
    }

    private static string FormatCadence(NotificationResponse notification)
    {
        var interval = NotificationScheduleCalculator.SanitizeInterval(notification.NudgeInterval);
        var total = Math.Max(0, notification.MaxNudges) + 1;
        var plural = total == 1 ? "time" : "times";

        return $"First reminder then every {interval.TotalMinutes:0} min (up to {total} {plural} per cycle)";
    }

    private static string FormatCreated(DateTime utcDate)
    {
        return utcDate.ToLocalTime().ToString("g");
    }

    private static string FormatTime(TimeSpan? value)
    {
        if (!value.HasValue)
        {
            return "--:--";
        }

        var totalHours = (int)Math.Floor(value.Value.TotalHours);
        var minutes = Math.Abs(value.Value.Minutes);
        return $"{totalHours:D2}:{minutes:D2}";
    }
}
