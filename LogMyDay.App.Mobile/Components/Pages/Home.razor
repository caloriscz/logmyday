@page "/home"
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject NavigationManager Navigation

<PageTitle>Home - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <div class="max-w-7xl mx-auto px-4 py-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Welcome to LogMyDay</h1>
        <p class="text-gray-600 dark:text-gray-400 mb-6">Track your daily activities with ease</p>
        
        <div class="card mb-4">
            <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Getting Started</h5>
            <p class="text-gray-600 dark:text-gray-400">
                LogMyDay helps you track and organize your daily activities. 
                Use the navigation below to explore the app.
            </p>
        </div>
        
        @if (AuthService?.IsAuthenticated == true)
        {
            <div class="alert-success mb-4">
                <i class="bi bi-check-circle"></i> You are logged in and ready to use LogMyDay!
            </div>
            
            <div class="space-y-2">
                <button class="w-full px-4 py-3 bg-primary-600 text-white rounded-md hover:bg-primary-700 active:bg-primary-800 transition-colors flex items-center justify-center gap-2" @onclick="StartLogging">
                    <i class="bi bi-plus-circle"></i> Start Logging Activities
                </button>
            </div>
        }
        else
        {
            <div class="alert-info mb-4">
                <i class="bi bi-info-circle"></i> Please log in to start tracking your activities.
            </div>
            
            <div class="space-y-2">
                <button class="w-full px-4 py-3 border-2 border-primary-600 text-primary-600 dark:text-primary-400 dark:border-primary-400 rounded-md hover:bg-primary-50 dark:hover:bg-gray-800 active:bg-primary-100 dark:active:bg-gray-700 transition-colors flex items-center justify-center gap-2" @onclick="GoToLogin">
                    <i class="bi bi-person"></i> Go to Login
                </button>
            </div>
        }
    </div>
</div>

@code {
    private void StartLogging()
    {
        Navigation.NavigateTo("/activities");
    }
    
    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}