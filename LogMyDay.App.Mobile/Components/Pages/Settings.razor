@page "/settings"
@inject NavigationManager Navigation
@inject AuthenticationService AuthService
@inject IApiContext ApiContext
@inject ILogger<Settings> Logger

<PageTitle>Settings - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <div class="max-w-7xl mx-auto px-4 py-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Settings</h1>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden divide-y divide-gray-200 dark:divide-gray-700">
            <button type="button"
                    class="w-full px-4 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-left"
                    @onclick="@(() => NavigateTo("/settings/account"))">
                <div class="flex items-center gap-3">
                    <span class="text-primary-600 dark:text-primary-400">
                        <i class="bi bi-person-gear text-2xl"></i>
                    </span>
                    <div>
                        <div class="font-semibold text-gray-900 dark:text-white">Account settings</div>
                        <small class="text-gray-600 dark:text-gray-400">Update your profile information</small>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-gray-400"></i>
            </button>

            <button type="button"
                    class="w-full px-4 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-left"
                    @onclick="@(() => NavigateTo("/settings/password"))">
                <div class="flex items-center gap-3">
                    <span class="text-green-600 dark:text-green-400">
                        <i class="bi bi-shield-lock text-2xl"></i>
                    </span>
                    <div>
                        <div class="font-semibold text-gray-900 dark:text-white">Password</div>
                        <small class="text-gray-600 dark:text-gray-400">Change your account password securely</small>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-gray-400"></i>
            </button>

            <button type="button"
                    class="w-full px-4 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-left text-red-600 dark:text-red-400"
                    @onclick="LogoutAsync"
                    disabled="@isLoggingOut">
                <div class="flex items-center gap-3">
                    <span>
                        <i class="bi bi-box-arrow-right text-2xl"></i>
                    </span>
                    <div>
                        <div class="font-semibold">Log out</div>
                        <small class="text-gray-600 dark:text-gray-400">Sign out of this device</small>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-gray-400"></i>
            </button>
        </div>

        <div class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Manage the same information available on the web profile page, organised into focused mobile-friendly screens.
        </div>
    </div>
</div>

@code {
    private bool isLoggingOut;

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private Task LogoutAsync()
    {
        if (isLoggingOut)
        {
            return Task.CompletedTask;
        }

        isLoggingOut = true;

        try
        {
            ApiContext.Clear();
            AuthService.ClearAuthentication();
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Failed to log out");
        }
        finally
        {
            isLoggingOut = false;
        }
        return Task.CompletedTask;
    }
}
