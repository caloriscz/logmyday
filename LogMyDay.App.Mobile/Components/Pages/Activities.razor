@page "/activities"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Activities> Logger
@implements IAsyncDisposable

<PageTitle>Activities - LogMyDay</PageTitle>

<MobileTopbar Title="Activities" />

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <!-- Removed h1 as it's now in topbar -->
            </div>
        </div>

        <!-- Activities List -->
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal"
                        data-bs-target="#filterModal" title="Open filters">
                        <i class="bi bi-funnel"></i> Filters
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-link" @onclick="@(() => ChangeOrder("asc"))">Ascending</button>
                    <button class="btn btn-link" @onclick="@(() => ChangeOrder("desc"))">Descending</button>

                    @if (displayType != "daily")
                    {
                        <div class="ms-3">
                            <button class="btn btn-secondary btn-sm me-2" @onclick="PrevPage"
                                disabled="@(GetCurrentPageNumber() == 1)">Previous</button>
                            <span>Page @GetCurrentPageNumber() of @totalPages</span>
                            <button class="btn btn-secondary btn-sm ms-2" @onclick="NextPage"
                                disabled="@(GetCurrentPageNumber() == totalPages)">Next</button>
                        </div>
                    }
                </div>
            </div>

            @if (pagedResult == null)
            {
                <p><em>Loading...</em></p>
            }
            else if (!pagedResult.Items.Any())
            {
                <div class="alert alert-info">
                    No activities found for the selected criteria.
                </div>
            }
            else
            {
                @foreach (var group in pagedResult.Items.GroupBy(a => a.DateStarted.Date).OrderByDescending(g => g.Key))
                {
                    <h5>@group.Key.ToString("yyyy-MM-dd")</h5>
                    
                    <!-- Desktop Table View -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">Actions</th>
                                    <th>Tag</th>
                                    <th>Description</th>
                                    <th>Date Started</th>
                                    <th>Date Finished</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in group)
                                {
                                    <tr>
                                        <td>
                                            <button @onclick="() => DeleteActivity(activity.Id)"
                                                class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                        <td>@activity.PrimaryTagName</td>
                                        <td>@activity.Description</td>
                                        <td>@activity.DateStarted.ToString("HH:mm")</td>
                                        <td>@(activity.DateFinished?.ToString("HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="d-md-none">
                        @foreach (var activity in group)
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0">@activity.PrimaryTagName</h6>
                                        <button @onclick="() => DeleteActivity(activity.Id)"
                                            class="btn btn-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(activity.Description))
                                    {
                                        <p class="card-text mb-2">@activity.Description</p>
                                    }
                                    <div class="row text-muted small">
                                        <div class="col-6">
                                            <strong>Started:</strong> @activity.DateStarted.ToString("HH:mm")
                                        </div>
                                        <div class="col-6">
                                            <strong>Finished:</strong> @(activity.DateFinished?.ToString("HH:mm") ?? "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<button class="fab" data-bs-toggle="modal" data-bs-target="#addActivityModal" title="Add Activity">
    <i class="bi bi-plus-lg"></i>
</button>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">Filters & Navigation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Display Type -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Display Type:</label>
                        <select value="@displayType" @onchange="OnDisplayTypeChanged" class="form-select">
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                        </select>
                    </div>

                    <!-- Description Filter -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Description Filter:</label>
                        <input value="@descriptionFilter" @onchange="OnFilterChanged" class="form-control"
                            placeholder="Search description..." />
                    </div>

                    <!-- Calendar Navigation -->
                    <div class="col-12">
                        <label class="form-label">Date Navigation:</label>
                        
                        <!-- Navigation Controls -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <!-- Daily navigation -->
                            <button class="btn btn-outline-secondary" @onclick="PreviousCalendarPeriod" title="Previous Day">
                                &lt;
                            </button>
                            
                            <div class="flex-grow-1 text-center">
                                <strong>@GetCurrentPeriodDisplay()</strong>
                            </div>
                            
                            <button class="btn btn-outline-secondary" @onclick="NextCalendarPeriod" title="Next Day">
                                &gt;
                            </button>
                            <button class="btn btn-outline-primary" @onclick="GoToToday">
                                @GetTodayButtonText()
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add New Activity Modal -->
<div class="modal fade" id="addActivityModal" tabindex="-1" aria-labelledby="addActivityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addActivityModalLabel">Add New Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="newActivity" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Primary Tag:</label>
                        <InputSelect @bind-Value="newActivity.PrimaryTagId" class="form-select" @bind-Value:after="OnTagSelectionChanged">
                            <option value="">-- Select Tag --</option>
                            @if (tags != null)
                            {
                                foreach (var tag in tags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        @if (selectedTag?.TypeId.HasValue == true)
                        {
                            @if (selectedTag.TypeId == 1) // Integer
                            {
                                <label class="form-label">Value:</label>
                                <input type="number" @bind="integerValue" @bind:after="OnIntegerValueChanged" class="form-control"
                                    placeholder="Enter numeric value" step="1" />
                            }
                            else if (selectedTag.TypeId == 2) // String
                            {
                                <label class="form-label">Value:</label>
                                <InputText @bind-Value="newActivity.Description" class="form-control"
                                    placeholder="Enter text value" />
                            }
                            else if (selectedTag.TypeId == 3) // Boolean
                            {
                                <div class="form-check">
                                    <input type="checkbox" @bind="booleanValue" @bind:after="OnBooleanValueChanged" class="form-check-input" id="booleanInput" />
                                    <label class="form-check-label" for="booleanInput">Value</label>
                                </div>
                            }
                            else if (selectedTag.TypeId == 4) // Date
                            {
                                <label class="form-label">Value:</label>
                                <input type="date" @bind="dateValue" @bind:after="OnDateValueChanged" class="form-control" />
                            }
                            else if (selectedTag.TypeId == 5) // Time
                            {
                                <label class="form-label">Value:</label>
                                <input type="time" @bind="timeValue" @bind:after="OnTimeValueChanged" class="form-control" />
                            }
                            else if (selectedTag.TypeId == 6) // Decimal, precision 2
                            {
                                <label class="form-label">Value:</label>
                                <input type="number" @bind="decimalValue" @bind:after="OnDecimalValueChanged" class="form-control"
                                    placeholder="Enter decimal value" step="0.01" />
                            }
                            else
                            {
                                <label class="form-label">Description:</label>
                                <InputText @bind-Value="newActivity.Description" class="form-control"
                                    placeholder="Enter activity description" />
                            }
                        }
                        else
                        {
                            <label class="form-label">Description:</label>
                            <InputText @bind-Value="newActivity.Description" class="form-control"
                                placeholder="Enter activity description" />
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Date Started:</label>
                                @if (selectedTag?.TimeGranularity == LogMyDay.Domain.Enums.TimeGranularity.Exact || selectedTag?.TimeGranularity == LogMyDay.Domain.Enums.TimeGranularity.Hourly)
                                {
                                    <input type="datetime-local" @bind="newActivity.DateStarted" class="form-control" />
                                }
                                else
                                {
                                    <InputDate @bind-Value="newActivity.DateStarted" class="form-control" />
                                }
                            </div>
                        </div>
                        @if (selectedTag?.IsRange == true)
                        {
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Date Finished (optional):</label>
                                    @if (selectedTag?.TimeGranularity == LogMyDay.Domain.Enums.TimeGranularity.Exact || selectedTag?.TimeGranularity == LogMyDay.Domain.Enums.TimeGranularity.Hourly)
                                    {
                                        <input type="datetime-local" @bind="newActivity.DateFinished" class="form-control" />
                                    }
                                    else
                                    {
                                        <InputDate @bind-Value="newActivity.DateFinished" class="form-control" />
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="addAnotherAfterSave" id="addAnotherCheck">
                            <label class="form-check-label" for="addAnotherCheck">
                                <i class="bi bi-plus-circle me-1"></i>Add another activity after saving
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            Keep the form open with selected tag and date, but reset description
                        </small>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            Add Activity
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private PagedResult<LogMyDay.Shared.DTOs.ActivityResponse>? pagedResult;
    private IList<LogMyDay.Shared.DTOs.TagResponse>? tags;
    private LogMyDay.Shared.DTOs.ActivityRequest newActivity = new();
    private string? errorMessage;
    private LogMyDay.Shared.DTOs.TagResponse? selectedTag;
    private bool addAnotherAfterSave = false;
    
    // Input type value helpers
    private bool booleanValue = false;
    private DateTime? dateValue = null;
    private int? integerValue = null;
    private TimeOnly? timeValue = null;
    private decimal? decimalValue = null;

    // Display and filtering
    private string displayType = "daily";
    private string? descriptionFilter;
    private DateTime selectedDate = DateTime.Today;
    private int pageNumber = 1;
    private int weekPageNumber = 1;
    private int monthPageNumber = 1;
    private int weeksPerPage = 12;
    private int monthsPerPage = 12;
    private int totalPages = 1;
    private string orderBy = "desc";

    protected override async Task OnInitializedAsync()
    {
        // Redirect to login if not authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        selectedDate = DateTime.Today;
        InitializeNewActivity();
        await LoadData();
    }

    public async ValueTask DisposeAsync()
    {
        // No cleanup needed in mobile version
        await Task.CompletedTask;
    }

    private async Task LoadData()
    {
        try
        {
            DateTime? startDate = null;
            DateTime? endDate = null;

            // Set date range based on display type and selected date/period
            switch (displayType)
            {
                case "daily":
                    startDate = selectedDate.Date;
                    endDate = selectedDate.Date.AddDays(1).AddTicks(-1);
                    // For daily, get all activities for the day (no pagination)
                    pagedResult = await ActivityApi.GetActivities(1, 1000, orderBy, null, startDate, endDate, descriptionFilter);
                    totalPages = 1;
                    break;

                case "weekly":
                    var weekStart = GetStartOfWeek(selectedDate);
                    var weekEnd = weekStart.AddDays(7).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByWeeks(weekPageNumber, weeksPerPage, orderBy, null, weekStart, weekEnd,
                    descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / weeksPerPage);
                    break;

                case "monthly":
                    var monthStart = new DateTime(selectedDate.Year, selectedDate.Month, 1);
                    var monthEnd = monthStart.AddMonths(1).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByMonths(monthPageNumber, monthsPerPage, orderBy, null, monthStart,
                    monthEnd, descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / monthsPerPage);
                    break;
            }

            tags = await ActivityApi.GetTags();
            OnTagSelectionChanged();
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // AutoRetryAuthHandler will handle automatic retry and redirect to login if needed
            // Just show a user-friendly message
            errorMessage = "Authentication expired. Please wait or try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task OnDisplayTypeChanged(ChangeEventArgs e)
    {
        displayType = e.Value?.ToString() ?? "daily";
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        selectedDate = DateTime.Today;
        InitializeNewActivity();
        await LoadData();
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        descriptionFilter = e.Value?.ToString();
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        await LoadData();
    }

    private string GetCurrentPeriodDisplay()
    {
        return displayType switch
        {
            "daily" => selectedDate.ToString("MMMM dd, yyyy"),
            "weekly" => $"Week of {GetStartOfWeek(selectedDate):MMMM dd, yyyy}",
            "monthly" => selectedDate.ToString("MMMM yyyy"),
            _ => selectedDate.ToString("MMMM dd, yyyy")
        };
    }

    private string GetTodayButtonText()
    {
        return displayType switch
        {
            "daily" => "Today",
            "weekly" => "This Week",
            "monthly" => "This Month",
            _ => "Today"
        };
    }

    private async Task PreviousCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(-1),
            "weekly" => selectedDate.AddDays(-7),
            "monthly" => selectedDate.AddMonths(-1),
            _ => selectedDate.AddDays(-1)
        };

        InitializeNewActivity();
        await LoadData();
    }

    private async Task NextCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(1),
            "weekly" => selectedDate.AddDays(7),
            "monthly" => selectedDate.AddMonths(1),
            _ => selectedDate.AddDays(1)
        };

        InitializeNewActivity();
        await LoadData();
    }

    private async Task GoToToday()
    {
        selectedDate = DateTime.Today;
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        InitializeNewActivity();
        await LoadData();
    }

    private void InitializeNewActivity()
    {
        // Set the DateStarted to the selected date, but keep the current time if it's today
        if (selectedDate.Date == DateTime.Today)
        {
            newActivity.DateStarted = DateTime.Now;
        }
        else
        {
            // For other dates, set to the beginning of the selected day
            newActivity.DateStarted = selectedDate.Date;
        }
    }

    private DateTime GetStartOfWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-1 * diff).Date;
    }

    private int GetCurrentPageNumber()
    {
        return displayType switch
        {
            "weekly" => weekPageNumber,
            "monthly" => monthPageNumber,
            _ => pageNumber
        };
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // Check for duplicates if tag is selected and not repeatable
            if (newActivity.PrimaryTagId.HasValue && selectedTag != null && !selectedTag.IsRepeatable)
            {
                // Only skip duplicate check for Exact granularity since it allows precise timing
                if (selectedTag.TimeGranularity != LogMyDay.Domain.Enums.TimeGranularity.Exact)
                {
                    var duplicateCheck = await ActivityApi.CheckDuplicate(newActivity.PrimaryTagId.Value, newActivity.DateStarted);
                    if (duplicateCheck.HasDuplicate)
                    {
                        var granularityText = selectedTag.TimeGranularity.ToString().ToLower();
                        errorMessage = $"An activity for this tag already exists for the selected {granularityText} period. This tag is not repeatable.";

                        return;
                    }
                }
            }

            await ActivityApi.CreateCalendarItem(newActivity);
            
            // Store current values for "Add Another" functionality
            var keepTagId = newActivity.PrimaryTagId;
            var keepDate = newActivity.DateStarted;
            
            newActivity = new();
            InitializeNewActivity();
            
            if (addAnotherAfterSave)
            {
                // Keep selected tag and date, but reset description
                newActivity.PrimaryTagId = keepTagId;
                newActivity.DateStarted = keepDate;
                // Don't reset selectedTag so UI shows the kept selection
                // Reset only the description value, keep other values
                // Note: Input type values are reset below as normal
            }
            else
            {
                selectedTag = null; // Reset selected tag only if not adding another
            }
            
            integerValue = null; // Reset integer value
            booleanValue = false; // Reset boolean value
            dateValue = null; // Reset date value
            timeValue = null; // Reset time value
            decimalValue = null; // Reset decimal value
            errorMessage = null;
            await LoadData();

            // Close the modal after successful submission only if not adding another
            if (!addAnotherAfterSave)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("eval",
                    "bootstrap.Modal.getInstance(document.getElementById('addActivityModal'))?.hide()");
                }
                catch (InvalidOperationException)
                {
                    // Ignore JavaScript interop errors during static rendering
                }
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Handle validation errors from the server
            var content = await ex.GetContentAsAsync<string>();
            Logger.LogWarning("Validation error creating activity: {Content}", content);
            if (content != null && content.Contains("already exists"))
            {
                errorMessage = "An activity for this tag already exists for the selected period. This tag is not repeatable.";
            }
            else
            {
                errorMessage = $"Validation error: {content ?? ex.Message}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating activity");
            errorMessage = $"Error creating activity: {ex.Message}";
        }
    }

    private async Task DeleteActivity(int id)
    {
        try
        {
            await ActivityApi.Delete(id);
            await LoadData();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting activity with ID {ActivityId}", id);
            errorMessage = $"Error deleting activity: {ex.Message}";
        }
    }

    private async Task PrevPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber > 1)
                {
                    weekPageNumber--;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber > 1)
                {
                    monthPageNumber--;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber > 1)
                {
                    pageNumber--;
                    await LoadData();
                }
                break;
        }
    }

    private async Task NextPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber < totalPages)
                {
                    weekPageNumber++;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber < totalPages)
                {
                    monthPageNumber++;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber < totalPages)
                {
                    pageNumber++;
                    await LoadData();
                }
                break;
        }
    }

    private async Task ChangeOrder(string order)
    {
        orderBy = order;
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        await LoadData();
    }

    private void OnTagSelectionChanged()
    {
        if (newActivity.PrimaryTagId.HasValue)
        {
            selectedTag = tags?.FirstOrDefault(t => t.Id == newActivity.PrimaryTagId.Value);
            
            // Clear DateFinished if the selected tag is not a range type
            if (selectedTag?.IsRange != true)
            {
                newActivity.DateFinished = null;
            }
            
            // Initialize input type values and clear description
            newActivity.Description = null;
            if (selectedTag?.TypeId == 1) // Integer
            {
                integerValue = null;
                newActivity.Description = string.Empty;
            }
            else if (selectedTag?.TypeId == 3) // Boolean
            {
                booleanValue = false;
                newActivity.Description = "false";
            }
            else if (selectedTag?.TypeId == 4) // Date
            {
                dateValue = DateTime.Today;
                newActivity.Description = DateTime.Today.ToString("yyyy-MM-dd");
            }
            else if (selectedTag?.TypeId == 5) // Time
            {
                timeValue = TimeOnly.FromDateTime(DateTime.Now);
                newActivity.Description = timeValue?.ToString("HH:mm") ?? string.Empty;
            }
            else if (selectedTag?.TypeId == 6) // Decimal, precision 2
            {
                decimalValue = null;
                newActivity.Description = string.Empty;
            }
        }
        else
        {
            selectedTag = null;
            newActivity.DateFinished = null;
            newActivity.Description = null;
            integerValue = null;
            booleanValue = false;
            dateValue = null;
            timeValue = null;
            decimalValue = null;
        }
    }
    
    private void OnIntegerValueChanged()
    {
        newActivity.Description = integerValue?.ToString() ?? string.Empty;
    }
    
    private void OnBooleanValueChanged()
    {
        newActivity.Description = booleanValue.ToString().ToLower();
    }
    
    private void OnDateValueChanged()
    {
        newActivity.Description = dateValue?.ToString("yyyy-MM-dd") ?? string.Empty;
    }
    
    private void OnTimeValueChanged()
    {
        newActivity.Description = timeValue?.ToString("HH:mm") ?? string.Empty;
    }
    
    private void OnDecimalValueChanged()
    {
        // Round to 2 decimal places if value has higher precision
        if (decimalValue.HasValue)
        {
            var rounded = Math.Round(decimalValue.Value, 2);
            if (rounded != decimalValue.Value)
            {
                decimalValue = rounded;
            }
            newActivity.Description = rounded.ToString("F2");
        }
        else
        {
            newActivity.Description = string.Empty;
        }
    }
}
