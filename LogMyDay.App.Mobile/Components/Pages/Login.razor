@page "/"
@page "/login"
@using System.ComponentModel.DataAnnotations
@inject IActivityApi ActivityApi
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject LogMyDay.App.Mobile.Services.ServerConfigurationService ServerConfig
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Login - LogMyDay</PageTitle>

<div class="login-container">
    <div class="login-header">
        <h1>LogMyDay</h1>
        <p class="text-muted">Track your daily activities</p>
    </div>

    <div class="login-form">
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            
            <div class="form-group mb-3">
                <label class="form-label">Server URL:</label>
                <InputText @bind-Value="loginModel.ServerUrl" class="form-control form-control-lg" placeholder="https://logmyday.tadata.cz" />
                <ValidationMessage For="@(() => loginModel.ServerUrl)" class="text-danger" />
                <div class="form-text">Enter your LogMyDay server URL</div>
            </div>
            
            <div class="form-group mb-3">
                <label class="form-label">Username:</label>
                <InputText @bind-Value="loginModel.Username" class="form-control form-control-lg" placeholder="Enter username" />
                <ValidationMessage For="@(() => loginModel.Username)" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Password:</label>
                <InputText type="password" @bind-Value="loginModel.Password" class="form-control form-control-lg" placeholder="Enter password" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    @errorMessage
                </div>
            }

            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Login
            </button>
        </EditForm>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .login-header {
        text-align: center;
        color: white;
        margin-bottom: 2rem;
    }

    .login-header h1 {
        font-size: 2.5rem;
        font-weight: 300;
        margin-bottom: 0.5rem;
    }

    .login-form {
        background: white;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 400px;
    }

    .form-control-lg {
        padding: 0.75rem 1rem;
        font-size: 1.1rem;
    }

    .btn-lg {
        padding: 0.75rem 1rem;
        font-size: 1.1rem;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        // If already authenticated, redirect to home
        if (AuthService.CheckAuthentication())
        {
            Navigation.NavigateTo("/");
            return;
        }
        
        // Load saved server URL and credentials
        loginModel.ServerUrl = ServerConfig.CurrentServerUrl;
        if (string.IsNullOrEmpty(loginModel.ServerUrl))
        {
            loginModel.ServerUrl = "https://logmyday.tadata.cz";
        }
        
        // Optionally load saved username (but not password for security)
        loginModel.Username = Preferences.Get("Username", "");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Validate server URL
            var serverUrl = loginModel.ServerUrl?.Trim();
            if (string.IsNullOrEmpty(serverUrl))
            {
                errorMessage = "Server URL is required.";
                return;
            }

            // Configure server and test connection
            ServerConfig.UpdateServerConfiguration(serverUrl, loginModel.Username, loginModel.Password);
            
            // Test connection
            bool connectionSuccess = await ServerConfig.TestConnectionAsync();
            
            if (connectionSuccess)
            {
                // Connection successful - set authentication state
                AuthService.SetAuthenticated(true);
                
                // Navigate to home
                Navigation.NavigateTo("/");
            }
            else
            {
                // Try to get more specific error information
                var response = await ServerConfig.GetAsync("tags");
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Invalid username or password.";
                }
                else
                {
                    errorMessage = $"Cannot connect to server. Please check your server URL and credentials.";
                }
                Logger.LogWarning($"Login failed: {response.StatusCode} {response.ReasonPhrase}");
            }
        }
        catch (UriFormatException)
        {
            errorMessage = "Invalid server URL format. Please enter a valid URL like https://example.com";
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
            Logger.LogError(ex, "Login error");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required]
        [Url(ErrorMessage = "Please enter a valid URL")]
        public string ServerUrl { get; set; } = "https://logmyday.tadata.cz";

        [Required]
        public string Username { get; set; } = string.Empty;

        [Required] 
        public string Password { get; set; } = string.Empty;
    }
}
