@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="mobile-container">
    <div class="mobile-content" data-refresh-scrollable="true">
        @Body
    </div>
    
    <nav class="mobile-nav">
        <button class="mobile-nav-item @(IsActive("/") ? "active" : "")" @onclick="@(() => NavigateTo("/"))">
            <div><i class="bi bi-house"></i></div>
            <div>Home</div>
        </button>
        <button class="mobile-nav-item @(IsActive("/login") ? "active" : "")" @onclick="@(() => NavigateTo("/login"))">
            <div><i class="bi bi-person"></i></div>
            <div>Login</div>
        </button>
        <button class="mobile-nav-item @(IsActive("/test") ? "active" : "")" @onclick="@(() => NavigateTo("/test"))">
            <div><i class="bi bi-gear"></i></div>
            <div>Test</div>
        </button>
    </nav>
</div>

@code {
    private bool IsActive(string path)
    {
        try 
        {
            var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.Equals(currentPath, path.TrimStart('/'), StringComparison.OrdinalIgnoreCase) ||
                   (path == "/" && string.IsNullOrEmpty(currentPath));
        }
        catch 
        {
            return false;
        }
    }

    private void NavigateTo(string path)
    {
        try 
        {
            Navigation.NavigateTo(path);
            System.Diagnostics.Debug.WriteLine($"MainLayout: Navigated to {path}");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"MainLayout: Navigation error: {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        System.Diagnostics.Debug.WriteLine("MainLayout: Simple layout initialized");
    }
}
