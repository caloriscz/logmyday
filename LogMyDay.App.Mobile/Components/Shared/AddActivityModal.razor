@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<AddActivityModal> Logger

<!-- Add New Activity Modal - Full Screen Overlay -->
<div id="@modalId" data-modal class="hidden fixed inset-0 z-50 bg-white dark:bg-slate-900 transition-opacity duration-300 opacity-0" aria-labelledby="@($"{modalId}Label")">
    <div data-modal-content class="w-full h-full flex flex-col">
        <!-- Modal Header - Fixed at top -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
            <h5 class="text-xl font-semibold text-gray-900 dark:text-gray-100" id="@($"{modalId}Label")">Add New Activity</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors p-3 -mr-2" data-modal-hide="@modalId" aria-label="Close">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        
        <!-- Modal Body - Scrollable content -->
        <div class="flex-1 overflow-y-auto px-6 py-6">
                <EditForm id="@($"{modalId}Form")" Model="Activity" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-red-600 dark:text-red-400 mb-4" />

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Primary Tag:</label>
                        <InputSelect @bind-Value="Activity.PrimaryTagId" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" @bind-Value:after="OnTagSelectionChanged">
                            <option value="">-- Select Tag --</option>
                            @if (AvailableTags != null)
                            {
                                @foreach (var tag in AvailableTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-4">
                        @if (selectedTag?.TypeId.HasValue == true)
                        {
                            @switch (selectedTag.TypeId.Value)
                            {
                                case 1: // Integer
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Value:</label>
                                    <input type="number" @bind="integerValue" @bind:after="OnIntegerValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                case 3: // Boolean
                                    <div class="flex items-center">
                                        <input type="checkbox" @bind="booleanValue" @bind:after="OnBooleanValueChanged" class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" id="@($"{modalId}BoolCheck")" />
                                        <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="@($"{modalId}BoolCheck")">
                                            @selectedTag.Title
                                        </label>
                                    </div>
                                    break;
                                case 4: // Date
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Date:</label>
                                    <CultureAwareDatePicker Value="@dateValue" 
                                                          ValueChanged="@OnDateValueInputChanged" 
                                                          EnableTime="false" 
                                                          Placeholder="Select date" />
                                    break;
                                case 5: // Time
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Time:</label>
                                    <input type="time" @bind="timeValue" @bind:after="OnTimeValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                case 6: // Decimal
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Value:</label>
                                    <input type="number" step="0.01" @bind="decimalValue" @bind:after="OnDecimalValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                default:
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Description:</label>
                                    <input type="text" @bind="Activity.Description" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                            }
                        }
                        else
                        {
                            <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Description:</label>
                            <input type="text" @bind="Activity.Description" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                        }
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="">
                            <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Start Date & Time:</label>
                            <CultureAwareDatePicker Value="@Activity.DateStarted" 
                                                  ValueChanged="@((DateTime? v) => { Activity.DateStarted = v ?? DateTime.Now; })" 
                                                  EnableTime="true" 
                                                  Placeholder="Select start date & time" />
                        </div>
                        @if (selectedTag?.IsRange == true)
                        {
                            <div class="">
                                <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">End Date & Time:</label>
                                <CultureAwareDatePicker Value="@Activity.DateFinished" 
                                                      ValueChanged="@((DateTime? v) => { Activity.DateFinished = v; })" 
                                                      EnableTime="true" 
                                                      Placeholder="Select end date & time" />
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }
                    
                    <div class="mb-4">
                        <div class="flex items-center">
                            <input type="checkbox" @bind="AddAnotherAfterSave" @bind:after="OnAddAnotherChanged" class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" id="@($"{modalId}AddAnother")" />
                            <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="@($"{modalId}AddAnother")">
                                Add another activity after saving
                            </label>
                        </div>
                        <small class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                            Keep the form open with the same tag and date selected for quick entry of multiple activities.
                        </small>
                    </div>
                </EditForm>
            </div>
            
            <!-- Modal Footer - Fixed at bottom -->
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
                <div class="flex items-center justify-end gap-3">
                    <button type="button" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors text-base font-medium" data-modal-hide="@modalId">Cancel</button>
                    <button type="submit" form="@($"{modalId}Form")" class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 active:bg-primary-800 transition-colors text-base font-medium shadow-sm">
                        Save Activity
                    </button>
                </div>
            </div>
        </div>
</div>

@code {
    [Parameter] public ActivityRequest Activity { get; set; } = new();
    [Parameter] public IList<TagResponse>? AvailableTags { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool AddAnotherAfterSave { get; set; } = false;
    [Parameter] public EventCallback<bool> AddAnotherAfterSaveChanged { get; set; }
    [Parameter] public EventCallback<ActivityRequest> OnActivityCreated { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }
    [Parameter] public EventCallback OnFormReset { get; set; }
    [Parameter] public string ModalId { get; set; } = "addActivityModal";

    private TagResponse? selectedTag;
    
    // Input type value helpers
    private bool booleanValue = false;
    private DateTime? dateValue = null;
    private int? integerValue = null;
    private TimeOnly? timeValue = null;
    private decimal? decimalValue = null;

    private string modalId => ModalId;

    protected override void OnParametersSet()
    {
        // Update selected tag when activity changes
        OnTagSelectionChanged();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // Check for duplicates if tag is selected and not repeatable
            if (Activity.PrimaryTagId.HasValue && selectedTag != null && !selectedTag.IsRepeatable)
            {
                // Only skip duplicate check for Exact granularity since it allows precise timing
                if (selectedTag.TimeGranularity != TimeGranularity.Exact)
                {
                    var duplicateCheck = await ActivityApi.CheckDuplicate(Activity.PrimaryTagId.Value, Activity.DateStarted);
                    if (duplicateCheck.HasDuplicate)
                    {
                        var granularityText = selectedTag.TimeGranularity.ToString().ToLower();
                        await OnFormReset.InvokeAsync();
                        // Parent will handle showing error message
                        return;
                    }
                }
            }

            await ActivityApi.CreateCalendarItem(Activity);
            await OnActivityCreated.InvokeAsync(Activity);

            // Close the modal after successful submission only if not adding another
            if (!AddAnotherAfterSave)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("hideModal", modalId);
                }
                catch (InvalidOperationException)
                {
                    // Ignore JavaScript interop errors during static rendering
                }
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // AutoRetryAuthHandler will handle automatic retry and redirect to login if needed
            await OnFormReset.InvokeAsync();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Handle validation errors from the server
            var content = await ex.GetContentAsAsync<string>();
            Logger.LogWarning("Validation error creating activity: {Content}", content);
            
            if (content != null && content.Contains("already exists"))
            {
                await OnFormReset.InvokeAsync();
                // Parent will handle showing duplicate error message
            }
            else
            {
                await OnFormReset.InvokeAsync();
                // Parent will handle showing validation error message
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating activity");
            await OnFormReset.InvokeAsync();
            // Parent will handle showing general error message
        }
    }

    private void OnTagSelectionChanged()
    {
        if (Activity.PrimaryTagId.HasValue && AvailableTags != null)
        {
            selectedTag = AvailableTags.FirstOrDefault(t => t.Id == Activity.PrimaryTagId.Value);
            
            // Clear DateFinished if the selected tag is not a range type
            if (selectedTag?.IsRange != true)
            {
                Activity.DateFinished = null;
            }
            
            // Initialize input type values and clear description
            Activity.Description = null;
            if (selectedTag?.TypeId == 1) // Integer
            {
                integerValue = null;
                Activity.Description = string.Empty;
            }
            else if (selectedTag?.TypeId == 3) // Boolean
            {
                booleanValue = false;
                Activity.Description = "false";
            }
            else if (selectedTag?.TypeId == 4) // Date
            {
                dateValue = DateTime.Today;
                Activity.Description = DateTime.Today.ToString("yyyy-MM-dd");
            }
            else if (selectedTag?.TypeId == 5) // Time
            {
                timeValue = TimeOnly.FromDateTime(DateTime.Now);
                Activity.Description = timeValue?.ToString("HH:mm") ?? string.Empty;
            }
            else if (selectedTag?.TypeId == 6) // Decimal, precision 2
            {
                decimalValue = null;
                Activity.Description = string.Empty;
            }
        }
        else
        {
            selectedTag = null;
            Activity.DateFinished = null;
            Activity.Description = null;
            integerValue = null;
            booleanValue = false;
            dateValue = null;
            timeValue = null;
            decimalValue = null;
        }
    }
    
    private void OnIntegerValueChanged()
    {
        Activity.Description = integerValue?.ToString() ?? string.Empty;
    }
    
    private void OnBooleanValueChanged()
    {
        Activity.Description = booleanValue.ToString().ToLower();
    }
    
    private void OnDateValueChanged()
    {
        Activity.Description = dateValue?.ToString("yyyy-MM-dd") ?? string.Empty;
    }
    
    private void OnDateValueInputChanged(DateTime? value)
    {
        dateValue = value;
        OnDateValueChanged();
    }
    
    private void OnTimeValueChanged()
    {
        Activity.Description = timeValue?.ToString("HH:mm") ?? string.Empty;
    }
    
    private void OnDecimalValueChanged()
    {
        // Round to 2 decimal places if value has higher precision
        if (decimalValue.HasValue)
        {
            var rounded = Math.Round(decimalValue.Value, 2);
            if (rounded != decimalValue.Value)
            {
                decimalValue = rounded;
            }
            Activity.Description = rounded.ToString("F2");
        }
        else
        {
            Activity.Description = string.Empty;
        }
    }

    private async Task OnAddAnotherChanged()
    {
        if (AddAnotherAfterSaveChanged.HasDelegate)
        {
            await AddAnotherAfterSaveChanged.InvokeAsync(AddAnotherAfterSave);
        }
    }

    public void ResetForm()
    {
        selectedTag = null;
        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
    }
}


