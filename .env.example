# LogMyDay Docker Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQL Server connection details
# Examples:
#   - Azure SQL: yourserver.database.windows.net
#   - Local SQL Server: localhost,1433 or host.docker.internal,1433 (from Docker)
#   - Remote SQL Server: 192.168.1.100,1433
DB_HOST=your_sql_server_host
DB_NAME=your_database_name
DB_USER=your_database_user

# Note: Database password is stored in secrets/db_password.txt (not in this file)

# =============================================================================
# API BASE ADDRESS
# =============================================================================
# Internal API URL for Blazor Server to call its own API endpoints
# For Docker: Use http://localhost:9099
# For production with reverse proxy: Use your public HTTPS URL
# Examples:
#   - Docker development: http://localhost:9099
#   - Production: https://your-domain.com
API_BASE_URL=http://localhost:9099

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP server settings for sending emails (password reset, notifications)
# Leave these empty or use placeholder values if email is not configured
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@example.com
SMTP_SENDER_EMAIL=noreply@example.com
SMTP_SENDER_NAME=LogMyDay

# Note: SMTP password is stored in secrets/smtp_password.txt (not in this file)

# Password reset page URL (sent in email links)
# Should match your API_BASE_URL
PASSWORD_RESET_URL=http://localhost:9099/reset-password

# =============================================================================
# SECURITY / RATE LIMITING
# =============================================================================
# Authentication brute-force protection settings
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOCKOUT_MINUTES=30

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual configuration values
# 3. Create secret files in the secrets/ directory:
#    - secrets/db_password.txt (your database password)
#    - secrets/smtp_password.txt (your SMTP password, or empty if not using email)
# 4. Run: docker-compose up -d
