@using System.Globalization
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<AddActivityModal> Logger

<!-- Add New Activity Modal -->
<div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}Label")" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@($"{modalId}Label")">Add New Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="Activity" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Primary Tag:</label>
                        <InputSelect @bind-Value="Activity.PrimaryTagId" class="form-select" @bind-Value:after="OnTagSelectionChanged">
                            <option value="">-- Select Tag --</option>
                            @if (AvailableTags != null)
                            {
                                @foreach (var tag in AvailableTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        @if (selectedOptionList is not null)
                        {
                            <label class="form-label" for="@($"{modalId}OptionSelect")">Value:</label>
                            <InputSelect id="@($"{modalId}OptionSelect")" class="form-select" @bind-Value="selectedOptionValue" @bind-Value:after="OnOptionValueChanged">
                                <option value="">-- Select an option --</option>
                                @foreach (var option in selectedOptionList.Options)
                                {
                                    <option value="@option.Value">@(!string.IsNullOrWhiteSpace(option.DisplayName) ? option.DisplayName : option.Value)</option>
                                }
                            </InputSelect>
                        }
                        else if (selectedTag?.TypeId.HasValue == true)
                        {
                            @switch (selectedTag.TypeId.Value)
                            {
                                case 1: // Integer
                                    <label class="form-label">Value @if (!string.IsNullOrWhiteSpace(selectedTag?.UnitSymbol)) { <span class="text-muted">(@selectedTag.UnitSymbol)</span> }</label>
                                    <input type="number" @bind="integerValue" @bind:after="OnIntegerValueChanged" class="form-control"
                                           placeholder="Enter numeric value" step="1" />
                                    break;
                                case 2: // String
                                    <label class="form-label">Value:</label>
                                    <input type="text" @bind="Activity.Description" class="form-control"
                                           placeholder="Enter text value" />
                                    break;
                                case 3: // Boolean
                                    <div class="form-check">
                                        <input type="checkbox" @bind="booleanValue" @bind:after="OnBooleanValueChanged" class="form-check-input" id="@($"{modalId}BoolCheck")" />
                                        <label class="form-check-label" for="@($"{modalId}BoolCheck")">
                                            @selectedTag.Title
                                        </label>
                                    </div>
                                    break;
                                case 4: // Date
                                    <label class="form-label">Date:</label>
                                    <input type="date" @bind="dateValue" @bind:after="OnDateValueChanged" class="form-control" />
                                    break;
                                case 5: // Time
                                    <label class="form-label">Time:</label>
                                    <input type="time" @bind="timeValue" @bind:after="OnTimeValueChanged" class="form-control" />
                                    break;
                                case 6: // Decimal
                                    <label class="form-label">Value @if (!string.IsNullOrWhiteSpace(selectedTag?.UnitSymbol)) { <span class="text-muted">(@selectedTag.UnitSymbol)</span> }</label>
                                    <input type="number" step="0.01" @bind="decimalValue" @bind:after="OnDecimalValueChanged" class="form-control"
                                           placeholder="Enter decimal value" />
                                    break;
                                default:
                                    <label class="form-label">Description:</label>
                                    <input type="text" @bind="Activity.Description" class="form-control"
                                           placeholder="Enter activity description" />
                                    break;
                            }
                        }
                        else
                        {
                            <label class="form-label">Description:</label>
                            <input type="text" @bind="Activity.Description" class="form-control"
                                   placeholder="Enter activity description" />
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Start Date & Time:</label>
                            @if (selectedTag?.TimeGranularity == TimeGranularity.Exact || selectedTag?.TimeGranularity == TimeGranularity.Hourly)
                            {
                                <input type="datetime-local" @bind="Activity.DateStarted" class="form-control" />
                            }
                            else
                            {
                                <input type="date" @bind="dateStartedInput" @bind:after="OnDateStartedChanged" class="form-control" />
                            }
                        </div>
                        @if (selectedTag?.IsRange == true)
                        {
                            <div class="col-md-6">
                                <label class="form-label">End Date & Time:</label>
                                @if (selectedTag?.TimeGranularity == TimeGranularity.Exact || selectedTag?.TimeGranularity == TimeGranularity.Hourly)
                                {
                                    <input type="datetime-local" @bind="Activity.DateFinished" class="form-control" />
                                }
                                else
                                {
                                    <input type="date" @bind="dateFinishedInput" @bind:after="OnDateFinishedChanged" class="form-control" />
                                }
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" @bind="AddAnotherAfterSave" @bind:after="OnAddAnotherChanged" class="form-check-input" id="@($"{modalId}AddAnother")" />
                            <label class="form-check-label" for="@($"{modalId}AddAnother")">
                                Add another activity after saving
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            Keep the form open with the same tag and date selected for quick entry of multiple activities.
                        </small>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            Save Activity
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ActivityRequest Activity { get; set; } = new();
    [Parameter] public IList<TagResponse>? AvailableTags { get; set; }
    [Parameter] public IReadOnlyList<TagOptionListResponse>? OptionLists { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool AddAnotherAfterSave { get; set; } = false;
    [Parameter] public EventCallback<bool> AddAnotherAfterSaveChanged { get; set; }
    [Parameter] public EventCallback<ActivityRequest> OnActivityCreated { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public string ModalId { get; set; } = "addActivityModal";
    [Parameter] public int? PreselectedTagId { get; set; }
    [Parameter] public DateTime? PreselectedDate { get; set; }

    private TagResponse? selectedTag;
    private TagOptionListResponse? selectedOptionList;
    private string? selectedOptionValue;
    
    // Input type value helpers
    private bool booleanValue = false;
    private DateTime? dateValue = null;
    private int? integerValue = null;
    private TimeOnly? timeValue = null;
    private decimal? decimalValue = null;
    
    // Date input helpers for non-exact time granularities
    private DateTime? dateStartedInput = null;
    private DateTime? dateFinishedInput = null;

    private string modalId => ModalId;

    protected override void OnParametersSet()
    {
        // Set preselected tag if provided
        if (PreselectedTagId.HasValue && Activity.PrimaryTagId != PreselectedTagId.Value)
        {
            Activity.PrimaryTagId = PreselectedTagId.Value;
            OnTagSelectionChanged();
        }
        
        // Set preselected date if provided
        if (PreselectedDate.HasValue)
        {
            Activity.DateStarted = PreselectedDate.Value.Date == DateTime.Today 
                ? DateTime.Now 
                : PreselectedDate.Value.Date;
            dateStartedInput = PreselectedDate.Value.Date;
        }
        else if (Activity.DateStarted == default)
        {
            Activity.DateStarted = DateTime.Now;
            dateStartedInput = DateTime.Today;
        }
        
        // Update selected tag when activity changes
        OnTagSelectionChanged();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // Check for duplicates if tag is selected and not repeatable
            if (Activity.PrimaryTagId.HasValue && selectedTag != null && !selectedTag.IsRepeatable)
            {
                // Only skip duplicate check for Exact granularity since it allows precise timing
                if (selectedTag.TimeGranularity != TimeGranularity.Exact)
                {
                    var duplicateCheck = await ActivityApi.CheckDuplicate(Activity.PrimaryTagId.Value, Activity.DateStarted);
                    if (duplicateCheck.HasDuplicate)
                    {
                        var granularityText = selectedTag.TimeGranularity.ToString().ToLower();
                        await OnError.InvokeAsync($"Activity with tag '{selectedTag.Title}' already exists for this {granularityText}. This tag is not repeatable.");
                        return;
                    }
                }
            }

            await ActivityApi.CreateCalendarItem(Activity);
            await OnActivityCreated.InvokeAsync(Activity);

            // Close the modal after successful submission only if not adding another
            if (!AddAnotherAfterSave)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("eval",
                        $"bootstrap.Modal.getInstance(document.getElementById('{modalId}'))?.hide()");
                }
                catch (InvalidOperationException)
                {
                    // Ignore JavaScript interop errors during static rendering
                }
            }
            else
            {
                // Reset form for adding another activity but keep tag and date
                ResetFormForAnother();
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await OnError.InvokeAsync("Authentication failed. Please refresh and try again.");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Handle validation errors from the server
            var content = await ex.GetContentAsAsync<string>();
            Logger.LogWarning("Validation error creating activity: {Content}", content);
            
            if (content != null && content.Contains("already exists"))
            {
                await OnError.InvokeAsync($"Activity with tag '{selectedTag?.Title}' already exists for this time period. This tag is not repeatable.");
            }
            else
            {
                await OnError.InvokeAsync($"Validation error: {content ?? "Invalid data provided."}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating activity");
            await OnError.InvokeAsync("An unexpected error occurred while creating the activity. Please try again.");
        }
    }

    private void OnTagSelectionChanged()
    {
        if (Activity.PrimaryTagId.HasValue && AvailableTags != null)
        {
            selectedTag = AvailableTags.FirstOrDefault(t => t.Id == Activity.PrimaryTagId.Value);
            selectedOptionList = null;
            selectedOptionValue = null;

            if (selectedTag?.IsRange != true)
            {
                Activity.DateFinished = null;
                dateFinishedInput = null;
            }

            Activity.Description = null;
            integerValue = null;
            booleanValue = false;
            dateValue = null;
            timeValue = null;
            decimalValue = null;

            if (selectedTag?.OptionListId is int listId && OptionLists != null)
            {
                selectedOptionList = OptionLists.FirstOrDefault(list => list.Id == listId);
                if (selectedOptionList is not null)
                {
                    selectedOptionValue = ResolveDefaultOptionValue(selectedTag, selectedOptionList);
                    Activity.Description = selectedOptionValue ?? string.Empty;
                    return;
                }
            }

            switch (selectedTag?.TypeId)
            {
                case 1:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && int.TryParse(selectedTag.DefaultValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var defaultInt))
                    {
                        integerValue = defaultInt;
                        Activity.Description = defaultInt.ToString(CultureInfo.InvariantCulture);
                    }
                    else
                    {
                        Activity.Description = string.Empty;
                    }
                    break;
                case 2:
                    Activity.Description = selectedTag.DefaultValue ?? string.Empty;
                    break;
                case 3:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && bool.TryParse(selectedTag.DefaultValue, out var defaultBool))
                    {
                        booleanValue = defaultBool;
                    }
                    Activity.Description = booleanValue ? "true" : "false";
                    break;
                case 4:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && DateTime.TryParse(selectedTag.DefaultValue, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var defaultDate))
                    {
                        dateValue = defaultDate.Date;
                    }
                    else
                    {
                        dateValue = Activity.DateStarted.Date;
                    }

                    Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
                    break;
                case 5:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && TimeOnly.TryParse(selectedTag.DefaultValue, CultureInfo.InvariantCulture, out var defaultTime))
                    {
                        timeValue = defaultTime;
                    }
                    else
                    {
                        timeValue = TimeOnly.FromDateTime(Activity.DateStarted);
                    }

                    Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
                    break;
                case 6:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && decimal.TryParse(selectedTag.DefaultValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var defaultDecimal))
                    {
                        decimalValue = defaultDecimal;
                        Activity.Description = defaultDecimal.ToString("0.#############################", CultureInfo.InvariantCulture);
                    }
                    else
                    {
                        Activity.Description = string.Empty;
                    }
                    break;
                default:
                    Activity.Description = string.Empty;
                    break;
            }
        }
        else
        {
            selectedTag = null;
            selectedOptionList = null;
            selectedOptionValue = null;
            Activity.DateFinished = null;
            dateFinishedInput = null;
            Activity.Description = null;
            integerValue = null;
            booleanValue = false;
            dateValue = null;
            timeValue = null;
            decimalValue = null;
        }
    }
    
    private void OnIntegerValueChanged()
    {
        Activity.Description = integerValue?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private void OnBooleanValueChanged()
    {
        Activity.Description = booleanValue ? "true" : "false";
    }

    private void OnDateValueChanged()
    {
        Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private void OnTimeValueChanged()
    {
        Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private void OnDecimalValueChanged()
    {
        // Round to 2 decimal places if value has higher precision
        if (decimalValue.HasValue)
        {
            var rounded = Math.Round(decimalValue.Value, 2);
            if (rounded != decimalValue.Value)
            {
                decimalValue = rounded;
            }
            Activity.Description = rounded.ToString("0.#############################", CultureInfo.InvariantCulture);
        }
        else
        {
            Activity.Description = string.Empty;
        }
    }

    private void OnOptionValueChanged()
    {
        Activity.Description = selectedOptionValue ?? string.Empty;
    }

    private static string? ResolveDefaultOptionValue(TagResponse? tag, TagOptionListResponse optionList)
    {
        if (tag is null)
        {
            return optionList.Options.FirstOrDefault()?.Value;
        }

        if (!string.IsNullOrWhiteSpace(tag.DefaultValue))
        {
            var match = optionList.Options.FirstOrDefault(o => string.Equals(o.Value, tag.DefaultValue, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                return match.Value;
            }
        }

        return optionList.Options.FirstOrDefault()?.Value;
    }

    private void OnDateStartedChanged()
    {
        if (dateStartedInput.HasValue)
        {
            Activity.DateStarted = dateStartedInput.Value.Date;
        }
    }

    private void OnDateFinishedChanged()
    {
        if (dateFinishedInput.HasValue)
        {
            Activity.DateFinished = dateFinishedInput.Value.Date;
        }
    }

    private async Task OnAddAnotherChanged()
    {
        if (AddAnotherAfterSaveChanged.HasDelegate)
        {
            await AddAnotherAfterSaveChanged.InvokeAsync(AddAnotherAfterSave);
        }
    }

    public void ResetForm()
    {
        Activity = new ActivityRequest
        {
            DateStarted = DateTime.Now
        };
        dateStartedInput = DateTime.Today;
        selectedTag = null;
        selectedOptionList = null;
        selectedOptionValue = null;
        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
        dateFinishedInput = null;
    }

    private void ResetFormForAnother()
    {
        // Keep tag and date, reset only the description and input values
        var keepTagId = Activity.PrimaryTagId;
        var keepDateStarted = Activity.DateStarted;
        var keepDateFinished = Activity.DateFinished;

        // Reset input values but keep tag selection
        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
        selectedOptionValue = null;

        // Reset description based on tag type
        if (selectedOptionList is not null)
        {
            selectedOptionValue = ResolveDefaultOptionValue(selectedTag, selectedOptionList);
            Activity.Description = selectedOptionValue ?? string.Empty;
        }
        else if (selectedTag?.TypeId == 3) // Boolean
        {
            booleanValue = false;
            Activity.Description = "false";
        }
        else if (selectedTag?.TypeId == 4) // Date
        {
            dateValue = keepDateStarted.Date;
            Activity.Description = dateValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
        else if (selectedTag?.TypeId == 5) // Time
        {
            timeValue = TimeOnly.FromDateTime(keepDateStarted);
            Activity.Description = timeValue.ToString("HH:mm", CultureInfo.InvariantCulture);
        }
        else
        {
            Activity.Description = string.Empty;
        }
        
        // Restore preserved values
        Activity.PrimaryTagId = keepTagId;
        Activity.DateStarted = keepDateStarted;
        Activity.DateFinished = keepDateFinished;
    }
}
