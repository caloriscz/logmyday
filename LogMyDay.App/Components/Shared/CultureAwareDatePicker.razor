@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Microsoft.JSInterop
@using LogMyDay.Shared.Preferences
@using Microsoft.AspNetCore.Components.Web
@using LogMyDay.App.Services
@inject IJSRuntime JSRuntime
@inject IUserPreferencesService UserPreferencesService
@implements IAsyncDisposable

<div class="culture-aware-datepicker-wrapper @(Stretch ? "stretch" : string.Empty)">
    <input type="text"
           id="@elementId"
           class="@GetInputCssClasses()"
           placeholder="@Placeholder"
           readonly="@(!AllowManualInput)"
           disabled="@Disabled"
           @onfocus="HandleFocus"
           @onmousedown="HandleMouseDown" />
</div>

@code {
    private readonly string elementId = $"datepicker_{Guid.NewGuid():N}";
    private DotNetObjectReference<CultureAwareDatePicker>? dotnetHelper;
    private UserPreferencesSnapshot? userPreferences;
    private bool isInitialized;
    private DateTime? lastValue;
    private DateTime? lastSyncedValue;

    [Parameter]
    public DateTime? Value { get; set; }

    [Parameter]
    public EventCallback<DateTime?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback ValueChangedAfter { get; set; }

    [Parameter]
    public bool EnableTime { get; set; } = false;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string Placeholder { get; set; } = "Select date";

    [Parameter]
    public bool AllowManualInput { get; set; } = false;

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public bool Stretch { get; set; } = true;

    private string GetInputCssClasses()
    {
        var baseClasses = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100";

        return string.IsNullOrWhiteSpace(CssClass)
            ? baseClasses
            : $"{baseClasses} {CssClass}";
    }

    private string FormattedValue => FormatValue(Value);

    private string GetDisplayPattern()
    {
        if (userPreferences == null)
        {
            var culture = CultureInfo.CurrentCulture;
            return EnableTime
                ? $"{culture.DateTimeFormat.ShortDatePattern} {culture.DateTimeFormat.ShortTimePattern}"
                : culture.DateTimeFormat.ShortDatePattern;
        }

        return EnableTime
            ? $"{userPreferences.Preferences.ShortDatePattern} {userPreferences.Preferences.ShortTimePattern}"
            : userPreferences.Preferences.ShortDatePattern;
    }

    private string FormatValue(DateTime? value)
    {
        if (value == null)
        {
            return string.Empty;
        }

        var pattern = GetDisplayPattern();
        var culture = userPreferences?.Culture ?? CultureInfo.CurrentCulture;

        return value.Value.ToString(pattern, culture);
    }

    private void HandleFocus(FocusEventArgs args)
    {
        if (!AllowManualInput)
        {
            _ = JSRuntime.InvokeVoidAsync("lmdDatePicker.open", elementId);
        }
    }

    private void HandleMouseDown(MouseEventArgs args)
    {
        if (!AllowManualInput)
        {
            _ = JSRuntime.InvokeVoidAsync("lmdDatePicker.open", elementId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Value != lastValue)
        {
            lastValue = Value;

            if (isInitialized)
            {
                await SyncPickerValueAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializePickerAsync();
        }
    }

    private async Task InitializePickerAsync()
    {
        try
        {
            userPreferences ??= await UserPreferencesService.GetAsync();

            if (userPreferences == null)
            {
                Console.WriteLine("Warning: Could not load user preferences for CultureAwareDatePicker");
                return;
            }

            dotnetHelper = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync("lmdDatePicker.init", elementId, dotnetHelper, BuildConfig());

            isInitialized = true;
            await SyncPickerValueAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing CultureAwareDatePicker: {ex.Message}");
        }
    }

    private object BuildConfig()
    {
        var pattern = GetDisplayPattern();
        var culture = userPreferences!.Culture;
        return new
        {
            defaultDate = GetJsDateValue(Value, EnableTime),
            enableTime = EnableTime,
            enableSeconds = EnableTime && ContainsSeconds(userPreferences.Preferences.ShortTimePattern),
            culture = culture.Name,
            formatPattern = pattern,
            firstDayOfWeek = (int)userPreferences.Preferences.StartOfWeek,
            monthNames = culture.DateTimeFormat.MonthNames.Where(m => !string.IsNullOrWhiteSpace(m)).Take(12).ToArray(),
            monthNamesShort = culture.DateTimeFormat.AbbreviatedMonthNames.Where(m => !string.IsNullOrWhiteSpace(m)).Take(12).ToArray(),
            weekDayNames = culture.DateTimeFormat.DayNames,
            weekDayNamesShort = culture.DateTimeFormat.AbbreviatedDayNames,
            allowManualInput = AllowManualInput
        };
    }

    private bool Uses24HourClock()
    {
        if (userPreferences == null)
        {
            return !CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern.Contains("tt", StringComparison.OrdinalIgnoreCase);
        }

        return !userPreferences.Preferences.ShortTimePattern.Contains("tt", StringComparison.OrdinalIgnoreCase);
    }

    private IDictionary<string, object?>? BuildFormatOptions()
    {
        if (userPreferences == null)
        {
            return null;
        }

        var options = new Dictionary<string, object?>();

        AddDateFormatOptions(userPreferences.Preferences.ShortDatePattern, options);

        if (EnableTime)
        {
            var timePattern = userPreferences.Preferences.ShortTimePattern;
            var hourOption = GetHourFormatOption(timePattern);
            var minuteOption = GetMinuteFormatOption(timePattern);
            var secondOption = GetSecondFormatOption(timePattern);

            if (hourOption != null)
            {
                options["hour"] = hourOption;
            }

            if (minuteOption != null)
            {
                options["minute"] = minuteOption;
            }

            if (secondOption != null)
            {
                options["second"] = secondOption;
            }

            options["hour12"] = Is12HourFormat(timePattern);
        }

        return options.Count == 0 ? null : options;
    }

    private static void AddDateFormatOptions(string pattern, IDictionary<string, object?> options)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return;
        }

        if (pattern.Contains("yyyy", StringComparison.OrdinalIgnoreCase))
        {
            options["year"] = "numeric";
        }
        else if (pattern.Contains("yy", StringComparison.OrdinalIgnoreCase))
        {
            options["year"] = "2-digit";
        }

        if (pattern.Contains("MMMM", StringComparison.Ordinal))
        {
            options["month"] = "long";
        }
        else if (pattern.Contains("MMM", StringComparison.Ordinal))
        {
            options["month"] = "short";
        }
        else if (pattern.Contains("MM", StringComparison.Ordinal))
        {
            options["month"] = "2-digit";
        }
        else if (pattern.Contains("M", StringComparison.Ordinal))
        {
            options["month"] = "numeric";
        }

        if (pattern.Contains("dd", StringComparison.Ordinal))
        {
            options["day"] = "2-digit";
        }
        else if (pattern.Contains("d", StringComparison.Ordinal))
        {
            options["day"] = "numeric";
        }
    }

    private static string? GetHourFormatOption(string pattern)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return null;
        }

        if (pattern.Contains("HH", StringComparison.Ordinal))
        {
            return "2-digit";
        }

        if (pattern.Contains("H", StringComparison.Ordinal))
        {
            return "numeric";
        }

        if (pattern.Contains("hh", StringComparison.Ordinal))
        {
            return "2-digit";
        }

        if (pattern.Contains("h", StringComparison.Ordinal))
        {
            return "numeric";
        }

        return null;
    }

    private static string? GetMinuteFormatOption(string pattern)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return null;
        }

        if (pattern.Contains("mm", StringComparison.Ordinal))
        {
            return "2-digit";
        }

        if (pattern.Contains("m", StringComparison.Ordinal))
        {
            return "numeric";
        }

        return null;
    }

    private static string? GetSecondFormatOption(string pattern)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return null;
        }

        if (pattern.Contains("ss", StringComparison.Ordinal))
        {
            return "2-digit";
        }

        if (pattern.Contains("s", StringComparison.Ordinal))
        {
            return "numeric";
        }

        return null;
    }

    private static bool ContainsSeconds(string pattern)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return false;
        }

        return pattern.Contains("s", StringComparison.Ordinal);
    }

    private static bool Is12HourFormat(string pattern)
    {
        if (string.IsNullOrEmpty(pattern))
        {
            return false;
        }

        return pattern.Contains("h", StringComparison.Ordinal) || pattern.Contains("tt", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SyncPickerValueAsync()
    {
        if (!isInitialized)
        {
            return;
        }

        if (Value == lastSyncedValue)
        {
            return;
        }

        var jsValue = GetJsDateValue(Value, EnableTime);
        await JSRuntime.InvokeVoidAsync("lmdDatePicker.setValue", elementId, jsValue);
        lastSyncedValue = Value;
    }

    private static string? GetJsDateValue(DateTime? value, bool includeTime)
    {
        if (!value.HasValue)
        {
            return null;
        }

        return includeTime
            ? value.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)
            : value.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    [JSInvokable]
    public async Task OnDateChanged(string dateStr)
    {
        try
        {
            var parsedDate = ParseIncomingDate(dateStr);

            lastSyncedValue = parsedDate;
            await ValueChanged.InvokeAsync(parsedDate);

            if (ValueChangedAfter.HasDelegate)
            {
                await ValueChangedAfter.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing date in CultureAwareDatePicker: {ex.Message}");
        }
    }

    private DateTime? ParseIncomingDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsedUtc))
        {
            return ConvertFromUtcIfNeeded(parsedUtc);
        }

        if (userPreferences != null)
        {
            var culture = userPreferences.Culture;
            var pattern = GetDisplayPattern();

            if (DateTime.TryParseExact(value, pattern, culture, DateTimeStyles.None, out var parsedExact))
            {
                return parsedExact;
            }

            if (DateTime.TryParse(value, culture, DateTimeStyles.None, out var parsedCulture))
            {
                return parsedCulture;
            }
        }

        if (DateTime.TryParse(value, out var fallback))
        {
            return fallback;
        }

        throw new FormatException($"Failed to parse date value '{value}'.");
    }

    private DateTime ConvertFromUtcIfNeeded(DateTime parsedUtc)
    {
        if (parsedUtc.Kind != DateTimeKind.Utc || userPreferences == null)
        {
            return parsedUtc;
        }

        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(parsedUtc, userPreferences.TimeZone);
        }
        catch (TimeZoneNotFoundException)
        {
            return parsedUtc.ToLocalTime();
        }
        catch (InvalidTimeZoneException)
        {
            return parsedUtc.ToLocalTime();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (isInitialized)
            {
                await JSRuntime.InvokeVoidAsync("lmdDatePicker.destroy", elementId);
            }
        }
        catch
        {
            // Suppress exceptions during disposal
        }
        finally
        {
            dotnetHelper?.Dispose();
        }
    }
}
