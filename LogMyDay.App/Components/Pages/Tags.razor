@page "/tags"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Services
@using System.Linq
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject ILogger<Tags> Logger
@inject IPageTitleService PageTitleService

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-md-6">
            <h3>Add New Tag</h3>
            <EditForm Model="newTag" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label">Title:</label>
                    <InputText @bind-Value="newTag.Tag" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Type (optional):</label>
                    <InputSelect @bind-Value="newTag.TypeId" class="form-select">
                        <option value="">(None)</option>
                        @foreach (var type in inputTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </InputSelect>
                </div>                <div class="mb-3">
                    <label class="form-label">Required:</label>
                    <InputCheckbox @bind-Value="newTag.IsRequired" class="form-check-input" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Repeatable:</label>
                    <InputCheckbox @bind-Value="newTag.IsRepeatable" class="form-check-input" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Time Granularity:</label>
                    <InputSelect @bind-Value="newTag.TimeGranularity" class="form-select">
                        @foreach (var granularity in Enum.GetValues<TimeGranularity>())
                        {
                            <option value="@granularity">@granularity</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label">Is Range:</label>
                    <InputCheckbox @bind-Value="newTag.IsRange" class="form-check-input" />
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Min Value:</label>
                        <InputNumber @bind-Value="newTag.MinValue" class="form-control" TValue="double?" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Max Value:</label>
                        <InputNumber @bind-Value="newTag.MaxValue" class="form-control" TValue="double?" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Step:</label>
                        <InputNumber @bind-Value="newTag.Step" class="form-control" TValue="double?" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Default Value:</label>
                    <InputText @bind-Value="newTag.DefaultValue" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Unit (optional):</label>
                    @if (availableUnits.Count > 0)
                    {
                        <InputSelect @bind-Value="newTag.UnitId" class="form-select" TValue="int?">
                            <option value="">(None)</option>
                            @foreach (var unit in availableUnits)
                            {
                                <option value="@unit.Id">@unit.Symbol (@unit.QuantityKey)</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            No units yet. <a href="/units">Let's create your first unit.</a>
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">Option List (optional):</label>
                    @if (availableOptionLists.Count > 0)
                    {
                        <InputSelect @bind-Value="newTag.OptionListId" class="form-select" TValue="int?">
                            <option value="">(None)</option>
                            @foreach (var list in availableOptionLists)
                            {
                                <option value="@list.Id">@list.Name</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            No option lists yet. <a href="/option-lists">Let's create your first list.</a>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Add Tag</button>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="text-danger mt-2">@errorMessage</div>
                }
            </EditForm>
        </div>
        <div class="col-md-12 mt-5">
            <h3>Tags</h3>
            <div class="mb-3 d-flex align-items-end gap-2">
                <div>
                    <label>Name Filter:</label>
                    <input class="form-control" style="width:200px;display:inline-block;" @bind="filter" @bind:event="oninput" placeholder="Filter by name..." />
                </div>
                <div>
                    <label>Type:</label>
                    <select class="form-select" style="width:120px;display:inline-block;" @bind="filterType">
                        <option value="contains">Contains</option>
                        <option value="exact">Exact</option>
                    </select>
                </div>
                <div>
                    <label>Sort:</label>
                    <select class="form-select" style="width:120px;display:inline-block;" @bind="orderBy">
                        <option value="asc">A-Z</option>
                        <option value="desc">Z-A</option>
                    </select>
                </div>
                <button class="btn btn-primary" @onclick="ApplyFilter">Apply</button>
            </div>

            @if (pagedResult == null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="table-responsive d-none d-lg-block">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Actions</th>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Required</th>
                                <th>Repeatable</th>
                                <th>Time Granularity</th>
                                <th>Is Range</th>
                                <th>Unit</th>
                                <th>Default</th>
                                <th>Min</th>
                                <th>Max</th>
                                <th>Step</th>
                                <th>Option List</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tag in pagedResult.Items)
                            {
                                <tr>
                                    <td>
                                        <a class="btn btn-secondary btn-sm me-1" href="/tags/edit/@tag.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(tag.Id)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                    <td>@tag.Id</td>
                                    <td>@tag.Title</td>
                                    <td>
                                        @if (tag.TypeId.HasValue)
                                        {
                                            var typeName = inputTypes.FirstOrDefault(t => t.Id == tag.TypeId)?.Name;
                                            @typeName
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>@(tag.IsRequired ? "Yes" : "No")</td>
                                    <td>@(tag.IsRepeatable ? "Yes" : "No")</td>
                                    <td>@tag.TimeGranularity</td>
                                    <td>@(tag.IsRange ? "Yes" : "No")</td>
                                    <td>@(string.IsNullOrWhiteSpace(tag.UnitSymbol) ? "-" : tag.UnitSymbol)</td>
                                    <td>@(string.IsNullOrWhiteSpace(tag.DefaultValue) ? "-" : tag.DefaultValue)</td>
                                    <td>@(tag.MinValue?.ToString() ?? "-")</td>
                                    <td>@(tag.MaxValue?.ToString() ?? "-")</td>
                                    <td>@(tag.Step?.ToString() ?? "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(tag.OptionListName) ? "-" : tag.OptionListName)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-lg-none">
                    @foreach (var tag in pagedResult.Items)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h6 class="card-title mb-0">@tag.Title</h6>
                                    <div>
                                        <a class="btn btn-secondary btn-sm me-1" href="/tags/edit/@tag.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(tag.Id)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">ID:</small>
                                        <div>@tag.Id</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Type:</small>
                                        <div>
                                            @if (tag.TypeId.HasValue)
                                            {
                                                var typeName = inputTypes.FirstOrDefault(t => t.Id == tag.TypeId)?.Name;
                                                @typeName
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Required:</small>
                                        <div>
                                            @if (tag.IsRequired)
                                            {
                                                <span class="badge bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Repeatable:</small>
                                        <div>
                                            @if (tag.IsRepeatable)
                                            {
                                                <span class="badge bg-info">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Time Granularity:</small>
                                        <div>@tag.TimeGranularity</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Is Range:</small>
                                        <div>
                                            @if (tag.IsRange)
                                            {
                                                <span class="badge bg-warning">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Unit:</small>
                                        <div>@(string.IsNullOrWhiteSpace(tag.UnitSymbol) ? "-" : tag.UnitSymbol)</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Default:</small>
                                        <div>@(string.IsNullOrWhiteSpace(tag.DefaultValue) ? "-" : tag.DefaultValue)</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <small class="text-muted">Min:</small>
                                        <div>@(tag.MinValue?.ToString() ?? "-")</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Max:</small>
                                        <div>@(tag.MaxValue?.ToString() ?? "-")</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Step:</small>
                                        <div>@(tag.Step?.ToString() ?? "-")</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <small class="text-muted">Option List:</small>
                                        <div>@(string.IsNullOrWhiteSpace(tag.OptionListName) ? "-" : tag.OptionListName)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-secondary btn-sm" @onclick="PrevPage" disabled="@(pageNumber == 1)">Previous</button>
                    <span>Page @pageNumber of @totalPages</span>
                    <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(pageNumber == totalPages)">Next</button>
                </div>
            }
        </div>
    </div>
</div>

@if (tagIdToDelete.HasValue)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this tag?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => tagIdToDelete = null" disabled="@isDeleting">Cancel</button>
                    <button class="btn btn-danger" @onclick="() => DeleteTag(tagIdToDelete.Value)" disabled="@isDeleting">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<TagResponse>? pagedResult;
    private int pageNumber = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private string orderBy = "asc";
    private string? filter = null;
    private string filterType = "contains";

    private LogMyDay.Shared.DTOs.TagRequest newTag = new()
    {
        Tag = string.Empty,
        TypeId = 1,
        IsRequired = false,
        IsRepeatable = true,
        TimeGranularity = TimeGranularity.Exact,
        IsRange = false,
        UnitId = null,
        MinValue = null,
        MaxValue = null,
        Step = null,
        DefaultValue = null,
        OptionListId = null
    };
    private string? errorMessage;
    private List<InputTypeDto> inputTypes = new();
    private List<UnitResponse> availableUnits = new();
    private List<TagOptionListResponse> availableOptionLists = new();

    private int? tagIdToDelete = null;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Tags");
        
        try
        {
            inputTypes = await ActivityApi.GetInputTypesAsync();
            await LoadSupportingData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load input types");
        }

        await LoadTags();
    }

    private async Task LoadSupportingData()
    {
        try
        {
            availableUnits = (await ActivityApi.GetUnitsAsync())
                .OrderBy(u => u.QuantityKey)
                .ThenBy(u => u.Key)
                .ToList();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load units");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load units");
        }

        try
        {
            availableOptionLists = (await ActivityApi.GetTagOptionListsAsync())
                .OrderBy(l => l.Name)
                .ToList();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load option lists");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load option lists");
        }
    }

    private async Task LoadTags()
    {
        try
        {
            pagedResult = await ActivityApi.GetTagsPaged(pageNumber, pageSize, orderBy, filter, filterType);
            totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / pageSize);
            errorMessage = null;
            StateHasChanged();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
            Logger.LogError(ex, "Error loading tags");
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            await ActivityApi.CreateTag(newTag);
            newTag = new()
            {
                Tag = string.Empty,
                TypeId = 1,
                IsRequired = false,
                IsRepeatable = true,
                TimeGranularity = TimeGranularity.Exact,
                IsRange = false,
                UnitId = null,
                MinValue = null,
                MaxValue = null,
                Step = null,
                DefaultValue = null,
                OptionListId = null
            }; // Default to Integer, not required
            await LoadTags();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating tag: {ex.Message}";
            Logger.LogError(ex, "Error creating tag");
        }
    }

    private async Task PrevPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadTags();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadTags();
        }
    }

    private async Task ApplyFilter()
    {
        pageNumber = 1;
        await LoadTags();
    }

    private async Task DeleteTag(int id)
    {
        isDeleting = true;
        try
        {
            await ActivityApi.DeleteTag(id);
            await LoadTags();
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting tag: {ex.Message}";
            Logger.LogError(ex, "Error deleting tag");
        }
        finally
        {
            isDeleting = false;
            tagIdToDelete = null;
        }
    }

    private void ConfirmDelete(int id)
    {
        tagIdToDelete = id;
    }
}
