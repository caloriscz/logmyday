@page "/tags"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Shared
@using System.Linq
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject ILogger<Tags> Logger
@inject IPageTitleService PageTitleService

<div class="mx-auto max-w-6xl space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Tags</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Manage the tags and metadata used across your activities.</p>
        </div>
        <a href="/tags/new" class="inline-flex items-center gap-2 self-start rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:self-auto">
            <Icon Name="plus" Class="h-4 w-4" />
            Add Tag
        </a>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }

    <section class="space-y-4">
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="grid gap-4 sm:grid-cols-[repeat(4,minmax(0,1fr))] sm:items-end">
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Name Filter</label>
                        <input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" @bind="filter" @bind:event="oninput" placeholder="Filter by name..." />
                    </div>
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Type</label>
                        <select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" @bind="filterType">
                            <option value="contains">Contains</option>
                            <option value="exact">Exact</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Sort</label>
                        <select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" @bind="orderBy">
                            <option value="asc">A-Z</option>
                            <option value="desc">Z-A</option>
                        </select>
                    </div>
                    <div class="sm:justify-self-end">
                        <button type="button" class="mt-2 inline-flex items-center gap-2 rounded-lg border border-primary-200 bg-primary-50 px-4 py-2 text-sm font-semibold text-primary-700 transition-colors hover:bg-primary-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-primary-500/40 dark:bg-primary-500/20 dark:text-primary-200 dark:hover:bg-primary-500/30 dark:focus-visible:ring-offset-slate-900" @onclick="ApplyFilter">
                            <Icon Name="filter" Class="h-4 w-4" />
                            Apply
                        </button>
                    </div>
                </div>
            </div>

            @if (pagedResult == null)
            {
                <div class="rounded-xl border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    Loading tags…
                </div>
            }
            else if (!pagedResult.Items.Any())
            {
                <div class="rounded-xl border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    No tags found. Adjust your filters or create a new tag.
                </div>
            }
            else
            {
                <div class="hidden md:block">
                    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                            <thead class="bg-gray-50 dark:bg-slate-800">
                                <tr>
                                    <th scope="col" class="w-28 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300"></th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Name</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Type</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Required</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Repeatable</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Time Granularity</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Is Range</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Unit</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Default</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Min</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Max</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Step</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Option List</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                                @foreach (var tag in pagedResult.Items)
                                {
                                    <tr class="transition-colors hover:bg-gray-50 focus-within:bg-gray-50 dark:even:bg-slate-800/30 dark:hover:bg-slate-800/60 dark:focus-within:bg-slate-800/60">
                                        <td class="px-1 w-[56px] py-3">
                                            <div class="flex items-center gap-2">
                                                <a href="/tags/edit/@tag.Id" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" title="Edit tag">
                                                    <Icon Name="pencil" Class="h-4 w-4" />
                                                </a>
                                                <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" title="Delete tag" @onclick="() => ConfirmDelete(tag.Id)">
                                                    <Icon Name="trash" Class="h-4 w-4" />
                                                </button>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-slate-100">@tag.Title</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@GetTypeName(tag.TypeId)</td>
                                        <td class="px-4 py-3 text-sm">
                                            @if (tag.IsRequired)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-500/20 dark:text-rose-200">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm">
                                            @if (tag.IsRepeatable)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-200">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@tag.TimeGranularity</td>
                                        <td class="px-4 py-3 text-sm">
                                            @if (tag.IsRange)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:bg-amber-500/20 dark:text-amber-200">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.UnitSymbol) ? "—" : tag.UnitSymbol)</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.DefaultValue) ? "—" : tag.DefaultValue)</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(tag.MinValue?.ToString() ?? "—")</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(tag.MaxValue?.ToString() ?? "—")</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(tag.Step?.ToString() ?? "—")</td>
                                        <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.OptionListName) ? "—" : tag.OptionListName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="space-y-3 md:hidden">
                    @foreach (var tag in pagedResult.Items)
                    {
                        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all focus-within:ring-2 focus-within:ring-primary-500 dark:border-slate-700 dark:bg-slate-900">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@tag.Title</h3>
                                    <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">ID @tag.Id</p>
                                </div>
                                <div class="flex gap-2">
                                    <a href="/tags/edit/@tag.Id" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" title="Edit tag">
                                        <Icon Name="pencil" Class="h-4 w-4" />
                                    </a>
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" title="Delete tag" @onclick="() => ConfirmDelete(tag.Id)">
                                        <Icon Name="trash" Class="h-4 w-4" />
                                    </button>
                                </div>
                            </div>

                            <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Type</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@GetTypeName(tag.TypeId)</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Time Granularity</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@tag.TimeGranularity</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Required</dt>
                                    <dd>
                                        @if (tag.IsRequired)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-500/20 dark:text-rose-200">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Repeatable</dt>
                                    <dd>
                                        @if (tag.IsRepeatable)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-200">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Is Range</dt>
                                    <dd>
                                        @if (tag.IsRange)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:bg-amber-500/20 dark:text-amber-200">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">No</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Unit</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.UnitSymbol) ? "—" : tag.UnitSymbol)</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Default</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.DefaultValue) ? "—" : tag.DefaultValue)</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Min</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(tag.MinValue?.ToString() ?? "—")</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Max</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(tag.MaxValue?.ToString() ?? "—")</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Step</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(tag.Step?.ToString() ?? "—")</dd>
                                </div>
                                <div class="col-span-2">
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Option List</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@(string.IsNullOrWhiteSpace(tag.OptionListName) ? "—" : tag.OptionListName)</dd>
                                </div>
                            </dl>
                        </div>
                    }
                </div>

                <div class="flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:flex-row sm:items-center sm:justify-between">
                    <span class="text-sm font-medium text-gray-700 dark:text-slate-300">Page @pageNumber of @totalPages</span>
                    <div class="flex items-center gap-2">
                        <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="PrevPage" disabled="@(pageNumber == 1)">
                            Previous
                        </button>
                        <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="NextPage" disabled="@(pageNumber == totalPages)">
                            Next
                        </button>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    Total tags: @(pagedResult?.TotalCount ?? 0)
                </div>
            }
    </section>
</div>

@if (tagIdToDelete.HasValue)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-xl border border-gray-200 bg-white shadow-xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete tag</h3>
            </div>
            <div class="px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                Are you sure you want to delete this tag? This action cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="() => tagIdToDelete = null" disabled="@isDeleting">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" @onclick="() => DeleteTag(tagIdToDelete.Value)" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string GetTypeName(int? typeId)
    {
        if (!typeId.HasValue)
        {
            return "—";
        }

        var type = inputTypes.FirstOrDefault(t => t.Id == typeId);

        return type?.Name ?? "—";
    }

    private PagedResult<TagResponse>? pagedResult;
    private int pageNumber = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private string orderBy = "asc";
    private string? filter = null;
    private string filterType = "contains";

    private string? errorMessage;
    private List<InputTypeDto> inputTypes = new();

    private int? tagIdToDelete = null;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Tags");
        
        try
        {
            inputTypes = await ActivityApi.GetInputTypesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load input types");
        }

        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            pagedResult = await ActivityApi.GetTagsPaged(pageNumber, pageSize, orderBy, filter, filterType);
            totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / pageSize);
            errorMessage = null;
            StateHasChanged();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
            Logger.LogError(ex, "Error loading tags");
        }
    }

    private async Task PrevPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadTags();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadTags();
        }
    }

    private async Task ApplyFilter()
    {
        pageNumber = 1;
        await LoadTags();
    }

    private async Task DeleteTag(int id)
    {
        isDeleting = true;
        try
        {
            await ActivityApi.DeleteTag(id);
            await LoadTags();
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting tag: {ex.Message}";
            Logger.LogError(ex, "Error deleting tag");
        }
        finally
        {
            isDeleting = false;
            tagIdToDelete = null;
        }
    }

    private void ConfirmDelete(int id)
    {
        tagIdToDelete = id;
    }
}
