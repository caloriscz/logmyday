@page "/users"
@using System.ComponentModel.DataAnnotations
@using LogMyDay.Shared.Preferences
@using Microsoft.AspNetCore.Authorization
@using LogMyDay.App.Services
@inject IUsersApi UsersApi
@inject IAuthApi AuthApi
@inject IJSRuntime JSRuntime
@inject ILogger<Users> Logger
@inject IPageTitleService PageTitleService

@attribute [Authorize(Policy = "AdminOnly")]

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
        <h2 class="mb-0">User Management</h2>
        <div class="text-muted small">
            Manage application users. Only administrators can access this page.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success")" role="alert">
            @statusMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Loading users...</span>
        </div>
    }
    else if (isUnauthorized)
    {
        <div class="alert alert-danger" role="alert">
            You do not have permission to manage users.
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-xl-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Create New User</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="newUser" OnValidSubmit="CreateUserAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label" for="newUserEmail">Email</label>
                                <InputText id="newUserEmail" @bind-Value="newUser.Email" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="newUserCulture">Culture</label>
                                <InputText id="newUserCulture" @bind-Value="newUser.Culture" class="form-control" />
                                <div class="form-text">Examples: en-US, de-AT.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="newUserTimeZone">Time Zone</label>
                                <InputText id="newUserTimeZone" @bind-Value="newUser.TimeZone" class="form-control" />
                                <div class="form-text">Use IANA identifiers like Europe/Vienna.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="newUserDisplayName">Display Name (optional)</label>
                                <InputText id="newUserDisplayName" @bind-Value="newUser.DisplayName" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="newUserPassword">Password</label>
                                <InputText id="newUserPassword" @bind-Value="newUser.Password" type="password" class="form-control" autocomplete="new-password" />
                                <div class="form-text">Minimum 10 characters.</div>
                            </div>

                            <div class="form-check mb-3">
                                <InputCheckbox id="newUserIsAdmin" @bind-Value="newUser.IsAdmin" class="form-check-input" />
                                <label class="form-check-label" for="newUserIsAdmin">Grant administrator access</label>
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@isCreating">
                                @if (isCreating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-person-plus me-1"></i>Create User</span>
                                }
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">Existing Users</h5>
                    </div>
                    <div class="card-body">
                        @if (users == null || users.Count == 0)
                        {
                            <div class="alert alert-info mb-0">No users found. Create a new user using the form on the left.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Email</th>
                                            <th>Display Name</th>
                                            <th>Preferences</th>
                                            <th class="text-center">Admin</th>
                                            <th>Updated</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in users)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@user.Email</div>
                                                    <div class="text-muted small">Created @user.CreatedUtc.ToLocalTime().ToString("g")</div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(user.DisplayName) ? "—" : user.DisplayName)</div>
                                                    <div class="text-muted small">@user.Id</div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@user.Culture</div>
                                                    <div class="text-muted small">@user.TimeZone</div>
                                                </td>
                                                <td class="text-center">
                                                    @if (user.IsAdmin)
                                                    {
                                                        <span class="badge bg-success">Admin</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">User</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="small text-muted">@user.UpdatedUtc.ToLocalTime().ToString("g")</span>
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-secondary btn-sm me-2" @onclick="() => BeginEdit(user)" disabled="@isCreating">
                                                        <i class="bi bi-pencil"></i> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDeleteAsync(user)" disabled="@(!CanDelete(user) || deletingUserId == user.Id || isCreating)">
                                                        @if (deletingUserId == user.Id)
                                                        {
                                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-trash"></i> Delete</span>
                                                        }
                                                    </button>
                                                </td>
                                            </tr>

                                            if (editingUserId == user.Id)
                                            {
                                                <tr class="table-light">
                                                    <td colspan="6">
                                                        <EditForm Model="editUser" OnValidSubmit="SaveEditAsync">
                                                            <DataAnnotationsValidator />
                                                            <ValidationSummary />
                                                            <div class="row g-3">
                                                                <div class="col-md-6 col-lg-3">
                                                                    <label class="form-label" for="editEmail">Email</label>
                                                                    <InputText id="editEmail" @bind-Value="editUser.Email" class="form-control" />
                                                                </div>
                                                                <div class="col-md-6 col-lg-3">
                                                                    <label class="form-label" for="editDisplayName">Display Name</label>
                                                                    <InputText id="editDisplayName" @bind-Value="editUser.DisplayName" class="form-control" />
                                                                </div>
                                                                <div class="col-md-6 col-lg-3">
                                                                    <label class="form-label" for="editCulture">Culture</label>
                                                                    <InputText id="editCulture" @bind-Value="editUser.Culture" class="form-control" />
                                                                </div>
                                                                <div class="col-md-6 col-lg-3">
                                                                    <label class="form-label" for="editTimeZone">Time Zone</label>
                                                                    <InputText id="editTimeZone" @bind-Value="editUser.TimeZone" class="form-control" />
                                                                </div>
                                                                <div class="col-12 col-lg-3">
                                                                    <div class="form-check mt-2 mt-lg-4">
                                                                        <InputCheckbox id="editIsAdmin" @bind-Value="editUser.IsAdmin" class="form-check-input" />
                                                                        <label class="form-check-label" for="editIsAdmin">Administrator</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex justify-content-end gap-2 mt-3">
                                                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@isUpdating">
                                                                    Cancel
                                                                </button>
                                                                <button type="submit" class="btn btn-primary" disabled="@isUpdating">
                                                                    @if (isUpdating)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                                        <span>Saving...</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span><i class="bi bi-save me-1"></i>Save Changes</span>
                                                                    }
                                                                </button>
                                                            </div>
                                                        </EditForm>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<UserDto> users = new();
    private Guid? currentUserId;
    private CreateUserModel newUser = new();
    private EditUserModel editUser = new();
    private Guid? editingUserId;
    private bool isLoading = true;
    private bool isUnauthorized;
    private bool isCreating;
    private bool isUpdating;
    private Guid? deletingUserId;
    private string? statusMessage;
    private bool statusIsError;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("User Management");
        
        try
        {
            isLoading = true;
            statusMessage = null;

            try
            {
                var currentUser = await AuthApi.GetCurrentUserAsync();
                currentUserId = currentUser?.Id;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load current user information");
            }

            await LoadUsersAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var response = await UsersApi.GetUsersAsync();
            users.Clear();
            users.AddRange(response.OrderBy(u => u.Email));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden || ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "User management is not authorized");
            isUnauthorized = true;
            SetStatus("You are not authorized to view users.", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
            SetStatus("Failed to load users. Please try again.", true);
        }
    }

    private async Task CreateUserAsync()
    {
        if (isCreating)
        {
            return;
        }

        isCreating = true;
        SetStatus(null);

        try
        {
            var request = new CreateUserDto(
                newUser.Email.Trim(),
                newUser.Password,
                string.IsNullOrWhiteSpace(newUser.DisplayName) ? null : newUser.DisplayName.Trim(),
                newUser.IsAdmin,
                newUser.Culture.Trim(),
                newUser.TimeZone.Trim());

            var createdUser = await UsersApi.CreateUserAsync(request);
            users.Add(createdUser);
            SortUsers();
            newUser = new CreateUserModel();
            SetStatus($"User '{createdUser.Email}' created successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to create user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to create user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while creating user");
            SetStatus("An unexpected error occurred while creating the user.", true);
        }
        finally
        {
            isCreating = false;
        }
    }

    private void BeginEdit(UserDto user)
    {
        editingUserId = user.Id;
        editUser = new EditUserModel
        {
            Email = user.Email,
            DisplayName = user.DisplayName ?? string.Empty,
            Culture = user.Culture,
            TimeZone = user.TimeZone,
            IsAdmin = user.IsAdmin
        };
        SetStatus(null);
    }

    private void CancelEdit()
    {
        editingUserId = null;
        editUser = new EditUserModel();
    }

    private async Task SaveEditAsync()
    {
        if (editingUserId == null || isUpdating)
        {
            return;
        }

        isUpdating = true;
        SetStatus(null);

        try
        {
            var request = new UpdateUserDto(
                editUser.Email.Trim(),
                editUser.DisplayName?.Trim(),
                editUser.IsAdmin,
                editUser.Culture.Trim(),
                editUser.TimeZone.Trim());

            var updatedUser = await UsersApi.UpdateUserAsync(editingUserId.Value, request);
            var index = users.FindIndex(u => u.Id == updatedUser.Id);
            if (index >= 0)
            {
                users[index] = updatedUser;
                SortUsers();
            }
            editingUserId = null;
            editUser = new EditUserModel();
            SetStatus($"User '{updatedUser.Email}' updated successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to update user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to update user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while updating user");
            SetStatus("An unexpected error occurred while updating the user.", true);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task ConfirmDeleteAsync(UserDto user)
    {
        if (!CanDelete(user) || deletingUserId == user.Id)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete user '{user.Email}'? This action cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        deletingUserId = user.Id;
        SetStatus(null);

        try
        {
            await UsersApi.DeleteUserAsync(user.Id);
            users.RemoveAll(u => u.Id == user.Id);
            SetStatus($"User '{user.Email}' deleted successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to delete user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while deleting user");
            SetStatus("An unexpected error occurred while deleting the user.", true);
        }
        finally
        {
            deletingUserId = null;
        }
    }

    private bool CanDelete(UserDto user)
    {
        return currentUserId == null || currentUserId.Value != user.Id;
    }

    private void SortUsers()
    {
        users.Sort((a, b) => string.Compare(a.Email, b.Email, StringComparison.OrdinalIgnoreCase));
    }

    private void SetStatus(string? message, bool isError = false)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private static async Task<string?> ExtractErrorMessageAsync(Refit.ApiException exception)
    {
        if (!string.IsNullOrWhiteSpace(exception.Content))
        {
            return exception.Content;
        }

        try
        {
            var problemDetails = await exception.GetContentAsAsync<Microsoft.AspNetCore.Mvc.ProblemDetails>();
            return problemDetails?.Detail ?? problemDetails?.Title;
        }
        catch
        {
            return null;
        }
    }

    private sealed class CreateUserModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters long.")]
        public string Password { get; set; } = string.Empty;

        public string? DisplayName { get; set; }

        [Required]
        public string Culture { get; set; } = PreferencesFactory.DefaultCulture;

        [Required]
        public string TimeZone { get; set; } = PreferencesFactory.DefaultTimeZoneId;

        public bool IsAdmin { get; set; }
    }

    private sealed class EditUserModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? DisplayName { get; set; }

        [Required]
        public string Culture { get; set; } = PreferencesFactory.DefaultCulture;

        [Required]
        public string TimeZone { get; set; } = PreferencesFactory.DefaultTimeZoneId;

        public bool IsAdmin { get; set; }
    }
}
