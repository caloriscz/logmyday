@page "/users"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using LogMyDay.Shared.Preferences
@using Microsoft.AspNetCore.Authorization
@using LogMyDay.App.Services
@inject IUsersApi UsersApi
@inject IJSRuntime JSRuntime
@inject ILogger<Users> Logger
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService

@attribute [Authorize(Policy = "AdminOnly")]

<div class="mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">User Management</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Only administrators can invite, edit, or remove users.</p>
        </div>
        <button type="button" class="inline-flex items-center gap-2 self-start rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:self-auto" @onclick="OpenCreateModal" disabled="@isCreating">
            <Icon Name="person-plus" Class="h-4 w-4" />
            Invite User
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="rounded-lg border @(statusIsError ? "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-100" : "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-500/40 dark:bg-emerald-500/20 dark:text-emerald-100") px-4 py-3 text-sm">
            @statusMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
            <span>Loading users…</span>
        </div>
    }
    else if (isUnauthorized)
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-100">
            You do not have permission to manage users.
        </div>
    }
    else
    {
        <section class="space-y-4">
                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Existing Users</h2>
                        <span class="text-sm text-gray-500 dark:text-slate-400">Updated @FormatUserDate(DateTime.UtcNow)</span>
                    </div>
                </div>

                @if (users == null || users.Count == 0)
                {
                    <div class="rounded-xl border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                        No users found. Use the Invite User button above to add someone.
                    </div>
                }
                else
                {
                    <div class="hidden md:block">
                        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                            <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                                <thead class="bg-gray-50 dark:bg-slate-800">
                                    <tr>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Email</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Display Name</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Preferences</th>
                                        <th scope="col" class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Admin</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Updated</th>
                                        <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                                    @foreach (var user in users)
                                    {
                                        <tr class="transition-colors hover:bg-gray-50 focus-within:bg-gray-50 dark:even:bg-slate-800/30 dark:hover:bg-slate-800/60 dark:focus-within:bg-slate-800/60">
                                            <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                                                <div class="font-semibold">@user.Email</div>
                                                <div class="text-xs text-gray-500 dark:text-slate-400">Created @FormatUserDate(user.CreatedUtc)</div>
                                            </td>
                                            <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                                                <div class="font-semibold">@(string.IsNullOrWhiteSpace(user.DisplayName) ? "—" : user.DisplayName)</div>
                                                <div class="text-xs text-gray-500 dark:text-slate-400">@user.Id</div>
                                            </td>
                                            <td class="px-4 py-3 text-sm text-gray-900 dark:text-slate-100">
                                                <div class="font-semibold">@user.Culture</div>
                                                <div class="text-xs text-gray-500 dark:text-slate-400">@user.TimeZone</div>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                @if (user.IsAdmin)
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-200">Admin</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">User</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@FormatUserDate(user.UpdatedUtc)</td>
                                            <td class="px-4 py-3 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => BeginEdit(user)" disabled="@isCreating">
                                                        <Icon Name="pencil" Class="h-4 w-4" />
                                                        <span>Edit</span>
                                                    </button>
                                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDeleteAsync(user)" disabled="@(!CanDelete(user) || deletingUserId == user.Id || isCreating)">
                                                        @if (deletingUserId == user.Id)
                                                        {
                                                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-rose-500/40 border-t-rose-500"></span>
                                                            <span>Deleting…</span>
                                                        }
                                                        else
                                                        {
                                                            <Icon Name="trash" Class="h-4 w-4" />
                                                            <span>Delete</span>
                                                        }
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>

                                        if (editingUserId == user.Id)
                                        {
                                            <tr class="bg-gray-50/70 dark:bg-slate-800/60">
                                                <td colspan="6" class="px-4 py-4">
                                                    <EditForm Model="editUser" OnValidSubmit="SaveEditAsync">
                                                        <DataAnnotationsValidator />
                                                        <ValidationSummary class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200" />
                                                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                                                            <div class="space-y-2">
                                                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="editEmail">Email</label>
                                                                <InputText id="editEmail" @bind-Value="editUser.Email" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
                                                            </div>
                                                            <div class="space-y-2">
                                                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="editDisplayName">Display Name</label>
                                                                <InputText id="editDisplayName" @bind-Value="editUser.DisplayName" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
                                                            </div>
                                                            <div class="space-y-2">
                                                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="editCulture">Culture</label>
                                                                <SearchableSelect @bind-Value="editUser.Culture"
                                                                                  Id="editCulture"
                                                                                  Options="CultureOptions"
                                                                                  Placeholder="Select culture"
                                                                                  SearchPlaceholder="Search cultures"
                                                                                  ShowValueInList="true" />
                                                            </div>
                                                            <div class="space-y-2">
                                                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="editTimeZone">Time Zone</label>
                                                                <SearchableSelect @bind-Value="editUser.TimeZone"
                                                                                  Id="editTimeZone"
                                                                                  Options="TimeZoneOptions"
                                                                                  Placeholder="Select time zone"
                                                                                  SearchPlaceholder="Search time zones"
                                                                                  ShowValueInList="true" />
                                                            </div>
                                                            <div class="flex items-center gap-3">
                                                                <InputCheckbox id="editIsAdmin" @bind-Value="editUser.IsAdmin" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" />
                                                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="editIsAdmin">Administrator</label>
                                                            </div>
                                                        </div>
                                                        <div class="mt-4 flex flex-wrap justify-end gap-3">
                                                            <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="CancelEdit" disabled="@isUpdating">
                                                                Cancel
                                                            </button>
                                                            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" disabled="@isUpdating">
                                                                @if (isUpdating)
                                                                {
                                                                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                                                                    <span>Saving…</span>
                                                                }
                                                                else
                                                                {
                                                                    <Icon Name="save" Class="h-4 w-4" />
                                                                    <span>Save Changes</span>
                                                                }
                                                            </button>
                                                        </div>
                                                    </EditForm>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="space-y-4 md:hidden">
                        @foreach (var user in users)
                        {
                            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@user.Email</h3>
                                        <p class="text-xs text-gray-500 dark:text-slate-400">Created @FormatUserDate(user.CreatedUtc)</p>
                                    </div>
                                    <div class="flex gap-2">
                                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => BeginEdit(user)" disabled="@isCreating">
                                            <Icon Name="pencil" Class="h-4 w-4" />
                                        </button>
                                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDeleteAsync(user)" disabled="@(!CanDelete(user) || deletingUserId == user.Id || isCreating)">
                                            @if (deletingUserId == user.Id)
                                            {
                                                <span class="h-4 w-4 animate-spin rounded-full border-2 border-rose-500/40 border-t-rose-500"></span>
                                            }
                                            else
                                            {
                                                <Icon Name="trash" Class="h-4 w-4" />
                                            }
                                        </button>
                                    </div>
                                </div>

                                <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">Display Name</dt>
                                        <dd class="text-gray-900 dark:text-slate-200">@(string.IsNullOrWhiteSpace(user.DisplayName) ? "—" : user.DisplayName)</dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">User ID</dt>
                                        <dd class="text-xs text-gray-500 dark:text-slate-400">@user.Id</dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">Culture</dt>
                                        <dd class="text-gray-900 dark:text-slate-200">@user.Culture</dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">Time Zone</dt>
                                        <dd class="text-gray-900 dark:text-slate-200">@user.TimeZone</dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">Admin</dt>
                                        <dd>
                                            @if (user.IsAdmin)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-200">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700/40 dark:text-slate-300">User</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-600 dark:text-slate-400">Updated</dt>
                                        <dd class="text-gray-900 dark:text-slate-200">@FormatUserDate(user.UpdatedUtc)</dd>
                                    </div>
                                </dl>

                                @if (editingUserId == user.Id)
                                {
                                    <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-800/60">
                                        <EditForm Model="editUser" OnValidSubmit="SaveEditAsync">
                                            <DataAnnotationsValidator />
                                            <div class="space-y-3">
                                                <div class="space-y-1">
                                                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="mobileEditEmail">Email</label>
                                                    <InputText id="mobileEditEmail" @bind-Value="editUser.Email" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
                                                </div>
                                                <div class="space-y-1">
                                                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="mobileEditDisplayName">Display Name</label>
                                                    <InputText id="mobileEditDisplayName" @bind-Value="editUser.DisplayName" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
                                                </div>
                                                <SearchableSelect @bind-Value="editUser.Culture"
                                                                  Id="mobileEditCulture"
                                                                  Options="CultureOptions"
                                                                  Placeholder="Select culture"
                                                                  SearchPlaceholder="Search cultures"
                                                                  ShowValueInList="true" />
                                                <SearchableSelect @bind-Value="editUser.TimeZone"
                                                                  Id="mobileEditTimeZone"
                                                                  Options="TimeZoneOptions"
                                                                  Placeholder="Select time zone"
                                                                  SearchPlaceholder="Search time zones"
                                                                  ShowValueInList="true" />
                                                <label class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-slate-200">
                                                    <InputCheckbox id="mobileEditIsAdmin" @bind-Value="editUser.IsAdmin" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" />
                                                    Administrator
                                                </label>
                                                <div class="flex flex-wrap justify-end gap-2">
                                                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="CancelEdit" disabled="@isUpdating">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" disabled="@isUpdating">
                                                        @if (isUpdating)
                                                        {
                                                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                                                            <span>Saving…</span>
                                                        }
                                                        else
                                                        {
                                                            <Icon Name="save" Class="h-4 w-4" />
                                                            <span>Save</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </EditForm>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    Total users: @(users?.Count ?? 0)
                </div>
            </section>
    }
</div>

@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isCreating) CloseCreateModal(); }">
        <div class="w-full max-w-3xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Invite User</h2>
                    <p class="text-sm text-gray-600 dark:text-slate-400">Create a new account and configure their preferences.</p>
                </div>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200 dark:focus-visible:ring-offset-slate-900" @onclick="() => { if (!isCreating) CloseCreateModal(); }" disabled="@isCreating">
                    <Icon Name="close" Class="h-5 w-5" />
                    <span class="sr-only">Close</span>
                </button>
            </div>

            <EditForm Model="newUser" OnValidSubmit="CreateUserAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="mx-6 mt-5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200" />

                <div class="max-h-[70vh] overflow-y-auto px-6 py-5">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="sm:col-span-2 space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="newUserEmail">Email</label>
                            <InputText id="newUserEmail" @bind-Value="newUser.Email" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isCreating" />
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="newUserCulture">Culture</label>
                            <SearchableSelect @bind-Value="newUser.Culture"
                                              Id="newUserCulture"
                                              Options="CultureOptions"
                                              Placeholder="Select culture"
                                              SearchPlaceholder="Search cultures"
                                              ShowValueInList="true" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">Pick a culture (e.g., Deutsch (Österreich) — de-AT).</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="newUserTimeZone">Time Zone</label>
                            <SearchableSelect @bind-Value="newUser.TimeZone"
                                              Id="newUserTimeZone"
                                              Options="TimeZoneOptions"
                                              Placeholder="Select time zone"
                                              SearchPlaceholder="Search time zones"
                                              ShowValueInList="true" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">Pick an IANA time zone (e.g., Europe/Vienna).</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="newUserDisplayName">Display Name (optional)</label>
                            <InputText id="newUserDisplayName" @bind-Value="newUser.DisplayName" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isCreating" />
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="newUserPassword">Password</label>
                            <InputText id="newUserPassword" @bind-Value="newUser.Password" type="password" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" autocomplete="new-password" disabled="@isCreating" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">Minimum 10 characters.</p>
                        </div>

                        <div class="sm:col-span-2">
                            <label class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-slate-200">
                                <InputCheckbox id="newUserIsAdmin" @bind-Value="newUser.IsAdmin" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" disabled="@isCreating" />
                                Grant administrator access
                            </label>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="() => { if (!isCreating) CloseCreateModal(); }" disabled="@isCreating">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Creating…</span>
                        }
                        else
                        {
                            <Icon Name="person-plus" Class="h-4 w-4" />
                            <span>Create User</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyList<SelectOption> CultureOptions = CultureCatalog.All;
    private static readonly IReadOnlyList<SelectOption> TimeZoneOptions = TimeZoneCatalog.All;

    private readonly List<UserDto> users = new();
    private Guid? currentUserId;
    private CreateUserModel newUser = new();
    private EditUserModel editUser = new();
    private Guid? editingUserId;
    private bool isLoading = true;
    private bool isUnauthorized;
    private bool isCreating;
    private bool isUpdating;
    private bool showCreateModal;
    private Guid? deletingUserId;
    private string? statusMessage;
    private bool statusIsError;
    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;
    private EffectivePreferences? effectivePreferences;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("User Management");
        
        try
        {
            isLoading = true;
            statusMessage = null;

            try
            {
                userPreferences = await UserPreferencesService.GetAsync();
                currentUserId = userPreferences.CurrentUser.Id;
                displayCulture = userPreferences.Culture;
                displayTimeZone = userPreferences.TimeZone;
                effectivePreferences = userPreferences.Preferences;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load current user preferences");
            }

            await LoadUsersAsync();
            ResetNewUser();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var response = await UsersApi.GetUsersAsync();
            users.Clear();
            users.AddRange(response.OrderBy(u => u.Email));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden || ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "User management is not authorized");
            isUnauthorized = true;
            SetStatus("You are not authorized to view users.", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
            SetStatus("Failed to load users. Please try again.", true);
        }
    }

    private async Task CreateUserAsync()
    {
        if (isCreating)
        {
            return;
        }

        isCreating = true;
        SetStatus(null);

        try
        {
            var request = new CreateUserDto(
                newUser.Email.Trim(),
                newUser.Password,
                string.IsNullOrWhiteSpace(newUser.DisplayName) ? null : newUser.DisplayName.Trim(),
                newUser.IsAdmin,
                newUser.Culture.Trim(),
                newUser.TimeZone.Trim());

            var createdUser = await UsersApi.CreateUserAsync(request);
            users.Add(createdUser);
            SortUsers();
            CloseCreateModal();
            SetStatus($"User '{createdUser.Email}' created successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to create user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to create user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while creating user");
            SetStatus("An unexpected error occurred while creating the user.", true);
        }
        finally
        {
            isCreating = false;
        }
    }

    private void OpenCreateModal()
    {
        if (isCreating)
        {
            return;
        }

        ResetNewUser();
        SetStatus(null);
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        ResetNewUser();
    }

    private void BeginEdit(UserDto user)
    {
        editingUserId = user.Id;
        editUser = new EditUserModel
        {
            Email = user.Email,
            DisplayName = user.DisplayName ?? string.Empty,
            Culture = user.Culture,
            TimeZone = user.TimeZone,
            IsAdmin = user.IsAdmin
        };
        SetStatus(null);
    }

    private void CancelEdit()
    {
        editingUserId = null;
        editUser = new EditUserModel();
    }

    private async Task SaveEditAsync()
    {
        if (editingUserId == null || isUpdating)
        {
            return;
        }

        isUpdating = true;
        SetStatus(null);

        try
        {
            var request = new UpdateUserDto(
                editUser.Email.Trim(),
                editUser.DisplayName?.Trim(),
                editUser.IsAdmin,
                editUser.Culture.Trim(),
                editUser.TimeZone.Trim());

            var updatedUser = await UsersApi.UpdateUserAsync(editingUserId.Value, request);
            var index = users.FindIndex(u => u.Id == updatedUser.Id);
            if (index >= 0)
            {
                users[index] = updatedUser;
                SortUsers();
            }
            editingUserId = null;
            editUser = new EditUserModel();
            SetStatus($"User '{updatedUser.Email}' updated successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to update user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to update user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while updating user");
            SetStatus("An unexpected error occurred while updating the user.", true);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task ConfirmDeleteAsync(UserDto user)
    {
        if (!CanDelete(user) || deletingUserId == user.Id)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete user '{user.Email}'? This action cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        deletingUserId = user.Id;
        SetStatus(null);

        try
        {
            await UsersApi.DeleteUserAsync(user.Id);
            users.RemoveAll(u => u.Id == user.Id);
            SetStatus($"User '{user.Email}' deleted successfully.");
        }
        catch (Refit.ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete user");
            var message = await ExtractErrorMessageAsync(ex) ?? "Failed to delete user.";
            SetStatus(message, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while deleting user");
            SetStatus("An unexpected error occurred while deleting the user.", true);
        }
        finally
        {
            deletingUserId = null;
        }
    }

    private bool CanDelete(UserDto user)
    {
        return currentUserId == null || currentUserId.Value != user.Id;
    }

    private void SortUsers()
    {
        users.Sort((a, b) => string.Compare(a.Email, b.Email, StringComparison.OrdinalIgnoreCase));
    }

    private string FormatUserDate(DateTime utc)
    {
        var utcValue = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        var local = TimeZoneInfo.ConvertTimeFromUtc(utcValue, displayTimeZone);
        var datePart = local.ToString(effectivePreferences?.ShortDatePattern ?? displayCulture.DateTimeFormat.ShortDatePattern, displayCulture);
        var timePart = local.ToString(effectivePreferences?.ShortTimePattern ?? displayCulture.DateTimeFormat.ShortTimePattern, displayCulture);
        return string.IsNullOrEmpty(timePart) ? datePart : $"{datePart} {timePart}";
    }

    private void SetStatus(string? message, bool isError = false)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void ResetNewUser()
    {
        var culture = userPreferences?.Culture?.Name ?? PreferencesFactory.DefaultCulture;
        var timeZone = userPreferences?.TimeZone?.Id ?? PreferencesFactory.DefaultTimeZoneId;

        newUser = new CreateUserModel
        {
            Culture = culture,
            TimeZone = timeZone
        };
    }

    private static async Task<string?> ExtractErrorMessageAsync(Refit.ApiException exception)
    {
        if (!string.IsNullOrWhiteSpace(exception.Content))
        {
            return exception.Content;
        }

        try
        {
            var problemDetails = await exception.GetContentAsAsync<Microsoft.AspNetCore.Mvc.ProblemDetails>();
            return problemDetails?.Detail ?? problemDetails?.Title;
        }
        catch
        {
            return null;
        }
    }

    private sealed class CreateUserModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters long.")]
        public string Password { get; set; } = string.Empty;

        public string? DisplayName { get; set; }

        [Required]
        public string Culture { get; set; } = PreferencesFactory.DefaultCulture;

        [Required]
        public string TimeZone { get; set; } = PreferencesFactory.DefaultTimeZoneId;

        public bool IsAdmin { get; set; }
    }

    private sealed class EditUserModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? DisplayName { get; set; }

        [Required]
        public string Culture { get; set; } = PreferencesFactory.DefaultCulture;

        [Required]
        public string TimeZone { get; set; } = PreferencesFactory.DefaultTimeZoneId;

        public bool IsAdmin { get; set; }
    }
}
