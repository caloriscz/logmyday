@page "/tools/breathing"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using LogMyDay.Domain.Entities
@using Microsoft.AspNetCore.Components
@inject IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<BreathingTechniques> Logger

<PageTitle>Breathing Techniques</PageTitle>

<div class="container-fluid">
    <div class="row">
        <!-- Back Navigation -->
        <div class="col-12 mb-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/tools">Tools</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Breathing Techniques</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="text-center mb-4">
                <h2>Breathing Techniques</h2>
                <p class="text-muted">Practice guided breathing exercises for relaxation and focus</p>
            </div>

            <!-- Controls Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <label for="breathingType" class="form-label">Technique</label>
                            <select @bind="selectedTechnique" id="breathingType" class="form-select">
                                <option value="box">Box Breathing (4-4-4-4)</option>
                                <option value="relax">Relaxing Breath (4-7-8)</option>
                                <option value="energy">Energizing Breath (4-4-6)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0">
                            <label for="tagSelect" class="form-label">Save as Tag</label>
                            <select @bind="selectedTagId" id="tagSelect" class="form-select" disabled="@(isLoading || availableTags == null)">
                                @if (isLoading)
                                {
                                    <option>Loading tags...</option>
                                }
                                else if (availableTags?.Any() == true)
                                {
                                    <option value="0">Select a tag to save session</option>
                                    @foreach (var tag in availableTags)
                                    {
                                        <option value="@tag.Id">@tag.Title</option>
                                    }
                                }
                                else
                                {
                                    <option>No integer tags available</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button @onclick="ToggleBreathing" class="btn @(isActive ? "btn-danger" : "btn-success")" disabled="@isLoading">
                                    @if (isActive)
                                    {
                                        <i class="bi bi-stop-circle me-1"></i>@:Stop
                                    }
                                    else
                                    {
                                        <i class="bi bi-play-circle me-1"></i>@:Start
                                    }
                                </button>
                                <button @onclick="SaveSession" class="btn btn-primary" disabled="@(selectedTagId == 0 || !canSave || saveCountdown > 0)">
                                    @if (saveCountdown > 0)
                                    {
                                        <span>@saveCountdown s</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-save me-1"></i>@:Save Session
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Breathing Visualization -->
            <div class="breathing-center-wrapper">
                <div class="breathing-container" id="breathingBox">
                    <!-- Main breathing circle -->
                    <div class="breathing-circle">
                        <div class="breathing-text">@currentInstruction</div>
                    </div>
                    
                    <!-- Progressive border trace -->
                    <div class="border-trace" id="borderTrace">
                        <div class="trace-segment trace-left" id="traceLeft"></div>
                        <div class="trace-segment trace-top" id="traceTop"></div>
                        <div class="trace-segment trace-right" id="traceRight"></div>
                        <div class="trace-segment trace-bottom" id="traceBottom"></div>
                    </div>
                </div>
                
                <!-- Session Statistics -->
                <div class="text-center">
                    <div class="counter mb-3">
                        <strong>Session: </strong>@sessionTime.ToString(@"mm\:ss")
                        @if (completedCycles > 0)
                        {
                            <span class="ms-3"><strong>Cycles: </strong>@completedCycles</span>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert alert-info">@statusMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .breathing-center-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        padding: 20px;
    }
    
    .breathing-container {
        width: 300px;
        height: 300px;
        position: relative;
        margin-bottom: 20px;
        background-color: #f8f9fa;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: 2px solid #e9ecef;
        overflow: hidden;
    }
    
    .breathing-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80px;
        height: 80px;
        background-color: rgba(25, 135, 84, 0.1);
        border: 2px solid #198754;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 20;
    }
    
    .breathing-text {
        font-size: 1.1em;
        font-weight: 600;
        color: #198754;
        text-align: center;
        line-height: 1.2;
    }
    
    .border-trace {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
    
    .trace-segment {
        position: absolute;
        background-color: #198754;
        box-shadow: 0 0 8px rgba(25, 135, 84, 0.6);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .trace-left {
        left: 0;
        bottom: 0;
        width: 6px;
        height: 0%;
        border-radius: 3px 3px 0 0;
        transform-origin: bottom;
    }
    
    .trace-top {
        top: 0;
        left: 0;
        width: 0%;
        height: 6px;
        border-radius: 0 3px 3px 0;
        transform-origin: left;
    }
    
    .trace-right {
        top: 0;
        right: 0;
        width: 6px;
        height: 0%;
        border-radius: 0 0 3px 3px;
        transform-origin: top;
    }
    
    .trace-bottom {
        bottom: 0;
        right: 0;
        width: 0%;
        height: 6px;
        border-radius: 3px 0 0 3px;
        transform-origin: right;
    }
    
    /* Active states for progressive animation */
    .trace-segment.active {
        opacity: 1;
    }
    
    .trace-left.animating {
        height: 100%;
        transition: height linear;
    }
    
    .trace-top.animating {
        width: 100%;
        transition: width linear;
    }
    
    .trace-right.animating {
        height: 100%;
        transition: height linear;
    }
    
    .trace-bottom.animating {
        width: 100%;
        transition: width linear;
    }
    
    .counter {
        font-size: 1.3em;
        color: #495057;
    }
    
    @@media (max-width: 768px) {
        .breathing-container {
            width: 250px;
            height: 250px;
        }
        
        .breathing-text {
            font-size: 1em;
        }
    }
</style>

@code {
    private string selectedTechnique = "box";
    private int selectedTagId = 0;
    private bool isActive = false;
    private bool isLoading = true;
    private bool canSave = false;
    private int saveCountdown = 0;
    private string currentInstruction = "Press Start to begin";
    private TimeSpan sessionTime = TimeSpan.Zero;
    private int completedCycles = 0;
    private string statusMessage = "";
    
    private List<TagResponse>? availableTags;
    private System.Threading.Timer? breathingTimer;
    private System.Threading.Timer? sessionTimer;
    private System.Threading.Timer? cooldownTimer;
    
    private DateTime sessionStartTime;
    private int currentPhase = 0; // 0: inhale, 1: hold, 2: exhale, 3: hold
    
    // Breathing patterns (in seconds)
    private readonly Dictionary<string, int[]> breathingPatterns = new()
    {
        { "box", new[] { 4, 4, 4, 4 } },      // Box breathing: inhale-hold-exhale-hold
        { "relax", new[] { 4, 7, 8, 0 } },    // 4-7-8 breathing: inhale-hold-exhale-pause
        { "energy", new[] { 4, 4, 6, 0 } }    // Energizing: inhale-hold-exhale-pause
    };
    
    private readonly string[] phaseInstructions = { "Breathe In", "Hold", "Breathe Out", "Hold" };

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableTags();
    }

    private async Task LoadAvailableTags()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            var allTags = await ActivityApi.GetTags();
            availableTags = allTags?.Where(t => t.TypeId == 1).ToList(); // Integer input type
            
            Logger.LogInformation("Loaded {Count} integer tags for breathing techniques", availableTags?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tags for breathing techniques");
            statusMessage = "Failed to load tags. You won't be able to save sessions.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTechniqueChanged()
    {
        if (isActive)
        {
            await StopBreathing();
        }
        StateHasChanged();
    }

    private async Task ToggleBreathing()
    {
        if (isActive)
        {
            await StopBreathing();
        }
        else
        {
            await StartBreathing();
        }
    }

    private async Task StartBreathing()
    {
        isActive = true;
        canSave = false;
        sessionStartTime = DateTime.Now;
        sessionTime = TimeSpan.Zero;
        completedCycles = 0;
        currentPhase = 0;
        statusMessage = "";
        
        // Start session timer
        sessionTimer = new System.Threading.Timer(UpdateSessionTime, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        
        // Start breathing animation
        await StartBreathingCycle();
        
        StateHasChanged();
    }

    private async Task StopBreathing()
    {
        isActive = false;
        canSave = sessionTime.TotalSeconds >= 30; // Allow saving if session was at least 30 seconds
        
        breathingTimer?.Dispose();
        sessionTimer?.Dispose();
        
        await ResetVisualization();
        currentInstruction = canSave ? "Session complete! You can save your results." : "Press Start to begin";
        
        StateHasChanged();
    }

    private async Task StartBreathingCycle()
    {
        if (!isActive) return;
        
        var pattern = breathingPatterns[selectedTechnique];
        var phaseDuration = pattern[currentPhase];
        
        if (phaseDuration == 0)
        {
            // Skip this phase (like pause in 4-7-8)
            AdvancePhase();
            await StartBreathingCycle();
            return;
        }
        
        currentInstruction = phaseInstructions[currentPhase];
        await AnimatePhase(currentPhase, phaseDuration);
        
        // Schedule next phase
        breathingTimer = new System.Threading.Timer(async _ =>
        {
            if (isActive)
            {
                AdvancePhase();
                await InvokeAsync(async () => await StartBreathingCycle());
            }
        }, null, TimeSpan.FromSeconds(phaseDuration), Timeout.InfiniteTimeSpan);
        
        StateHasChanged();
    }

    private void AdvancePhase()
    {
        currentPhase = (currentPhase + 1) % 4;
        if (currentPhase == 0) // Completed full cycle, reset visualization
        {
            completedCycles++;
            InvokeAsync(async () => await ResetVisualization());
        }
    }

    private async Task AnimatePhase(int phase, int duration)
    {
        var animationClass = phase switch
        {
            0 => "animate-inhale",
            1 => "animate-hold",
            2 => "animate-exhale",
            3 => "animate-hold",
            _ => ""
        };
        
        await JSRuntime.InvokeVoidAsync("animateBreathingPhase", phase, duration * 1000);
    }

    private async Task ResetVisualization()
    {
        await JSRuntime.InvokeVoidAsync("resetBreathingVisualization");
    }

    private void UpdateSessionTime(object? state)
    {
        if (isActive)
        {
            sessionTime = DateTime.Now - sessionStartTime;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveSession()
    {
        if (selectedTagId == 0 || !canSave || saveCountdown > 0)
            return;

        try
        {
            var sessionMinutes = (int)Math.Round(sessionTime.TotalMinutes);
            if (sessionMinutes < 1) sessionMinutes = 1; // Minimum 1 minute
            
            var request = new ActivityRequest
            {
                DateStarted = sessionStartTime,
                Description = sessionMinutes.ToString(), // Store minutes as description for integer tags
                PrimaryTagId = selectedTagId
            };

            await ActivityApi.CreateCalendarItem(request);
            
            statusMessage = $"Session saved successfully! Duration: {sessionMinutes} minutes";
            Logger.LogInformation("Breathing session saved: {Minutes} minutes, {Cycles} cycles", sessionMinutes, completedCycles);
            
            // Start cooldown
            saveCountdown = 60;
            cooldownTimer = new System.Threading.Timer(DecrementCooldown, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save breathing session");
            statusMessage = "Failed to save session. Please try again.";
        }
        
        StateHasChanged();
    }

    private void DecrementCooldown(object? state)
    {
        if (saveCountdown > 0)
        {
            saveCountdown--;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            cooldownTimer?.Dispose();
        }
    }

    private string GetTechniqueName(string technique) => technique switch
    {
        "box" => "Box Breathing",
        "relax" => "4-7-8 Relaxing",
        "energy" => "Energizing",
        _ => "Breathing"
    };

    public void Dispose()
    {
        breathingTimer?.Dispose();
        sessionTimer?.Dispose();
        cooldownTimer?.Dispose();
    }
}
