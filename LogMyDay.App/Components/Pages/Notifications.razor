@page "/notifications"
@using LogMyDay.Shared.DTOs
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">Notifications</h3>
                <div class="d-flex align-items-center">
                    <input type="date" class="form-control me-2" @bind="selectedDate" @bind:after="LoadRequiredTags" />
                    <button class="btn btn-outline-primary" @onclick="RefreshNotifications">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading notifications...</p>
                </div>
            }
            else if (unfilledRequiredTags?.Any() == true)
            {
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    You have <strong>@unfilledRequiredTags.Count</strong> required tag(s) that haven't been filled for @selectedDate.ToString("MMMM dd, yyyy").
                </div>

                <div class="row">
                    @foreach (var tag in unfilledRequiredTags)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0 text-warning">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            @tag.Title
                                        </h5>
                                        <span class="badge bg-warning text-dark">Required</span>
                                    </div>
                                    
                                    <div class="card-text">
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            Time Granularity: @tag.TimeGranularity
                                        </small>
                                        @if (tag.IsRepeatable)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                Repeatable
                                            </small>
                                        }
                                        @if (tag.IsRange)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi bi-arrows-expand me-1"></i>
                                                Range Values
                                            </small>
                                        }
                                    </div>
                                    
                                    <div class="mt-3">
                                        <button class="btn btn-sm btn-outline-primary w-100" 
                                                @onclick="@(() => NavigateToAddActivity(tag.Id))">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Activity
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    Great! All required tags have been filled for @selectedDate.ToString("MMMM dd, yyyy").
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TagResponse>? unfilledRequiredTags;
    private DateTime selectedDate = DateTime.Today;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequiredTags();
    }

    private async Task LoadRequiredTags()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            unfilledRequiredTags = await ActivityApi.GetRequiredDailyTagsNotFilledForDate(selectedDate.ToString("yyyy-MM-dd"));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading notifications: {ex.Message}";
            unfilledRequiredTags = new List<TagResponse>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshNotifications()
    {
        await LoadRequiredTags();
    }

    private void NavigateToAddActivity(int tagId)
    {
        Navigation.NavigateTo($"/calendar?tagId={tagId}&date={selectedDate:yyyy-MM-dd}");
    }
}
