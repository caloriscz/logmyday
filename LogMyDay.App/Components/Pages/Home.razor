@page "/"
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Components.Shared
@using LogMyDay.App.Services
@using LogMyDay.Shared.Preferences
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService

<div class="mx-auto max-w-6xl px-4 py-6 space-y-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">Activities</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Review and manage your logged activities.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" title="Open filters" @onclick="OpenFilterModal" class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">
                <Icon Name="filter" Class="w-5 h-5" />
                <span>Filters</span>
            </button>
            <div class="inline-flex overflow-hidden rounded-md border border-gray-300 dark:border-gray-600">
                <button type="button" class="@GetOrderButtonClasses("asc")" @onclick="@(() => ChangeOrder("asc"))">Ascending</button>
                <button type="button" class="@GetOrderButtonClasses("desc")" @onclick="@(() => ChangeOrder("desc"))">Descending</button>
            </div>
        </div>
    </div>

    @if (displayType != "daily" && pagedResult != null)
    {
        <div class="flex flex-col gap-3 rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900/60 sm:flex-row sm:items-center sm:justify-between">
            <div class="text-sm text-gray-600 dark:text-gray-300">
                Page @GetCurrentPageNumber() of @totalPages
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="@GetNavButtonClasses()" @onclick="PrevPage" disabled="@(GetCurrentPageNumber() == 1)">Previous</button>
                <button type="button" class="@GetNavButtonClasses()" @onclick="NextPage" disabled="@(GetCurrentPageNumber() == totalPages)">Next</button>
            </div>
        </div>
    }

    @if (pagedResult == null)
    {
        <div class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-300">
            Loading activities…
        </div>
    }
    else if (displayType == "daily")
    {
        <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
                <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousMonth" title="Previous Month" disabled="@IsPreviousMonthDisabled()">&lt;&lt;</button>
                <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousDay" title="Previous Day">‹</button>
                <CultureAwareDatePicker Value="@selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="w-40 sm:w-48" Stretch="false" Placeholder="Select date" />
                <button type="button" class="@GetNavButtonClasses()" @onclick="NextDay" title="Next Day">›</button>
                <button type="button" class="@GetNavButtonClasses()" @onclick="NextMonth" title="Next Month" disabled="@IsNextMonthDisabled()">&gt;&gt;</button>
                <button type="button" class="@GetNavButtonClasses(true)" @onclick="GoToToday">Today</button>
            </div>

            @if (!pagedResult.Items.Any())
            {
                <div class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-300">
                    No activities found for @FormatDate(selectedDate).
                </div>
            }
            else
            {
                <div class="hidden md:block">
                    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900/60">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                            <thead class="bg-gray-50 dark:bg-gray-800/60">
                                <tr>
                                    <th scope="col" class="w-20 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Actions</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Tag</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Description</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Date Started</th>
                                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Date Finished</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                                @foreach (var activity in pagedResult.Items.OrderByDescending(a => a.DateStarted))
                                {
                                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/60">
                                        <td class="px-4 py-3">
                                            <button type="button" class="inline-flex items-center gap-1 rounded-md bg-danger-100 px-3 py-1.5 text-sm font-medium text-danger-700 transition-colors hover:bg-danger-200 focus:outline-none focus:ring-2 focus:ring-danger-500 dark:bg-danger-900/40 dark:text-danger-200 dark:hover:bg-danger-900/60" @onclick="() => DeleteActivity(activity.Id)">
                                                <Icon Name="trash" Class="w-4 h-4" />
                                                <span class="sr-only">Delete activity</span>
                                            </button>
                                        </td>
                                        <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">@activity.PrimaryTagName</td>
                                        <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@GetActivityDisplayValue(activity)</td>
                                        <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@FormatTime(activity.DateStarted)</td>
                                        <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="space-y-3 md:hidden">
                    @foreach (var activity in pagedResult.Items.OrderByDescending(a => a.DateStarted))
                    {
                        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900/60">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@activity.PrimaryTagName</h3>
                                    @{ var displayValue = GetActivityDisplayValue(activity);
                                        if (!string.IsNullOrWhiteSpace(displayValue))
                                        {
                                            <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@displayValue</p>
                                        }
                                    }
                                </div>
                                <button type="button" class="inline-flex items-center gap-1 rounded-md bg-danger-100 px-3 py-1.5 text-sm font-medium text-danger-700 transition-colors hover:bg-danger-200 focus:outline-none focus:ring-2 focus:ring-danger-500 dark:bg-danger-900/40 dark:text-danger-200 dark:hover:bg-danger-900/60" @onclick="() => DeleteActivity(activity.Id)">
                                    <Icon Name="trash" Class="w-4 h-4" />
                                    <span class="sr-only">Delete activity</span>
                                </button>
                            </div>
                            <dl class="mt-4 grid grid-cols-2 gap-4 text-sm text-gray-600 dark:text-gray-300">
                                <div>
                                    <dt class="font-medium text-gray-500 dark:text-gray-400">Started</dt>
                                    <dd>@FormatTime(activity.DateStarted)</dd>
                                </div>
                                <div>
                                    <dt class="font-medium text-gray-500 dark:text-gray-400">Finished</dt>
                                    <dd>@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</dd>
                                </div>
                            </dl>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (!pagedResult.Items.Any())
    {
        <div class="rounded-lg border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-300">
            No activities found for the selected criteria.
        </div>
    }
    else
    {
        <div class="space-y-8">
            @foreach (var group in pagedResult.Items.GroupBy(a => a.DateStarted.Date).OrderByDescending(g => g.Key))
            {
                <section class="space-y-3">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">@FormatDate(group.Key)</h2>

                    <div class="hidden md:block">
                        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900/60">
                            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                                <thead class="bg-gray-50 dark:bg-gray-800/60">
                                    <tr>
                                        <th scope="col" class="w-20 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Actions</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Tag</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Description</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Date Started</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-300">Date Finished</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                                    @foreach (var activity in group)
                                    {
                                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/60">
                                            <td class="px-4 py-3">
                                                <button type="button" class="inline-flex items-center gap-1 rounded-md bg-danger-100 px-3 py-1.5 text-sm font-medium text-danger-700 transition-colors hover:bg-danger-200 focus:outline-none focus:ring-2 focus:ring-danger-500 dark:bg-danger-900/40 dark:text-danger-200 dark:hover:bg-danger-900/60" @onclick="() => DeleteActivity(activity.Id)">
                                                    <Icon Name="trash" Class="w-4 h-4" />
                                                    <span class="sr-only">Delete activity</span>
                                                </button>
                                            </td>
                                            <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">@activity.PrimaryTagName</td>
                                            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@GetActivityDisplayValue(activity)</td>
                                            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@FormatTime(activity.DateStarted)</td>
                                            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="space-y-3 md:hidden">
                        @foreach (var activity in group)
                        {
                            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900/60">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@activity.PrimaryTagName</h3>
                                        @{ var displayValue = GetActivityDisplayValue(activity);
                                            if (!string.IsNullOrWhiteSpace(displayValue))
                                            {
                                                <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@displayValue</p>
                                            }
                                        }
                                    </div>
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md bg-danger-100 px-3 py-1.5 text-sm font-medium text-danger-700 transition-colors hover:bg-danger-200 focus:outline-none focus:ring-2 focus:ring-danger-500 dark:bg-danger-900/40 dark:text-danger-200 dark:hover:bg-danger-900/60" @onclick="() => DeleteActivity(activity.Id)">
                                        <Icon Name="trash" Class="w-4 h-4" />
                                        <span class="sr-only">Delete activity</span>
                                    </button>
                                </div>
                                <dl class="mt-4 grid grid-cols-2 gap-4 text-sm text-gray-600 dark:text-gray-300">
                                    <div>
                                        <dt class="font-medium text-gray-500 dark:text-gray-400">Started</dt>
                                        <dd>@FormatTime(activity.DateStarted)</dd>
                                    </div>
                                    <div>
                                        <dt class="font-medium text-gray-500 dark:text-gray-400">Finished</dt>
                                        <dd>@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</dd>
                                    </div>
                                </dl>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

<!-- Floating Action Button -->
<button type="button" class="fixed bottom-6 right-6 z-40 inline-flex items-center justify-center gap-2 rounded-full bg-primary-600 p-4 text-white shadow-lg transition-transform hover:scale-105 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" @onclick="OpenAddActivityModal" title="Add Activity">
    <Icon Name="plus" Class="h-6 w-6" />
    <span class="sr-only">Add activity</span>
</button>

<!-- Filter Modal (Tailwind) -->
@if (showFilterModal && isInitialized)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-75 flex items-center justify-center z-50 p-4" @onclick="CloseFilterModal">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-4xl max-h-[90vh] overflow-hidden" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Filters</h3>
                <button type="button" @onclick="CloseFilterModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                    <Icon Name="close" Class="w-5 h-5" />
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 overflow-y-auto max-h-[calc(90vh-140px)]">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Display Type -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Display Type:</label>
                        <select value="@displayType" @onchange="OnDisplayTypeChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                        </select>
                    </div>

                    <!-- Description Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description Filter:</label>
                        <input value="@descriptionFilter" @onchange="OnFilterChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                            placeholder="Search description..." />
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 p-4 border-t border-gray-200 dark:border-gray-700">
                <button type="button" @onclick="CloseFilterModal" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 focus:ring-2 focus:ring-gray-500 focus:outline-none transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- Add Activity Modal -->
@if (showAddActivityModal && isInitialized && tags != null && newActivity != null)
{
    <AddActivityModal
        Activity="newActivity"
        AvailableTags="tags"
        OptionLists="optionLists"
        OptionListLookup="optionListLookup"
        DisplayCulture="displayCulture"
        DisplayTimeZone="displayTimeZone"
        ErrorMessage="@errorMessage"
        OnActivityCreated="OnActivityCreated"
        OnCanceled="CloseAddActivityModal"
        OnError="OnError"
        ModalId="addActivityModal"
        PreselectedDate="@GetPreselectedDate()" />
}

@code {
    private PagedResult<ActivityResponse>? pagedResult;
    private IList<TagResponse>? tags;
    private IList<TagOptionListResponse>? optionLists;
    private Dictionary<int, TagOptionListResponse>? optionListLookup;
    private ActivityRequest newActivity = new();
    private string? errorMessage;
    
    // Modal state
    private bool showFilterModal = false;
    private bool showAddActivityModal = false;

    // User preferences and localization
    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;
    private EffectivePreferences? effectivePreferences;

    // Display and filtering
    private string displayType = "daily";
    private string? descriptionFilter;
    private DateTime selectedDate = DateTime.Today;
    private DateTime calendarMonth = DateTime.Today;
    private int pageNumber = 1;
    private int weekPageNumber = 1;
    private int monthPageNumber = 1;
    private int weeksPerPage = 12;
    private int monthsPerPage = 12;
    private int totalPages = 1;
    private string orderBy = "desc";
    private bool isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Home");

        userPreferences = await UserPreferencesService.GetAsync();
        displayCulture = userPreferences.Culture;
        displayTimeZone = userPreferences.TimeZone;
        effectivePreferences = userPreferences.Preferences;

        var today = GetTodayInDisplayZone();
        selectedDate = today;
        calendarMonth = new DateTime(today.Year, today.Month, 1);

        // Initialize new activity with current date/time
        newActivity = new ActivityRequest
        {
            DateStarted = GetCurrentDateTimeInDisplayZone()
        };

        await LoadData();
        
        isInitialized = true;
    }

    private async Task LoadData()
    {
        try
        {
            // Always refresh tags and option lists to ensure we have latest data
            tags = await ActivityApi.GetTags();
            optionLists = await ActivityApi.GetTagOptionListsAsync();
            
            if (optionLists is not null)
            {
                optionListLookup = optionLists.ToDictionary(list => list.Id);
            }

            DateTime? startDate = null;
            DateTime? endDate = null;

            // Set date range based on display type and selected date/period
            switch (displayType)
            {
                case "daily":
                    startDate = selectedDate.Date;
                    endDate = selectedDate.Date.AddDays(1).AddTicks(-1);
                    // For daily, get all activities for the day (no pagination)
                    pagedResult = await ActivityApi.GetActivities(1, 1000, orderBy, null, startDate, endDate, descriptionFilter);
                    totalPages = 1;
                    break;

                case "weekly":
                    var weekStart = GetStartOfWeek(selectedDate);
                    var weekEnd = weekStart.AddDays(7).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByWeeks(weekPageNumber, weeksPerPage, orderBy, null, weekStart, weekEnd,
                    descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / weeksPerPage);
                    break;

                case "monthly":
                    var monthStart = new DateTime(selectedDate.Year, selectedDate.Month, 1);
                    var monthEnd = monthStart.AddMonths(1).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByMonths(monthPageNumber, monthsPerPage, orderBy, null, monthStart,
                    monthEnd, descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / monthsPerPage);
                    break;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
        }
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
    {
        var timezone = displayTimeZone ?? TimeZoneInfo.Local;
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, timezone);
    }

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private string FormatDate(DateTime date)
    {
        var culture = displayCulture ?? CultureInfo.CurrentCulture;
        var pattern = effectivePreferences?.ShortDatePattern ?? culture.DateTimeFormat.ShortDatePattern;
        return date.ToString(pattern, culture);
    }

    private string FormatTime(DateTime dateTime)
    {
        var culture = displayCulture ?? CultureInfo.CurrentCulture;
        var timezone = displayTimeZone ?? TimeZoneInfo.Local;
        
        // Convert to user's timezone if needed
        var localDateTime = dateTime.Kind == DateTimeKind.Utc 
            ? TimeZoneInfo.ConvertTimeFromUtc(dateTime, timezone)
            : TimeZoneInfo.ConvertTime(dateTime, timezone);
            
        var pattern = effectivePreferences?.ShortTimePattern ?? culture.DateTimeFormat.ShortTimePattern;
        return localDateTime.ToString(pattern, culture);
    }

    private string GetOrderButtonClasses(string order)
    {
        var isActive = string.Equals(orderBy, order, System.StringComparison.OrdinalIgnoreCase);
        var baseClasses = "inline-flex items-center justify-center px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500";
        var activeClasses = "bg-primary-600 text-white hover:bg-primary-700";
        var inactiveClasses = "bg-white text-gray-700 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700";

        return $"{baseClasses} {(isActive ? activeClasses : inactiveClasses)}";
    }

    private string GetNavButtonClasses(bool emphasize = false)
    {
        var baseClasses = "inline-flex items-center justify-center rounded-md border px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:cursor-not-allowed disabled:opacity-50";

        if (emphasize)
        {
            return $"{baseClasses} border-primary-600 bg-primary-600 text-white hover:bg-primary-700";
        }

        return $"{baseClasses} border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700";
    }

    private string GetActivityDisplayValue(ActivityResponse activity)
    {
        var rawValue = activity.PrimaryTagValue ?? activity.Description ?? string.Empty;
        var tag = tags?.FirstOrDefault(t => t.Id == activity.PrimaryTagId);
        var valueForDisplay = rawValue;

        if (tag?.OptionListId is int listId && optionListLookup != null && optionListLookup.TryGetValue(listId, out var list))
        {
            var option = list.Options.FirstOrDefault(o => string.Equals(o.Value, rawValue, StringComparison.OrdinalIgnoreCase));
            if (option is not null)
            {
                valueForDisplay = option.DisplayName ?? option.Value;
            }
        }
        else if (tag?.TypeId == 1 && long.TryParse(rawValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var intValue))
        {
            valueForDisplay = intValue.ToString(displayCulture);
        }
        else if (tag?.TypeId == 6 && decimal.TryParse(rawValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var decimalValue))
        {
            valueForDisplay = decimalValue.ToString("0.#############################", displayCulture);
        }

        if (tag is not null && !string.IsNullOrWhiteSpace(tag.UnitSymbol) && !string.IsNullOrWhiteSpace(valueForDisplay))
        {
            valueForDisplay = $"{valueForDisplay} {tag.UnitSymbol}";
        }

        return valueForDisplay;
    }

    private async Task OnDisplayTypeChanged(ChangeEventArgs e)
    {
        displayType = e.Value?.ToString() ?? "daily";

        // Reset pagination counters
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;

        // Reset to today/this week/this month
        var today = GetTodayInDisplayZone();
        selectedDate = today;
        calendarMonth = new DateTime(today.Year, today.Month, 1);

        await LoadData();
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        descriptionFilter = e.Value?.ToString();

        // Reset pagination when filter changes
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;

        await LoadData();
    }

    private string GetCurrentPeriodDisplay()
    {
        var culture = displayCulture ?? CultureInfo.CurrentCulture;
        var longPattern = effectivePreferences?.LongDatePattern ?? culture.DateTimeFormat.LongDatePattern;
        var shortPattern = effectivePreferences?.ShortDatePattern ?? culture.DateTimeFormat.ShortDatePattern;

        var weekStart = GetStartOfWeek(selectedDate);
        var weekEnd = weekStart.AddDays(6);

        return displayType switch
        {
            "daily" => selectedDate.ToString(longPattern, culture),
            "weekly" => string.Format(culture, "{0} – {1}", FormatDate(weekStart), FormatDate(weekEnd)),
            "monthly" => selectedDate.ToString("Y", culture),
            _ => selectedDate.ToString(longPattern, culture)
        };
    }

