@page "/"
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Components.Shared
@using LogMyDay.App.Services
@using LogMyDay.Shared.Preferences
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Activities</h1>
            </div>
        </div>

        <!-- Activities List -->
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal"
                        data-bs-target="#filterModal" title="Open filters">
                        <i class="bi bi-funnel"></i> Filters
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-link" @onclick="@(() => ChangeOrder("asc"))">Ascending</button>
                    <button class="btn btn-link" @onclick="@(() => ChangeOrder("desc"))">Descending</button>

                    @if (displayType != "daily")
                    {
                        <div class="ms-3">
                            <button class="btn btn-secondary btn-sm me-2" @onclick="PrevPage"
                                disabled="@(GetCurrentPageNumber() == 1)">Previous</button>
                            <span>Page @GetCurrentPageNumber() of @totalPages</span>
                            <button class="btn btn-secondary btn-sm ms-2" @onclick="NextPage"
                                disabled="@(GetCurrentPageNumber() == totalPages)">Next</button>
                        </div>
                    }
                </div>
            </div>

            @if (pagedResult == null)
            {
                <p><em>Loading...</em></p>
            }
            else if (displayType == "daily")
            {
                <!-- Daily view with date navigation -->
                <div class="d-flex align-items-center mb-3">
                    <!-- Mobile: centered layout, Desktop: left-aligned with gap -->
                    <div class="d-flex align-items-center gap-2 mx-auto mx-md-0">
                        <button class="btn btn-outline-secondary" @onclick="PreviousDay" title="Previous Day">
                            &lt;
                        </button>
                        <CultureAwareDatePicker Value="@selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="d-inline-block" Placeholder="Select date" />
                        <button class="btn btn-outline-secondary" @onclick="NextDay" title="Next Day">
                            &gt;
                        </button>
                    </div>
                </div>

                @if (!pagedResult.Items.Any())
                {
                <div class="alert alert-info">
                    No activities found for @FormatDate(selectedDate).
                    </div>
                }
                else
                {
                    <!-- Desktop Table View -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">Actions</th>
                                    <th>Tag</th>
                                    <th>Description</th>
                                    <th>Date Started</th>
                                    <th>Date Finished</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in pagedResult.Items.OrderByDescending(a => a.DateStarted))
                                {
                                    <tr>
                                        <td>
                                            <button @onclick="() => DeleteActivity(activity.Id)"
                                                class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                        <td>@activity.PrimaryTagName</td>
                                        <td>@GetActivityDisplayValue(activity)</td>
                                        <td>@FormatTime(activity.DateStarted)</td>
                                        <td>@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="d-md-none">
                        @foreach (var activity in pagedResult.Items.OrderByDescending(a => a.DateStarted))
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0">@activity.PrimaryTagName</h6>
                                        <button @onclick="() => DeleteActivity(activity.Id)"
                                            class="btn btn-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    @{ var displayValue = GetActivityDisplayValue(activity);
                                        if (!string.IsNullOrWhiteSpace(displayValue))
                                        {
                                            <p class="card-text mb-2">@displayValue</p>
                                        }
                                    }
                                    <div class="row text-muted small">
                                        <div class="col-6">
                                            <strong>Started:</strong> @FormatTime(activity.DateStarted)
                                        </div>
                                        <div class="col-6">
                                            <strong>Finished:</strong> @(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (!pagedResult.Items.Any())
            {
                <div class="alert alert-info">
                    No activities found for the selected criteria.
                </div>
            }
            else
            {
                @foreach (var group in pagedResult.Items.GroupBy(a => a.DateStarted.Date).OrderByDescending(g => g.Key))
                {
                    <h5>@FormatDate(group.Key)</h5>
                    
                    <!-- Desktop Table View -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">Actions</th>
                                    <th>Tag</th>
                                    <th>Description</th>
                                    <th>Date Started</th>
                                    <th>Date Finished</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in group)
                                {
                                    <tr>
                                        <td>
                                            <button @onclick="() => DeleteActivity(activity.Id)"
                                                class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                        <td>@activity.PrimaryTagName</td>
                                        <td>@GetActivityDisplayValue(activity)</td>
                                        <td>@FormatTime(activity.DateStarted)</td>
                                        <td>@(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="d-md-none">
                        @foreach (var activity in group)
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0">@activity.PrimaryTagName</h6>
                                        <button @onclick="() => DeleteActivity(activity.Id)"
                                            class="btn btn-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    @{ var displayValue = GetActivityDisplayValue(activity);
                                        if (!string.IsNullOrWhiteSpace(displayValue))
                                        {
                                            <p class="card-text mb-2">@displayValue</p>
                                        }
                                    }
                                    <div class="row text-muted small">
                                        <div class="col-6">
                                            <strong>Started:</strong> @FormatTime(activity.DateStarted)
                                        </div>
                                        <div class="col-6">
                                            <strong>Finished:</strong> @(activity.DateFinished.HasValue ? FormatTime(activity.DateFinished.Value) : "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<button class="fab" data-bs-toggle="modal" data-bs-target="#addActivityModal" title="Add Activity">
    <i class="bi bi-plus-lg"></i>
</button>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">Filters & Navigation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Display Type -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Display Type:</label>
                        <select value="@displayType" @onchange="OnDisplayTypeChanged" class="form-select">
                            <option value="daily">Daily</option>
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                        </select>
                    </div>

                    <!-- Description Filter -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Description Filter:</label>
                        <input value="@descriptionFilter" @onchange="OnFilterChanged" class="form-control"
                            placeholder="Search description..." />
                    </div>

                    <!-- Calendar Navigation -->
                    <div class="col-12">
                        <label class="form-label">Date Navigation:</label>
                        
                        <!-- Navigation Controls -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <!-- Daily navigation -->
                            <button class="btn btn-outline-secondary" @onclick="PreviousCalendarPeriod" title="Previous Day">
                                &lt;
                            </button>
                            
                            <!-- Additional navigation for daily view -->
                            @if (displayType == "daily")
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousWeek" title="Previous Week">
                                    &lt;&lt;
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousMonth" title="Previous Month" disabled="@IsPreviousMonthDisabled()">
                                    &lt;&lt;&lt;
                                </button>
                            }
                            
                            <div class="flex-grow-1 text-center">
                                <strong>@GetCurrentPeriodDisplay()</strong>
                            </div>
                            
                            <!-- Additional navigation for daily view -->
                            @if (displayType == "daily")
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth" title="Next Month" disabled="@IsNextMonthDisabled()">
                                    &gt;&gt;&gt;
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="NextWeek" title="Next Week">
                                    &gt;&gt;
                                </button>
                            }
                            
                            <button class="btn btn-outline-secondary" @onclick="NextCalendarPeriod" title="Next Day">
                                &gt;
                            </button>
                            <button class="btn btn-outline-primary" @onclick="GoToToday">
                                @GetTodayButtonText()
                            </button>
                        </div>
                        
                        <!-- Mini Calendar for Daily view -->
                        @if (displayType == "daily")
                        {
                            <div class="mt-3">
                                <div class="calendar-grid">
                                    <div class="calendar-header">
                                        @foreach (var day in GetDayNames())
                                        {
                                            <div class="calendar-day-header">@day</div>
                                        }
                                    </div>
                                    <div class="calendar-body">
                                        @foreach (var date in GetCalendarDates())
                                        {
                                            <div class="calendar-day @GetDayClass(date)" @onclick="() => SelectDate(date)">
                                                @date.Day
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Activity Modal -->
<AddActivityModal
    Activity="newActivity"
    AvailableTags="tags"
    OptionLists="optionLists"
    OptionListLookup="optionListLookup"
    DisplayCulture="displayCulture"
    DisplayTimeZone="displayTimeZone"
    ErrorMessage="@errorMessage"
    OnActivityCreated="OnActivityCreated"
    OnError="OnError"
    ModalId="addActivityModal"
    PreselectedDate="@GetPreselectedDate()" />

@code {
    private PagedResult<ActivityResponse>? pagedResult;
    private IList<TagResponse>? tags;
    private IList<TagOptionListResponse>? optionLists;
    private Dictionary<int, TagOptionListResponse>? optionListLookup;
    private ActivityRequest newActivity = new();
    private string? errorMessage;

    // User preferences and localization
    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;
    private EffectivePreferences? effectivePreferences;

    // Display and filtering
    private string displayType = "daily";
    private string? descriptionFilter;
    private DateTime selectedDate = DateTime.Today;
    private DateTime calendarMonth = DateTime.Today;
    private int pageNumber = 1;
    private int weekPageNumber = 1;
    private int monthPageNumber = 1;
    private int weeksPerPage = 12;
    private int monthsPerPage = 12;
    private int totalPages = 1;
    private string orderBy = "desc";

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Home");

        userPreferences = await UserPreferencesService.GetAsync();
        displayCulture = userPreferences.Culture;
        displayTimeZone = userPreferences.TimeZone;
        effectivePreferences = userPreferences.Preferences;

        var today = GetTodayInDisplayZone();
        selectedDate = today;
        calendarMonth = new DateTime(today.Year, today.Month, 1);

        // Initialize new activity with current date/time
        newActivity = new ActivityRequest
        {
            DateStarted = GetCurrentDateTimeInDisplayZone()
        };

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            // Always refresh tags and option lists to ensure we have latest data
            tags = await ActivityApi.GetTags();
            optionLists = await ActivityApi.GetTagOptionListsAsync();
            
            if (optionLists is not null)
            {
                optionListLookup = optionLists.ToDictionary(list => list.Id);
            }

            DateTime? startDate = null;
            DateTime? endDate = null;

            // Set date range based on display type and selected date/period
            switch (displayType)
            {
                case "daily":
                    startDate = selectedDate.Date;
                    endDate = selectedDate.Date.AddDays(1).AddTicks(-1);
                    // For daily, get all activities for the day (no pagination)
                    pagedResult = await ActivityApi.GetActivities(1, 1000, orderBy, null, startDate, endDate, descriptionFilter);
                    totalPages = 1;
                    break;

                case "weekly":
                    var weekStart = GetStartOfWeek(selectedDate);
                    var weekEnd = weekStart.AddDays(7).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByWeeks(weekPageNumber, weeksPerPage, orderBy, null, weekStart, weekEnd,
                    descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / weeksPerPage);
                    break;

                case "monthly":
                    var monthStart = new DateTime(selectedDate.Year, selectedDate.Month, 1);
                    var monthEnd = monthStart.AddMonths(1).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByMonths(monthPageNumber, monthsPerPage, orderBy, null, monthStart,
                    monthEnd, descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / monthsPerPage);
                    break;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
        }
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, displayTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private string FormatDate(DateTime date)
    {
        var pattern = effectivePreferences?.ShortDatePattern ?? displayCulture.DateTimeFormat.ShortDatePattern;
        return date.ToString(pattern, displayCulture);
    }

    private string FormatTime(DateTime dateTime)
    {
        // Convert to user's timezone if needed
        var localDateTime = dateTime.Kind == DateTimeKind.Utc 
            ? TimeZoneInfo.ConvertTimeFromUtc(dateTime, displayTimeZone)
            : TimeZoneInfo.ConvertTime(dateTime, displayTimeZone);
            
        var pattern = effectivePreferences?.ShortTimePattern ?? displayCulture.DateTimeFormat.ShortTimePattern;
        return localDateTime.ToString(pattern, displayCulture);
    }

    private string GetActivityDisplayValue(ActivityResponse activity)
    {
        var rawValue = activity.PrimaryTagValue ?? activity.Description ?? string.Empty;
        var tag = tags?.FirstOrDefault(t => t.Id == activity.PrimaryTagId);
        var valueForDisplay = rawValue;

        if (tag?.OptionListId is int listId && optionListLookup != null && optionListLookup.TryGetValue(listId, out var list))
        {
            var option = list.Options.FirstOrDefault(o => string.Equals(o.Value, rawValue, StringComparison.OrdinalIgnoreCase));
            if (option is not null)
            {
                valueForDisplay = option.DisplayName ?? option.Value;
            }
        }
        else if (tag?.TypeId == 1 && long.TryParse(rawValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var intValue))
        {
            valueForDisplay = intValue.ToString(displayCulture);
        }
        else if (tag?.TypeId == 6 && decimal.TryParse(rawValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var decimalValue))
        {
            valueForDisplay = decimalValue.ToString("0.#############################", displayCulture);
        }

        if (tag is not null && !string.IsNullOrWhiteSpace(tag.UnitSymbol) && !string.IsNullOrWhiteSpace(valueForDisplay))
        {
            valueForDisplay = $"{valueForDisplay} {tag.UnitSymbol}";
        }

        return valueForDisplay;
    }

    private async Task OnDisplayTypeChanged(ChangeEventArgs e)
    {
        displayType = e.Value?.ToString() ?? "daily";

        // Reset pagination counters
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;

        // Reset to today/this week/this month
        var today = GetTodayInDisplayZone();
        selectedDate = today;
        calendarMonth = new DateTime(today.Year, today.Month, 1);

        await LoadData();
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        descriptionFilter = e.Value?.ToString();

        // Reset pagination when filter changes
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;

        await LoadData();
    }

    private string GetCurrentPeriodDisplay()
    {
        var longPattern = effectivePreferences?.LongDatePattern ?? displayCulture.DateTimeFormat.LongDatePattern;
        var shortPattern = effectivePreferences?.ShortDatePattern ?? displayCulture.DateTimeFormat.ShortDatePattern;

        var weekStart = GetStartOfWeek(selectedDate);
        var weekEnd = weekStart.AddDays(6);

        return displayType switch
        {
            "daily" => selectedDate.ToString(longPattern, displayCulture),
            "weekly" => string.Format(displayCulture, "{0} – {1}", FormatDate(weekStart), FormatDate(weekEnd)),
            "monthly" => selectedDate.ToString("Y", displayCulture),
            _ => selectedDate.ToString(longPattern, displayCulture)
        };
    }

    private string GetTodayButtonText()
    {
        return displayType switch
        {
            "daily" => "Today",
            "weekly" => "This Week",
            "monthly" => "This Month",
            _ => "Today"
        };
    }

    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            selectedDate = newDate.Value;
            await LoadData();
        }
    }

    private async Task PreviousCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(-1),
            "weekly" => selectedDate.AddDays(-7),
            "monthly" => selectedDate.AddMonths(-1),
            _ => selectedDate.AddDays(-1)
        };

        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task NextCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(1),
            "weekly" => selectedDate.AddDays(7),
            "monthly" => selectedDate.AddMonths(1),
            _ => selectedDate.AddDays(1)
        };

        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task GoToToday()
    {
        var today = GetTodayInDisplayZone();
        selectedDate = today;
        calendarMonth = new DateTime(today.Year, today.Month, 1);

        // Reset pagination
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;

        await LoadData();
    }

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;
        await LoadData();
    }

    private string[] GetDayNames()
    {
        var culture = displayCulture ?? CultureInfo.CurrentCulture;
        var startOfWeek = effectivePreferences?.StartOfWeek ?? culture.DateTimeFormat.FirstDayOfWeek;
        var names = new string[7];

        for (var i = 0; i < 7; i++)
        {
            var day = (DayOfWeek)(((int)startOfWeek + i) % 7);
            names[i] = culture.DateTimeFormat.GetAbbreviatedDayName(day);
        }

        return names;
    }

    private List<DateTime> GetCalendarDates()
    {
        var firstDayOfMonth = calendarMonth;
        var startOfWeek = GetStartOfWeek(firstDayOfMonth);
        var dates = new List<DateTime>();

        for (int i = 0; i < 42; i++) // 6 weeks * 7 days
        {
            dates.Add(startOfWeek.AddDays(i));
        }

        return dates;
    }

    private string GetDayClass(DateTime date)
    {
        var classes = new List<string>();

        if (date.Month != calendarMonth.Month)
            classes.Add("other-month");

        if (date.Date == selectedDate.Date)
            classes.Add("selected");

        if (date.Date == GetTodayInDisplayZone())
            classes.Add("today");

        return string.Join(" ", classes);
    }

    private DateTime GetStartOfWeek(DateTime date)
    {
        var start = effectivePreferences?.StartOfWeek ?? displayCulture.DateTimeFormat.FirstDayOfWeek;
        int diff = (7 + ((int)date.DayOfWeek - (int)start)) % 7;
        return date.AddDays(-diff).Date;
    }

    private int GetCurrentPageNumber()
    {
        return displayType switch
        {
            "weekly" => weekPageNumber,
            "monthly" => monthPageNumber,
            _ => pageNumber
        };
    }

    private async Task DeleteActivity(int id)
    {
        try
        {
            await ActivityApi.Delete(id);
            await LoadData();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting activity with ID {ActivityId}", id);
        }
    }

    private async Task PrevPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber > 1)
                {
                    weekPageNumber--;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber > 1)
                {
                    monthPageNumber--;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber > 1)
                {
                    pageNumber--;
                    await LoadData();
                }
                break;
        }
    }

    private async Task NextPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber < totalPages)
                {
                    weekPageNumber++;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber < totalPages)
                {
                    monthPageNumber++;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber < totalPages)
                {
                    pageNumber++;
                    await LoadData();
                }
                break;
        }
    }

    private async Task ChangeOrder(string order)
    {
        orderBy = order;
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        await LoadData();
    }

    // Additional navigation methods for daily view
    private async Task PreviousWeek()
    {
        selectedDate = selectedDate.AddDays(-7);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task NextWeek()
    {
        selectedDate = selectedDate.AddDays(7);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task PreviousMonth()
    {
        selectedDate = selectedDate.AddMonths(-1);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private async Task NextMonth()
    {
        selectedDate = selectedDate.AddMonths(1);
        calendarMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        await LoadData();
    }

    private bool IsPreviousMonthDisabled()
    {
        // Disable if going back would take us before a reasonable historical limit
        // For example, disable if it would go before 5 years ago
        var limitDate = GetTodayInDisplayZone().AddYears(-5);
        return selectedDate.AddMonths(-1) < limitDate;
    }

    private bool IsNextMonthDisabled()
    {
        // Disable if going forward would take us beyond next month
        var nextMonth = GetTodayInDisplayZone().AddMonths(1);
        return selectedDate.AddMonths(1) > nextMonth;
    }

    // Add Activity Modal Event Handlers
    private async Task OnActivityCreated(ActivityRequest activity)
    {
        // Refresh the activities list
        await LoadData();

        // Reset the form
        newActivity = new ActivityRequest
        {
            DateStarted = GetCurrentDateTimeInDisplayZone()
        };
        errorMessage = null;
    }

    private async Task OnError(string error)
    {
        errorMessage = error;
        await Task.CompletedTask;
    }

    // Get the preselected date for the AddActivityModal based on display mode and selected date
    private DateTime? GetPreselectedDate()
    {
        return displayType == "daily" ? selectedDate : null;
    }
}