@page "/tools"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Api.Application.Interfaces
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Shared
@inject IBackupService BackupService
@inject IExcelExportService ExcelExportService
@inject IJSRuntime JSRuntime
@inject ILogger<Tools> Logger
@inject IPageTitleService PageTitleService

<div class="mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="space-y-1">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Tools & Utilities</h1>
        <p class="text-sm text-gray-600 dark:text-slate-300">Helpful tools to enhance your activity logging experience.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-1 flex-col space-y-3 p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Practice Breathing</h2>
                <p class="text-sm text-gray-600 dark:text-slate-300">
                    Practice guided breathing exercises and track your sessions, saving them as activities with customizable tags.
                </p>
            </div>
            <div class="border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <a href="/tools/breathing" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                    <span>Start Breathing</span>
                </a>
            </div>
        </div>

        <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-1 flex-col space-y-3 p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Exercise</h2>
                <p class="text-sm text-gray-600 dark:text-slate-300">
                    HIIT trainer and other exercise routines to keep you moving.
                </p>
            </div>
            <div class="border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <a href="/tools/exercise" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                    <span>Start Exercise</span>
                </a>
            </div>
        </div>
    </div>

    <div class="rounded-xl border border-sky-200 bg-sky-50 px-6 py-5 text-sky-900 shadow-sm dark:border-sky-500/40 dark:bg-sky-500/20 dark:text-sky-100">
        <div class="flex items-start gap-3">
            <Icon Name="info" Class="h-5 w-5 flex-shrink-0" />
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">About Tools</h3>
                <p class="text-sm">
                    These tools are designed to complement your activity logging workflow. Each tool can save results directly to your activity log using your configured tags, making it easy to track various aspects of your daily routine.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("Tools");
    }
}
