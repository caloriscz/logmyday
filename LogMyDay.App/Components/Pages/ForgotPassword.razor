@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Refit
@using LogMyDay.App.Services
@inject IAccountApi AccountApi
@inject ILogger<ForgotPassword> Logger
@inject IPageTitleService PageTitleService

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4" style="max-width: 450px; width: 100%;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Forgot Password</h3>
            <p class="text-muted text-center">
                Enter the email associated with your account and we'll send you a link to reset your password.
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="alert">@successMessage</div>
            }

            <EditForm Model="request" OnValidSubmit="SendRequestAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="request.Email" placeholder="you@example.com" />
                    <ValidationMessage For="() => request.Email" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isSending">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Sending reset link...</span>
                    }
                    else
                    {
                        <span>Send reset link</span>
                    }
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none">Back to login</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel request = new();
    private bool isSending;
    private string? errorMessage;
    private string? successMessage;

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("Forgot Password");
    }

    private async Task SendRequestAsync()
    {
        if (isSending)
        {
            return;
        }

        try
        {
            isSending = true;
            errorMessage = null;
            successMessage = null;

            Logger.LogInformation("ForgotPassword.SendRequestAsync: Requesting password reset link");

            var email = request.Email?.Trim();
            request.Email = email;

            var response = await AccountApi.ForgotPasswordAsync(new ForgotDto(email!));
            successMessage = response.Message ?? "If an account exists for the provided email, a password reset link has been sent.";
        }
        catch (ApiException apiEx)
        {
            Logger.LogError(apiEx, "ForgotPassword.SendRequestAsync: API error while requesting password reset link");
            errorMessage = !string.IsNullOrWhiteSpace(apiEx.Content) ? apiEx.Content : apiEx.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ForgotPassword.SendRequestAsync: Unexpected error while requesting password reset link");
            errorMessage = "An unexpected error occurred while requesting the password reset. Please try again.";
        }
        finally
        {
            isSending = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string? Email { get; set; }
    }
}
