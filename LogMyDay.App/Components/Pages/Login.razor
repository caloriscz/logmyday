@page "/login"
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Login</PageTitle>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4" style="max-width: 400px; width: 100%;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Login to LogMyDay</h3>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger text-center" role="alert">@ErrorMessage</div>
            }
            <form method="post" action="/api/auth/login-form" onsubmit="console.log('Form submitted to /api/auth/login-form'); return true;">
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" class="form-control" name="email" autocomplete="username" placeholder="your-email@example.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" name="password" autocomplete="current-password" placeholder="Your password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <span>Login</span>
                </button>
            </form>
            
            <div class="text-center mt-3">
                <a href="/forgot-password" class="text-decoration-none">Forgot Password?</a>
            </div>

            <div class="text-center mt-2">
                <small class="text-muted">
                    No admin user yet? <a href="/register-first" class="text-decoration-none">Create first admin</a>
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    private string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        Logger.LogInformation("Login.OnInitialized: Starting login page initialization. Current URL: {Url}", Navigation.Uri);
        
        // Check for error message in query parameters
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("error", out var error))
        {
            ErrorMessage = error.ToString();
            Logger.LogWarning("Login.OnInitialized: Error message found in query parameters: {ErrorMessage}", ErrorMessage);
        }
        else
        {
            Logger.LogInformation("Login.OnInitialized: No error message in query parameters");
        }
        
        Logger.LogInformation("Login.OnInitialized: Login page initialization completed");
    }
}
