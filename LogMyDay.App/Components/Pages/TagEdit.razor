@page "/tags/edit/{Id:int}"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Notifications
@using LogMyDay.Domain.Enums
@using System.Globalization
@using LogMyDay.App.Services
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject ILogger<TagEdit> Logger
@inject IPageTitleService PageTitleService

<div class="container mt-4">
    <h3>Edit Tag</h3>
    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (editTag != null)
    {
        <EditForm Model="editTag" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label class="form-label">Title:</label>
                <InputText @bind-Value="editTag.Tag" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Type (optional):</label>
                <InputSelect @bind-Value="editTag.TypeId" class="form-select">
                    <option value="">(None)</option>
                    @foreach (var type in inputTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label class="form-label">Required:</label>
                <InputCheckbox @bind-Value="editTag.IsRequired" class="form-check-input" />
            </div>
            <div class="mb-3">
                <label class="form-label">Repeatable:</label>
                <InputCheckbox @bind-Value="editTag.IsRepeatable" class="form-check-input" />
            </div>
            <div class="mb-3">
                <label class="form-label">Time Granularity:</label>
                <InputSelect @bind-Value="editTag.TimeGranularity" class="form-select">
                    @foreach (var granularity in Enum.GetValues<TimeGranularity>())
                    {
                        <option value="@granularity">@granularity</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label class="form-label">Is Range:</label>
                <InputCheckbox @bind-Value="editTag.IsRange" class="form-check-input" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@isSaving">Save</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack" disabled="@isSaving">Cancel</button>
        </EditForm>

        <hr class="my-4" />

        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Notifications</h4>
                <button class="btn btn-sm btn-primary" type="button" @onclick="StartAddNotification">Add Notification</button>
            </div>

            @if (isNotificationFormVisible && editingNotification != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <EditForm Model="editingNotification" OnValidSubmit="SaveNotificationAsync">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Notification Text</label>
                                <InputText @bind-Value="editingNotification.NotificationText" class="form-control" />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Not Before Time</label>
                                    <input type="text" class="form-control" value="@editingNotification.NotBeforeTime" placeholder="08:00 or 32:00" @onchange="@((ChangeEventArgs e) => editingNotification.NotBeforeTime = e.Value?.ToString())" />
                                    <small class="text-muted">Supports offsets beyond 24 hours (e.g., 32:00 = next day at 08:00).</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Not After Time</label>
                                    <input type="text" class="form-control" value="@editingNotification.NotAfterTime" placeholder="Optional" @onchange="@((ChangeEventArgs e) => editingNotification.NotAfterTime = e.Value?.ToString())" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Max Nudges</label>
                                    <InputNumber @bind-Value="editingNotification.MaxNudges" class="form-control" min="0" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nudge Interval (minutes)</label>
                                    <InputNumber @bind-Value="editingNotification.NudgeIntervalMinutes" class="form-control" min="0" />
                                </div>
                            </div>
                            <div class="form-check mb-3">
                                <InputCheckbox @bind-Value="editingNotification.IsActive" class="form-check-input" id="notificationActive" />
                                <label class="form-check-label" for="notificationActive">Active</label>
                            </div>
                            @if (!string.IsNullOrEmpty(notificationErrorMessage))
                            {
                                <div class="text-danger mb-3">@notificationErrorMessage</div>
                            }
                            <button type="submit" class="btn btn-primary me-2" disabled="@isNotificationSaving">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CancelNotificationEdit" disabled="@isNotificationSaving">Cancel</button>
                        </EditForm>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(notificationErrorMessage))
            {
                <div class="alert alert-danger">@notificationErrorMessage</div>
            }

            @if (notifications.Count == 0)
            {
                <p class="text-muted mb-0">No notifications configured for this tag yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Text</th>
                                <th>Time Window</th>
                                <th>Max Nudges</th>
                                <th>Nudge Interval (min)</th>
                                <th>Active</th>
                                <th>Created</th>
                                <th style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var notification in notifications)
                            {
                                <tr>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(notification.NotificationText))
                                        {
                                            <em>(Default)</em>
                                        }
                                        else
                                        {
                                            @notification.NotificationText
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(notification.NotBeforeTime) || !string.IsNullOrWhiteSpace(notification.NotAfterTime))
                                        {
                                            <span>@(notification.NotBeforeTime ?? "-") - @(notification.NotAfterTime ?? "-")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>@notification.MaxNudges</td>
                                    <td>@(notification.NudgeIntervalMinutes?.ToString() ?? "-")</td>
                                    <td>
                                        @if (notification.IsActive)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>@notification.DateCreated.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => EditNotification(notification)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="async () => await DeleteNotificationAsync(notification.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TagRequest? editTag;
    private List<InputTypeDto> inputTypes = new();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;

    private List<NotificationViewModel> notifications = new();
    private NotificationEditModel? editingNotification;
    private bool isNotificationFormVisible;
    private string? notificationErrorMessage;
    private bool isNotificationSaving;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Edit Tag");
        
        try
        {
            inputTypes = await ActivityApi.GetInputTypesAsync();
            var tag = await ActivityApi.GetTagById(Id);

            editTag = new TagRequest
            {
                Tag = tag.Title,
                TypeId = tag.TypeId ?? 0,
                IsRequired = tag.IsRequired,
                IsRepeatable = tag.IsRepeatable,
                TimeGranularity = tag.TimeGranularity,
                IsRange = tag.IsRange
            };

            await LoadNotifications();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tag: {ex.Message}";
            Logger.LogError(ex, "Error loading tag");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadNotifications()
    {
        try
        {
            var items = await ActivityApi.GetNotificationsByTag(Id);
            notifications = items.Select(MapToViewModel).ToList();
            notificationErrorMessage = null;
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error loading notifications: {ex.Message}";
            Logger.LogError(ex, "Error loading notifications for tag {TagId}", Id);
        }
    }

    private void StartAddNotification()
    {
        editingNotification = new NotificationEditModel
        {
            TagId = Id,
            MaxNudges = 3,
            NudgeIntervalMinutes = 15,
            IsActive = true
        };
        notificationErrorMessage = null;
        isNotificationFormVisible = true;
    }

    private void EditNotification(NotificationViewModel notification)
    {
        editingNotification = new NotificationEditModel
        {
            Id = notification.Id,
            TagId = notification.TagId,
            NotificationText = notification.NotificationText,
            NotBeforeTime = notification.NotBeforeTime,
            NotAfterTime = notification.NotAfterTime,
            MaxNudges = notification.MaxNudges,
            NudgeIntervalMinutes = notification.NudgeIntervalMinutes,
            IsActive = notification.IsActive
        };
        notificationErrorMessage = null;
        isNotificationFormVisible = true;
    }

    private void CancelNotificationEdit()
    {
        editingNotification = null;
        isNotificationFormVisible = false;
        notificationErrorMessage = null;
    }

    private async Task SaveNotificationAsync()
    {
        if (editingNotification is null)
        {
            return;
        }

        notificationErrorMessage = null;

        if (!TryBuildRequest(editingNotification, out var request, out var error))
        {
            notificationErrorMessage = error;
            return;
        }

        isNotificationSaving = true;

        try
        {
            if (editingNotification.Id.HasValue)
            {
                await ActivityApi.UpdateNotification(editingNotification.Id.Value, request);
            }
            else
            {
                await ActivityApi.CreateNotification(request);
            }

            await LoadNotifications();
            CancelNotificationEdit();
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error saving notification: {ex.Message}";
            Logger.LogError(ex, "Error saving notification");
        }
        finally
        {
            isNotificationSaving = false;
        }
    }

    private async Task DeleteNotificationAsync(int notificationId)
    {
        try
        {
            await ActivityApi.DeleteNotification(notificationId);
            notifications.RemoveAll(n => n.Id == notificationId);
            notificationErrorMessage = null;
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error deleting notification: {ex.Message}";
            Logger.LogError(ex, "Error deleting notification {NotificationId}", notificationId);
        }
    }

    private NotificationViewModel MapToViewModel(NotificationResponse response)
    {
        return new NotificationViewModel
        {
            Id = response.Id,
            TagId = response.TagId,
            NotificationText = response.NotificationText,
            NotBeforeTime = FormatTimeSpan(response.NotBeforeTime),
            NotAfterTime = FormatTimeSpan(response.NotAfterTime),
            MaxNudges = response.MaxNudges,
            NudgeIntervalMinutes = response.NudgeInterval.HasValue
                ? (int?)Math.Round(response.NudgeInterval.Value.TotalMinutes)
                : null,
            IsActive = response.IsActive,
            DateCreated = response.DateCreated
        };
    }

    private bool TryBuildRequest(NotificationEditModel model, out NotificationRequest request, out string? error)
    {
        request = new NotificationRequest
        {
            TagId = Id,
            NotificationText = string.IsNullOrWhiteSpace(model.NotificationText) ? null : model.NotificationText.Trim(),
            MaxNudges = model.MaxNudges,
            IsActive = model.IsActive
        };

        if (!TryParseTime(model.NotBeforeTime, out var notBefore, out error))
        {
            return false;
        }

        if (!TryParseTime(model.NotAfterTime, out var notAfter, out error))
        {
            return false;
        }

        if (model.MaxNudges < 0)
        {
            error = "Max nudges must be zero or greater.";
            return false;
        }

        if (model.NudgeIntervalMinutes.HasValue)
        {
            if (model.NudgeIntervalMinutes.Value < 0)
            {
                error = "Nudge interval must be zero or greater.";
                return false;
            }

            if (model.NudgeIntervalMinutes.Value > 0 && model.NudgeIntervalMinutes.Value < NotificationScheduleCalculator.MinimumIntervalMinutes)
            {
                error = $"Nudge interval must be at least {NotificationScheduleCalculator.MinimumIntervalMinutes} minutes.";
                return false;
            }
        }

        request.NotBeforeTime = notBefore;
        request.NotAfterTime = notAfter;
        request.NudgeInterval = model.NudgeIntervalMinutes.HasValue
            ? TimeSpan.FromMinutes(model.NudgeIntervalMinutes.Value)
            : null;

        return true;
    }

    private static bool TryParseTime(string? value, out TimeSpan? time, out string? error)
    {
        time = null;
        error = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var parsed))
        {
            time = parsed;
            return true;
        }

        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var hoursOnly))
        {
            time = TimeSpan.FromHours(hoursOnly);
            return true;
        }

        error = "Time values must use HH:mm format or a total hour value (e.g., 32).";
        return false;
    }

    private static string? FormatTimeSpan(TimeSpan? timeSpan)
    {
        if (!timeSpan.HasValue)
        {
            return null;
        }

        var totalHours = (int)Math.Floor(timeSpan.Value.TotalHours);
        var minutes = Math.Abs(timeSpan.Value.Minutes);
        return $"{totalHours:D2}:{minutes:D2}";
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        try
        {
            await ActivityApi.UpdateTag(Id, editTag!);
            Navigation.NavigateTo("/tags");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving tag: {ex.Message}";
            Logger.LogError(ex, "Error saving tag");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/tags");
    }

    private sealed class NotificationViewModel
    {
        public int Id { get; set; }
        public int TagId { get; set; }
        public string? NotificationText { get; set; }
        public string? NotBeforeTime { get; set; }
        public string? NotAfterTime { get; set; }
        public int MaxNudges { get; set; }
        public int? NudgeIntervalMinutes { get; set; }
        public bool IsActive { get; set; }
        public DateTime DateCreated { get; set; }
    }

    private sealed class NotificationEditModel
    {
        public int? Id { get; set; }
        public int TagId { get; set; }
        public string? NotificationText { get; set; }
        public string? NotBeforeTime { get; set; }
        public string? NotAfterTime { get; set; }
        public int MaxNudges { get; set; } = 3;
        public int? NudgeIntervalMinutes { get; set; } = 15;
        public bool IsActive { get; set; } = true;
    }
}
