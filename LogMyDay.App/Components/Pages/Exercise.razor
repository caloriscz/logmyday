@page "/tools/exercise"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@inject IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<Exercise> Logger

<PageTitle>Advanced Breathing Techniques</PageTitle>
<style>
    :root {
        --bg: #0b1020;
        --card: #ffffff;
        --text: #111827;
        --muted: #6b7280;
        --prepare: #3b82f6;
        --work: #22c55e;
        --rest: #f59e0b;
    }

    .frame {
        width: 100%;
        max-width: 460px;
        background: var(--card);
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,.35);
        overflow: hidden
    }

    .appbar {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 56px;
        font-weight: 700;
        letter-spacing: .08em;
        color: #374151;
        border-bottom: 1px solid #e5e7eb
    }

    .screen {
        display: none
    }

        .screen.active {
            display: block
        }

    .settings {
        padding: 28px 20px 88px
    }

    .section {
        margin: 22px 0
    }

        .section h3 {
            margin: 0 0 10px;
            text-align: center;
            font-weight: 800;
            letter-spacing: .18em;
            color: #374151
        }

    .value {
        font-variant-numeric: tabular-nums;
        font-size: 48px;
        font-weight: 800;
        text-align: center
    }

    .btn {
        height: 44px;
        width: 44px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        cursor: pointer;
        user-select: none;
        background: #0f172a;
        color: #fff;
        font-size: 26px;
        border: none;
        transition: .15s transform ease
    }

        .btn:active {
            transform: scale(.96)
        }

    .hint {
        margin-top: 8px;
        text-align: center;
        color: var(--muted);
        font-size: .9rem
    }

    .footer {
        position: sticky;
        bottom: 0;
        left: 0;
        right: 0;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr
    }

        .footer button {
            border: 0;
            padding: 18px 16px;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: .18em;
            color: #fff;
            cursor: pointer
        }

    #settingsFooter {
        grid-template-columns: 1fr
    }

        #settingsFooter button {
            background: #4b646d;
            font-size: 20px
        }

    #activeFooter .stop {
        background: #b91c1c
    }

    #activeFooter .add {
        background: #0f766e
    }

    #activeFooter .pause {
        background: #374151
    }

    .stage {
        --stage-color: var(--prepare);
        background: var(--stage-color);
        color: #111827;
        min-height: 520px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        align-items: center;
        justify-items: center;
        padding-bottom: 88px;
        position: relative
    }
        /* Subtle darken overlay driven by --shade (0..0.14) */
        .stage::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,var(--shade,0));
            pointer-events: none;
            transition: background .15s linear
        }

        .stage .sets {
            margin-top: 12px;
            font-size: 28px;
            font-weight: 700
        }

    .digits {
        font-variant-numeric: tabular-nums;
        font-size: 120px;
        font-weight: 900
    }

    .label {
        font-weight: 900;
        letter-spacing: .18em;
        opacity: .6;
        font-size: 36px;
        margin-bottom: 12px
    }

    @@media (min-width:700px) {
        .digits {
            font-size: 140px
        }
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <main class="frame" id="app">
            <div class="appbar">HIIT TIMER</div>

            <!-- SETTINGS -->
            <section id="settings" class="screen settings active">
                <div class="section">
                    <h3>SETS</h3>
                    <div class="row">
                        <button class="btn" id="setsMinus">−</button>
                        <div class="value" id="setsVal">6</div>
                        <button class="btn" id="setsPlus">+</button>
                    </div>
                </div>
                <div class="section">
                    <h3>WORK</h3>
                    <div class="row">
                        <button class="btn" id="workMinus">−</button>
                        <div class="value" id="workVal">00:30</div>
                        <button class="btn" id="workPlus">+</button>
                    </div>
                    <div class="hint">Step: 5s. Tap the time to switch to minute stepping (±60s).</div>
                </div>
                <div class="section">
                    <h3>REST</h3>
                    <div class="row">
                        <button class="btn" id="restMinus">−</button>
                        <div class="value" id="restVal">00:15</div>
                        <button class="btn" id="restPlus">+</button>
                    </div>
                </div>
                <div class="footer" id="settingsFooter">
                    <button id="startBtn">⚡ START</button>
                </div>
            </section>

            <!-- ACTIVE -->
            <section id="active" class="screen">
                <div class="stage" id="stage" style="--stage-color:var(--prepare)">
                    <div class="sets" id="setsRemain">6</div>
                    <div class="digits" id="digits">00:05</div>
                    <div class="label" id="stageLabel">GET READY</div>
                </div>
                <div class="footer" id="activeFooter">
                    <button class="stop" id="stopBtn">■ STOP</button>
                    <button class="add" id="addSetBtn">+1 SET</button>
                    <button class="pause" id="pauseBtn">⏸ PAUSE</button>
                </div>
            </section>
        </main>
    </div>
</div>
<script>
(function(){
  const prepareSeconds = 5;
  let setsTotal = 6;
  let workSeconds = 30; // 00:30 default
  let restSeconds = 15; // 00:15 default
  let editMinutes = false;

  let timer=null, endTime=0, remaining=0; // ms/seconds
  let phase='settings';
  let setsLeft = setsTotal;
  let paused=false;
  let phaseTotal = 0; // seconds for current phase

  const $ = s=>document.querySelector(s);
  const format = s=>{ s=Math.max(0,Math.round(s)); const m=Math.floor(s/60), sec=s%60; return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`; };
  const clamp=(v,min,max)=>Math.min(max,Math.max(min,v));

  function setScreen(id){ document.querySelectorAll('.screen').forEach(el=>el.classList.remove('active')); document.getElementById(id).classList.add('active'); }
  function renderSettings(){ $('#setsVal').textContent=String(setsTotal); $('#workVal').textContent=format(workSeconds); $('#restVal').textContent=format(restSeconds); }
  function updateSetsRemain(){ $('#setsRemain').textContent=setsLeft; }

  function startCountdown(seconds,label,color,next){
    phase = label.toLowerCase();
    phaseTotal = seconds;
    $('#stage').style.setProperty('--stage-color', color);
    $('#stage').style.setProperty('--shade','0');
    $('#stageLabel').textContent = label.toUpperCase();
    $('#digits').textContent = format(seconds);
    updateSetsRemain();
    // enable +1 SET only during workout/rest
    const addBtn = $('#addSetBtn');
    if(addBtn) addBtn.disabled = !(phase.includes('work') || phase.includes('rest'));

    endTime = Date.now() + seconds*1000; paused=false; clearInterval(timer);
    timer = setInterval(()=>{
      const now = Date.now();
      const rem = Math.max(0,(endTime - now)/1000);
      const secs = Math.max(0, Math.ceil(rem));
      $('#digits').textContent = format(secs);

      // Subtle darken during last 5s only if phase >= 5s
      if(phaseTotal >= 5){
        if(rem <= 5){
          const t = (5 - rem)/5; // 0→1 over last 5s
          const shade = (0.14 * Math.min(1, Math.max(0, t))).toFixed(3);
          $('#stage').style.setProperty('--shade', shade);
        } else {
          $('#stage').style.setProperty('--shade','0');
        }
      }

      if(now >= endTime){ clearInterval(timer); next(); }
    },200);
  }

  function runSequence(){ setScreen('active'); setsLeft = setsTotal; $('#pauseBtn').textContent='⏸ PAUSE'; startCountdown(prepareSeconds,'Get Ready',getColor('prepare'),()=>enterWork()); }
  function enterWork(){ if(setsLeft<=0){finish();return;} startCountdown(workSeconds,'Workout',getColor('work'),()=>enterRest()); }
  function enterRest(){ startCountdown(restSeconds,'Rest',getColor('rest'),()=>{ setsLeft--; (setsLeft>0)?enterWork():finish(); }); }
  function finish(){ $('#stageLabel').textContent='DONE'; $('#digits').textContent='00:00'; $('#stage').style.setProperty('--shade','0'); setTimeout(()=>stopAll(),1000); }
  function stopAll(){ clearInterval(timer); phase='settings'; setScreen('settings'); renderSettings(); }
  const getColor = kind => getComputedStyle(document.documentElement).getPropertyValue(`--${kind}`).trim();

  // settings events
  $('#setsMinus').addEventListener('click',()=>{ setsTotal=clamp(setsTotal-1,1,999); renderSettings(); });
  $('#setsPlus').addEventListener('click',()=>{ setsTotal=clamp(setsTotal+1,1,999); renderSettings(); });
  const STEP=5;
  const stepWork=d=>{ workSeconds=clamp(workSeconds+d*STEP,5,24*60*60); renderSettings(); };
  const stepRest=d=>{ restSeconds=clamp(restSeconds+d*STEP,5,24*60*60); renderSettings(); };
  $('#workMinus').addEventListener('click',()=>stepWork(-1));
  $('#workPlus').addEventListener('click',()=>stepWork(1));
  $('#restMinus').addEventListener('click',()=>stepRest(-1));
  $('#restPlus').addEventListener('click',()=>stepRest(1));
  $('#startBtn').addEventListener('click',()=>{ renderSettings(); runSequence(); });

  // active controls
  $('#pauseBtn').addEventListener('click',()=>{
    if(phase==='settings') return;
    if(!paused){ paused=true; clearInterval(timer); remaining=Math.max(0,Math.ceil((endTime-Date.now())/1000)); $('#pauseBtn').textContent='▶ RESUME'; }
    else { paused=false; $('#pauseBtn').textContent='⏸ PAUSE'; const label=$('#stageLabel').textContent; const color=getComputedStyle($('#stage')).getPropertyValue('--stage-color'); startCountdown(remaining,label,color,()=>{ const l=label.toLowerCase(); if(l.includes('ready')) enterWork(); else if(l.includes('work')) enterRest(); else if(l.includes('rest')){ setsLeft--; (setsLeft>0)?enterWork():finish(); } }); }
  });
  $('#stopBtn').addEventListener('click',stopAll);
  $('#addSetBtn').addEventListener('click',()=>{ if(phase.includes('work')||phase.includes('rest')){ setsLeft++; setsTotal++; updateSetsRemain(); }});

  renderSettings();
})();</script>


