@page "/calendar"
@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IPageTitleService PageTitleService

<style>
    .calendar-table th, .calendar-table td {
        text-align: center;
        vertical-align: middle;
        height: 80px;
    }
    .calendar-value {
        background: var(--success-color, #198754);
        color: #fff;
        border-radius: 8px;
        padding: 2px 6px;
        display: inline-block;
        margin-top: 4px;
        font-weight: 500;
        border: 1px solid transparent;
    }
    
    /* Dark theme adjustments for better visibility */
    [data-bs-theme="dark"] .calendar-value {
        background: #28a745;
        border: 1px solid #34ce57;
        color: #ffffff;
        font-weight: 600;
    }
    
    .calendar-empty {
        background: var(--warning-color, #fff3cd);
        color: #856404;
        border-radius: 8px;
        padding: 2px 6px;
        display: inline-block;
        margin-top: 4px;
        font-weight: 500;
        border: 1px solid transparent;
    }
    
    /* Dark theme adjustments for empty values */
    [data-bs-theme="dark"] .calendar-empty {
        background: #6c4e00;
        border: 1px solid #8a6600;
        color: #ffcc00;
        font-weight: 600;
    }    .month-container {
        padding: 10px;
    }
    .description-symbol {
        cursor: pointer;
        user-select: none;
    }
    .description-symbol:hover {
        opacity: 0.8;
    }
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .modal-content {
        background: white;
        border-radius: 8px;
        padding: 20px;
        max-width: 400px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container-fluid px-4">
    <h2 class="mb-3">Calendar</h2><div class="mb-3 row">
        <div class="col-md-4">
            <label for="tagPicker" class="form-label">Select Tag</label>
            <select id="tagPicker" class="form-select" @onchange="OnTagChangedHandler">
                <option value="">-- Select Tag --</option>
                @if (tags != null)
                {
                    foreach (var tag in tags)
                    {
                        <option value="@tag.Id">@tag.Title</option>
                    }
                }
            </select>
        </div>
    </div>    <div class="mb-2 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-link" @onclick="@(() => ChangeOrder("asc"))">Ascending</button>
            <button class="btn btn-link" @onclick="@(() => ChangeOrder("desc"))">Descending</button>
        </div>
        <div>
            <button class="btn btn-secondary btn-sm me-2" @onclick="PrevYear" disabled="@(!hasPreviousYear)">Previous Year</button>
            <span>@currentYear (@(availableYears.Count) years available)</span>
            <button class="btn btn-secondary btn-sm ms-2" @onclick="NextYear" disabled="@(!hasNextYear)">Next Year</button>
        </div>
    </div>
    <div id="calendar">
        @if (activitiesByDate == null)
        {
            <div><em>Select a tag to view activities.</em></div>
        }
        else if (activitiesByDate.Count == 0)
        {
            <div><em>No activities found for this tag.</em></div>
        }
        else
        {
            <div class="row">
                @foreach (var month in GetAllMonths())
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4 month-container">
                        <h5>@month.ToString("MMMM yyyy")</h5>
                        @RenderSingleMonth(month.Year, month.Month)
                    </div>
                }
            </div>
        }
    </div>    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

@* Modal for showing full description *@
@if (showModal && !string.IsNullOrEmpty(modalDescription))
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="modal-title">Activity Description</h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>@modalDescription</p>
            </div>
        </div>
    </div>
}

@code {
    private IList<TagResponse>? tags;
    private Dictionary<string, List<string>>? activitiesByDate;
    private int? selectedTagId;
    private string? errorMessage;
    private DateTime? minActivityMonth = null;
    private DateTime? maxActivityMonth = null;
    private static readonly string[] dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    
    // Modal variables
    private bool showModal = false;
    private string? modalDescription = null;
    
    // Year navigation variables
    private int currentYear = DateTime.Now.Year;
    private List<int> availableYears = new List<int>();
    private bool hasNextYear = false;
    private bool hasPreviousYear = false;
    private string orderBy = "desc";

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Calendar");
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task OnTagChanged(int? value)
    {
        if (value.HasValue)
        {
            selectedTagId = value;
            await LoadActivitiesForTag(value.Value);
        }
        else
        {
            activitiesByDate = null;
        }
    }    private async Task LoadActivitiesForTag(int tagId)
    {
        try
        {
            // Load activities for the current year
            var activities = await ActivityApi.GetActivitiesByYear(currentYear, tagId);
            
            // Load available years for navigation
            availableYears = await ActivityApi.GetAvailableYears(tagId);
            
            // Update navigation button states
            var currentIndex = availableYears.IndexOf(currentYear);
            hasPreviousYear = currentIndex > 0;
            hasNextYear = currentIndex < availableYears.Count - 1;

            // Group activities by date
            activitiesByDate = activities?
                .GroupBy(a => a.DateStarted.ToString("yyyy-MM-dd"))
                .ToDictionary(g => g.Key, g => g.Select(a => a.Description ?? string.Empty).ToList()) ?? new Dictionary<string, List<string>>();
            
            errorMessage = null;

            // Set min/max activity months for the year
            if (activities?.Any() == true)
            {
                minActivityMonth = new DateTime(currentYear, 1, 1);
                maxActivityMonth = new DateTime(currentYear, 12, 1);
            }
            else
            {
                minActivityMonth = new DateTime(currentYear, 1, 1);
                maxActivityMonth = new DateTime(currentYear, 12, 1);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading activities: {ex.Message}";
        }
    }

    private int? SelectedTagId
    {
        get => selectedTagId;
        set
        {
            if (selectedTagId != value)
            {
                selectedTagId = value;
                _ = OnTagChanged(value);
            }
        }
    }

    private async Task OnTagChangedHandler(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var tagId))
        {
            SelectedTagId = tagId;
            await OnTagChanged(tagId);
        }
        else
        {
            SelectedTagId = null;
            activitiesByDate = null;
        }
    }

    private IEnumerable<DateTime> GetAllMonths()
    {
        // Always show all 12 months of the current year
        for (int month = 1; month <= 12; month++)
        {
            if (orderBy == "asc")
            {
                yield return new DateTime(currentYear, month, 1);
            }
            else
            {
                yield return new DateTime(currentYear, 13 - month, 1);
            }
        }
    }

    private RenderFragment RenderSingleMonth(int year, int month)
    {
        return builder =>
        {
            var firstDay = new DateTime(year, month, 1);
            var lastDay = firstDay.AddMonths(1).AddDays(-1);
            int startDay = ((int)firstDay.DayOfWeek + 6) % 7; // Monday=0
            int daysInMonth = lastDay.Day;
            int seq = 0;
            builder.OpenElement(seq++, "table");
            builder.AddAttribute(seq++, "class", "table table-bordered calendar-table");
            // Header
            builder.OpenElement(seq++, "thead");
            builder.OpenElement(seq++, "tr");
            foreach (var dayName in dayNames)
            {
                builder.OpenElement(seq++, "th");
                builder.AddContent(seq++, dayName);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            // Body
            builder.OpenElement(seq++, "tbody");
            int dayNum = 1;
            for (int i = 0; i < 6; i++)
            {
                builder.OpenElement(seq++, "tr");
                for (int j = 0; j < 7; j++)
                {
                    int cellIndex = i * 7 + j;
                    builder.OpenElement(seq++, "td");
                    builder.AddAttribute(seq++, "style", "height:80px;vertical-align:top;");
                    if (cellIndex < startDay || dayNum > daysInMonth)
                    {
                        builder.AddContent(seq++, " ");
                    }
                    else
                    {
                        var dateStr = new DateTime(year, month, dayNum).ToString("yyyy-MM-dd");
                        builder.OpenElement(seq++, "div");
                        builder.AddAttribute(seq++, "class", "fw-bold");
                        builder.AddContent(seq++, dayNum);
                        builder.CloseElement();                        if (activitiesByDate != null && activitiesByDate.TryGetValue(dateStr, out var values) && values.Count > 0)
                        {
                            foreach (var value in values)
                            {
                                builder.OpenElement(seq++, "span");
                                builder.AddAttribute(seq++, "class", "calendar-value");
                                
                                if (value.Length > 4)
                                {
                                    // Show symbol for long descriptions
                                    builder.AddAttribute(seq++, "class", "calendar-value description-symbol");
                                    builder.AddAttribute(seq++, "title", "Click to view full description");
                                    builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => ShowDescriptionModal(value)));
                                    builder.AddContent(seq++, "📄"); // Document symbol
                                }
                                else
                                {
                                    // Show full text for short descriptions
                                    builder.AddAttribute(seq++, "title", value);
                                    builder.AddContent(seq++, value);
                                }
                                
                                builder.CloseElement();
                            }
                        }
                        else
                        {
                            builder.OpenElement(seq++, "span");
                            builder.AddAttribute(seq++, "class", "calendar-empty");
                            builder.AddContent(seq++, "-");
                            builder.CloseElement();
                        }
                        dayNum++;
                    }
                    builder.CloseElement(); // td
                }
                builder.CloseElement(); // tr
            }
            builder.CloseElement(); // tbody
            builder.CloseElement(); // table
        };
    }    private async Task PrevYear()
    {
        if (selectedTagId.HasValue && hasPreviousYear)
        {
            var currentIndex = availableYears.IndexOf(currentYear);
            if (currentIndex > 0)
            {
                currentYear = availableYears[currentIndex - 1];
                await LoadActivitiesForTag(selectedTagId.Value);
            }
        }
    }

    private async Task NextYear()
    {
        if (selectedTagId.HasValue && hasNextYear)
        {
            var currentIndex = availableYears.IndexOf(currentYear);
            if (currentIndex < availableYears.Count - 1)
            {
                currentYear = availableYears[currentIndex + 1];
                await LoadActivitiesForTag(selectedTagId.Value);
            }
        }
    }    private async Task ChangeOrder(string order)
    {
        orderBy = order;
        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
        }
    }

    private void ShowDescriptionModal(string description)
    {
        modalDescription = description;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalDescription = null;
    }
}
