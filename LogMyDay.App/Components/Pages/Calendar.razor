@page "/calendar"
@using LogMyDay.Shared.DTOs
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation

<style>
    .calendar-table th, .calendar-table td {
        text-align: center;
        vertical-align: middle;
        height: 80px;
    }
    .calendar-value {
        background: #198754;
        color: #fff;
        border-radius: 8px;
        padding: 2px 6px;
        display: inline-block;
        margin-top: 4px;
    }
    .calendar-empty {
        background: #fff3cd;
        color: #856404;
        border-radius: 8px;
        padding: 2px 6px;
        display: inline-block;
        margin-top: 4px;
    }    .month-container {
        padding: 10px;
    }
    .description-symbol {
        cursor: pointer;
        user-select: none;
    }
    .description-symbol:hover {
        opacity: 0.8;
    }
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .modal-content {
        background: white;
        border-radius: 8px;
        padding: 20px;
        max-width: 400px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container-fluid px-4">
    <h2 class="mb-3">Calendar</h2><div class="mb-3 row">
        <div class="col-md-4">
            <label for="tagPicker" class="form-label">Select Tag</label>
            <select id="tagPicker" class="form-select" @onchange="OnTagChangedHandler">
                <option value="">-- Select Tag --</option>
                @if (tags != null)
                {
                    foreach (var tag in tags)
                    {
                        <option value="@tag.Id">@tag.Title</option>
                    }
                }
            </select>
        </div>        <div class="col-md-4">
            <label for="paginationMode" class="form-label">Pagination Mode</label>
            <select id="paginationMode" class="form-select" @onchange="OnPaginationModeChanged">
                <option value="weeks" selected>By Weeks (@weeksPerPage weeks)</option>
                <option value="months">By Months (@monthsPerPage months)</option>
            </select>
        </div>
    </div>    <div class="mb-2 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-link" @onclick="@(() => ChangeOrder("asc"))">Ascending</button>
            <button class="btn btn-link" @onclick="@(() => ChangeOrder("desc"))">Descending</button>
        </div>        <div class="me-3">
            <label class="form-label me-2">Pagination Type:</label>
            <select class="form-select form-select-sm d-inline-block" style="width: auto;" @onchange="OnPaginationTypeChanged">
                <option value="weeks" selected="@(paginationType == "weeks")">By Weeks</option>
                <option value="months" selected="@(paginationType == "months")">By Months</option>
            </select>
        </div><div>
            <button class="btn btn-secondary btn-sm me-2" @onclick="PrevPage" disabled="@(GetCurrentPageNumber() == 1)">Previous</button>
            <span>Page @GetCurrentPageNumber() of @totalPages (@GetPaginationDescription())</span>
            <button class="btn btn-secondary btn-sm ms-2" @onclick="NextPage" disabled="@(GetCurrentPageNumber() == totalPages)">Next</button>
        </div>
    </div>
    <div id="calendar">
        @if (activitiesByDate == null)
        {
            <div><em>Select a tag to view activities.</em></div>
        }
        else if (activitiesByDate.Count == 0)
        {
            <div><em>No activities found for this tag.</em></div>
        }
        else
        {
            <div class="row">
                @foreach (var month in GetAllMonths())
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2 mb-4 month-container">
                        <h5>@month.ToString("MMMM yyyy")</h5>
                        @RenderSingleMonth(month.Year, month.Month)
                    </div>
                }
            </div>
        }
    </div>    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

@* Modal for showing full description *@
@if (showModal && !string.IsNullOrEmpty(modalDescription))
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="modal-title">Activity Description</h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>@modalDescription</p>
            </div>
        </div>
    </div>
}

@code {
    private IList<TagResponse>? tags;
    private PagedResult<ActivityResponse>? pagedResult;
    private Dictionary<string, List<string>>? activitiesByDate;
    private int? selectedTagId;
    private string? errorMessage;
    private DateTime? minActivityMonth = null;
    private DateTime? maxActivityMonth = null;
    private static readonly string[] dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    
    // Modal variables
    private bool showModal = false;
    private string? modalDescription = null;
    
    // Pagination variables
    private string paginationMode = "weeks"; // "weeks", "months"
    private string paginationType = "weeks"; // "weeks", "months"
    private int weekPageNumber = 1;
    private int weeksPerPage = 12;
    private int monthPageNumber = 1;
    private int monthsPerPage = 12;
    private int totalPages = 1;
    private string orderBy = "desc";

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task OnTagChanged(int? value)
    {
        if (value.HasValue)
        {
            selectedTagId = value;
            await LoadActivitiesForTag(value.Value);
        }
        else
        {
            pagedResult = null;
            activitiesByDate = null;
        }
    }    private async Task LoadActivitiesForTag(int tagId)
    {
        try
        {
            switch (paginationType)
            {
                case "weeks":
                    pagedResult = await ActivityApi.GetActivitiesByWeeks(weekPageNumber, weeksPerPage, orderBy, tagId);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / weeksPerPage);
                    break;
                case "months":
                    pagedResult = await ActivityApi.GetActivitiesByMonths(monthPageNumber, monthsPerPage, orderBy, tagId);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / monthsPerPage);
                    break;
            }

            activitiesByDate = pagedResult?.Items?
                .GroupBy(a => a.DateStarted.ToString("yyyy-MM-dd"))
                .ToDictionary(g => g.Key, g => g.Select(a => a.Description ?? string.Empty).ToList());
            
            errorMessage = null;

            if (pagedResult?.Items?.Any() == true)
            {
                minActivityMonth = pagedResult.Items.Min(a => a.DateStarted).Date;
                minActivityMonth = new DateTime(minActivityMonth.Value.Year, minActivityMonth.Value.Month, 1);
                maxActivityMonth = pagedResult.Items.Max(a => a.DateStarted).Date;
                maxActivityMonth = new DateTime(maxActivityMonth.Value.Year, maxActivityMonth.Value.Month, 1);
            }
            else
            {
                minActivityMonth = null;
                maxActivityMonth = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading activities: {ex.Message}";
        }
    }

    private int? SelectedTagId
    {
        get => selectedTagId;
        set
        {
            if (selectedTagId != value)
            {
                selectedTagId = value;
                _ = OnTagChanged(value);
            }
        }
    }

    private async Task OnTagChangedHandler(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var tagId))
        {
            SelectedTagId = tagId;
            await OnTagChanged(tagId);
        }
        else
        {
            SelectedTagId = null;
            pagedResult = null;
            activitiesByDate = null;
        }
    }

    private IEnumerable<DateTime> GetAllMonths()
    {
        if (minActivityMonth == null || maxActivityMonth == null)
            yield break;

        var start = orderBy == "asc" ? minActivityMonth.Value : maxActivityMonth.Value;
        var end = orderBy == "asc" ? maxActivityMonth.Value : minActivityMonth.Value;
        int step = orderBy == "asc" ? 1 : -1;
        var current = start;
        while ((step > 0 && current <= end) || (step < 0 && current >= end))
        {
            yield return current;
            current = current.AddMonths(step);
        }
    }

    private RenderFragment RenderSingleMonth(int year, int month)
    {
        return builder =>
        {
            var firstDay = new DateTime(year, month, 1);
            var lastDay = firstDay.AddMonths(1).AddDays(-1);
            int startDay = ((int)firstDay.DayOfWeek + 6) % 7; // Monday=0
            int daysInMonth = lastDay.Day;
            int seq = 0;
            builder.OpenElement(seq++, "table");
            builder.AddAttribute(seq++, "class", "table table-bordered calendar-table");
            // Header
            builder.OpenElement(seq++, "thead");
            builder.OpenElement(seq++, "tr");
            foreach (var dayName in dayNames)
            {
                builder.OpenElement(seq++, "th");
                builder.AddContent(seq++, dayName);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            // Body
            builder.OpenElement(seq++, "tbody");
            int dayNum = 1;
            for (int i = 0; i < 6; i++)
            {
                builder.OpenElement(seq++, "tr");
                for (int j = 0; j < 7; j++)
                {
                    int cellIndex = i * 7 + j;
                    builder.OpenElement(seq++, "td");
                    builder.AddAttribute(seq++, "style", "height:80px;vertical-align:top;");
                    if (cellIndex < startDay || dayNum > daysInMonth)
                    {
                        builder.AddContent(seq++, " ");
                    }
                    else
                    {
                        var dateStr = new DateTime(year, month, dayNum).ToString("yyyy-MM-dd");
                        builder.OpenElement(seq++, "div");
                        builder.AddAttribute(seq++, "class", "fw-bold");
                        builder.AddContent(seq++, dayNum);
                        builder.CloseElement();                        if (activitiesByDate != null && activitiesByDate.TryGetValue(dateStr, out var values) && values.Count > 0)
                        {
                            foreach (var value in values)
                            {
                                builder.OpenElement(seq++, "span");
                                builder.AddAttribute(seq++, "class", "calendar-value");
                                
                                if (value.Length > 4)
                                {
                                    // Show symbol for long descriptions
                                    builder.AddAttribute(seq++, "class", "calendar-value description-symbol");
                                    builder.AddAttribute(seq++, "title", "Click to view full description");
                                    builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => ShowDescriptionModal(value)));
                                    builder.AddContent(seq++, "📄"); // Document symbol
                                }
                                else
                                {
                                    // Show full text for short descriptions
                                    builder.AddAttribute(seq++, "title", value);
                                    builder.AddContent(seq++, value);
                                }
                                
                                builder.CloseElement();
                            }
                        }
                        else
                        {
                            builder.OpenElement(seq++, "span");
                            builder.AddAttribute(seq++, "class", "calendar-empty");
                            builder.AddContent(seq++, "-");
                            builder.CloseElement();
                        }
                        dayNum++;
                    }
                    builder.CloseElement(); // td
                }
                builder.CloseElement(); // tr
            }
            builder.CloseElement(); // tbody
            builder.CloseElement(); // table
        };
    }    private async Task PrevPage()
    {
        if (selectedTagId.HasValue)
        {
            switch (paginationType)
            {
                case "weeks":
                    if (weekPageNumber > 1)
                    {
                        weekPageNumber--;
                        await LoadActivitiesForTag(selectedTagId.Value);
                    }
                    break;
                case "months":
                    if (monthPageNumber > 1)
                    {
                        monthPageNumber--;
                        await LoadActivitiesForTag(selectedTagId.Value);
                    }
                    break;
            }
        }
    }    private async Task NextPage()
    {
        if (selectedTagId.HasValue)
        {
            switch (paginationType)
            {
                case "weeks":
                    if (weekPageNumber < totalPages)
                    {
                        weekPageNumber++;
                        await LoadActivitiesForTag(selectedTagId.Value);
                    }
                    break;
                case "months":
                    if (monthPageNumber < totalPages)
                    {
                        monthPageNumber++;
                        await LoadActivitiesForTag(selectedTagId.Value);
                    }
                    break;
            }
        }
    }    private async Task ChangeOrder(string order)
    {
        orderBy = order;
        weekPageNumber = 1;
        monthPageNumber = 1;
        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
        }
    }    private int GetCurrentPageNumber()
    {
        return paginationType switch
        {
            "weeks" => weekPageNumber,
            "months" => monthPageNumber,
            _ => weekPageNumber
        };
    }    private async Task OnPaginationTypeChanged(ChangeEventArgs e)
    {
        paginationType = e.Value?.ToString() ?? "weeks";
        
        // Reset page numbers when switching pagination types
        weekPageNumber = 1;
        monthPageNumber = 1;
        
        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
        }
    }    private async Task OnPaginationModeChanged(ChangeEventArgs e)
    {
        paginationMode = e.Value?.ToString() ?? "weeks";
        paginationType = paginationMode;
        
        // Reset page numbers when switching pagination types
        weekPageNumber = 1;
        monthPageNumber = 1;
        
        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
        }
    }    private string GetPaginationDescription()
    {
        return paginationType switch
        {
            "weeks" => $"{weeksPerPage} weeks per page",
            "months" => $"{monthsPerPage} months per page",
            _ => $"{weeksPerPage} weeks per page"
        };
    }

    private void ShowDescriptionModal(string description)
    {
        modalDescription = description;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalDescription = null;
    }
}
