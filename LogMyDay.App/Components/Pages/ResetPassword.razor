@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Refit
@inject IAccountApi AccountApi
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset Password</PageTitle>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4" style="max-width: 450px; width: 100%;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Reset Password</h3>

            @if (!string.IsNullOrEmpty(tokenError))
            {
                <div class="alert alert-danger" role="alert">
                    @tokenError
                    @if (string.IsNullOrWhiteSpace(TokenQuery))
                    {
                        <br/><small>No token found in URL. Please use the link from your email.</small>
                    }
                    else
                    {
                        <br/><small>Token received but invalid: @TokenQuery</small>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            @if (isSuccess)
            {
                <div class="alert alert-success" role="alert">
                    Your password has been reset successfully. You can now <a href="/login">log in</a> with your new password.
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="ResetPasswordAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="password" class="form-label">New Password</label>
                        <InputText id="password" class="form-control" type="password" @bind-Value="model.Password" placeholder="At least 10 characters" />
                        <ValidationMessage For="() => model.Password" />
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <InputText id="confirmPassword" class="form-control" type="password" @bind-Value="model.ConfirmPassword" />
                        <ValidationMessage For="() => model.ConfirmPassword" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@(isSubmitting || string.IsNullOrWhiteSpace(token))">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Updating password...</span>
                        }
                        else
                        {
                            <span>Update password</span>
                        }
                    </button>
                </EditForm>
            }

            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none">Back to login</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ResetPasswordModel model = new();
    private bool isSubmitting;
    private bool isSuccess;
    private string? errorMessage;
    private string? tokenError;

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenQuery { get; set; }

    private string? token;

    protected override void OnParametersSet()
    {
        token = TokenQuery?.Trim();
        Logger.LogInformation("ResetPassword.OnParametersSet: TokenQuery='{TokenQuery}', ProcessedToken='{Token}'", TokenQuery ?? "null", token ?? "null");
        
        if (string.IsNullOrWhiteSpace(token))
        {
            tokenError = "The password reset link is invalid or missing the reset token.";
            Logger.LogWarning("ResetPassword.OnParametersSet: Token is null or empty");
        }
        else
        {
            tokenError = null;
            Logger.LogInformation("ResetPassword.OnParametersSet: Token is valid, length={Length}", token.Length);
        }
    }

    private async Task ResetPasswordAsync()
    {
        Logger.LogInformation("ResetPassword.ResetPasswordAsync: Starting password reset, isSubmitting={IsSubmitting}, token='{Token}'", isSubmitting, token ?? "null");
        
        if (isSubmitting)
        {
            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Already submitting, returning");
            return;
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            tokenError = "The password reset link is invalid or has expired.";
            Logger.LogWarning("ResetPassword.ResetPasswordAsync: Token is null or empty");
            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;

            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Resetting password using provided reset token");

            await AccountApi.ConfirmForgotPasswordAsync(new ForgotConfirmDto(token, model.Password!));

            isSuccess = true;
            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Password reset successful");
        }
        catch (ApiException apiEx)
        {
            Logger.LogError(apiEx, "ResetPassword.ResetPasswordAsync: API error during password reset using provided token");
            errorMessage = !string.IsNullOrWhiteSpace(apiEx.Content) ? apiEx.Content : apiEx.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ResetPassword.ResetPasswordAsync: Unexpected error during password reset using provided token");
            errorMessage = "An unexpected error occurred while resetting the password. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "A new password is required.")]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters long.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string? ConfirmPassword { get; set; }
    }
}
