@inject NavigationManager Navigation
@inject LogMyDay.Shared.Interfaces.IAuthApi AuthApi
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection

<nav class="navbar navbar-expand-lg top-navigation">
    <div class="container-fluid">
        <!-- Logo/Brand -->
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-graph-up" style="color: #0d6efd;"></i>
            LogMyDay <span style="font-size: 0.65rem; opacity: 0.8;">v@(GetAppVersion())</span>
        </a>

        <!-- Mobile menu toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house"></i> Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="tags">
                        <i class="bi bi-tags"></i> Tags
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="notifications">
                        <i class="bi bi-calendar3"></i> Notifications
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="calendar">
                        <i class="bi bi-calendar3"></i> Calendar
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="tools">
                        <i class="bi bi-tools"></i> Tools
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="backup">
                        <i class="bi bi-cloud-download"></i> Backup
                    </NavLink>
                </li>
                @if (isAdminUser)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="users">
                            <i class="bi bi-people"></i> Users
                        </NavLink>
                    </li>
                }
            </ul>

            <!-- Theme toggle and logout -->
            <div class="navbar-nav d-flex flex-row align-items-center gap-2">
                <button class="theme-toggle" @onclick="ToggleTheme" title="Toggle theme">
                    <i class="bi @(isDarkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </div>
        </div>
    </div>
</nav>

@implements IDisposable

@code {
    private bool isDarkMode = false;
    private bool isAdminUser = false;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await DetermineAdminAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user has a saved theme preference
            var savedTheme = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "theme");
            isDarkMode = savedTheme == "dark";
            await ApplyTheme();
            StateHasChanged();
        }
    }

    private async Task DetermineAdminAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdminUser = user?.Claims.Any(c => c.Type == "is_admin" && string.Equals(c.Value, "true", StringComparison.OrdinalIgnoreCase)) == true;
        }
        catch
        {
            isAdminUser = false;
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;
            var user = authState.User;
            var isAdmin = user?.Claims.Any(c => c.Type == "is_admin" && string.Equals(c.Value, "true", StringComparison.OrdinalIgnoreCase)) == true;
            if (isAdmin != isAdminUser)
            {
                isAdminUser = isAdmin;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            isAdminUser = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Logout()
    {
        try
        {
            await AuthApi.LogoutAsync();
        }
        catch (Exception)
        {
            // Ignore logout errors - we'll redirect anyway
        }
        finally
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private string GetAppVersion()
    {
        var assembly = Assembly.GetExecutingAssembly();
        var version = assembly.GetName().Version;
        return version?.ToString(3) ?? "Unknown"; // Returns major.minor.build
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await ApplyTheme();
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", isDarkMode ? "dark" : "light");
    }

    private async Task ApplyTheme()
    {
        var theme = isDarkMode ? "dark" : "light";
        await JSRuntime.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-bs-theme', '{theme}')");
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
