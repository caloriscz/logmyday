@inject NavigationManager Navigation
@inject LogMyDay.Shared.Interfaces.IAuthApi AuthApi
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Refit
@using System.Net
@using System.Reflection
@using System.Security.Claims

<nav class="navbar navbar-expand-lg top-navigation">
    <div class="container-fluid">
        <!-- Logo/Brand -->
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-graph-up" style="color: #0d6efd;"></i>
            LogMyDay <span style="font-size: 0.65rem; opacity: 0.8;">v@(GetAppVersion())</span>
        </a>

        <!-- Mobile menu toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house"></i> Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="tags">
                        <i class="bi bi-tags"></i> Tags
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="units">
                        <i class="bi bi-rulers"></i> Units
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="option-lists">
                        <i class="bi bi-list-check"></i> Lists
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="notifications">
                        <i class="bi bi-calendar3"></i> Notifications
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="calendar">
                        <i class="bi bi-calendar3"></i> Calendar
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="tools">
                        <i class="bi bi-tools"></i> Tools
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="backup">
                        <i class="bi bi-cloud-download"></i> Backup
                    </NavLink>
                </li>
                @if (isAdminUser)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="users">
                            <i class="bi bi-people"></i> Users
                        </NavLink>
                    </li>
                }
            </ul>

            <!-- Theme toggle and account menu -->
            <div class="navbar-nav d-flex flex-row align-items-center gap-2">
                <div class="dropdown account-dropdown">
                    <button class="btn account-menu-toggle dropdown-toggle"
                            type="button"
                            id="userMenuButton"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Account menu"
                            title="@DisplayEmail">
                        <i class="bi bi-person-circle"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu" aria-labelledby="userMenuButton">
                        <li>
                            <NavLink class="dropdown-item account-email-item" href="profile">
                                <i class="bi bi-envelope-open me-2"></i>
                                <span class="text-break">@DisplayEmail</span>
                            </NavLink>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <NavLink class="dropdown-item" href="profile">
                                <i class="bi bi-person-lines-fill me-2"></i>
                                Profile
                            </NavLink>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" @onclick="ToggleTheme">
                                <i class="bi @(ThemeToggleIcon)"></i>
                                <span>@ThemeToggleText</span>
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item text-danger d-flex align-items-center gap-2" type="button" @onclick="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>

@implements IDisposable

@code {
    private bool isDarkMode = false;
    private bool isAdminUser = false;
    private string? currentUserEmail;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RefreshUserInfoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user has a saved theme preference
            var savedTheme = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "theme");
            isDarkMode = savedTheme == "dark";
            await ApplyTheme();
            StateHasChanged();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;
            await RefreshUserInfoAsync(authState);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            isAdminUser = false;
            currentUserEmail = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshUserInfoAsync(AuthenticationState? authState = null)
    {
        try
        {
            authState ??= await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdminUser = user?.Claims.Any(c => c.Type == "is_admin" && string.Equals(c.Value, "true", StringComparison.OrdinalIgnoreCase)) == true;

            if (user?.Identity?.IsAuthenticated == true)
            {
                try
                {
                    var currentUser = await AuthApi.GetCurrentUserAsync();
                    currentUserEmail = currentUser.Email;
                }
                catch (Refit.ApiException apiEx) when (apiEx.StatusCode == HttpStatusCode.Unauthorized || apiEx.StatusCode == HttpStatusCode.Forbidden)
                {
                    currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name;
                }
            }
            else
            {
                currentUserEmail = null;
            }
        }
        catch
        {
            isAdminUser = false;
            currentUserEmail = null;
        }
    }

    private async Task Logout()
    {
        try
        {
            await AuthApi.LogoutAsync();
        }
        catch (Exception)
        {
            // Ignore logout errors - we'll redirect anyway
        }
        finally
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private string GetAppVersion()
    {
        var assembly = Assembly.GetExecutingAssembly();
        var version = assembly.GetName().Version;
        return version?.ToString(3) ?? "Unknown"; // Returns major.minor.build
    }

    private string DisplayEmail => string.IsNullOrWhiteSpace(currentUserEmail) ? "Account" : currentUserEmail;
    private string ThemeToggleText => isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode";
    private string ThemeToggleIcon => isDarkMode ? "bi-sun" : "bi-moon";

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await ApplyTheme();
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", isDarkMode ? "dark" : "light");
    }

    private async Task ApplyTheme()
    {
        var theme = isDarkMode ? "dark" : "light";
        await JSRuntime.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-bs-theme', '{theme}')");
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
