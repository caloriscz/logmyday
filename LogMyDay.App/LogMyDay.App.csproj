<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>0.2.0.0</Version>
		<AssemblyVersion>0.2.0.0</AssemblyVersion>
		<FileVersion>0.2.0.0</FileVersion>
	</PropertyGroup>

	<Target Name="CleanPrecompressedArtifacts" BeforeTargets="Build">
		<RemoveDir Directories="$(BaseIntermediateOutputPath)\staticwebassets" />
	</Target>


	<ItemGroup>
		<None Remove="LogMyDay.App.csproj.Backup.tmp" />
	</ItemGroup>


	<ItemGroup>
	  <Content Include="appsettings.Development.json.dist" />
	  <Content Include="appsettings.json.dist" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogMyDay.Api\LogMyDay.Api.csproj" />
		<ProjectReference Include="..\LogMyDay.Domain\LogMyDay.Domain.csproj" />
		<ProjectReference Include="..\LogMyDay.Shared\LogMyDay.Shared.csproj" />
	</ItemGroup>

</Project>
