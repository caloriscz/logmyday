<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- As in the web.config the SDK generates: applications nested under the site don't inherit LogMyDay's settings. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- A database restore takes a file of up to 1 GB in a multipart request (BackupController.MaxDatabaseRequestBytes).
               IIS request filtering refuses more than 30,000,000 bytes by default, before the app sees the request. -->
          <requestLimits maxAllowedContentLength="1074790400" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
