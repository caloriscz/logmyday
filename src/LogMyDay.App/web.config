<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- The database restore endpoints take files of up to 1 GB (BackupController.MaxDatabaseUploadBytes).
             IIS request filtering refuses more than 30,000,000 bytes by default, before the app sees the request. -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
