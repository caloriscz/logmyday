    // ── Helpers ──

    private static DateTime? ParseDateTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateTime.TryParse(value, out var d) ? d : null;
    }

    private static DateOnly? ParseDateOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateOnly.TryParse(value, out var d) ? d : null;
    }

    private static TimeOnly? ParseTimeOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return TimeOnly.TryParse(value, out var t) ? t : null;
    }

    private static bool IsQuickCompleteInputType(int? id) => id is
        InputTypeIds.Boolean or InputTypeIds.String or
        InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage or
        InputTypeIds.StarRating or InputTypeIds.StarRating10 or
        InputTypeIds.Score or InputTypeIds.Score10;

    private static bool HasValidPrefilledValue(TodoItemResponse item, int? inputTypeId)
    {
        if (string.IsNullOrWhiteSpace(item.Notes)) return false;
        return inputTypeId switch
        {
            InputTypeIds.Boolean => item.Notes is "true" or "false",
            InputTypeIds.String => true,
            InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage =>
                decimal.TryParse(item.Notes, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _),
            InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10 =>
                int.TryParse(item.Notes, out var v) && v > 0,
            _ => false
        };
    }

    private void OpenQuickCompleteModal(TodoItemResponse item, int? inputTypeId)
    {
        _quickItem = item;
        _quickInputTypeId = inputTypeId;
        _quickBoolValue = null;
        _quickStringValue = null;
        _quickDecimalValue = null;
        _quickIntValue = null;
        _quickAllowUnfilled = false;
        _quickError = null;

        switch (inputTypeId)
        {
            case InputTypeIds.Boolean:
                _quickBoolValue = item.Notes switch { "true" => true, "false" => false, _ => null };
                break;
            case InputTypeIds.String:
                _quickStringValue = item.Notes;
                break;
            case InputTypeIds.Integer:
            case InputTypeIds.Decimal:
            case InputTypeIds.Percentage:
                if (!string.IsNullOrWhiteSpace(item.Notes) &&
                    decimal.TryParse(item.Notes, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
                {
                    _quickDecimalValue = d;
                }
                else
                {
                    var tag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
                    if (!string.IsNullOrWhiteSpace(tag?.DefaultValue) &&
                        decimal.TryParse(tag.DefaultValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var defVal))
                    {
                        _quickDecimalValue = defVal;
                    }
                }
                break;
            case InputTypeIds.StarRating:
            case InputTypeIds.StarRating10:
            case InputTypeIds.Score:
            case InputTypeIds.Score10:
                if (!string.IsNullOrWhiteSpace(item.Notes) && int.TryParse(item.Notes, out var iv))
                {
                    _quickIntValue = iv;
                }
                break;
        }

        _showQuickModal = true;
        StateHasChanged();
    }

    private static bool IsNumericInputType(int? inputTypeId) =>
        inputTypeId is 1 or 6 or 7 or 8 or 9 or 10 or 11;

    private static bool IsBooleanInputType(int? inputTypeId) =>
        inputTypeId == 3;
}
