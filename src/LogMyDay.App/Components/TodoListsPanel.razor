@using LogMyDay.Domain.Enums
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using Refit
@implements IDisposable

@inject ITodoApi TodoApi
@inject IActivityApi ActivityApi
@inject IJSRuntime JS
@inject ILogger<TodoListsPanel> Logger

<div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100">To-Do Lists</h2>
    <button type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden disabled:opacity-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            @onclick="OpenAddListModal"
            disabled="@(_lists == null)">
        <Icon Name="plus" Class="h-4 w-4" />
        New list
    </button>
</div>

@if (_loadError != null)
{
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
        @_loadError
    </div>
}
else if (_lists == null)
{
    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-slate-400">
        <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-gray-600 dark:border-slate-700 dark:border-t-slate-300"></span>
        Loading to-do lists…
    </div>
}
else if (_lists.Count == 0)
{
    <div class="py-8 text-center text-sm text-gray-400 dark:text-slate-500">
        No lists yet.
        <button type="button" class="underline hover:no-underline" @onclick="OpenAddListModal">Create one</button>
    </div>
}
else
{
    @* Grid of panels — 1 col → 2 col sm → 3 col 2xl → 4 col 3xl *@
    <div class="todo-list-grid grid gap-6 sm:grid-cols-2 2xl:grid-cols-3">
        @foreach (var list in _lists)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var listId = list.Id;
            var activeItems = list.Items
                .Where(i => !i.IsDone && (i.StartDate == null || i.StartDate <= today))
                .OrderBy(i => i.DisplayOrder)
                .ThenBy(i => i.DueDate ?? DateOnly.MaxValue)
                .ThenBy(i => i.DateCreated)
                .ToList();
            var doneItems = list.Items.Where(i => i.IsDone).ToList();
            var showDoneForThis = _showDonePerList.Contains(listId);

            <div @key="listId" class="flex flex-col rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900" style="min-height: 600px;">

                @* Panel header *@
                <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-slate-700">
                    <div class="flex items-center gap-2 min-w-0">
                        <h3 class="truncate text-base font-semibold text-gray-900 dark:text-slate-100">@list.Name</h3>
                        <span class="shrink-0 text-xs text-gray-500 dark:text-slate-400">@activeItems.Count</span>
                        @if (list.ListType == TodoListType.Reminder)
                        {
                            <span class="shrink-0 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/20 dark:text-amber-300">Reminder</span>
                        }
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded-lg bg-primary-600 px-2.5 py-1 text-xs font-semibold text-white shadow-xs transition hover:bg-primary-700 focus:outline-hidden disabled:opacity-60"
                                @onclick="() => OpenAddItemModal(listId)"
                                disabled="@_isBusy">
                            <Icon Name="plus" Class="h-3.5 w-3.5" />
                            Add item
                        </button>
                        <button type="button"
                                class="inline-flex items-center rounded-md p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-slate-200 dark:hover:bg-slate-800 focus:outline-hidden transition-colors"
                                title="Edit list"
                                @onclick="() => OpenEditListModal(list)"
                                disabled="@_isBusy">
                            <Icon Name="pencil" Class="h-3.5 w-3.5" />
                        </button>
                        <button type="button"
                                class="inline-flex items-center rounded-md p-1.5 text-gray-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:text-rose-400 dark:hover:bg-rose-500/10 focus:outline-hidden transition-colors"
                                title="Delete list"
                                @onclick="() => ConfirmDeleteList(list)"
                                disabled="@_isBusy">
                            <Icon Name="trash" Class="h-3.5 w-3.5" />
                        </button>
                    </div>
                </div>

                @* Items area — scrollable *@
                <div class="flex-1 overflow-y-auto px-3 py-3 space-y-0.5" style="min-height: 480px;">
                    @if (!activeItems.Any())
                    {
                        <p class="py-8 text-center text-sm text-gray-400 dark:text-slate-500">No pending items.</p>
                    }
                    else
                    {
                        @foreach (var item in activeItems)
                        {

                            var isOverdue = item.DueDate.HasValue && item.DueDate.Value < today;
                            var isDragging = _draggingItem?.Id == item.Id;
                            var isDragOver = _dragOverItem?.Id == item.Id && !isDragging;
                            <div class="flex items-start gap-3 rounded-lg px-2 py-2 hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors @(isOverdue ? "border-l-2 border-rose-400" : "") @(isDragging ? "opacity-40" : "") @(isDragOver ? "ring-2 ring-primary-400 ring-inset" : "")"
                                 draggable="true"
                                 @ondragstart="() => { _draggingItem = item; _dragFromListId = listId; }"
                                 @ondragover:preventDefault
                                 @ondragover="() => _dragOverItem = item"
                                 @ondrop="() => OnDropItemAsync(item, listId)"
                                 @ondragend="() => { _draggingItem = null; _dragOverItem = null; _dragFromListId = 0; }">
                                <i class="bi bi-grip-vertical mt-0.5 shrink-0 cursor-grab text-gray-300 dark:text-slate-600 select-none"></i>
                                <input type="checkbox"
                                       class="mt-0.5 h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:focus:ring-offset-slate-900 cursor-pointer"
                                       checked="@item.IsDone"
                                       @onchange="() => CompleteItemAsync(item)"
                                       disabled="@_isBusy" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-sm text-gray-900 dark:text-slate-100">@item.Title</span>
                                        @if (list.ListType == TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="text-sm text-gray-500 dark:text-slate-400">@item.Notes</span>
                                        }
                                        @if (isOverdue)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">Overdue</span>
                                        }
                                        @if (item.DueDate.HasValue && !isOverdue)
                                        {
                                            <span class="text-xs text-gray-400 dark:text-slate-500">due @item.DueDate.Value.ToString("MMM d")</span>
                                        }
                                        @if (item.RecurrenceType != RecurrenceType.None)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><Icon Name="arrow-repeat" Class="me-1 h-3 w-3" />@item.RecurrenceType</span>
                                        }
                                    </div>
                                    @if (list.ListType != TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p class="mt-0.5 text-xs text-gray-500 dark:text-slate-400 truncate">@item.Notes</p>
                                    }
                                </div>
                                <div class="flex items-center gap-1 shrink-0">
                                    @if (list.ListType == TodoListType.Basic)
                                    {
                                        <button type="button"
                                                class="inline-flex items-center rounded p-1 @(_copiedItemId == item.Id ? "text-green-500" : "text-gray-400 hover:text-gray-600 dark:hover:text-slate-200") focus:outline-hidden"
                                                title="@(_copiedItemId == item.Id ? "Copied!" : "Copy title")"
                                                @onclick="() => CopyItemTitleAsync(item)"
                                                disabled="@_isBusy">
                                            <Icon Name="@(_copiedItemId == item.Id ? "check" : "copy")" Class="h-3.5 w-3.5" />
                                        </button>
                                    }
                                    <button type="button"
                                            class="inline-flex items-center rounded p-1 text-gray-400 hover:text-gray-600 dark:hover:text-slate-200 focus:outline-hidden"
                                            title="Edit item"
                                            @onclick="() => OpenEditItemModal(item)"
                                            disabled="@_isBusy">
                                        <Icon Name="pencil" Class="h-3.5 w-3.5" />
                                    </button>
                                    <button type="button"
                                            class="inline-flex items-center rounded p-1 text-gray-400 hover:text-rose-500 dark:hover:text-rose-400 focus:outline-hidden"
                                            title="Delete item"
                                            @onclick="() => DeleteItemAsync(item)"
                                            disabled="@_isBusy">
                                        <Icon Name="trash" Class="h-3.5 w-3.5" />
                                    </button>
                                </div>
                            </div>
                        }

                        @* Sentinel drop zone — invisible until drag is active in this list *@
                        <div class="mt-1 transition-all @(_dragFromListId == listId ? (_dragOverLastZoneListId == listId ? "flex h-10 items-center justify-center rounded-lg border-2 border-dashed border-primary-400 bg-primary-50 dark:bg-primary-500/10" : "h-10 rounded-lg border-2 border-dashed border-gray-300 dark:border-slate-600") : "h-0 overflow-hidden")"
                             @ondragover:preventDefault
                             @ondragover="() => _dragOverLastZoneListId = listId"
                             @ondrop="() => OnDropLastAsync(listId)">
                            @if (_dragOverLastZoneListId == listId && _draggingItem != null)
                            {
                                <span class="text-xs text-primary-500 select-none">Drop here to place last</span>
                            }
                        </div>
                    }

                    @* Completed items toggle *@
                    @if (doneItems.Any())
                    {
                        <div class="mt-3 border-t border-gray-200 pt-2 dark:border-slate-700">
                            <button type="button"
                                    class="text-xs text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors"
                                    @onclick="() => ToggleShowDone(listId)">
                                @(showDoneForThis ? "Hide" : "Show") completed (@doneItems.Count)
                            </button>
                            @if (showDoneForThis)
                            {
                                <div class="mt-2 space-y-0.5">
                                    @foreach (var item in doneItems.OrderByDescending(i => i.DoneAt))
                                    {
                                        <div class="flex items-center gap-3 rounded-lg px-2 py-1.5 opacity-60">
                                            <input type="checkbox"
                                                   class="h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-slate-600 cursor-pointer"
                                                   checked="@item.IsDone"
                                                   @onchange="() => ReopenItemAsync(item)"
                                                   disabled="@_isBusy" />
                                            <span class="flex-1 text-sm line-through text-gray-500 dark:text-slate-400">@item.Title</span>
                                            <button type="button"
                                                    class="inline-flex items-center rounded p-1 text-gray-300 hover:text-rose-500 dark:hover:text-rose-400 focus:outline-hidden"
                                                    title="Delete item"
                                                    @onclick="() => DeleteItemAsync(item)"
                                                    disabled="@_isBusy">
                                                <Icon Name="trash" Class="h-3.5 w-3.5" />
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Panel footer: error only (visible when an item save fails) *@
                @if (!string.IsNullOrEmpty(_itemErrorPerList.GetValueOrDefault(listId)))
                {
                    <div class="border-t border-gray-200 px-4 py-2 dark:border-slate-700">
                        <div class="flex items-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                            <span class="flex-1">@_itemErrorPerList[listId]</span>
                            <button type="button" class="shrink-0 font-medium underline hover:no-underline" @onclick="LoadDataAsync">Reload</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@* ── List Create/Edit Modal ── *@
@if (_showListModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!_isBusy) CloseListModal(); }">
        <div class="w-full max-w-md overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(_isEditingList ? "Edit list" : "New list")</h3>
                <button type="button"
                        class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 dark:text-slate-400 dark:hover:bg-slate-800"
                        @onclick="CloseListModal" disabled="@_isBusy">
                    <Icon Name="x" Class="h-5 w-5" />
                </button>
            </div>
            <EditForm Model="_listForm" OnValidSubmit="SaveListAsync">
                <DataAnnotationsValidator />
                <div class="space-y-4 px-6 py-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Name <span class="text-rose-500">*</span></label>
                        <InputText class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                   @bind-Value="_listForm.Name"
                                   maxlength="200"
                                   placeholder="e.g. Work tasks" />
                        <ValidationMessage For="@(() => _listForm.Name)" class="mt-1 text-xs text-rose-600 dark:text-rose-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">List type</label>
                        <InputSelect @bind-Value="_listForm.ListType" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
                            <option value="@TodoListType.Basic">Basic</option>
                            <option value="@TodoListType.Reminder">Reminder</option>
                        </InputSelect>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_listError))
                {
                    <div class="mx-6 mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @_listError
                    </div>
                }
                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                            @onclick="CloseListModal" disabled="@_isBusy">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 disabled:opacity-60 focus:outline-hidden"
                            disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(_isEditingList ? "Save changes" : "Create list")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ── Item Create/Edit Modal ── *@
@if (_showItemModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!_isBusy) CloseItemModal(); }">
        <div class="w-full max-w-md overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(_isEditingItem ? "Edit item" : "New item")</h3>
                <button type="button"
                        class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 dark:text-slate-400 dark:hover:bg-slate-800"
                        @onclick="CloseItemModal" disabled="@_isBusy">
                    <Icon Name="x" Class="h-5 w-5" />
                </button>
            </div>
            <EditForm Model="_itemForm" OnValidSubmit="SaveItemAsync">
                <DataAnnotationsValidator />
                <div class="space-y-4 px-6 py-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Title <span class="text-rose-500">*</span></label>
                        <InputText class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                   @bind-Value="_itemForm.Title"
                                   maxlength="500"
                                   placeholder="What needs to be done?" />
                        <ValidationMessage For="@(() => _itemForm.Title)" class="mt-1 text-xs text-rose-600 dark:text-rose-400" />
                    </div>
                    @if (_currentListForItemModal?.ListType == TodoListType.Reminder)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Value <span class="text-rose-500">*</span></label>
                            @if (IsNumericInputType(_allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId)?.InputTypeId))
                            {
                                <InputText class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Enter a number" />
                            }
                            else
                            {
                                <InputText class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Enter a value" />
                            }
                            <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">Logged as activity value when completed.</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Notes</label>
                            <InputTextArea class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                           @bind-Value="_itemForm.Notes"
                                           rows="2"
                                           placeholder="Optional notes" />
                        </div>
                    }
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Auto-log tag</label>
                        <select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                @bind="_itemForm.CompletionTagId">
                            <option value="">— None —</option>
                            @if (_allTags != null)
                            {
                                @foreach (var tag in _allTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </select>
                        @if (_itemForm.CompletionTagId.HasValue && _allTags != null)
                        {
                            var selectedItemTag = _allTags.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value);
                            @if (selectedItemTag != null && !selectedItemTag.IsRepeatable && _itemForm.AutoLogMode != AutoLogMode.Add)
                            {
                                <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">
                                    This tag is not repeatable — completing multiple items on the same day will replace the existing activity.
                                </p>
                            }
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Start date</label>
                            <input type="date"
                                   class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                   value="@(_itemForm.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                   @onchange="e => _itemForm.StartDate = ParseDateOnly(e.Value?.ToString())" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Due date</label>
                            <input type="date"
                                   class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                   value="@(_itemForm.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                   @onchange="e => _itemForm.DueDate = ParseDateOnly(e.Value?.ToString())" />
                        </div>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Remind me at</label>
                        <input type="time"
                               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                               value="@(_itemForm.NotifyAt?.ToString("HH:mm") ?? "")"
                               @onchange="e => _itemForm.NotifyAt = ParseTimeOnly(e.Value?.ToString())" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Recurrence</label>
                        <InputSelect @bind-Value="_itemForm.RecurrenceType" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
                            <option value="@RecurrenceType.None">None (one-time)</option>
                            <option value="@RecurrenceType.Daily">Daily</option>
                            <option value="@RecurrenceType.Weekly">Weekly</option>
                        </InputSelect>
                    </div>
                    @if (_itemForm.CompletionTagId.HasValue && _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value)?.IsRepeatable == false)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-slate-300">Auto-log mode</label>
                            <InputSelect @bind-Value="_itemForm.AutoLogMode" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
                                <option value="@AutoLogMode.Add">Add (accumulate)</option>
                                <option value="@AutoLogMode.ResetIfExists">Replace if exists</option>
                            </InputSelect>
                        </div>
                    }
                    @if (_itemForm.RecurrenceType != RecurrenceType.None && _itemForm.CompletionTagId.HasValue)
                    {
                        <div class="rounded-lg border border-gray-200 p-4 space-y-3 dark:border-slate-700">
                            <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wide">Activity monitoring window</p>
                            <div class="flex items-center gap-6">
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300 cursor-pointer">
                                    <input type="radio" class="text-primary-600" checked="@_monitorUseDaysBack"
                                           @onchange="() => { _monitorUseDaysBack = true; _itemForm.MonitorFromDate = null; _itemForm.MonitorToDate = null; }" />
                                    Last N days
                                </label>
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300 cursor-pointer">
                                    <input type="radio" class="text-primary-600" checked="@(!_monitorUseDaysBack)"
                                           @onchange="() => { _monitorUseDaysBack = false; _itemForm.MonitorDaysBack = null; _itemForm.MonitorFromDate = DateOnly.FromDateTime(DateTime.Today); }" />
                                    Date range
                                </label>
                            </div>
                            @if (_monitorUseDaysBack)
                            {
                                <div>
                                    <label class="mb-1 block text-xs text-gray-500 dark:text-slate-400">Days back from today (0 = today only)</label>
                                    <InputNumber @bind-Value="_itemForm.MonitorDaysBack"
                                                 class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                                 min="0" />
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="mb-1 block text-xs text-gray-500 dark:text-slate-400">From</label>
                                        <input type="date"
                                               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                               value="@(_itemForm.MonitorFromDate?.ToString("yyyy-MM-dd") ?? "")"
                                               @onchange="e => _itemForm.MonitorFromDate = ParseDateOnly(e.Value?.ToString())" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-xs text-gray-500 dark:text-slate-400">To</label>
                                        <input type="date"
                                               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                                               value="@(_itemForm.MonitorToDate?.ToString("yyyy-MM-dd") ?? "")"
                                               @onchange="e => _itemForm.MonitorToDate = ParseDateOnly(e.Value?.ToString())" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_itemModalError))
                {
                    <div class="mx-6 mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @_itemModalError
                    </div>
                }
                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                            @onclick="CloseItemModal" disabled="@_isBusy">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 disabled:opacity-60 focus:outline-hidden"
                            disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(_isEditingItem ? "Save changes" : "Add item")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ── Delete list confirmation ── *@
@if (_pendingDeleteList != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-sm rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete list</h3>
            </div>
            <div class="px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                Delete <strong>@_pendingDeleteList.Name</strong> and all its items? This cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                        @onclick="() => _pendingDeleteList = null" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-rose-700 disabled:opacity-60 focus:outline-hidden"
                        @onclick="DeleteListConfirmedAsync" disabled="@_isBusy">
                    @if (_isBusy)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IList<TodoListResponse>? _lists;
    private IList<TagResponse>? _allTags;
    private string? _loadError;
    private string? _listError;
    private string? _itemModalError;
    private bool _isBusy;

    // Per-list state
    private readonly HashSet<int> _showDonePerList = new();
    private readonly Dictionary<int, string?> _itemErrorPerList = new();

    private bool _notificationsNeedUpdate;

    // Drag state
    private TodoItemResponse? _draggingItem;
    private TodoItemResponse? _dragOverItem;
    private int _dragFromListId;
    private int _dragOverLastZoneListId;
    private int _copiedItemId;

    // List modal state
    private bool _showListModal;
    private bool _isEditingList;
    private int _editingListId;
    private TodoListRequest _listForm = new() { Name = string.Empty };

    // Item modal state
    private bool _showItemModal;
    private bool _isEditingItem;
    private int _editingItemId;
    private int _addItemToListId;
    private TodoListResponse? _currentListForItemModal;
    private bool _monitorUseDaysBack = true;
    private TodoItemRequest _itemForm = new() { Title = string.Empty };

    // Delete confirmation
    private TodoListResponse? _pendingDeleteList;

    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _refreshTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(async () =>
            {
                if (!_showItemModal && !_showListModal && !_isBusy && _pendingDeleteList == null)
                {
                    await LoadDataAsync();
                    StateHasChanged();
                }
            }),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RequestNotificationPermissionAsync();
        }

        if (_notificationsNeedUpdate)
        {
            _notificationsNeedUpdate = false;
            await ScheduleNotificationsAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var listsTask = TodoApi.GetTodoLists();
            var tagsTask = ActivityApi.GetTags();
            await Task.WhenAll(listsTask, tagsTask);
            _lists = listsTask.Result;
            _allTags = tagsTask.Result;
            _itemErrorPerList.Clear();
            _notificationsNeedUpdate = true;
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to load todo data");
            _loadError = "Could not load to-do lists. Please refresh the page.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unexpected error loading todo data");
            _loadError = "Could not load to-do lists. Please refresh the page.";
        }
    }

    private async Task RequestNotificationPermissionAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("todoNotifications.requestPermission");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Notification permission request failed");
        }
    }

    private async Task ScheduleNotificationsAsync()
    {
        if (_lists == null)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var items = _lists
            .SelectMany(l => l.Items)
            .Where(i => !i.IsDone && i.NotifyAt.HasValue && (i.StartDate == null || i.StartDate <= today))
            .Select(i => new
            {
                id = i.Id,
                title = i.Title,
                notifyAtMs = (long)i.NotifyAt!.Value.ToTimeSpan().TotalMilliseconds
            })
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("todoNotifications.scheduleNotifications", (object)items);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to schedule todo notifications");
        }
    }

    // ── List modal ──

    private void OpenAddListModal()
    {
        _isEditingList = false;
        _listForm = new TodoListRequest { Name = string.Empty };
        _listError = null;
        _showListModal = true;
    }

    private void OpenEditListModal(TodoListResponse list)
    {
        _isEditingList = true;
        _editingListId = list.Id;
        _listForm = new TodoListRequest
        {
            Name = list.Name,
            DisplayOrder = list.DisplayOrder,
            ListType = list.ListType
        };
        _listError = null;
        _showListModal = true;
    }

    private void CloseListModal()
    {
        _showListModal = false;
        _listError = null;
    }

    private async Task SaveListAsync()
    {
        _isBusy = true;
        _listError = null;
        try
        {
            if (_isEditingList)
            {
                await TodoApi.UpdateTodoList(_editingListId, _listForm);
            }
            else
            {
                await TodoApi.CreateTodoList(_listForm);
            }

            _showListModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo list");
            _listError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ConfirmDeleteList(TodoListResponse list)
    {
        _pendingDeleteList = list;
    }

    private async Task DeleteListConfirmedAsync()
    {
        if (_pendingDeleteList == null)
        {
            return;
        }

        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoList(_pendingDeleteList.Id);
            _pendingDeleteList = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo list");
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Item modal ──

    private void OpenAddItemModal(int listId)
    {
        _isEditingItem = false;
        _addItemToListId = listId;
        _currentListForItemModal = _lists?.FirstOrDefault(l => l.Id == listId);
        _monitorUseDaysBack = true;
        _itemForm = new TodoItemRequest { Title = string.Empty, ListId = listId, MonitorDaysBack = 0 };
        _itemModalError = null;
        _showItemModal = true;
    }

    private void OpenEditItemModal(TodoItemResponse item)
    {
        _isEditingItem = true;
        _editingItemId = item.Id;
        _currentListForItemModal = _lists?.FirstOrDefault(l => l.Id == item.ListId);
        _monitorUseDaysBack = item.MonitorFromDate == null;
        _itemForm = new TodoItemRequest
        {
            ListId = item.ListId,
            Title = item.Title,
            Notes = item.Notes,
            StartDate = item.StartDate,
            DueDate = item.DueDate,
            NotifyAt = item.NotifyAt,
            DisplayOrder = item.DisplayOrder,
            RecurrenceType = item.RecurrenceType,
            AutoLogMode = item.AutoLogMode,
            MonitorDaysBack = item.MonitorDaysBack,
            MonitorFromDate = item.MonitorFromDate,
            MonitorToDate = item.MonitorToDate,
            CompletionTagId = item.CompletionTagId
        };
        _itemModalError = null;
        _showItemModal = true;
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _itemModalError = null;
    }

    private async Task SaveItemAsync()
    {
        _isBusy = true;
        _itemModalError = null;
        try
        {
            if (_isEditingItem)
            {
                await TodoApi.UpdateTodoItem(_editingItemId, _itemForm);
            }
            else
            {
                await TodoApi.CreateTodoItem(_itemForm);
            }

            _showItemModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex) when (_isEditingItem && ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when saving", _editingItemId);
            _itemModalError = "This item no longer exists. Close and reload to refresh.";
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo item");
            _itemModalError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleShowDone(int listId)
    {
        if (!_showDonePerList.Remove(listId))
        {
            _showDonePerList.Add(listId);
        }
    }

    private async Task CompleteItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.CompleteItem(item.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
            await LoadDataAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when completing", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReopenItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.ReopenItem(item.Id);
            await LoadDataAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when reopening", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to reopen todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoItem(item.Id);
            await LoadDataAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when deleting", item.Id);
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to delete. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CopyItemTitleAsync(TodoItemResponse item)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", item.Title);
        _copiedItemId = item.Id;
        await Task.Delay(2000);
        _copiedItemId = 0;
        StateHasChanged();
    }

    private async Task OnDropItemAsync(TodoItemResponse target, int listId)
    {
        var dragging = _draggingItem;
        _draggingItem = null;
        _dragOverItem = null;
        _dragFromListId = 0;

        if (dragging == null || dragging.Id == target.Id)
        {
            return;
        }

        var list = _lists?.FirstOrDefault(l => l.Id == listId);

        if (list == null)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var ordered = list.Items
            .Where(i => !i.IsDone && (i.StartDate == null || i.StartDate <= today))
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.DueDate ?? DateOnly.MaxValue)
            .ThenBy(i => i.DateCreated)
            .ToList();

        var fromIndex = ordered.FindIndex(i => i.Id == dragging.Id);
        var toIndex = ordered.FindIndex(i => i.Id == target.Id);

        if (fromIndex < 0 || toIndex < 0)
        {
            return;
        }

        ordered.RemoveAt(fromIndex);
        ordered.Insert(toIndex, dragging);

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].DisplayOrder = i;
        }

        _isBusy = true;
        try
        {
            var request = ordered
                .Select((item, idx) => new TodoItemReorderRequest { Id = item.Id, DisplayOrder = idx })
                .ToList();

            await TodoApi.ReorderItems(list.Id, request);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder todo items in list {ListId}", list.Id);
            _itemErrorPerList[list.Id] = "Failed to save order. Please try again.";
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnDropLastAsync(int listId)
    {
        var dragging = _draggingItem;
        _draggingItem = null;
        _dragOverItem = null;
        _dragOverLastZoneListId = 0;
        _dragFromListId = 0;

        if (dragging == null)
        {
            return;
        }

        var list = _lists?.FirstOrDefault(l => l.Id == listId);

        if (list == null)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var ordered = list.Items
            .Where(i => !i.IsDone && (i.StartDate == null || i.StartDate <= today))
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.DueDate ?? DateOnly.MaxValue)
            .ThenBy(i => i.DateCreated)
            .ToList();

        var fromIndex = ordered.FindIndex(i => i.Id == dragging.Id);

        if (fromIndex < 0)
        {
            return;
        }

        ordered.RemoveAt(fromIndex);
        ordered.Add(dragging);

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].DisplayOrder = i;
        }

        _isBusy = true;
        try
        {
            var request = ordered
                .Select((item, idx) => new TodoItemReorderRequest { Id = item.Id, DisplayOrder = idx })
                .ToList();

            await TodoApi.ReorderItems(list.Id, request);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder todo items in list {ListId}", list.Id);
            _itemErrorPerList[list.Id] = "Failed to save order. Please try again.";
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Helpers ──

    private static DateOnly? ParseDateOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateOnly.TryParse(value, out var d) ? d : null;
    }

    private static TimeOnly? ParseTimeOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return TimeOnly.TryParse(value, out var t) ? t : null;
    }

    private static bool IsNumericInputType(int? inputTypeId) =>
        inputTypeId is 1 or 6 or 7 or 8 or 9 or 10 or 11;
}
