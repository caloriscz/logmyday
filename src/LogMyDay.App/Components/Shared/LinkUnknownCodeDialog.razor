@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums

<div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="HandleBackdropClick">
    <div class="w-full max-w-2xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
            <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Unknown Code Scanned</h2>
                <p class="text-sm text-gray-600 dark:text-slate-400">Link this code to a tag so future scans create activities automatically.</p>
            </div>
            <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="HandleCancel" disabled="@isBusy">
                <Icon Name="close" Class="h-5 w-5" />
            </button>
        </div>

        <div class="max-h-[70vh] overflow-y-auto px-6 py-5">
            <div class="mb-5 rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-800">
                <p class="text-sm font-medium text-gray-600 dark:text-slate-400">Scanned value</p>
                <p class="mt-1 break-all font-mono text-sm text-gray-900 dark:text-slate-100">@CodeValue</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                    @errorMessage
                </div>
            }

            <div class="space-y-5">
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Tag</label>
                    <GroupedTagSelect Tags="AvailableTags" @bind-Value="selectedTagId" SelectClass="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" Disabled="@isBusy" />
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Display Name</label>
                    <input type="text" @bind="displayName" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="e.g., Magnesium 400mg" disabled="@isBusy" />
                    <p class="text-xs text-gray-500 dark:text-slate-400">Optional friendly name for this code.</p>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Default Value</label>
                    <input type="text" @bind="defaultDescription" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="Pre-filled activity value" disabled="@isBusy" />
                    <p class="text-xs text-gray-500 dark:text-slate-400">Pre-filled as the activity description on future scans.</p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
            <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="HandleSkip" disabled="@isBusy">
                Skip
            </button>
            <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" @onclick="HandleSave" disabled="@(isBusy || !selectedTagId.HasValue)">
                @if (isBusy)
                {
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    <span>Saving…</span>
                }
                else
                {
                    <Icon Name="link" Class="h-4 w-4" />
                    <span>Link &amp; Create Activity</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string CodeValue { get; set; } = string.Empty;

    [Parameter]
    public CodeType CodeType { get; set; } = CodeType.QRCode;

    [Parameter]
    public IList<TagResponse>? AvailableTags { get; set; }

    /// <summary>
    /// Invoked when user creates a mapping and wants to proceed to activity creation.
    /// Provides the created mapping response so the parent can open AddActivityModal.
    /// </summary>
    [Parameter]
    public EventCallback<ScanMappingResponse> OnLinked { get; set; }

    /// <summary>
    /// Invoked when user cancels/skips without linking.
    /// </summary>
    [Parameter]
    public EventCallback OnCanceled { get; set; }

    @inject LogMyDay.Shared.Interfaces.IScanMappingApi ScanMappingApi

    private int? selectedTagId;
    private string? displayName;
    private string? defaultDescription;
    private string? errorMessage;
    private bool isBusy;

    private async Task HandleBackdropClick()
    {
        if (!isBusy)
        {
            await HandleCancel();
        }
    }

    private async Task HandleCancel()
    {
        await OnCanceled.InvokeAsync();
    }

    private async Task HandleSkip()
    {
        await OnCanceled.InvokeAsync();
    }

    private async Task HandleSave()
    {
        if (!selectedTagId.HasValue)
        {
            errorMessage = "Please select a tag.";

            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            var request = new ScanMappingRequest
            {
                CodeValue = CodeValue,
                CodeType = CodeType,
                TagId = selectedTagId.Value,
                DisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim(),
                DefaultDescription = string.IsNullOrWhiteSpace(defaultDescription) ? null : defaultDescription.Trim(),
                IsActive = true
            };

            var created = await ScanMappingApi.Create(request);
            await OnLinked.InvokeAsync(created);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            errorMessage = "A mapping for this code already exists.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save mapping: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
