@inject NavigationManager Navigation
@inject LogMyDay.Shared.Interfaces.IAuthApi AuthApi
@inject LogMyDay.Shared.Interfaces.IAiApi AiApi
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Refit
@using System.Net
@using System.Reflection
@using System.Security.Claims

<nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
    <div class="mx-auto max-w-screen-2xl layout-constrained px-4">
        <div class="flex items-center justify-between h-16">
            <!-- Logo/Brand -->
            <a href="" class="flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                <img src="images/favicon.png" alt="LogMyDay logo" class="h-8 w-8 rounded-md shadow-xs" loading="lazy" />
                <span>LogMyDay</span>
                <span class="text-xs opacity-60">v@(GetAppVersion())</span>
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center gap-1">
                <NavLink href="" Match="NavLinkMatch.All" 
                         class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                         ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                    <Icon Name="home" Class="w-4 h-4" />
                    <span>Home</span>
                </NavLink>
                <NavLink href="activities" 
                         class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                         ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                    <Icon Name="calendar" Class="w-4 h-4" />
                    <span>Activities</span>
                </NavLink>
                <NavLink href="todos"
                         class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                         ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                    <Icon Name="check-square" Class="w-4 h-4" />
                    <span>To-Do</span>
                </NavLink>
                
                <!-- Tags Dropdown -->
                <div class="relative" @onmouseenter="() => showTagsMenu = true" @onmouseleave="() => showTagsMenu = false">
                    <button type="button"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                            aria-label="Tags menu"
                            aria-expanded="@showTagsMenu">
                        <Icon Name="tag" Class="w-4 h-4" />
                        <span>Tags</span>
                        <Icon Name="chevron-down" Class="w-4 h-4" />
                    </button>
                    
                    @if (showTagsMenu)
                    {
                        <div class="absolute left-0 top-full pt-1 z-50">
                            <div class="w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 py-1 animate-fade-in">
                            <NavLink href="tags" @onclick="() => showTagsMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="tag" Class="w-4 h-4" />
                                <span>Tags</span>
                            </NavLink>
                            <NavLink href="option-lists" @onclick="() => showTagsMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="list" Class="w-4 h-4" />
                                <span>Option Lists</span>
                            </NavLink>
                            <NavLink href="units" @onclick="() => showTagsMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="chart" Class="w-4 h-4" />
                                <span>Units</span>
                            </NavLink>
                            <NavLink href="tag-groups" @onclick="() => showTagsMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="folder" Class="w-4 h-4" />
                                <span>Tag Groups</span>
                            </NavLink>
                            </div>
                        </div>
                    }
                </div>
                
                <NavLink href="insights" 
                         class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                         ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                    <Icon Name="sparkles" Class="w-4 h-4" />
                    <span>Insights</span>
                </NavLink>
                
                <!-- Scan Dropdown -->
                <div class="relative" @onmouseenter="() => showScanMenu = true" @onmouseleave="() => showScanMenu = false">
                    <button type="button"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                            aria-label="Scan menu"
                            aria-expanded="@showScanMenu">
                        <Icon Name="qr-code" Class="w-4 h-4" />
                        <span>Scan</span>
                        <Icon Name="chevron-down" Class="w-4 h-4" />
                    </button>
                    
                    @if (showScanMenu)
                    {
                        <div class="absolute left-0 top-full pt-1 z-50">
                            <div class="w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 py-1 animate-fade-in">
                            <NavLink href="scan" @onclick="() => showScanMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="camera" Class="w-4 h-4" />
                                <span>Scan Code</span>
                            </NavLink>
                            <NavLink href="scan-mappings" @onclick="() => showScanMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="link" Class="w-4 h-4" />
                                <span>Scan Mappings</span>
                            </NavLink>
                            <NavLink href="qr-generator" @onclick="() => showScanMenu = false"
                                     class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                <Icon Name="qr-code" Class="w-4 h-4" />
                                <span>QR Generator</span>
                            </NavLink>
