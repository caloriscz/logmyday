                    <NavLink href="scan" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                        <Icon Name="camera" Class="w-5 h-5" />
                        <span>Scan Code</span>
                    </NavLink>
                    <NavLink href="scan-mappings" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                        <Icon Name="link" Class="w-5 h-5" />
                        <span>Scan Mappings</span>
                    </NavLink>
                    <NavLink href="qr-generator" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                        <Icon Name="qr-code" Class="w-5 h-5" />
                        <span>QR Generator</span>
                    </NavLink>
                    
                    <!-- Data Section -->
                    <div class="px-3 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-2">
                        Data
                    </div>
                    <NavLink href="backup" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                        <Icon Name="database" Class="w-5 h-5" />
                        <span>Backup</span>
                    </NavLink>
                    <NavLink href="reports" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
                        <Icon Name="file-text" Class="w-5 h-5" />
                        <span>Reports</span>
                    </NavLink>
                    <NavLink href="event-logs" @onclick="() => showMobileMenu = false"
                             class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 pl-6"
                             ActiveClass="bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400">
