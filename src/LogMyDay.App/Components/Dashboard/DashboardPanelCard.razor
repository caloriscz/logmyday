@using LogMyDay.Domain.Constants

<div class="@GetCardClasses()">
    <div class="flex items-start justify-between gap-2">
        <h3 class="text-sm font-medium text-gray-500 dark:text-slate-400 truncate">
            @GetTitle()
        </h3>
        <div class="flex flex-shrink-0 items-center gap-1">
            @if (PanelConfig.TagId == null)
            {
                <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">
                    Removed
                </span>
            }
            <a class="rounded p-1 text-gray-400 transition hover:text-gray-600 dark:text-slate-500 dark:hover:text-slate-300" href="/dashboard/panel/@PanelConfig.Id" title="Edit panel">
                <Icon Name="pencil" Class="h-4 w-4" />
            </a>
        </div>
    </div>

    @if (PanelConfig.TagId == null)
    {
        <div class="mt-3">
            <p class="text-sm text-gray-400 dark:text-slate-500 italic">Tag was deleted</p>
        </div>
    }
    else if (PanelData == null || !PanelData.HasData)
    {
        <div class="mt-3">
            <p class="text-3xl font-bold text-gray-300 dark:text-slate-600">&mdash;</p>
            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">@GetNoDataLabel()</p>
        </div>
    }
    else if (PanelConfig.WidgetTypeId == WidgetTypeIds.MonthlyMinMax)
    {
        <div class="mt-3 flex gap-4">
            <div>
                <p class="text-xs font-medium text-gray-400 dark:text-slate-500">Min</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@PanelData.DisplayValue</p>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-400 dark:text-slate-500">Max</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">@PanelData.SecondaryDisplayValue</p>
            </div>
        </div>
        <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">@GetSubtitle()</p>
    }
    else
    {
        <div class="mt-3">
            <div class="flex items-baseline gap-1.5">
                <p class="text-3xl font-bold text-gray-900 dark:text-white">@PanelData.DisplayValue</p>
            </div>
            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">@GetSubtitle()</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardPanelResponse PanelConfig { get; set; } = default!;
    [Parameter] public PanelDataResponse? PanelData { get; set; }

    private string GetCardClasses()
    {
        var sizeClass = PanelConfig.SizeId == PanelSizeIds.Wide ? "sm:col-span-2" : "";

        return $"rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 {sizeClass}".Trim();
    }

    private string GetTitle()
    {
        if (!string.IsNullOrWhiteSpace(PanelConfig.Title))
        {
            return PanelConfig.Title;
        }

        return PanelConfig.TagName ?? "Untitled";
    }

    private string GetNoDataLabel() => PanelConfig.WidgetTypeId switch
    {
        WidgetTypeIds.LatestValue => "No data today",
        WidgetTypeIds.WeeklyAverage => "No data in the last 7 days",
        WidgetTypeIds.MonthlyMinMax => "No data in the last 30 days",
        _ => "No data"
    };

    private string GetSubtitle() => PanelConfig.WidgetTypeId switch
    {
        WidgetTypeIds.LatestValue => "Latest value today",
        WidgetTypeIds.WeeklyAverage => "Average last 7 days",
        WidgetTypeIds.MonthlyMinMax => "Min / Max last 30 days",
        _ => PanelConfig.WidgetTypeName ?? ""
    };
}
