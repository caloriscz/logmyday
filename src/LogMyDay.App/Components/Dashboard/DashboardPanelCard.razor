@using LogMyDay.Domain.Constants

<div class="@GetCardClasses()">
    <div class="flex items-start justify-between gap-2">
        <h3 class="text-sm font-medium text-gray-500 dark:text-slate-400 truncate">
            @GetTitle()
        </h3>
        @if (PanelConfig.TagId == null)
        {
            <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">
                Removed
            </span>
        }
    </div>

    @if (PanelConfig.TagId == null)
    {
        <div class="mt-3">
            <p class="text-sm text-gray-400 dark:text-slate-500 italic">Tag was deleted</p>
        </div>
    }
    else if (PanelData == null || !PanelData.HasData)
    {
        <div class="mt-3">
            <p class="text-3xl font-bold text-gray-300 dark:text-slate-600">&mdash;</p>
            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">No data today</p>
        </div>
    }
    else
    {
        <div class="mt-3">
            <div class="flex items-baseline gap-1.5">
                <p class="text-3xl font-bold text-gray-900 dark:text-white">@PanelData.DisplayValue</p>
            </div>
            <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">@GetSubtitle()</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardPanelResponse PanelConfig { get; set; } = default!;
    [Parameter] public PanelDataResponse? PanelData { get; set; }

    private string GetCardClasses()
    {
        var sizeClass = PanelConfig.SizeId == PanelSizeIds.Wide ? "sm:col-span-2" : "";

        return $"rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 {sizeClass}".Trim();
    }

    private string GetTitle()
    {
        if (!string.IsNullOrWhiteSpace(PanelConfig.Title))
        {
            return PanelConfig.Title;
        }

        return PanelConfig.TagName ?? "Untitled";
    }

    private string GetSubtitle()
    {
        var aggregation = PanelConfig.AggregationTypeId switch
        {
            AggregationTypeIds.LatestValue => "Latest",
            AggregationTypeIds.Average => "Average",
            AggregationTypeIds.Sum => "Sum",
            AggregationTypeIds.Min => "Min",
            AggregationTypeIds.Max => "Max",
            AggregationTypeIds.Count => "Count",
            _ => ""
        };

        var timeRange = PanelConfig.TimeRangeId switch
        {
            TimeRangeIds.Today => "today",
            TimeRangeIds.Last7Days => "last 7 days",
            TimeRangeIds.Last30Days => "last 30 days",
            TimeRangeIds.ThisMonth => "this month",
            TimeRangeIds.ThisYear => "this year",
            TimeRangeIds.AllTime => "all time",
            _ => ""
        };

        return $"{aggregation} {timeRange}".Trim();
    }
}
