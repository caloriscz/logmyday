@page "/statistics"
@using LogMyDay.Shared.Interfaces
@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@inject IActivityApi ActivityApi
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService
@inject IJSRuntime JS

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Statistics", "Analyze numeric tag statistics and streaks")]

<PageTitle>@_pageTitle</PageTitle>

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <div class="space-y-2">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Statistics</h2>
        <p class="text-sm text-gray-600 dark:text-slate-300">Analyze numeric tag data with comprehensive statistics.</p>
    </div>

    <!-- Tag Selection Card -->
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
            <div class="flex-1">
                <label for="tagSelect" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Select numeric tag</label>
                <select id="tagSelect" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedTagId" @bind:after="OnTagChanged">
                    <option value="">-- Select a tag --</option>
                    @foreach (var tag in numericTags)
                    {
                        var inputTypeName = tag.InputTypeId.HasValue && inputTypeNames.ContainsKey(tag.InputTypeId.Value) 
                            ? inputTypeNames[tag.InputTypeId.Value] 
                            : "Unknown";
                        <option value="@tag.Id">@tag.Title (@inputTypeName)</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary flex items-center gap-2 whitespace-nowrap" @onclick="LoadStatistics" disabled="@(!CanLoadData)">
                <Icon Name="chart-bar" Class="w-4 h-4" />
                Load Statistics
            </button>
        </div>
    </div>

    @if (dataLoaded && statistics != null)
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Min/Max/Average Card -->
            <div class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h5 class="text-sm font-medium text-gray-600 dark:text-slate-400">Value Statistics</h5>
                        <select style="width: 80px;" class="form-select rounded-md border-gray-300 text-xs py-1 px-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedYearForValues" @bind:after="OnYearChangedForValues">
                            <option value="">All</option>
                            @foreach (var year in availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <Icon Name="arrow-down" Class="w-4 h-4 text-gray-500 dark:text-slate-400" />
                                <span class="text-xs text-gray-600 dark:text-slate-400">Minimum</span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900 dark:text-slate-100">@FormatValue(statistics.MinimumValue)</p>
                            @if (statistics.MinimumValueDate.HasValue)
                            {
                                <small class="text-xs text-gray-500 dark:text-slate-400">@statistics.MinimumValueDate.Value.ToString("MMM d, yyyy")</small>
                            }
                        </div>

                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <Icon Name="arrow-up" Class="w-4 h-4 text-gray-500 dark:text-slate-400" />
                                <span class="text-xs text-gray-600 dark:text-slate-400">Maximum</span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900 dark:text-slate-100">@FormatValue(statistics.MaximumValue)</p>
                            @if (statistics.MaximumValueDate.HasValue)
                            {
                                <small class="text-xs text-gray-500 dark:text-slate-400">@statistics.MaximumValueDate.Value.ToString("MMM d, yyyy")</small>
                            }
                        </div>

                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <Icon Name="chart-bar" Class="w-4 h-4 text-gray-500 dark:text-slate-400" />
                                <span class="text-xs text-gray-600 dark:text-slate-400">Average</span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900 dark:text-slate-100">@FormatAverageValue(statistics.AverageValue)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Average by Month Card -->
            <div class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h5 class="text-sm font-medium text-gray-600 dark:text-slate-400">Average by Month</h5>
                        <select style="width: 80px;" class="form-select rounded-md border-gray-300 text-xs py-1 px-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedYearForMonths" @bind:after="OnYearChangedForMonths">
                            <option value="">All</option>
                            @foreach (var year in availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="space-y-2">
                        @if (statistics.AverageByMonth.Any())
                        {
                            @foreach (var monthAvg in statistics.AverageByMonth.OrderBy(kvp => kvp.Key))
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-600 dark:text-slate-400">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthAvg.Key)</span>
                                    <span class="font-semibold text-gray-900 dark:text-slate-100">@FormatAverageValue(monthAvg.Value)</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-xs text-gray-500 dark:text-slate-400">No data available</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Average by Day of Week Card -->
            <div class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <h5 class="text-sm font-medium text-gray-600 dark:text-slate-400">Average by Day</h5>
                        <select style="width: 80px;" class="form-select rounded-md border-gray-300 text-xs py-1 px-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedYearForDays" @bind:after="OnYearChangedForDays">
                            <option value="">All</option>
                            @foreach (var year in availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="space-y-2">
                        @foreach (var dayAvg in statistics.AverageByDayOfWeek.OrderBy(kvp => (int)kvp.Key))
                        {
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-gray-600 dark:text-slate-400">@dayAvg.Key.ToString()</span>
                                <span class="font-semibold text-gray-900 dark:text-slate-100">@FormatAverageValue(dayAvg.Value)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Value Streaks Section -->
        @if (statistics.ValueStreaks.Any())
        {
            <div class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="p-5">
                    <h5 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-slate-100">
                        <Icon Name="chart-bar" Class="w-6 h-6 me-2 text-orange-500" />
                        Last Streaks by Value
                    </h5>
                    <p class="mb-4 text-sm text-gray-600 dark:text-slate-400">
                        Most recent consecutive day streaks for each numeric value (values that repeated at least once).
                    </p>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                            <thead class="bg-gray-50 dark:bg-slate-800">
                                <tr>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">
                                        Value
                                    </th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">
                                        Streak Days
                                    </th>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">
                                        Date Range
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-700 dark:bg-slate-900">
                                @foreach (var streak in statistics.ValueStreaks.OrderBy(s => s.Value))
                                {
                                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-800">
                                        <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-gray-900 dark:text-slate-100">
                                            @FormatValue(streak.Value)
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900 dark:text-slate-100">
                                            <span class="inline-flex items-center rounded-full bg-orange-100 px-3 py-1 text-sm font-medium text-orange-800 dark:bg-orange-900 dark:text-orange-200">
                                                @streak.ConsecutiveDays day@(streak.ConsecutiveDays > 1 ? "s" : "")
                                            </span>
                                        </td>
                                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600 dark:text-slate-400">
                                            @streak.StartDate.ToString("MMM d, yyyy") - @streak.EndDate.ToString("MMM d, yyyy")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else if (!dataLoaded)
    {
        <div class="rounded-xl border border-blue-200 bg-blue-50 p-4 dark:border-blue-900 dark:bg-blue-950">
            <div class="flex items-start gap-3">
                <Icon Name="information-circle" Class="w-5 h-5 text-blue-600 dark:text-blue-400" />
                <p class="text-sm text-blue-800 dark:text-blue-200">
                    Select a numeric tag and click "Load Statistics" to view data analysis.
                </p>
            </div>
        </div>
    }
</div>

@code {
    private string _pageTitle = "Statistics";
    private List<TagResponse> numericTags = new();
    private Dictionary<int, string> inputTypeNames = new();
    private int? selectedTagId;
    private bool dataLoaded = false;
    private TagStatistics? statistics;
    private List<DailyValue> allNumericValues = new();
    private List<int> availableYears = new();
    private int? selectedYearForValues;
    private int? selectedYearForMonths;
    private int? selectedYearForDays;

    private bool CanLoadData => selectedTagId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Statistics");
        // Don't load data here - wait for OnAfterRenderAsync when HttpContext is available
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadNumericTags();
            await LoadPreferences();
            StateHasChanged();
        }
    }

    private async Task LoadNumericTags()
    {
        try
        {
            // Load all input types to get their names
            var inputTypes = await ActivityApi.GetInputTypesAsync();
            inputTypeNames = inputTypes.ToDictionary(it => it.Id, it => it.Name);
            
            // Find the IDs for numeric input types
            var integerTypeId = inputTypes.FirstOrDefault(it => it.Name == "Integer")?.Id;
            var decimalTypeId = inputTypes.FirstOrDefault(it => it.Name == "Decimal")?.Id;
            var decimalP2TypeId = inputTypes.FirstOrDefault(it => it.Name == "Decimal, precision 2")?.Id;
            var rating5TypeId = inputTypes.FirstOrDefault(it => it.Name == "Rating 1-5")?.Id;
            var rating10TypeId = inputTypes.FirstOrDefault(it => it.Name == "Rating 1-10")?.Id;
            
            // Load tags and filter by numeric input types
            var allTags = await ActivityApi.GetTags();
            numericTags = allTags
                .Where(t => t.InputTypeId.HasValue && 
                           (t.InputTypeId == integerTypeId || 
                            t.InputTypeId == decimalTypeId ||
                            t.InputTypeId == decimalP2TypeId ||
                            t.InputTypeId == rating5TypeId ||
                            t.InputTypeId == rating10TypeId))
                .OrderBy(t => t.Title)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tags: {ex.Message}");
        }
    }

    private async Task LoadPreferences()
    {
        try
        {
            var prefs = await UserPreferencesService.GetAsync();
            var savedTagIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "statistics_selectedTag");
            
            if (!string.IsNullOrEmpty(savedTagIdStr) && int.TryParse(savedTagIdStr, out var savedTagId) && 
                numericTags.Any(t => t.Id == savedTagId))
            {
                selectedTagId = savedTagId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading preferences: {ex.Message}");
        }
    }

    private async Task OnTagChanged()
    {
        try
        {
            if (selectedTagId.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "statistics_selectedTag", selectedTagId.Value.ToString());
            }
            dataLoaded = false;
            statistics = null;
            availableYears.Clear();
            selectedYearForValues = null;
            selectedYearForMonths = null;
            selectedYearForDays = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving tag preference: {ex.Message}");
        }
    }

    private async Task LoadStatistics()
    {
        if (!selectedTagId.HasValue)
            return;

        try
        {
            // Get all activities for the selected tag (using pagination)
            var result = await ActivityApi.GetActivities(
                pageNumber: 1,
                pageSize: 10000,
                orderBy: "desc",
                tagId: selectedTagId.Value
            );
            
            var activities = result.Items.ToList();
            
            if (!activities.Any())
            {
                statistics = null;
                dataLoaded = true;
                availableYears.Clear();
                return;
            }

            allNumericValues = activities
                .Where(a => !string.IsNullOrEmpty(a.Description) && decimal.TryParse(a.Description, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _))
                .Select(a => new DailyValue
                { 
                    Value = decimal.Parse(a.Description!, System.Globalization.CultureInfo.InvariantCulture),
                    Date = a.DateStarted,
                    DayOfWeek = a.DateStarted.DayOfWeek
                })
                .ToList();

            if (!allNumericValues.Any())
            {
                statistics = null;
                dataLoaded = true;
                availableYears.Clear();
                return;
            }

            availableYears = allNumericValues
                .Select(v => v.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();

            CalculateStatistics(allNumericValues);

            dataLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
    }

    private void CalculateStatistics(List<DailyValue> numericValues)
    {
        var minValue = numericValues.Min(v => v.Value);
        var maxValue = numericValues.Max(v => v.Value);

        statistics = new TagStatistics
        {
            MinimumValue = minValue,
            MaximumValue = maxValue,
            AverageValue = numericValues.Average(v => v.Value),
            MinimumValueDate = numericValues.FirstOrDefault(v => v.Value == minValue)?.Date,
            MaximumValueDate = numericValues.FirstOrDefault(v => v.Value == maxValue)?.Date,
            AverageByDayOfWeek = numericValues
                .GroupBy(v => v.DayOfWeek)
                .ToDictionary(
                    g => g.Key,
                    g => g.Average(v => v.Value)
                ),
            AverageByMonth = numericValues
                .GroupBy(v => v.Date.Month)
                .ToDictionary(
                    g => g.Key,
                    g => g.Average(v => v.Value)
                ),
            ValueStreaks = CalculateValueStreaks(numericValues)
        };
    }

    private void OnYearChangedForValues()
    {
        if (!dataLoaded || allNumericValues == null || !allNumericValues.Any())
            return;

        var filteredValues = selectedYearForValues.HasValue
            ? allNumericValues.Where(v => v.Date.Year == selectedYearForValues.Value).ToList()
            : allNumericValues;

        if (filteredValues.Any() && statistics != null)
        {
            var minValue = filteredValues.Min(v => v.Value);
            var maxValue = filteredValues.Max(v => v.Value);

            statistics.MinimumValue = minValue;
            statistics.MaximumValue = maxValue;
            statistics.AverageValue = filteredValues.Average(v => v.Value);
            statistics.MinimumValueDate = filteredValues.FirstOrDefault(v => v.Value == minValue)?.Date;
            statistics.MaximumValueDate = filteredValues.FirstOrDefault(v => v.Value == maxValue)?.Date;
        }
    }

    private void OnYearChangedForMonths()
    {
        if (!dataLoaded || allNumericValues == null || !allNumericValues.Any())
            return;

        var filteredValues = selectedYearForMonths.HasValue
            ? allNumericValues.Where(v => v.Date.Year == selectedYearForMonths.Value).ToList()
            : allNumericValues;

        if (filteredValues.Any() && statistics != null)
        {
            statistics.AverageByMonth = filteredValues
                .GroupBy(v => v.Date.Month)
                .ToDictionary(
                    g => g.Key,
                    g => g.Average(v => v.Value)
                );
        }
    }

    private void OnYearChangedForDays()
    {
        if (!dataLoaded || allNumericValues == null || !allNumericValues.Any())
            return;

        var filteredValues = selectedYearForDays.HasValue
            ? allNumericValues.Where(v => v.Date.Year == selectedYearForDays.Value).ToList()
            : allNumericValues;

        if (filteredValues.Any() && statistics != null)
        {
            statistics.AverageByDayOfWeek = filteredValues
                .GroupBy(v => v.DayOfWeek)
                .ToDictionary(
                    g => g.Key,
                    g => g.Average(v => v.Value)
                );
        }
    }

    private string FormatValue(decimal value)
    {
        if (selectedTagId.HasValue)
        {
            var selectedTag = numericTags.FirstOrDefault(t => t.Id == selectedTagId.Value);
            if (selectedTag?.InputTypeId.HasValue == true && 
                inputTypeNames.ContainsKey(selectedTag.InputTypeId.Value) &&
                inputTypeNames[selectedTag.InputTypeId.Value] is "Decimal" or "Decimal, precision 2")
            {
                return value.ToString("F2");
            }
        }
        return value.ToString("F0");
    }

    private string FormatAverageValue(decimal value)
    {
        return value.ToString("F2");
    }

    private List<ValueStreak> CalculateValueStreaks(List<DailyValue> numericValues)
    {
        // Group by date and get the most common value for each day (in case multiple activities per day)
        var dailyValues = numericValues
            .GroupBy(v => v.Date.Date)
            .Select(g => 
            {
                var mostCommon = g.GroupBy(x => x.Value)
                    .OrderByDescending(x => x.Count())
                    .First();
                return new { Date = g.Key, Value = mostCommon.Key };
            })
            .OrderBy(v => v.Date)
            .ToList();

        if (!dailyValues.Any())
            return new List<ValueStreak>();

        // Find all streaks for each unique value
        var streaksByValue = new Dictionary<decimal, List<ValueStreak>>();

        for (int i = 0; i < dailyValues.Count; i++)
        {
            var currentValue = dailyValues[i].Value;
            var startDate = dailyValues[i].Date;
            var endDate = startDate;
            int consecutiveDays = 1;

            // Look ahead to find consecutive days with the same value
            int j = i + 1;
            while (j < dailyValues.Count)
            {
                var nextDate = dailyValues[j].Date;
                var nextValue = dailyValues[j].Value;

                // Check if next day is consecutive and has the same value
                if (nextValue == currentValue && (nextDate - endDate).TotalDays == 1)
                {
                    endDate = nextDate;
                    consecutiveDays++;
                    j++;
                }
                else
                {
                    break;
                }
            }

            // Only track values that repeated at least once (streak >= 2)
            if (consecutiveDays >= 2)
            {
                if (!streaksByValue.ContainsKey(currentValue))
                {
                    streaksByValue[currentValue] = new List<ValueStreak>();
                }

                streaksByValue[currentValue].Add(new ValueStreak
                {
                    Value = currentValue,
                    StartDate = startDate,
                    EndDate = endDate,
                    ConsecutiveDays = consecutiveDays
                });
            }

            // Skip ahead to avoid re-processing the same streak
            i = j - 1;
        }

        // Get the longest streak for each value (if tied, pick most recent)
        var longestStreaks = streaksByValue
            .Select(kvp => kvp.Value
                .OrderByDescending(s => s.ConsecutiveDays)
                .ThenByDescending(s => s.EndDate)
                .First())
            .ToList();

        return longestStreaks;
    }

    private class TagStatistics
    {
        public decimal MinimumValue { get; set; }
        public decimal MaximumValue { get; set; }
        public decimal AverageValue { get; set; }
        public DateTime? MinimumValueDate { get; set; }
        public DateTime? MaximumValueDate { get; set; }
        public Dictionary<DayOfWeek, decimal> AverageByDayOfWeek { get; set; } = new();
        public Dictionary<int, decimal> AverageByMonth { get; set; } = new();
        public List<ValueStreak> ValueStreaks { get; set; } = new();
    }

    private class ValueStreak
    {
        public decimal Value { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public int ConsecutiveDays { get; set; }
    }

    private class DailyValue
    {
        public decimal Value { get; set; }
        public DateTime Date { get; set; }
        public DayOfWeek DayOfWeek { get; set; }
    }
}
