@page "/scan-mappings"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.App.Services
@using Refit
@inject LogMyDay.Shared.Interfaces.IScanMappingApi ScanMappingApi
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject ILogger<ScanMappings> Logger
@inject IPageTitleService PageTitleService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("ScanMappings", "Manage barcode and QR code scan mappings to tags")]

<div class="mx-auto max-w-screen-2xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Scan Mappings</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Link barcodes and QR codes to tags for quick activity logging.</p>
        </div>
        <button type="button" class="inline-flex items-center gap-2 self-start rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:self-auto" @onclick="OpenCreateModal" disabled="@isBusy">
            <Icon Name="plus" Class="h-4 w-4" />
            Add Mapping
        </button>
    </div>

    <section class="space-y-4">
        @if (isLoading)
        {
            <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
                <span>Loading mappings…</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                @loadError
            </div>
        }
        else if (mappings.Count == 0)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                No scan mappings yet. Scan a barcode on the <a href="/scan" class="text-primary-600 hover:underline dark:text-primary-400">Scan page</a> or add one manually.
            </div>
        }
        else
        {
            <!-- Desktop Table -->
            <div class="hidden md:block">
                <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                        <thead class="bg-gray-50 dark:bg-slate-800">
                            <tr>
                                <th scope="col" class="w-24 px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300"></th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Display Name</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Code Value</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Type</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Tag</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Default Value</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-300">Active</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                            @foreach (var mapping in mappings)
                            {
                                <tr class="transition-colors hover:bg-gray-50 focus-within:bg-gray-50 dark:even:bg-slate-800/30 dark:hover:bg-slate-800/60 dark:focus-within:bg-slate-800/60">
                                    <td class="px-4 py-3">
                                        <div class="flex">
                                            <button type="button" class="inline-flex items-center rounded-md px-2 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEditModal(mapping)" disabled="@isBusy">
                                                <Icon Name="pencil" Class="h-4 w-4" />
                                            </button>
                                            <button type="button" class="inline-flex items-center rounded-md px-2 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(mapping)" disabled="@isBusy">
                                                <Icon Name="trash" Class="h-4 w-4" />
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-slate-100">@(mapping.DisplayName ?? "—")</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">
                                        <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono dark:bg-slate-800">@TruncateCode(mapping.CodeValue)</code>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @(mapping.CodeType == CodeType.QRCode ? "bg-violet-100 text-violet-800 dark:bg-violet-600/20 dark:text-violet-300" : "bg-amber-100 text-amber-800 dark:bg-amber-600/20 dark:text-amber-300")">
                                            @mapping.CodeType
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(mapping.TagName ?? $"Tag #{mapping.TagId}")</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@(mapping.DefaultDescription ?? "—")</td>
                                    <td class="px-4 py-3 text-sm">
                                        @if (mapping.IsActive)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-600/20 dark:text-emerald-300">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600 dark:bg-slate-700 dark:text-slate-400">No</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mobile Cards -->
            <div class="space-y-3 md:hidden">
                @foreach (var mapping in mappings)
                {
                    <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@(mapping.DisplayName ?? mapping.TagName ?? "Mapping")</h3>
                                <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
                                    <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono dark:bg-slate-800">@TruncateCode(mapping.CodeValue)</code>
                                </p>
                            </div>
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @(mapping.IsActive ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-600/20 dark:text-emerald-300" : "bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-400")">
                                @(mapping.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Tag</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@(mapping.TagName ?? $"#{mapping.TagId}")</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Type</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@mapping.CodeType</dd>
                            </div>
                            @if (!string.IsNullOrEmpty(mapping.DefaultDescription))
                            {
                                <div class="col-span-2">
                                    <dt class="font-medium text-gray-600 dark:text-slate-400">Default Value</dt>
                                    <dd class="text-gray-900 dark:text-slate-200">@mapping.DefaultDescription</dd>
                                </div>
                            }
                        </dl>

                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEditModal(mapping)" disabled="@isBusy">
                                <Icon Name="pencil" Class="h-4 w-4" />
                                <span>Edit</span>
                            </button>
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(mapping)" disabled="@isBusy">
                                <Icon Name="trash" Class="h-4 w-4" />
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                Total mappings: @mappings.Count
            </div>
        }
    </section>
</div>

@* Create/Edit Modal *@
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isBusy) CloseModal(); }">
        <div class="w-full max-w-2xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(isEditing ? "Edit Mapping" : "Add Mapping")</h2>
                    <p class="text-sm text-gray-600 dark:text-slate-400">Link a barcode or QR code to a tag.</p>
                </div>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                    <Icon Name="close" Class="h-5 w-5" />
                </button>
            </div>

            <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="mx-6 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @formError
                    </div>
                }

                <div class="max-h-[70vh] overflow-y-auto px-6 py-5">
                    <div class="space-y-5">
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Code Value</label>
                            <InputText @bind-Value="formModel.CodeValue" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="Barcode or QR code string" disabled="@isBusy" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">The raw value from the barcode or QR code.</p>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Code Type</label>
                                <InputSelect @bind-Value="formModel.CodeType" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy">
                                    <option value="@CodeType.Barcode">Barcode</option>
                                    <option value="@CodeType.QRCode">QR Code</option>
                                </InputSelect>
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Tag</label>
                                <InputSelect @bind-Value="formModel.TagId" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy">
                                    <option value="0">-- Select Tag --</option>
                                    @foreach (var tag in tags)
                                    {
                                        <option value="@tag.Id">@tag.Title</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Display Name</label>
                            <InputText @bind-Value="formModel.DisplayName" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="e.g., Magnesium 400mg" disabled="@isBusy" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">Optional human-readable name for this code.</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Default Description</label>
                            <InputText @bind-Value="formModel.DefaultDescription" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="Pre-filled activity value" disabled="@isBusy" />
                            <p class="text-xs text-gray-500 dark:text-slate-400">Pre-filled as the activity description when this code is scanned.</p>
                        </div>

                        <div class="flex items-center gap-3">
                            <InputCheckbox @bind-Value="formModel.IsActive" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" disabled="@isBusy" />
                            <label class="text-sm text-gray-700 dark:text-slate-200">Active</label>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(isEditing ? "Save Changes" : "Create Mapping")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (pendingDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete mapping</h3>
            </div>
            <div class="px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                Delete mapping <strong>@(pendingDelete.DisplayName ?? pendingDelete.CodeValue)</strong>? This cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="CancelDelete" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500" @onclick="DeleteMapping" disabled="@isBusy">
                    @if (isBusy)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                        <span>Deleting…</span>
                    }
                    else
                    {
                        <Icon Name="trash" Class="h-4 w-4" />
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<ScanMappingResponse> mappings = new();
    private readonly List<TagResponse> tags = new();
    private ScanMappingRequest formModel = new() { CodeValue = string.Empty };

    private string? loadError;
    private string? formError;
    private bool isLoading;
    private bool isBusy;
    private bool isEditing;
    private int? editingId;
    private bool showModal;
    private ScanMappingResponse? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Scan Mappings");
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var tagResults = await ActivityApi.GetTags();
            tags.Clear();
            tags.AddRange(tagResults.OrderBy(t => t.Title));

            var mappingResults = await ScanMappingApi.GetAll();
            mappings.Clear();
            mappings.AddRange(mappingResults.OrderBy(m => m.DisplayName ?? m.CodeValue));
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view scan mappings.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load scan mappings: {ex.Message}";
            Logger.LogError(ex, "Failed to load scan mappings");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        if (isBusy) return;

        isEditing = false;
        editingId = null;
        formModel = new ScanMappingRequest { CodeValue = string.Empty, IsActive = true };
        formError = null;
        showModal = true;
    }

    public void OpenCreateModalWithCode(string codeValue, CodeType codeType)
    {
        if (isBusy) return;

        isEditing = false;
        editingId = null;
        formModel = new ScanMappingRequest { CodeValue = codeValue, CodeType = codeType, IsActive = true };
        formError = null;
        showModal = true;
    }

    private void OpenEditModal(ScanMappingResponse mapping)
    {
        if (isBusy) return;

        isEditing = true;
        editingId = mapping.Id;
        formModel = new ScanMappingRequest
        {
            CodeValue = mapping.CodeValue,
            CodeType = mapping.CodeType,
            TagId = mapping.TagId,
            DisplayName = mapping.DisplayName,
            DefaultDescription = mapping.DefaultDescription,
            IsActive = mapping.IsActive
        };
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
    }

    private async Task HandleSubmit()
    {
        if (formModel.TagId == 0)
        {
            formError = "Please select a tag.";

            return;
        }

        isBusy = true;
        formError = null;

        try
        {
            if (isEditing && editingId.HasValue)
            {
                await ScanMappingApi.Update(editingId.Value, formModel);
            }
            else
            {
                await ScanMappingApi.Create(formModel);
            }

            CloseModal();
            await LoadDataAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            formError = "A mapping with this code value already exists.";
        }
        catch (Exception ex)
        {
            formError = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Failed to save scan mapping");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ConfirmDelete(ScanMappingResponse mapping)
    {
        if (isBusy) return;

        pendingDelete = mapping;
    }

    private void CancelDelete()
    {
        pendingDelete = null;
    }

    private async Task DeleteMapping()
    {
        if (pendingDelete == null) return;

        var deleteId = pendingDelete.Id;
        isBusy = true;

        try
        {
            await ScanMappingApi.Delete(deleteId);
            pendingDelete = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete scan mapping {Id}", deleteId);
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string TruncateCode(string code) =>
        code.Length > 30 ? string.Concat(code.AsSpan(0, 27), "…") : code;
}
