@page "/"
@using LogMyDay.Domain.Constants
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Dashboard
@inject LogMyDay.Shared.Interfaces.IDashboardApi DashboardApi
@inject IPageTitleService PageTitleService
@inject NavigationManager Navigation

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Dashboard", "View dashboard panels and today's reminders")]

<div class="mx-auto max-w-screen-2xl space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Dashboard</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Your daily overview at a glance.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/dashboard/manage" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900">
                <Icon Name="cog" Class="mr-1.5 h-4 w-4" />
                Manage
            </a>
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="RefreshAll" disabled="@isRefreshing">
                @if (isRefreshing)
                {
                    <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-gray-400 border-t-transparent"></span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    <!-- Reminders Section -->
    <div>
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Reminders</h2>
            <a href="/reminders" class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
                View all →
            </a>
        </div>
        <RemindersSection @ref="remindersRef" SelectedDate="DateTime.Today" OnDataChanged="OnRemindersDataChanged" />
    </div>

    <!-- Dashboard Panels -->
    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center gap-3 rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <span class="h-10 w-10 animate-spin rounded-full border-4 border-primary-200 border-t-primary-600"></span>
            <p class="text-sm text-gray-600 dark:text-slate-300">Loading dashboard…</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }
    else if (activePanels.Count == 0)
    {
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <Icon Name="chart-bar" Class="mx-auto h-12 w-12 text-gray-300 dark:text-slate-600" />
            <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-slate-100">No panels configured</h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Add panels to see your data at a glance.</p>
            <a href="/dashboard/manage" class="mt-4 inline-flex items-center gap-1 rounded-lg border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:border-primary-400 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus:ring-offset-slate-900">
                <Icon Name="plus" Class="h-4 w-4" />
                Add Panels
            </a>
        </div>
    }
    else
    {
        <div>
            <h2 class="mb-3 text-lg font-semibold text-gray-900 dark:text-slate-100">Panels</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
                @foreach (var panel in activePanels)
                {
                    <DashboardPanelCard PanelConfig="panel" PanelData="GetPanelData(panel.Id)" />
                }
            </div>
        </div>
    }
</div>

@code {
    private RemindersSection? remindersRef;
    private DashboardResponse? dashboard;
    private DashboardDataResponse? dashboardData;
    private List<DashboardPanelResponse> activePanels = new();
    private bool isLoading = true;
    private bool isRefreshing;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("Dashboard");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDashboard();
            StateHasChanged();
        }
    }

    private async Task LoadDashboard()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            dashboard = await DashboardApi.GetOrCreateDefault();
            activePanels = dashboard.Panels
                .Where(p => p.IsActive)
                .OrderBy(p => p.DisplayOrder)
                .ToList();

            if (activePanels.Count > 0)
            {
                dashboardData = await DashboardApi.GetDashboardData(dashboard.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshAll()
    {
        isRefreshing = true;
        StateHasChanged();

        try
        {
            if (remindersRef != null)
            {
                await remindersRef.RefreshAsync();
            }

            if (dashboard != null)
            {
                dashboardData = await DashboardApi.GetDashboardData(dashboard.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error refreshing: {ex.Message}";
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task OnRemindersDataChanged()
    {
        if (dashboard != null && activePanels.Count > 0)
        {
            try
            {
                dashboardData = await DashboardApi.GetDashboardData(dashboard.Id);
                StateHasChanged();
            }
            catch
            {
                // Silently ignore — panel data refresh is best-effort after reminder action
            }
        }
    }

    private PanelDataResponse? GetPanelData(int panelId)
        => dashboardData?.Panels.FirstOrDefault(p => p.PanelId == panelId);
}
