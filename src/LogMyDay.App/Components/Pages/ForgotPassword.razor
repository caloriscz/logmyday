@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Refit
@using LogMyDay.App.Services
@inject IAccountApi AccountApi
@inject ILogger<ForgotPassword> Logger
@inject IPageTitleService PageTitleService

<div class="relative flex min-h-screen items-center justify-center bg-linear-to-br from-slate-50 via-white to-slate-100 px-4 py-12 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 sm:px-6 lg:px-8">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/70 bg-white/90 p-8 shadow-2xl shadow-slate-900/10 backdrop-blur-sm dark:border-slate-800/70 dark:bg-slate-900/85 dark:shadow-slate-900/50">
        <div class="mb-6 text-center">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600/10 text-primary-600 dark:text-primary-400">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                    <path d="M20 21a8 8 0 1 0-16 0" stroke-linecap="round" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Forgot password</h1>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                Enter the email associated with your account and we will send a link to reset your password.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-100" role="alert">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 shadow-xs dark:border-emerald-500/40 dark:bg-emerald-500/20 dark:text-emerald-100" role="alert">
                @successMessage
            </div>
        }

        <EditForm Model="request" OnValidSubmit="SendRequestAsync" class="space-y-5">
            <DataAnnotationsValidator />

            <label class="block">
                <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Email address</span>
                <InputText id="email" type="email" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-xs outline-hidden transition focus:border-primary-400 focus:ring-2 focus:ring-primary-400 dark:border-slate-700 dark:bg-slate-950/80 dark:text-slate-100" @bind-Value="request.Email" placeholder="you@example.com" />
                <ValidationMessage For="() => request.Email" class="mt-2 block text-sm text-rose-600 dark:text-rose-400" />
            </label>

            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary-600 py-2.5 text-sm font-semibold text-white shadow-xs transition hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 dark:focus-visible:ring-offset-slate-900" disabled="@isSending">
                @if (isSending)
                {
                    <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" role="presentation">
                        <circle cx="12" cy="12" r="9" class="opacity-25" />
                        <path d="M21 12a9 9 0 0 1-9 9" stroke-linecap="round" class="opacity-75" />
                    </svg>
                    <span>Sending reset link...</span>
                }
                else
                {
                    <span>Send reset link</span>
                }
            </button>
        </EditForm>

        <div class="mt-6 text-center">
            <a href="/login" class="text-sm font-medium text-primary-600 transition hover:text-primary-700 hover:underline dark:text-primary-400 dark:hover:text-primary-300">Back to login</a>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel request = new();
    private bool isSending;
    private string? errorMessage;
    private string? successMessage;

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("Forgot Password");
    }

    private async Task SendRequestAsync()
    {
        if (isSending)
        {
            return;
        }

        try
        {
            isSending = true;
            errorMessage = null;
            successMessage = null;

            Logger.LogInformation("ForgotPassword.SendRequestAsync: Requesting password reset link");

            var email = request.Email?.Trim();
            request.Email = email;

            var response = await AccountApi.ForgotPasswordAsync(new ForgotDto(email!));
            successMessage = response.Message ?? "If an account exists for the provided email, a password reset link has been sent.";
        }
        catch (ApiException apiEx)
        {
            Logger.LogError(apiEx, "ForgotPassword.SendRequestAsync: API error while requesting password reset link");
            errorMessage = !string.IsNullOrWhiteSpace(apiEx.Content) ? apiEx.Content : apiEx.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ForgotPassword.SendRequestAsync: Unexpected error while requesting password reset link");
            errorMessage = "An unexpected error occurred while requesting the password reset. Please try again.";
        }
        finally
        {
            isSending = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string? Email { get; set; }
    }
}
