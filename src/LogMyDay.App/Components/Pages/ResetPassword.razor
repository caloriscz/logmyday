@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Refit
@using LogMyDay.App.Services
@inject IAccountApi AccountApi
@inject ILogger<ResetPassword> Logger
@inject IPageTitleService PageTitleService

<div class="relative flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-50 via-white to-slate-100 px-4 py-12 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 sm:px-6 lg:px-8">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/70 bg-white/90 p-8 shadow-2xl shadow-slate-900/10 backdrop-blur dark:border-slate-800/70 dark:bg-slate-900/85 dark:shadow-slate-900/50">
        <div class="mb-6 text-center">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600/10 text-primary-600 dark:text-primary-400">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                    <path d="M7 17v2a3 3 0 0 0 6 0v-2" stroke-linecap="round" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Reset password</h1>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                Choose a new password for your account. Passwords must be at least 10 characters long.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(tokenError))
        {
            <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-100" role="alert">
                <p class="font-medium">@tokenError</p>
                @if (string.IsNullOrWhiteSpace(TokenQuery))
                {
                    <p class="mt-1 text-xs text-rose-600 dark:text-rose-200">No token was found in the link. Please open the reset link directly from your email.</p>
                }
                else
                {
                    <p class="mt-1 text-xs text-rose-600 dark:text-rose-200">Token received but invalid: @TokenQuery</p>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-100" role="alert">
                @errorMessage
            </div>
        }

        @if (isSuccess)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm text-emerald-700 shadow-sm dark:border-emerald-500/40 dark:bg-emerald-500/20 dark:text-emerald-100" role="alert">
                Your password has been reset successfully. You can now <a href="/login" class="font-semibold underline">log in</a> with your new password.
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="ResetPasswordAsync" class="space-y-5">
                <DataAnnotationsValidator />

                <label class="block">
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">New password</span>
                    <InputText id="password" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-400 dark:border-slate-700 dark:bg-slate-950/80 dark:text-slate-100" type="password" @bind-Value="model.Password" placeholder="At least 10 characters" />
                    <ValidationMessage For="() => model.Password" class="mt-2 block text-sm text-rose-600 dark:text-rose-400" />
                </label>

                <label class="block">
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Confirm new password</span>
                    <InputText id="confirmPassword" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-400 dark:border-slate-700 dark:bg-slate-950/80 dark:text-slate-100" type="password" @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" class="mt-2 block text-sm text-rose-600 dark:text-rose-400" />
                </label>

                <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary-600 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 dark:focus-visible:ring-offset-slate-900" disabled="@(isSubmitting || string.IsNullOrWhiteSpace(token))">
                    @if (isSubmitting)
                    {
                        <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" role="presentation">
                            <circle cx="12" cy="12" r="9" class="opacity-25" />
                            <path d="M21 12a9 9 0 0 1-9 9" stroke-linecap="round" class="opacity-75" />
                        </svg>
                        <span>Updating password...</span>
                    }
                    else
                    {
                        <span>Update password</span>
                    }
                </button>
            </EditForm>
        }

        <div class="mt-6 text-center">
            <a href="/login" class="text-sm font-medium text-primary-600 transition hover:text-primary-700 hover:underline dark:text-primary-400 dark:hover:text-primary-300">Back to login</a>
        </div>
    </div>
</div>

@code {
    private readonly ResetPasswordModel model = new();
    private bool isSubmitting;
    private bool isSuccess;
    private string? errorMessage;
    private string? tokenError;

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenQuery { get; set; }

    private string? token;

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("Reset Password");
    }

    protected override void OnParametersSet()
    {
        token = TokenQuery?.Trim();
        Logger.LogInformation("ResetPassword.OnParametersSet: TokenQuery='{TokenQuery}', ProcessedToken='{Token}'", TokenQuery ?? "null", token ?? "null");
        
        if (string.IsNullOrWhiteSpace(token))
        {
            tokenError = "The password reset link is invalid or missing the reset token.";
            Logger.LogWarning("ResetPassword.OnParametersSet: Token is null or empty");
        }
    }

    private async Task ResetPasswordAsync()
    {
        Logger.LogInformation("ResetPassword.ResetPasswordAsync: Starting password reset, isSubmitting={IsSubmitting}, token='{Token}'", isSubmitting, token ?? "null");
        
        if (isSubmitting)
        {
            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Already submitting, returning");

            return;
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            tokenError = "The password reset link is invalid or has expired.";
            Logger.LogWarning("ResetPassword.ResetPasswordAsync: Token is null or empty");

            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;

            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Resetting password using provided reset token");

            await AccountApi.ConfirmForgotPasswordAsync(new ForgotConfirmDto(token, model.Password!));

            isSuccess = true;
            Logger.LogInformation("ResetPassword.ResetPasswordAsync: Password reset successful");
        }
        catch (ApiException apiEx)
        {
            Logger.LogError(apiEx, "ResetPassword.ResetPasswordAsync: API error during password reset using provided token");
            errorMessage = !string.IsNullOrWhiteSpace(apiEx.Content) ? apiEx.Content : apiEx.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ResetPassword.ResetPasswordAsync: Unexpected error during password reset using provided token");
            errorMessage = "An unexpected error occurred while resetting the password. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "A new password is required.")]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters long.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string? ConfirmPassword { get; set; }
    }
}
