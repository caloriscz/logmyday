        }
    }

    private async Task PrevPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber > 1)
                {
                    weekPageNumber--;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber > 1)
                {
                    monthPageNumber--;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber > 1)
                {
                    pageNumber--;
                    await LoadData();
                }
                break;
        }
    }

    private async Task NextPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber < totalPages)
                {
                    weekPageNumber++;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber < totalPages)
                {
                    monthPageNumber++;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber < totalPages)
                {
                    pageNumber++;
                    await LoadData();
                }
                break;
        }
    }

