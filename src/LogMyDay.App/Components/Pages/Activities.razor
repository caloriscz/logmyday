    private string GetCurrentPeriodDisplay()
    {
        var culture = displayCulture ?? CultureInfo.CurrentCulture;
        var longPattern = effectivePreferences?.LongDatePattern ?? culture.DateTimeFormat.LongDatePattern;
        var shortPattern = effectivePreferences?.ShortDatePattern ?? culture.DateTimeFormat.ShortDatePattern;

        var weekStart = GetStartOfWeek(selectedDate);
        var weekEnd = weekStart.AddDays(6);

        return displayType switch
        {
            "daily" => selectedDate.ToString(longPattern, culture),
            "weekly" => string.Format(culture, "{0} – {1}", FormatDate(weekStart), FormatDate(weekEnd)),
            "monthly" => selectedDate.ToString("Y", culture),
            _ => selectedDate.ToString(longPattern, culture)
        };
    }

