@page "/calendar"
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Preferences
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Shared
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService
@inject IJSRuntime JSRuntime

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Calendar", "View activities in calendar format")]

<div class="mx-auto max-w-screen-2xl space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
        <div class="space-y-2">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Calendar</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Review how often a tag appears across each month and year.</p>
        </div>
    </div>

    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="w-full max-w-sm space-y-2">
            <label for="tagPicker" class="text-sm font-medium text-gray-700 dark:text-slate-200">Select Tag</label>
            <select id="tagPicker" class="@InputCss" value="@(selectedTagId?.ToString() ?? string.Empty)" @onchange="OnTagChangedHandler">
                <option value="">Select a tag...</option>
                @if (tags != null)
                {
                    foreach (var tag in tags.OrderBy(t => t.Title))
                    {
                        <option value="@tag.Id">@tag.Title</option>
                    }
                }
            </select>
        </div>

        <div class="flex flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:justify-end">
            <div class="inline-flex items-center gap-1 rounded-full bg-gray-100 p-0.5 dark:bg-slate-800">
                <button type="button" class="@GetOrderButtonClass(OrderDescending)" @onclick="@(() => ChangeOrder(OrderDescending))">Newest First</button>
                <button type="button" class="@GetOrderButtonClass(OrderAscending)" @onclick="@(() => ChangeOrder(OrderAscending))">Oldest First</button>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 sm:justify-end">
                <button type="button" class="@NavButtonCss" @onclick="PrevYear" disabled="@(currentYear <= DateTime.Now.Year - 10)">Older</button>
                <div class="flex flex-col items-center gap-0.5">
                    <div class="text-sm text-gray-600 dark:text-slate-300">
                        <span class="font-semibold text-gray-900 dark:text-slate-100">@currentYear</span>
                        <span class="ml-2">(@availableYears.Count year@(availableYears.Count == 1 ? "" : "s") available)</span>
                    </div>
                    @if (selectedTagId.HasValue && activitiesByDate != null)
                    {
                        @if (activitiesByDate.Count > 0)
                        {
                            var entryCount = activitiesByDate.Values.Sum(v => v.Count);
                            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400">
                                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                @entryCount @(entryCount == 1 ? "entry" : "entries")
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-slate-400">
                                <span class="h-2 w-2 rounded-full border border-current"></span>
                                No entries &mdash; click any day to add
                            </span>
                        }
                    }
                </div>
                <button type="button" class="@NavButtonCss" @onclick="NextYear" disabled="@(currentYear >= DateTime.Now.Year)">Newer</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }

    @if (!selectedTagId.HasValue)
    {
        <div class="rounded-xl border border-dashed border-gray-300 bg-white px-4 py-6 text-center text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            Select a tag to view calendar data.
        </div>
    }
    else if (activitiesByDate == null)
    {
        <div class="rounded-xl border border-gray-200 bg-white p-6 text-center text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            Loading calendar data...
        </div>
    }
    else
    {
        <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var month in GetAllMonths())
            {
                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@month.ToString("MMMM yyyy")</h3>
                    <table class="mt-3 w-full table-fixed border-separate border-spacing-0 text-sm">
                        <thead>
                            <tr class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">
                                @foreach (var dayName in DayNames)
                                {
                                    <th class="border-b border-gray-200 pb-2 text-center dark:border-slate-700">@dayName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var week in GetCalendarWeeks(month.Year, month.Month))
                            {
                                <tr>
                                    @foreach (var day in week)
                                    {
                                        <td class="h-20 border border-gray-200 bg-white p-0 dark:border-slate-800 dark:bg-slate-900/70">
                                            @if (day.HasValue)
                                            {
                                                var key = day.Value.ToString("yyyy-MM-dd");
                                                List<string>? dayValues = null;

                                                if (activitiesByDate != null && activitiesByDate.TryGetValue(key, out var rawValues))
                                                {
                                                    dayValues = rawValues;
                                                }

                                                var hasValues = dayValues != null && dayValues.Count > 0;

                                                <button type="button" class="flex h-full w-full flex-col items-center justify-center gap-1.5 p-2 text-center transition-colors hover:bg-primary-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:hover:bg-slate-800/60 dark:focus-visible:ring-offset-slate-900" @onclick="() => OpenDayActivitiesModal(day.Value)">
                                                    <div class="text-xs font-semibold text-gray-900 dark:text-slate-100">@day.Value.Day</div>

                                                    @if (hasValues && dayValues != null)
                                                    {
                                                        <div class="flex w-full flex-wrap justify-center gap-0.5">
                                                            @foreach (var value in dayValues)
                                                            {
                                                                var inlineText = GetInlineText(value);
                                                                <span class="@ValueBadgeCss" title="@value">@inlineText</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="flex w-full justify-center">
                                                            <span class="@EmptyBadgeCss">-</span>
                                                        </div>
                                                    }
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="h-full bg-gray-50 dark:bg-slate-900/40"></div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@if (showDayActivitiesModal && selectedDayForModal.HasValue)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-gray-900/70" @onclick="CloseDayModal"></div>
        <div class="relative z-10 w-full max-w-2xl space-y-5 rounded-2xl border border-gray-200 bg-white p-6 shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-gray-900 dark:text-slate-100">Activities for @FormatModalDate(selectedDayForModal.Value)</h3>
                    <p class="text-sm text-gray-600 dark:text-slate-300">@GetSelectedTagTitle()</p>
                </div>
                <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-300 text-gray-600 transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800 dark:focus-visible:ring-offset-slate-900" @onclick="CloseDayModal" aria-label="Close">
                    <Icon Name="x" Class="h-4 w-4" />
                </button>
            </div>
            <div class="space-y-3 max-h-[55vh] overflow-y-auto">
                @if (!string.IsNullOrEmpty(dayModalError))
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @dayModalError
                    </div>
                }
                else if (isDayModalLoading)
                {
                    <div class="flex h-24 items-center justify-center text-sm text-gray-600 dark:text-slate-300">
                        Loading activities…
                    </div>
                }
                else if (dayActivities.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-gray-300 bg-white px-4 py-6 text-center text-sm text-gray-600 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300">
                        No activities recorded for this date.
                    </div>
                }
                else
                {
                    @foreach (var activity in dayActivities)
                    {
                        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
                            <div class="flex items-start justify-between gap-3">
                                <div class="space-y-1">
                                    <h4 class="text-sm font-semibold text-gray-900 dark:text-slate-100">@activity.PrimaryTagName</h4>
                                    @{ var displayValue = FormatActivityValue(activity);
                                       if (!string.IsNullOrWhiteSpace(displayValue))
                                       {
                                           <p class="text-sm text-gray-700 dark:text-slate-200">@displayValue</p>
                                       }
                                    }
                                    <p class="text-xs text-gray-500 dark:text-slate-400">@FormatActivityTime(activity)</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-sky-600 transition-all hover:bg-sky-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 dark:text-sky-400 dark:hover:bg-sky-500/20 dark:focus-visible:ring-sky-400 dark:focus-visible:ring-offset-slate-900" @onclick="() => StartEditDayActivity(activity)" aria-label="Edit activity">
                                        <Icon Name="pencil" Class="w-4 h-4" />
                                    </button>
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-2 dark:text-rose-400 dark:hover:bg-rose-500/20 dark:focus-visible:ring-rose-400 dark:focus-visible:ring-offset-slate-900" @onclick="() => DeleteActivityFromDay(activity.Id)" aria-label="Delete activity">
                                        <Icon Name="trash" Class="w-4 h-4" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="flex items-center justify-between gap-3 pt-2">
                <div class="flex items-center gap-1">
                    <button type="button" @onclick="() => ShiftDayModal(-1)" class="inline-flex items-center gap-1 rounded px-2 py-1.5 text-xs text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-slate-400 dark:hover:bg-gray-700 dark:hover:text-slate-200" title="Previous day" disabled="@isDayModalLoading">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        <span>-1d</span>
                    </button>
                    <button type="button" @onclick="() => ShiftDayModal(1)" class="inline-flex items-center gap-1 rounded px-2 py-1.5 text-xs text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-slate-400 dark:hover:bg-gray-700 dark:hover:text-slate-200" title="Next day" disabled="@isDayModalLoading">
                        <span>+1d</span>
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus-visible:ring-offset-slate-900" @onclick="StartCreateDayActivity" disabled="@(!selectedTagId.HasValue)">
                    <Icon Name="plus" Class="h-4 w-4" />
                    Add Activity
                </button>
            </div>
        </div>
    </div>
}

@if (showActivityEditor && tags != null && modalActivity != null)
{
    <AddActivityModal
        Activity="modalActivity"
        AvailableTags="tags"
        OptionLists="optionLists"
        OptionListLookup="optionListLookup"
        DisplayCulture="displayCulture"
        DisplayTimeZone="displayTimeZone"
        ErrorMessage="@activityEditorError"
        IsEditMode="isEditMode"
        ActivityId="editingActivityId"
        PreselectedTagId="@(!isEditMode ? selectedTagId : null)"
        PreselectedDate="@(!isEditMode ? selectedDayForModal : null)"
        OnActivityCreated="OnDayActivityCreated"
        OnActivityUpdated="OnDayActivityUpdated"
        OnCanceled="CloseActivityEditor"
        OnError="OnDayModalError"
        ModalId="calendarDayActivityModal" />
}

@code {
    private const string InputCss = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100";
    private const string NavButtonCss = "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60";
    private const string ValueBadgeCss = "flex w-full min-h-[1.75rem] items-center justify-center rounded-md bg-emerald-500 px-2.5 py-1 text-xs font-semibold text-white shadow-sm dark:bg-emerald-500/80";
    private const string EmptyBadgeCss = "flex w-full min-h-[1.75rem] items-center justify-center rounded-md border border-dashed border-amber-300 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 dark:border-amber-400/60 dark:bg-amber-500/10 dark:text-amber-200";
    private const string OrderButtonInactive = "inline-flex items-center justify-center rounded-full px-3 py-1 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-200";
    private const string OrderButtonActive = "inline-flex items-center justify-center rounded-full bg-gray-900 px-3 py-1 text-xs font-medium text-white shadow-sm dark:bg-slate-200 dark:text-slate-900";
    private const string OrderDescending = "desc";
    private const string OrderAscending = "asc";
    private const int MaxInlineCharacters = 6;
    private static readonly string[] DayNames = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private IList<TagResponse>? tags;
    private Dictionary<string, List<string>>? activitiesByDate;
    private IList<TagOptionListResponse>? optionLists;
    private Dictionary<int, TagOptionListResponse>? optionListLookup;
    private List<ActivityResponse> dayActivities = new();

    private int? selectedTagId;
    private string? errorMessage;
    private int currentYear = DateTime.Now.Year;
    private List<int> availableYears = new();
    private string orderBy = OrderDescending;

    private bool showDayActivitiesModal;
    private bool isDayModalLoading;
    private string? dayModalError;
    private DateTime? selectedDayForModal;

    private bool showActivityEditor;
    private bool isEditMode;
    private int? editingActivityId;
    private ActivityRequest modalActivity = new();
    private string? activityEditorError;

    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;
    private UserPreferencesSnapshot? userPreferences;
    private EffectivePreferences? effectivePreferences;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Calendar");
        await LoadPreferencesAsync();
        await LoadTags();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && tags != null && tags.Any())
        {
            try
            {
                var savedOrder = await JSRuntime.InvokeAsync<string?>("tagPersistence.getCalendarOrder");
                if (!string.IsNullOrEmpty(savedOrder))
                {
                    orderBy = savedOrder;
                }

                var savedTagId = await JSRuntime.InvokeAsync<int?>("tagPersistence.getSelectedTag");
                if (savedTagId.HasValue && tags.Any(t => t.Id == savedTagId.Value))
                {
                    selectedTagId = savedTagId.Value;
                    await LoadActivitiesForTag(savedTagId.Value);
                    StateHasChanged();
                }
                else if (!string.IsNullOrEmpty(savedOrder))
                {
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore errors loading saved tag preference
            }
        }
    }

    private async Task LoadPreferencesAsync()
    {
        try
        {
            userPreferences = await UserPreferencesService.GetAsync();
            displayCulture = userPreferences.Culture;
            displayTimeZone = userPreferences.TimeZone;
            effectivePreferences = userPreferences.Preferences;
        }
        catch
        {
            displayCulture = CultureInfo.CurrentCulture;
            displayTimeZone = TimeZoneInfo.Local;
            effectivePreferences = null;
        }
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
            await EnsureOptionListsLoadedAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tags: {ex.Message}";
        }
    }

    private async Task EnsureOptionListsLoadedAsync()
    {
        if (optionLists != null && optionListLookup != null)
        {
            return;
        }

        try
        {
            optionLists = await ActivityApi.GetTagOptionListsAsync();
            optionListLookup = optionLists?.ToDictionary(list => list.Id) ?? new Dictionary<int, TagOptionListResponse>();
        }
        catch
        {
            optionLists ??= new List<TagOptionListResponse>();
            optionListLookup ??= new Dictionary<int, TagOptionListResponse>();
        }
    }

    private async Task OnTagChangedHandler(ChangeEventArgs e)
    {
        showDayActivitiesModal = false;
        showActivityEditor = false;
        dayModalError = null;
        activityEditorError = null;

        if (int.TryParse(e.Value?.ToString(), out var tagId))
        {
            selectedTagId = tagId;
            await JSRuntime.InvokeVoidAsync("tagPersistence.saveSelectedTag", tagId);
            await LoadActivitiesForTag(tagId);
        }
        else
        {
            selectedTagId = null;
            await JSRuntime.InvokeVoidAsync("tagPersistence.saveSelectedTag", null);
            activitiesByDate = null;
            availableYears.Clear();
        }
    }

    private async Task LoadActivitiesForTag(int tagId)
    {
        try
        {
            await EnsureOptionListsLoadedAsync();

            availableYears = (await ActivityApi.GetAvailableYears(tagId))?
                .Distinct()
                .OrderByDescending(year => year)
                .ToList() ?? new List<int>();

            if (availableYears.Count > 0 && !availableYears.Contains(currentYear))
            {
                currentYear = availableYears[0];
            }
            else if (availableYears.Count == 0)
            {
                currentYear = DateTime.Now.Year;
            }

            await LoadActivitiesForYear(tagId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading activities: {ex.Message}";
            activitiesByDate = new Dictionary<string, List<string>>();
        }
    }

    private async Task LoadActivitiesForYear(int tagId)
    {
        try
        {
            var activities = await ActivityApi.GetActivitiesByYear(currentYear, tagId);

            activitiesByDate = activities?
                .GroupBy(a => a.DateStarted.ToString("yyyy-MM-dd"))
                .ToDictionary(
                    g => g.Key,
                    g => g.Select(a => a.Description ?? string.Empty).ToList())
                ?? new Dictionary<string, List<string>>();

            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading activities: {ex.Message}";
            activitiesByDate = new Dictionary<string, List<string>>();
        }
    }

    private IEnumerable<DateTime> GetAllMonths()
    {
        for (int month = 1; month <= 12; month++)
        {
            if (string.Equals(orderBy, OrderAscending, StringComparison.OrdinalIgnoreCase))
            {
                yield return new DateTime(currentYear, month, 1);
            }
            else
            {
                yield return new DateTime(currentYear, 13 - month, 1);
            }
        }
    }

    private IReadOnlyList<IReadOnlyList<DateTime?>> GetCalendarWeeks(int year, int month)
    {
        var weeks = new List<List<DateTime?>>();
        var firstDay = new DateTime(year, month, 1);
        var daysInMonth = DateTime.DaysInMonth(year, month);
        var startOffset = ((int)firstDay.DayOfWeek + 6) % 7;
        var dayCounter = 1;

        for (int week = 0; week < 6; week++)
        {
            var row = new List<DateTime?>(7);
            var hasDay = false;

            for (int day = 0; day < 7; day++)
            {
                var cellIndex = week * 7 + day;
                if (cellIndex < startOffset || dayCounter > daysInMonth)
                {
                    row.Add(null);
                }
                else
                {
                    row.Add(new DateTime(year, month, dayCounter++));
                    hasDay = true;
                }
            }

            if (!hasDay && dayCounter > daysInMonth)
            {
                break;
            }

            weeks.Add(row);
        }

        return weeks;
    }

    private static string GetInlineText(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "-";
        }

        return value.Length <= MaxInlineCharacters ? value : value[..MaxInlineCharacters];
    }

    private string GetOrderButtonClass(string order)
    {
        return string.Equals(orderBy, order, StringComparison.OrdinalIgnoreCase)
            ? OrderButtonActive
            : OrderButtonInactive;
    }

    private async Task PrevYear()
    {
        if (selectedTagId.HasValue && currentYear > DateTime.Now.Year - 10)
        {
            currentYear--;
            await LoadActivitiesForYear(selectedTagId.Value);
            if (showDayActivitiesModal && selectedDayForModal.HasValue)
            {
                await LoadDayActivitiesAsync();
            }
        }
    }

    private async Task NextYear()
    {
        if (selectedTagId.HasValue && currentYear < DateTime.Now.Year)
        {
            currentYear++;
            await LoadActivitiesForYear(selectedTagId.Value);
            if (showDayActivitiesModal && selectedDayForModal.HasValue)
            {
                await LoadDayActivitiesAsync();
            }
        }
    }

    private async Task ChangeOrder(string order)
    {
        if (string.Equals(orderBy, order, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        orderBy = order;
        await JSRuntime.InvokeVoidAsync("tagPersistence.saveCalendarOrder", order);

        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
            if (showDayActivitiesModal && selectedDayForModal.HasValue)
            {
                await LoadDayActivitiesAsync();
            }
        }
    }

    private async Task OpenDayActivitiesModal(DateTime day)
    {
        if (!selectedTagId.HasValue)
        {
            return;
        }

        selectedDayForModal = day;
        showDayActivitiesModal = true;
        isDayModalLoading = true;
        dayModalError = null;

        await EnsureOptionListsLoadedAsync();

        try
        {
            await LoadDayActivitiesAsync();
        }
        finally
        {
            isDayModalLoading = false;
        }
    }

    private async Task LoadDayActivitiesAsync()
    {
        if (!selectedTagId.HasValue || selectedDayForModal is null)
        {
            dayActivities = new List<ActivityResponse>();
            return;
        }

        try
        {
            var start = selectedDayForModal.Value.Date;
            var end = start.AddDays(1).AddTicks(-1);
            var result = await ActivityApi.GetActivities(1, 200, orderBy, selectedTagId, start, end, null);

            dayActivities = string.Equals(orderBy, OrderAscending, StringComparison.OrdinalIgnoreCase)
                ? result.Items.OrderBy(a => a.DateStarted).ToList()
                : result.Items.OrderByDescending(a => a.DateStarted).ToList();
        }
        catch (Exception ex)
        {
            dayModalError = $"Error loading day activities: {ex.Message}";
            dayActivities = new List<ActivityResponse>();
        }
    }

    private async Task ShiftDayModal(int days)
    {
        if (selectedDayForModal is null)
        {
            return;
        }

        selectedDayForModal = selectedDayForModal.Value.AddDays(days);
        isDayModalLoading = true;
        dayModalError = null;

        try
        {
            await LoadDayActivitiesAsync();
        }
        finally
        {
            isDayModalLoading = false;
        }
    }

    private void CloseDayModal()
    {
        showDayActivitiesModal = false;
        isDayModalLoading = false;
        selectedDayForModal = null;
        dayModalError = null;
        dayActivities.Clear();

        showActivityEditor = false;
        activityEditorError = null;
    }

    private void StartCreateDayActivity()
    {
        if (!selectedTagId.HasValue || selectedDayForModal is null)
        {
            return;
        }

        isEditMode = false;
        editingActivityId = null;
        modalActivity = new ActivityRequest
        {
            PrimaryTagId = selectedTagId,
            DateStarted = GetDefaultStartForDate(selectedDayForModal.Value),
            DateFinished = null,
            Description = null
        };

        activityEditorError = null;
        showActivityEditor = true;
    }

    private void StartEditDayActivity(ActivityResponse activity)
    {
        isEditMode = true;
        editingActivityId = activity.Id;

        modalActivity = new ActivityRequest
        {
            PrimaryTagId = activity.PrimaryTagId,
            Description = activity.Description,
            DateStarted = ConvertToDisplayZone(activity.DateStarted),
            DateFinished = activity.DateFinished.HasValue
                ? ConvertToDisplayZone(activity.DateFinished.Value)
                : null
        };

        activityEditorError = null;
        showActivityEditor = true;
    }

    private async Task DeleteActivityFromDay(int activityId)
    {
        try
        {
            await ActivityApi.Delete(activityId);
            await RefreshDayModalData();
        }
        catch (Exception ex)
        {
            dayModalError = $"Error deleting activity: {ex.Message}";
        }
    }

    private async Task OnDayActivityCreated(ActivityRequest _)
    {
        showActivityEditor = false;
        activityEditorError = null;
        await RefreshDayModalData();
    }

    private async Task OnDayActivityUpdated()
    {
        showActivityEditor = false;
        activityEditorError = null;
        await RefreshDayModalData();
    }

    private async Task OnDayModalError(string error)
    {
        activityEditorError = error;
        await Task.CompletedTask;
    }

    private void CloseActivityEditor()
    {
        showActivityEditor = false;
        activityEditorError = null;
    }

    private async Task RefreshDayModalData()
    {
        if (selectedTagId.HasValue)
        {
            await LoadActivitiesForTag(selectedTagId.Value);
        }

        if (showDayActivitiesModal && selectedDayForModal.HasValue)
        {
            await LoadDayActivitiesAsync();
        }
    }

    private string FormatModalDate(DateTime date)
    {
        return date.ToString("D", displayCulture);
    }

    private string GetSelectedTagTitle()
    {
        if (!selectedTagId.HasValue)
        {
            return "No tag selected";
        }

        var tag = tags?.FirstOrDefault(t => t.Id == selectedTagId.Value);
        return tag?.Title ?? $"Tag #{selectedTagId.Value}";
    }

    private string FormatActivityValue(ActivityResponse activity)
    {
        var rawValue = activity.PrimaryTagValue ?? activity.Description ?? string.Empty;
        var tag = tags?.FirstOrDefault(t => t.Id == activity.PrimaryTagId);
        var valueForDisplay = rawValue;

        if (tag?.OptionListId is int listId && optionListLookup != null && optionListLookup.TryGetValue(listId, out var list))
        {
            var option = list.Options.FirstOrDefault(o => string.Equals(o.Value, rawValue, StringComparison.OrdinalIgnoreCase));
            if (option is not null)
            {
                valueForDisplay = option.DisplayName ?? option.Value;
            }
        }
        else if (tag?.TypeId == 1 && long.TryParse(rawValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var intValue))
        {
            valueForDisplay = intValue.ToString(displayCulture);
        }
        else if (tag?.TypeId == 6 && decimal.TryParse(rawValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var decimalValue))
        {
            valueForDisplay = decimalValue.ToString("0.#############################", displayCulture);
        }

        if (tag is not null && !string.IsNullOrWhiteSpace(tag.UnitSymbol) && !string.IsNullOrWhiteSpace(valueForDisplay))
        {
            valueForDisplay = $"{valueForDisplay} {tag.UnitSymbol}";
        }

        return valueForDisplay;
    }

    private string FormatActivityTime(ActivityResponse activity)
    {
        var culture = displayCulture;
        var timePattern = effectivePreferences?.ShortTimePattern ?? culture.DateTimeFormat.ShortTimePattern;
        var datePattern = effectivePreferences?.ShortDatePattern ?? culture.DateTimeFormat.ShortDatePattern;

        var startLocal = ConvertToDisplayZone(activity.DateStarted);
        var startDate = startLocal.ToString(datePattern, culture);
        var startTime = startLocal.ToString(timePattern, culture);

        if (!activity.DateFinished.HasValue)
        {
            return $"{startDate} • {startTime}";
        }

        var endLocal = ConvertToDisplayZone(activity.DateFinished.Value);
        var endDate = endLocal.ToString(datePattern, culture);
        var endTime = endLocal.ToString(timePattern, culture);

        if (startLocal.Date == endLocal.Date)
        {
            return $"{startDate} • {startTime} – {endTime}";
        }

        return $"{startDate} {startTime} – {endDate} {endTime}";
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, displayTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private DateTime ConvertToDisplayZone(DateTime dateTime)
    {
        if (dateTime.Kind == DateTimeKind.Utc)
        {
            return TimeZoneInfo.ConvertTimeFromUtc(dateTime, displayTimeZone);
        }

        if (dateTime.Kind == DateTimeKind.Local)
        {
            return displayTimeZone.Equals(TimeZoneInfo.Local)
                ? dateTime
                : TimeZoneInfo.ConvertTime(dateTime, TimeZoneInfo.Local, displayTimeZone);
        }

        var unspecified = DateTime.SpecifyKind(dateTime, DateTimeKind.Local);
        return displayTimeZone.Equals(TimeZoneInfo.Local)
            ? unspecified
            : TimeZoneInfo.ConvertTime(unspecified, TimeZoneInfo.Local, displayTimeZone);
    }

    private DateTime GetDefaultStartForDate(DateTime date)
    {
        var today = GetTodayInDisplayZone();
        return date.Date == today ? GetCurrentDateTimeInDisplayZone() : date.Date;
    }

    private void NavigateToLinearView()
    {
        Navigation.NavigateTo("/calendar-linear");
    }
}
