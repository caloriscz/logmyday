@page "/qr-generator"

@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@using Microsoft.JSInterop
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject IPageTitleService PageTitleService
@inject IJSRuntime JSRuntime
@inject ILogger<QrGenerator> Logger

<div class="mx-auto max-w-(--breakpoint-md) space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="space-y-1">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">QR Code Generator</h1>
        <p class="text-sm text-gray-600 dark:text-slate-300">
            Generate QR codes for your tags. Print them on product labels or rack cards for quick scanning.
        </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-slate-700 dark:bg-slate-900">
        <div class="space-y-5">
            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Tag</label>
                <GroupedTagSelect Tags="tags" @bind-Value="selectedTagId" @bind-Value:after="OnTagChanged" SelectClass="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
            </div>

            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">
                    Pre-filled Value
                    <span class="font-normal text-gray-500 dark:text-slate-400">(optional)</span>
                </label>
                <input type="text" @bind="prefilledValue" @bind:after="OnValueChanged" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="e.g., 400mg" />
                <p class="text-xs text-gray-500 dark:text-slate-400">This value will be pre-filled in the activity description when scanned.</p>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">
                    Display Name
                    <span class="font-normal text-gray-500 dark:text-slate-400">(optional)</span>
                </label>
                <input type="text" @bind="displayName" @bind:after="OnValueChanged" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" placeholder="e.g., Magnesium 400mg" />
                <p class="text-xs text-gray-500 dark:text-slate-400">Human-readable label printed alongside the QR code.</p>
            </div>
        </div>
    </div>

    @if (selectedTagId.HasValue)
    {
        <div class="space-y-4 rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-slate-700 dark:bg-slate-900">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Generated QR Code</h2>
                <p class="text-xs text-gray-500 dark:text-slate-400 font-mono break-all">@generatedUri</p>
            </div>

            <div class="flex justify-center rounded-lg bg-white p-6 dark:bg-white">
                <div id="@qrElementId"></div>
            </div>

            <div class="flex flex-wrap gap-3">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700" @onclick="DownloadQr">
                    <Icon Name="arrow-down-tray" Class="h-4 w-4" />
                    Download PNG
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="PrintQr">
                    <Icon Name="printer" Class="h-4 w-4" />
                    Print
                </button>
            </div>
        </div>
    }
</div>

@code {
    private IList<TagResponse>? tags;
    private int? selectedTagId;
    private string? prefilledValue;
    private string? displayName;
    private string generatedUri = string.Empty;
    private string qrElementId = "qr-output";

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle("QR Generator");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTags();
            StateHasChanged();
        }

        if (selectedTagId.HasValue && !string.IsNullOrEmpty(generatedUri))
        {
            await RenderQr();
        }
    }

    private async Task LoadTags()
    {
        try
        {
            tags = await ActivityApi.GetTags();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load tags for QR generator");
        }
    }

    private async Task OnTagChanged()
    {
        RebuildUri();
        await RenderQr();
    }

    private async Task OnValueChanged()
    {
        RebuildUri();
        await RenderQr();
    }

    private void RebuildUri()
    {
        if (!selectedTagId.HasValue)
        {
            generatedUri = string.Empty;

            return;
        }

        // Build lmd://tag/{id}?v={value}&n={name}
        var uri = $"lmd://tag/{selectedTagId.Value}";
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(prefilledValue))
        {
            queryParts.Add($"v={Uri.EscapeDataString(prefilledValue.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(displayName))
        {
            queryParts.Add($"n={Uri.EscapeDataString(displayName.Trim())}");
        }

        if (queryParts.Count > 0)
        {
            uri += "?" + string.Join("&", queryParts);
        }

        generatedUri = uri;
    }

    private async Task RenderQr()
    {
        if (string.IsNullOrEmpty(generatedUri))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("LogMyDayQrGen.generate", qrElementId, generatedUri, 6);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to render QR code");
        }
    }

    private async Task DownloadQr()
    {
        if (string.IsNullOrEmpty(generatedUri))
        {
            return;
        }

        try
        {
            var tagTitle = tags?.FirstOrDefault(t => t.Id == selectedTagId)?.Title ?? "qrcode";
            var safeFileName = string.Join("_", tagTitle.Split(System.IO.Path.GetInvalidFileNameChars()));
            await JSRuntime.InvokeVoidAsync("LogMyDayQrGen.downloadPng", generatedUri, 10, $"lmd-{safeFileName}.png");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to download QR code");
        }
    }

    private async Task PrintQr()
    {
        if (string.IsNullOrEmpty(generatedUri))
        {
            return;
        }

        try
        {
            var label = displayName ?? tags?.FirstOrDefault(t => t.Id == selectedTagId)?.Title ?? "Tag";
            await JSRuntime.InvokeVoidAsync("LogMyDayQrGen.printWithLabel", generatedUri, 10, label);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to print QR code");
        }
    }
}
