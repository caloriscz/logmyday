@page "/event-logs"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using LogMyDay.App.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IEventLogApi EventLogApi
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<EventLogs> Logger
@inject IPageTitleService PageTitleService
@inject IJSRuntime JSRuntime

@attribute [Authorize]

<div class="mx-auto max-w-screen-2xl space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <PageHeader Title="Event Log" Subtitle="System events and error messages for your account.">
        <Actions>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" @onclick="DownloadLog" disabled="@isLoading"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Download .log
                </button>
                <button type="button" @onclick='() => DeleteEvents(null)' disabled="@_isDeleting"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-rose-300 bg-white px-3 py-2 text-sm font-medium text-rose-600 shadow-sm transition-colors hover:bg-rose-50 disabled:opacity-50 dark:border-rose-800 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-rose-950/40">
                    Delete All
                </button>
                <button type="button" @onclick='() => DeleteEvents(30)' disabled="@_isDeleting"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    &gt; 30 days
                </button>
                <button type="button" @onclick='() => DeleteEvents(90)' disabled="@_isDeleting"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    &gt; 90 days
                </button>
            </div>
        </Actions>
    </PageHeader>

    @* Filter Form *@
    <form @onsubmit="ApplyFilter" @onsubmit:preventDefault class="flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500 dark:text-slate-400">Level</label>
            <select @bind="_selectedLevel"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                <option value="">All Levels</option>
                <option value="Info">Info</option>
                <option value="Error">Error</option>
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500 dark:text-slate-400">Type</label>
            <select @bind="_selectedCategory"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                <option value="@EventLogCategoryFilter.All">All Types</option>
                <option value="@EventLogCategoryFilter.ReminderDiag">Reminder diag</option>
                <option value="@EventLogCategoryFilter.NoDiagnostics">No diagnostics</option>
                <option value="@EventLogCategoryFilter.Activity">Activities</option>
                <option value="@EventLogCategoryFilter.Reminder">Reminders</option>
                <option value="@EventLogCategoryFilter.TodoList">Todo lists</option>
            </select>
        </div>
        <div class="flex flex-col gap-1 flex-1 min-w-40">
            <label class="text-xs font-medium text-gray-500 dark:text-slate-400">Message</label>
            <input type="text" @bind="_messageFilter" placeholder="Contains…"
                   class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500 dark:text-slate-400">From</label>
            <input type="date" @bind="_dateFrom"
                   class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-gray-500 dark:text-slate-400">To</label>
            <input type="date" @bind="_dateTo"
                   class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" />
        </div>
        <button type="submit"
                class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
            Apply
        </button>
    </form>

    <StatusAlert Message="@statusMessage" IsError="@statusIsError" />

    @if (isLoading)
    {
        <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
            <span>Loading events…</span>
        </div>
    }
    else if (pagedResult != null && pagedResult.Items.Count > 0)
    {
        @* Pagination *@
        @if (totalPages > 1)
        {
            <div class="flex flex-col gap-3 rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="text-sm font-medium text-gray-700 dark:text-slate-300">
                        Page @pageNumber of @totalPages (@pagedResult.TotalCount events)
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="PrevPage" disabled="@(pageNumber <= 1)">Previous</button>
                        <button type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="NextPage" disabled="@(pageNumber >= totalPages)">Next</button>
                    </div>
                </div>
            </div>
        }

        @* Desktop Table *@
        <div class="hidden overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900 md:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-gray-200 bg-gray-50 text-xs font-semibold uppercase tracking-wider text-gray-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                    <tr>
                        <th class="px-4 py-3 w-24">
                            <button type="button" @onclick='() => SetSort("level")' class="flex items-center gap-1 hover:text-gray-900 dark:hover:text-slate-200 transition-colors">
                                Level @SortIndicator("level")
                            </button>
                        </th>
                        <th class="px-4 py-3">
                            <button type="button" @onclick='() => SetSort("message")' class="flex items-center gap-1 hover:text-gray-900 dark:hover:text-slate-200 transition-colors">
                                Message @SortIndicator("message")
                            </button>
                        </th>
                        @if (isAdmin)
                        {
                            <th class="px-4 py-3">Detail</th>
                        }
                        <th class="px-4 py-3 w-44">
                            <button type="button" @onclick='() => SetSort("time")' class="flex items-center gap-1 hover:text-gray-900 dark:hover:text-slate-200 transition-colors">
                                Time @SortIndicator("time")
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-slate-700/60">
                    @foreach (var item in pagedResult.Items)
                    {
                        <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-slate-800/60">
                            <td class="px-4 py-3">
                                @if (item.Level == "Error")
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">Error</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-medium text-sky-700 dark:bg-sky-500/20 dark:text-sky-300">Info</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-900 dark:text-slate-100">@item.Message</td>
                            @if (isAdmin)
                            {
                                <td class="px-4 py-3 text-gray-500 dark:text-slate-400 text-xs">@(item.Detail ?? "—")</td>
                            }
                            <td class="px-4 py-3 text-gray-500 dark:text-slate-400 whitespace-nowrap">@item.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile Cards *@
        <div class="space-y-3 md:hidden">
            @foreach (var item in pagedResult.Items)
            {
                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1 space-y-1">
                            <div class="flex items-center gap-2">
                                @if (item.Level == "Error")
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">Error</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-medium text-sky-700 dark:bg-sky-500/20 dark:text-sky-300">Info</span>
                                }
                                <span class="text-xs text-gray-500 dark:text-slate-400">@item.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <p class="text-sm text-gray-900 dark:text-slate-100">@item.Message</p>
                            @if (isAdmin && !string.IsNullOrEmpty(item.Detail))
                            {
                                <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">@item.Detail</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded-lg border border-gray-200 bg-white px-4 py-8 text-center text-sm text-gray-500 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            No events recorded yet.
        </div>
    }
</div>

@code {
    private PagedResult<EventLogResponse>? pagedResult;
    private bool isLoading = true;
    private bool isAdmin;
    private string? statusMessage;
    private bool statusIsError;
    private string _selectedLevel = "";
    private EventLogCategoryFilter _selectedCategory = EventLogCategoryFilter.All;
    private string? _messageFilter;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string _sortBy = "time";
    private bool _sortDesc = true;
    private bool _isDeleting;
    private int pageNumber = 1;
    private int pageSize = 50;
    private int totalPages => pagedResult == null || pagedResult.PageSize == 0
        ? 1
        : (int)Math.Ceiling((double)pagedResult.TotalCount / pagedResult.PageSize);

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Event Log");
        await CheckAdminAccess();
        await LoadEvents();
    }

    private async Task CheckAdminAccess()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAdmin = user.Identity?.IsAuthenticated == true &&
                  user.HasClaim("is_admin", "true");
    }

    private async Task LoadEvents()
    {
        try
        {
            isLoading = true;
            statusMessage = null;
            var level = string.IsNullOrEmpty(_selectedLevel) ? null : _selectedLevel;
            var (dateFromUtc, dateToUtc) = GetUtcDateRange();
            pagedResult = await EventLogApi.GetEventLogs(pageNumber, pageSize, level, _messageFilter, dateFromUtc, dateToUtc, _sortBy, _sortDesc, _selectedCategory);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load event logs");
            statusMessage = "Failed to load events. Please try again.";
            statusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Events are stored in UTC but picked and displayed as local dates, so the filter must
    // cover the whole local From/To days converted to UTC (To is inclusive of its entire day).
    private (DateTime? FromUtc, DateTime? ToUtc) GetUtcDateRange()
    {
        var fromUtc = _dateFrom?.Date.ToUniversalTime();
        var toUtc = _dateTo?.Date.AddDays(1).AddTicks(-1).ToUniversalTime();

        return (fromUtc, toUtc);
    }

    private async Task ApplyFilter()
    {
        pageNumber = 1;
        await LoadEvents();
    }

    private async Task SetSort(string column)
    {
        if (_sortBy == column)
        {
            _sortDesc = !_sortDesc;
        }
        else
        {
            _sortBy = column;
            _sortDesc = true;
        }

        await LoadEvents();
    }

    private string SortIndicator(string column)
    {
        if (_sortBy != column)
        {
            return "";
        }

        return _sortDesc ? "▼" : "▲";
    }

    private async Task DownloadLog()
    {
        try
        {
            var level = string.IsNullOrEmpty(_selectedLevel) ? null : _selectedLevel;
            var (dateFromUtc, dateToUtc) = GetUtcDateRange();
            var all = await EventLogApi.GetEventLogs(1, 10000, level, _messageFilter, dateFromUtc, dateToUtc, _sortBy, _sortDesc, _selectedCategory);
            var sb = new System.Text.StringBuilder();

            foreach (var item in all.Items)
            {
                sb.AppendLine($"[{item.CreatedUtc.ToLocalTime():yyyy-MM-dd HH:mm:ss}] [{item.Level.ToUpper()}] {item.Message}");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", "events.log", base64, "text/plain");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download event log");
            statusMessage = "Failed to download log. Please try again.";
            statusIsError = true;
        }
    }

    private async Task DeleteEvents(int? olderThanDays)
    {
        var confirmMessage = olderThanDays.HasValue
            ? $"Delete all events older than {olderThanDays} days?"
            : "Delete ALL events? This cannot be undone.";

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);

        if (!confirmed)
        {
            return;
        }

        try
        {
            _isDeleting = true;
            statusMessage = null;
            await EventLogApi.DeleteEventLogs(olderThanDays);
            pageNumber = 1;
            await LoadEvents();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete event logs");
            statusMessage = "Failed to delete events. Please try again.";
            statusIsError = true;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task PrevPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadEvents();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadEvents();
        }
    }
}
