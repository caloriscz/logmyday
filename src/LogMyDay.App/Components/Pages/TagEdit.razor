            return currentType != null && !currentType.IsRepeatableEditable;
        }
    }

    private void OnInputTypeChanged()
    {
        if (editTag == null) return;
        
        var selectedType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
        if (selectedType != null && !selectedType.IsRangeEditable)
        {
            // Auto-populate constraints for locked types
            var constraints = LogMyDay.Domain.Helpers.InputTypeDefaults.GetConstraintsForType(editTag.TypeId);
            editTag.MinValue = constraints.MinValue;
            editTag.MaxValue = constraints.MaxValue;
            editTag.Step = constraints.Step;
        }
        else
        {
            // Clear values when switching to editable type (unless they already have values)
            if (!editTag.MinValue.HasValue) editTag.MinValue = null;
            if (!editTag.MaxValue.HasValue) editTag.MaxValue = null;
            if (!editTag.Step.HasValue) editTag.Step = null;
        }
        
        // Auto-set IsRepeatable = false for locked types
        if (selectedType != null && !selectedType.IsRepeatableEditable)
        {
            editTag.IsRepeatable = false;
        }
        else if (!editTag.IsRepeatable)
        {
            // When switching to editable type, reset to true if currently false
            editTag.IsRepeatable = true;
        }

        StateHasChanged();
    }

