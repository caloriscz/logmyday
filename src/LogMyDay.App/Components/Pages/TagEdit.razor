    private async Task SaveNotificationAsync()
    {
        if (editingNotification is null)
        {
            return;
        }

        notificationErrorMessage = null;

        if (!TryBuildRequest(editingNotification, out var request, out var error))
        {
            notificationErrorMessage = error;
            return;
        }

        isNotificationSaving = true;

        try
        {
            if (editingNotification.Id.HasValue)
            {
                await ActivityApi.UpdateNotification(editingNotification.Id.Value, request);
            }
            else
            {
                await ActivityApi.CreateNotification(request);
            }

            await LoadNotifications();
            CancelNotificationEdit();
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error saving notification: {ex.Message}";
            Logger.LogError(ex, "Error saving notification");
        }
        finally
        {
            isNotificationSaving = false;
        }
    }

    private async Task DeleteNotificationAsync(int notificationId)
    {
        try
        {
            await ActivityApi.DeleteNotification(notificationId);
            notifications.RemoveAll(n => n.Id == notificationId);
            notificationErrorMessage = null;
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error deleting notification: {ex.Message}";
            Logger.LogError(ex, "Error deleting notification {NotificationId}", notificationId);
        }
    }

    private NotificationViewModel MapToViewModel(NotificationResponse response)
    {
        return new NotificationViewModel
        {
            Id = response.Id,
            TagId = response.TagId,
            NotificationText = response.NotificationText,
            NotBeforeTime = FormatTimeSpan(response.NotBeforeTime),
            NotAfterTime = FormatTimeSpan(response.NotAfterTime),
            MaxNudges = response.MaxNudges,
            NudgeIntervalMinutes = response.NudgeInterval.HasValue
                ? (int?)Math.Round(response.NudgeInterval.Value.TotalMinutes)
                : null,
            IsActive = response.IsActive,
            DateCreated = response.DateCreated
        };
    }

    private bool TryBuildRequest(NotificationEditModel model, out NotificationRequest request, out string? error)
    {
        request = new NotificationRequest
        {
            TagId = Id,
            NotificationText = string.IsNullOrWhiteSpace(model.NotificationText) ? null : model.NotificationText.Trim(),
            MaxNudges = model.MaxNudges,
            IsActive = model.IsActive
        };

        if (!TryParseTime(model.NotBeforeTime, out var notBefore, out error))
        {
            return false;
        }

        if (!TryParseTime(model.NotAfterTime, out var notAfter, out error))
        {
            return false;
        }

        if (model.MaxNudges < 0)
        {
            error = "Max nudges must be zero or greater.";
            return false;
        }

        if (model.NudgeIntervalMinutes.HasValue)
        {
            if (model.NudgeIntervalMinutes.Value < 0)
            {
                error = "Nudge interval must be zero or greater.";
                return false;
            }

            if (model.NudgeIntervalMinutes.Value > 0 && model.NudgeIntervalMinutes.Value < NotificationScheduleCalculator.MinimumIntervalMinutes)
            {
                error = $"Nudge interval must be at least {NotificationScheduleCalculator.MinimumIntervalMinutes} minutes.";
                return false;
            }
        }

        request.NotBeforeTime = notBefore;
        request.NotAfterTime = notAfter;
        request.NudgeInterval = model.NudgeIntervalMinutes.HasValue ? TimeSpan.FromMinutes(model.NudgeIntervalMinutes.Value) : null;

        return true;
    }

    private static bool TryParseTime(string? value, out TimeSpan? time, out string? error)
    {
        time = null;
        error = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var parsed))
        {
            time = parsed;
            return true;
        }

        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var hoursOnly))
        {
            time = TimeSpan.FromHours(hoursOnly);
            return true;
        }

        error = "Time values must use HH:mm format or a total hour value (e.g., 32).";
        
        return false;
    }

    private static string? FormatTimeSpan(TimeSpan? timeSpan)
    {
        if (!timeSpan.HasValue)
        {
            return null;
        }

        var totalHours = (int)Math.Floor(timeSpan.Value.TotalHours);
        var minutes = Math.Abs(timeSpan.Value.Minutes);
        return $"{totalHours:D2}:{minutes:D2}";
    }

