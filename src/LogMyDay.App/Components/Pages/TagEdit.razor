@page "/tags/edit/{Id:int}"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using System.Linq
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.Shared.Interfaces.ITagGroupApi TagGroupApi
@inject NavigationManager Navigation
@inject ILogger<TagEdit> Logger
@inject IPageTitleService PageTitleService

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">@(!string.IsNullOrEmpty(tagTitle) ? tagTitle : "Edit Tag")</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Update the tag details.</p>
        </div>
        <a href="/tags" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900">
            <Icon Name="chevron-left" Class="h-4 w-4" />
            Back to Tags
        </a>
    </div>

    @if (isLoading)
    {
        <EmptyState Message="Loading tag details..." />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }
    else if (editTag != null)
    {
        <section class="space-y-6 rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-slate-700 dark:bg-slate-900">
            <EditForm Model="editTag" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200" />

                <div class="space-y-6">
                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Title</label>
                        <InputText @bind-Value="editTag.Tag" class="@InputCss" disabled="@isSaving" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Description (optional)</label>
                        <InputTextArea @bind-Value="editTag.Description" rows="3" class="@InputCss" disabled="@isSaving" placeholder="What does this tag measure? How should values be interpreted?" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Group (optional)</label>
                        <InputSelect @bind-Value="editTag.GroupId" class="@InputCss" TValue="int?" disabled="@isSaving">
                            <option value="">(None)</option>
                            @foreach (var group in availableGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Type</label>
                        <InputSelect @bind-Value="editTag.TypeId" @bind-Value:after="OnInputTypeChanged" class="@InputCss" disabled="@isSaving">
                            @foreach (var type in inputTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-3">
                        <label class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-slate-200">
                            <InputCheckbox @bind-Value="editTag.IsRequired" class="@CheckboxCss" disabled="@isSaving" />
                            Required
                        </label>
                        @if (!IsRepeatableLockedForCurrentType || editTag.IsRepeatable)
                        {
                            <label class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-slate-200">
                                <InputCheckbox @bind-Value="editTag.IsRepeatable" class="@CheckboxCss" disabled="@(isSaving || IsRepeatableLockedForCurrentType)" />
                                Repeatable
                            </label>
                        }
                        <label class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-slate-200">
                            <InputCheckbox @bind-Value="editTag.IsRange" class="@CheckboxCss" disabled="@isSaving" />
                            Range
                        </label>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Time Granularity</label>
                        <InputSelect @bind-Value="editTag.TimeGranularity" class="@InputCss" disabled="@isSaving">
                            @foreach (var granularity in OrderedGranularityOptions)
                            {
                                <option value="@granularity">@granularity</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Default Value</label>
                            <InputText @bind-Value="editTag.DefaultValue" class="@InputCss" disabled="@isSaving" />
                        </div>
                        @if (!IsMinimumLockedForCurrentType || editTag.MinValue.HasValue)
                        {
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Min Value</label>
                                <InputNumber @bind-Value="editTag.MinValue" class="@InputCss" TValue="double?" disabled="@(isSaving || IsMinimumLockedForCurrentType)" />
                            </div>
                        }
                        @if (!IsMaximumLockedForCurrentType || editTag.MaxValue.HasValue)
                        {
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Max Value</label>
                                <InputNumber @bind-Value="editTag.MaxValue" class="@InputCss" TValue="double?" disabled="@(isSaving || IsMaximumLockedForCurrentType)" />
                            </div>
                        }
                        @if (!IsStepLockedForCurrentType || editTag.Step.HasValue)
                        {
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Step</label>
                                <InputNumber @bind-Value="editTag.Step" class="@InputCss" TValue="double?" disabled="@(isSaving || IsStepLockedForCurrentType)" />
                            </div>
                        }
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Unit (optional)</label>
                        @if (availableUnits.Count > 0)
                        {
                            <InputSelect @bind-Value="editTag.UnitId" class="@InputCss" TValue="int?" disabled="@isSaving">
                                <option value="">(None)</option>
                                @foreach (var unit in availableUnits)
                                {
                                    <option value="@unit.Id">@unit.Symbol (@unit.QuantityKey)</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <div class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-800 shadow-xs dark:border-sky-500/40 dark:bg-sky-500/20 dark:text-sky-200">
                                No units yet. <a href="/units" class="font-semibold underline">Let's create your first unit.</a>
                            </div>
                        }
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Option List (optional)</label>
                        @if (availableOptionLists.Count > 0)
                        {
                            <InputSelect @bind-Value="editTag.OptionListId" class="@InputCss" TValue="int?" disabled="@isSaving">
                                <option value="">(None)</option>
                                @foreach (var list in availableOptionLists)
                                {
                                    <option value="@list.Id">@list.Name</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <div class="rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-sm text-violet-800 shadow-xs dark:border-violet-500/40 dark:bg-violet-500/20 dark:text-violet-200">
                                No option lists yet. <a href="/option-lists" class="font-semibold underline">Let's create your first list.</a>
                            </div>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            }
                            Save Changes
                        </button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="GoBack" disabled="@isSaving">
                            Cancel
                        </button>
                    </div>
                </div>
            </EditForm>
        </section>

    }
</div>


@code {
    [Parameter]
    public int Id { get; set; }

    private static readonly IReadOnlyList<TimeGranularity> OrderedGranularityOptions = Enum
        .GetValues<TimeGranularity>()
        .OrderBy(g => g == TimeGranularity.Daily ? 0 : g == TimeGranularity.Exact ? 2 : 1)
        .ThenBy(g => g.ToString())
        .ToArray();

    private const string InputCss = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100";
    private const string CheckboxCss = "h-4 w-4 rounded-sm border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800";

    private TagRequest? editTag;
    private List<InputTypeDto> inputTypes = new();
    private List<UnitResponse> availableUnits = new();
    private List<TagOptionListResponse> availableOptionLists = new();
    private List<TagGroupResponse> availableGroups = new();
    private string? tagTitle;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Edit Tag");

        try
        {
            inputTypes = await ActivityApi.GetInputTypesAsync();
            var tag = await ActivityApi.GetTagById(Id);

            var bareName = tag.GroupName != null && tag.Title.StartsWith(tag.GroupName + ": ", StringComparison.Ordinal)
                ? tag.Title[(tag.GroupName.Length + 2)..]
                : tag.Title;

            editTag = new TagRequest
            {
                Tag = bareName,
                Description = tag.Description,
                TypeId = ResolveTypeId(tag.TypeId),
                IsRequired = tag.IsRequired,
                IsRepeatable = tag.IsRepeatable,
                TimeGranularity = tag.TimeGranularity,
                IsRange = tag.IsRange,
                UnitId = tag.UnitId,
                MinValue = tag.MinValue,
                MaxValue = tag.MaxValue,
                Step = tag.Step,
                DefaultValue = tag.DefaultValue,
                OptionListId = tag.OptionListId,
                GroupId = tag.GroupId
            };

            EnsureValidTypeSelection();

            tagTitle = tag.Title;
            PageTitleService.SetTitle(tag.Title);

            await LoadSupportingData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tag: {ex.Message}";
            Logger.LogError(ex, "Error loading tag");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSupportingData()
    {
        try
        {
            availableGroups = (await TagGroupApi.GetTagGroups())
                .OrderBy(g => g.DisplayOrder ?? int.MaxValue)
                .ThenBy(g => g.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tag groups");
        }

        try
        {
            availableUnits = (await ActivityApi.GetUnitsAsync())
                .OrderBy(u => u.QuantityKey)
                .ThenBy(u => u.Key)
                .ToList();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load units");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load units");
        }

        try
        {
            availableOptionLists = (await ActivityApi.GetTagOptionListsAsync())
                .OrderBy(l => l.Name)
                .ToList();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load option lists");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load option lists");
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        
        try
        {
            await ActivityApi.UpdateTag(Id, editTag!);
            Navigation.NavigateTo("/tags");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving tag: {ex.Message}";
            Logger.LogError(ex, "Error saving tag");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/tags");
    }

    private void EnsureValidTypeSelection()
    {
        if (editTag is null)
        {
            return;
        }

        editTag.TypeId = ResolveTypeId(editTag.TypeId);
    }

    private int ResolveTypeId(int? typeId)
    {
        if (typeId.HasValue && inputTypes.Any(it => it.Id == typeId.Value))
        {
            return typeId.Value;
        }

        return GetDefaultInputTypeId();
    }

    private int GetDefaultInputTypeId()
    {
        var integerType = inputTypes.FirstOrDefault(it => string.Equals(it.Name, "Integer", System.StringComparison.OrdinalIgnoreCase));

        return integerType?.Id ?? inputTypes.FirstOrDefault()?.Id ?? 0;
    }

    private bool IsRangeLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsRangeEditable;
        }
    }

    private bool IsStepLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsStepEditable;
        }
    }

    private bool IsMinimumLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsMinimumEditable;
        }
    }

    private bool IsMaximumLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsMaximumEditable;
        }
    }

    private bool IsRepeatableLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsRepeatableEditable;
        }
    }

    private void OnInputTypeChanged()
    {
        if (editTag == null) return;
        
        var selectedType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
        if (selectedType != null && !selectedType.IsRangeEditable)
        {
            // Auto-populate constraints for locked types
            var constraints = LogMyDay.Domain.Helpers.InputTypeDefaults.GetConstraintsForType(editTag.TypeId);
            editTag.MinValue = constraints.MinValue;
            editTag.MaxValue = constraints.MaxValue;
            editTag.Step = constraints.Step;
        }
        else
        {
            // Clear values when switching to editable type (unless they already have values)
            if (!editTag.MinValue.HasValue) editTag.MinValue = null;
            if (!editTag.MaxValue.HasValue) editTag.MaxValue = null;
            if (!editTag.Step.HasValue) editTag.Step = null;
        }
        
        // Auto-set IsRepeatable = false for locked types
        if (selectedType != null && !selectedType.IsRepeatableEditable)
        {
            editTag.IsRepeatable = false;
        }
        else if (!editTag.IsRepeatable)
        {
            // When switching to editable type, reset to true if currently false
            editTag.IsRepeatable = true;
        }

        StateHasChanged();
    }

}
