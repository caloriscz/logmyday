@page "/reports"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Enums
@using LogMyDay.Api.Application.Interfaces
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using LogMyDay.App.Services
@using LogMyDay.App.Components.Shared
@using LogMyDay.App.Models
@inject IExcelExportService ExcelExportService
@inject LogMyDay.Shared.Interfaces.IAuthApi AuthApi
@inject IJSRuntime JSRuntime
@inject ILogger<Reports> Logger
@inject IPageTitleService PageTitleService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Reports", "Generate activity reports")]

<div class="mx-auto max-w-screen-2xl px-4 py-6 space-y-6 sm:px-6 lg:px-8">
    <div class="space-y-2">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">
            Reports & Exports
        </h1>
        <p class="text-sm text-gray-600 dark:text-slate-300">Generate and download activity reports in various formats.</p>
    </div>

    @if (!string.IsNullOrEmpty(state.StatusMessage))
    {
        <div class="rounded-lg border @(state.IsError ? "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200" : "border-green-200 bg-green-50 text-green-700 dark:border-green-500/40 dark:bg-green-500/20 dark:text-green-200") px-4 py-3 shadow-sm">
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-2">
                    <Icon Name="@(state.IsError ? "exclamation-triangle" : "check-circle")" Class="h-5 w-5 mt-0.5 flex-shrink-0" />
                    <span class="text-sm">@state.StatusMessage</span>
                </div>
                <button type="button" class="text-current hover:opacity-70 transition-opacity" @onclick="() => state.ClearStatus()">
                    <Icon Name="close" Class="h-5 w-5" />
                    <span class="sr-only">Close</span>
                </button>
            </div>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-2">
        <!-- Excel Export Section -->
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 bg-sky-600 px-6 py-4 text-white dark:border-slate-700 rounded-t-xl">
                <h2 class="text-lg font-semibold flex items-center gap-2">
                    <Icon Name="document" Class="h-5 w-5" />
                    Excel Reports
                </h2>
            </div>
            <div class="p-6 space-y-4">
                <p class="text-sm text-gray-700 dark:text-slate-200">
                    Generate Excel reports with activities data for selected tags.
                </p>

                <!-- Tag Selection -->
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200">
                        Select Tags:
                        @if (state.ExcelSelectedTagIds.Any())
                        {
                            <span class="font-normal text-gray-600 dark:text-slate-400">@string.Join(", ", availableTags?.Where(t => state.ExcelSelectedTagIds.Contains(t.Id)).Select(t => t.Title) ?? Array.Empty<string>())</span>
                        }
                    </label>
                    @if (availableTags != null && availableTags.Any())
                    {
                        <div class="max-h-72 overflow-y-auto rounded-lg border border-gray-300 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
                            @foreach (var tag in availableTags)
                            {
                                <div class="flex items-center gap-2 py-1">
                                    <input type="checkbox"
                                           id="excel-tag-@tag.Id"
                                           checked="@state.ExcelSelectedTagIds.Contains(tag.Id)"
                                           @onchange="@((e) => state.ToggleExcelTag(tag.Id, (bool)e.Value!))"
                                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800" />
                                    <label for="excel-tag-@tag.Id" class="text-sm text-gray-700 dark:text-slate-200">
                                        @tag.Title
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-sm text-gray-500 dark:text-slate-400">Loading tags…</div>
                    }
                </div>

                <!-- All Data Checkbox -->
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="excel-all-data" @bind="state.ExcelIncludeAllData"
                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800" />
                    <label for="excel-all-data" class="text-sm text-gray-700 dark:text-slate-200">Include all available data</label>
                </div>

                <!-- Date Range Presets -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Date Range:</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.ExcelPreset == ReportDatePreset.Custom && !state.ExcelIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetExcelDatePreset(ReportDatePreset.Custom)">
                            Custom
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.ExcelPreset == ReportDatePreset.LastMonth && !state.ExcelIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetExcelDatePreset(ReportDatePreset.LastMonth)">
                            Last Month
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.ExcelPreset == ReportDatePreset.LastQuarter && !state.ExcelIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetExcelDatePreset(ReportDatePreset.LastQuarter)">
                            Last Quarter
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.ExcelPreset == ReportDatePreset.LastYear && !state.ExcelIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetExcelDatePreset(ReportDatePreset.LastYear)">
                            Last Year
                        </button>
                    </div>
                </div>

                <!-- Custom Date Range -->
                @if (!state.ExcelIncludeAllData)
                {
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Start Date:</label>
                            <CultureAwareDatePicker Value="@state.ExcelStartDate" ValueChanged="@((DateTime? v) => state.ExcelStartDate = v ?? DateTime.Today)" EnableTime="false" Stretch="true" />
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">End Date:</label>
                            <CultureAwareDatePicker Value="@state.ExcelEndDate" ValueChanged="@((DateTime? v) => state.ExcelEndDate = v ?? DateTime.Today)" EnableTime="false" Stretch="true" />
                        </div>
                    </div>
                }

                <!-- Freeze First Row Option -->
                <div class="flex items-center gap-2">
                    <input type="checkbox"
                           id="freezeFirstRow"
                           @bind="state.FreezeFirstRow"
                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800" />
                    <label for="freezeFirstRow" class="text-sm text-gray-700 dark:text-slate-200">
                        Freeze first row (header)
                    </label>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
                            @onclick="GenerateExcelReport"
                            disabled="@(!state.ExcelSelectedTagIds.Any() || state.IsGeneratingExcel)">
                        @if (state.IsGeneratingExcel)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <Icon Name="document" Class="h-4 w-4" />
                            <span>Generate</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- HTML Export Section -->
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 bg-purple-600 px-6 py-4 text-white dark:border-slate-700 rounded-t-xl">
                <h2 class="text-lg font-semibold flex items-center gap-2">
                    <Icon Name="file-text" Class="h-5 w-5" />
                    HTML Reports
                </h2>
            </div>
            <div class="p-6 space-y-4">
                <p class="text-sm text-gray-700 dark:text-slate-200">
                    Generate clean HTML reports with activities grouped by day.
                </p>

                <!-- Tag Selection for HTML -->
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700 dark:text-slate-200">
                        Select Tags:
                        @if (state.HtmlSelectedTagIds.Any())
                        {
                            <span class="font-normal text-gray-600 dark:text-slate-400">@string.Join(", ", availableTags?.Where(t => state.HtmlSelectedTagIds.Contains(t.Id)).Select(t => t.Title) ?? Array.Empty<string>())</span>
                        }
                    </label>
                    @if (availableTags != null && availableTags.Any())
                    {
                        <div class="max-h-72 overflow-y-auto rounded-lg border border-gray-300 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
                            @foreach (var tag in availableTags)
                            {
                                <div class="flex items-center gap-2 py-1">
                                    <input type="checkbox"
                                           id="html-tag-@tag.Id"
                                           checked="@state.HtmlSelectedTagIds.Contains(tag.Id)"
                                           @onchange="@((e) => state.ToggleHtmlTag(tag.Id, (bool)e.Value!))"
                                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800" />
                                    <label for="html-tag-@tag.Id" class="text-sm text-gray-700 dark:text-slate-200">
                                        @tag.Title
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-sm text-gray-500 dark:text-slate-400">Loading tags…</div>
                    }
                </div>

                <!-- All Data Checkbox -->
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="html-all-data" @bind="state.HtmlIncludeAllData"
                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800" />
                    <label for="html-all-data" class="text-sm text-gray-700 dark:text-slate-200">Include all available data</label>
                </div>

                <!-- Date Range Presets for HTML -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Date Range:</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.HtmlPreset == ReportDatePreset.Custom && !state.HtmlIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetHtmlDatePreset(ReportDatePreset.Custom)">
                            Custom
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.HtmlPreset == ReportDatePreset.LastMonth && !state.HtmlIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetHtmlDatePreset(ReportDatePreset.LastMonth)">
                            Last Month
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.HtmlPreset == ReportDatePreset.LastQuarter && !state.HtmlIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetHtmlDatePreset(ReportDatePreset.LastQuarter)">
                            Last Quarter
                        </button>
                        <button type="button"
                                class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors @(state.HtmlPreset == ReportDatePreset.LastYear && !state.HtmlIncludeAllData ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700 dark:hover:bg-slate-700")"
                                @onclick="() => SetHtmlDatePreset(ReportDatePreset.LastYear)">
                            Last Year
                        </button>
                    </div>
                </div>

                <!-- Date Range for HTML -->
                @if (!state.HtmlIncludeAllData)
                {
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Start Date:</label>
                            <CultureAwareDatePicker Value="@state.HtmlStartDate" ValueChanged="@((DateTime? v) => state.HtmlStartDate = v ?? DateTime.Today)" EnableTime="false" Stretch="true" />
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">End Date:</label>
                            <CultureAwareDatePicker Value="@state.HtmlEndDate" ValueChanged="@((DateTime? v) => state.HtmlEndDate = v ?? DateTime.Today)" EnableTime="false" Stretch="true" />
                        </div>
                    </div>
                }

                <!-- Output Format -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Output Format:</label>
                    <select @bind="state.HtmlFormat" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="@HtmlExportFormat.List">List Format</option>
                        <option value="@HtmlExportFormat.Table">Table Format</option>
                    </select>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
                            @onclick="GenerateHtmlReport"
                            disabled="@(!state.HtmlSelectedTagIds.Any() || state.IsGeneratingHtml)">
                        @if (state.IsGeneratingHtml)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <Icon Name="file-text" Class="h-4 w-4" />
                            <span>Generate</span>
                        }
                    </button>
                </div>

                @if (state.GeneratedYears.Any())
                {
                    <div class="mt-3 text-sm text-gray-600 dark:text-slate-400">
                        <span class="font-medium">Years:</span>
                        @foreach (var year in state.GeneratedYears.OrderBy(y => y))
                        {
                            <a href="#year-@year" class="ml-2 text-primary-600 dark:text-primary-400 hover:underline">@year</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ReportPageState state = new();
    private List<TagResponse>? availableTags;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reports & Exports");
        await LoadAvailableTags();
    }

    private async Task LoadAvailableTags()
    {
        try
        {
            var currentUser = await AuthApi.GetCurrentUserAsync();

            if (currentUser?.Id != null)
            {
                availableTags = await ExcelExportService.GetAvailableTags(currentUser.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load available tags");
        }
    }

    private void SetExcelDatePreset(ReportDatePreset preset)
    {
        state.ExcelPreset = preset;
        state.ExcelIncludeAllData = false;
        var (start, end, display) = state.CalculateDateRange(preset);
        state.ExcelStartDate = start;
        state.ExcelEndDate = end;
    }

    private void SetHtmlDatePreset(ReportDatePreset preset)
    {
        state.HtmlPreset = preset;
        state.HtmlIncludeAllData = false;
        var (start, end, display) = state.CalculateDateRange(preset);
        state.HtmlStartDate = start;
        state.HtmlEndDate = end;
    }
    private async Task GenerateExcelReport()
    {
        if (!state.ExcelSelectedTagIds.Any()) return;

        state.IsGeneratingExcel = true;
        state.ClearStatus();

        try
        {
            var currentUser = await AuthApi.GetCurrentUserAsync();

            var request = new ExcelExportRequest
            {
                TagIds = state.ExcelSelectedTagIds,
                StartDate = state.ExcelIncludeAllData ? null : state.ExcelStartDate,
                EndDate = state.ExcelIncludeAllData ? null : state.ExcelEndDate,
                UserId = currentUser.Id,
                FreezeFirstRow = state.FreezeFirstRow
            };

            var result = await ExcelExportService.GenerateExcelReport(request);

            if (result.Success && result.FileContent != null)
            {
                await JSRuntime.InvokeVoidAsync("downloadFile",
                    result.FileName,
                    Convert.ToBase64String(result.FileContent),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

                state.SetStatus($"Excel report generated successfully! {result.Statistics.TotalActivities} activities included.", false);
            }
            else
            {
                state.SetStatus($"Excel generation failed: {result.Message}", true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Excel generation failed");
            state.SetStatus($"Excel generation failed: {ex.Message}", true);
        }
        finally
        {
            state.IsGeneratingExcel = false;
        }
    }

    private async Task GenerateHtmlReport()
    {
        if (!state.HtmlSelectedTagIds.Any()) return;

        state.IsGeneratingHtml = true;
        state.ClearStatus();

        try
        {
            var currentUser = await AuthApi.GetCurrentUserAsync();

            var activities = await ExcelExportService.GetActivitiesForExport(new ExcelExportRequest
            {
                TagIds = state.HtmlSelectedTagIds,
                StartDate = state.HtmlIncludeAllData ? null : state.HtmlStartDate,
                EndDate = state.HtmlIncludeAllData ? null : state.HtmlEndDate,
                UserId = currentUser.Id
            });

            if (!activities.Any())
            {
                state.SetStatus("No activities found for the selected criteria", true);

                return;
            }

            var html = GenerateHtmlContent(activities);

            var htmlBytes = System.Text.Encoding.UTF8.GetBytes(html);
            var fileName = $"LogMyDay_Report_{DateTime.Now:yyyyMMdd_HHmmss}.html";

            await JSRuntime.InvokeVoidAsync("downloadFile",
                fileName,
                Convert.ToBase64String(htmlBytes),
                "text/html");

            state.SetStatus($"HTML report generated successfully! {activities.Count} activities included.", false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "HTML generation failed");
            state.SetStatus($"HTML generation failed: {ex.Message}", true);
        }
        finally
        {
            state.IsGeneratingHtml = false;
        }
    }
private string GenerateHtmlContent(List<ActivityExportRow> activities)
    {
        var sb = new System.Text.StringBuilder();
        
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang='en'>");
        sb.AppendLine("<head>");
        sb.AppendLine("    <meta charset='UTF-8'>");
        sb.AppendLine("    <meta name='viewport' content='width=device-width, initial-scale=1.0'>");
        sb.AppendLine("    <title>LogMyDay Activity Report</title>");
        sb.AppendLine("    <style>");
        sb.AppendLine("        * { margin: 0; padding: 0; box-sizing: border-box; }");
        sb.AppendLine("        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f5f5f5; padding: 20px; color: #333; line-height: 1.6; }");
        sb.AppendLine("        .container { max-width: 1400px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-radius: 8px; }");
        sb.AppendLine("        h1 { color: #2563eb; margin-bottom: 10px; font-size: 2em; }");
        sb.AppendLine("        .subtitle { color: #666; margin-bottom: 20px; font-size: 0.9em; }");
        sb.AppendLine("        .year-nav { margin-bottom: 30px; text-align: center; }");
        sb.AppendLine("        .year-nav a { color: #8b5cf6; text-decoration: none; margin: 0 8px; }");
        sb.AppendLine("        .year-nav a:hover { text-decoration: underline; }");
        sb.AppendLine("        .day { margin: 20px 0; padding: 15px; background: #fafafa; border-left: 4px solid #3b82f6; border-radius: 4px; }");
        sb.AppendLine("        .day-date { font-weight: 600; color: #1e40af; margin-bottom: 10px; font-size: 1.1em; }");
        sb.AppendLine("        .activities { margin-left: 20px; }");
        sb.AppendLine("        .activity-item { display: block; padding: 6px 0; border-bottom: 1px solid #f0f0f0; font-size: 0.9em; }");
        sb.AppendLine("        .activity-item:last-child { border-bottom: none; }");
        sb.AppendLine("        .activity-tag { color: #3730a3; font-weight: 600; }");
        sb.AppendLine("        .activity-desc { color: #475569; }");
        sb.AppendLine("        .activity-separator { color: #94a3b8; margin: 0 4px; }");
        sb.AppendLine("        .footer { margin-top: 50px; padding-top: 20px; border-top: 1px solid #e2e8f0; text-align: center; color: #94a3b8; font-size: 0.85em; }");
        
        if (state.HtmlFormat == HtmlExportFormat.Table)
        {
            sb.AppendLine("        table { width: 100%; border-collapse: collapse; margin: 20px 0; }");
            sb.AppendLine("        th, td { padding: 10px; text-align: left; border: 1px solid #e2e8f0; }");
            sb.AppendLine("        th { background-color: #f8fafc; font-weight: 600; }");
            sb.AppendLine("        td { background-color: white; }");
            sb.AppendLine("        .col-date { width: 120px; }");
            sb.AppendLine("        .col-tag { width: 200px; }");
            sb.AppendLine("        .col-desc { width: auto; }");
        }
        
        sb.AppendLine("        .year-heading-wrapper { display: flex; justify-content: space-between; align-items: baseline; margin: 40px 0 20px 0; padding-bottom: 10px; border-bottom: 3px solid #8b5cf6; }");
        sb.AppendLine("        .year-heading { font-size: 1.8em; font-weight: 700; color: #1e293b; margin: 0; }");
        sb.AppendLine("        .back-to-top { color: #8b5cf6; text-decoration: none; font-size: 0.9em; }");
        sb.AppendLine("        .back-to-top:hover { text-decoration: underline; }");
        sb.AppendLine("        @media print { body { background: white; padding: 0; } .container { box-shadow: none; padding: 20px; } }");
        sb.AppendLine("    </style>");
        sb.AppendLine("</head>");
        sb.AppendLine("<body>");
        sb.AppendLine("    <div id='top' class='container'>");
        sb.AppendLine("        <h1>LogMyDay Activity Report</h1>");
        sb.AppendLine($"        <div class='subtitle'>Generated on {DateTime.Now:MMMM dd, yyyy 'at' HH:mm}</div>");

        var years = activities.Select(a => a.DateStarted.Year).Distinct().OrderBy(y => y).ToList();
        if (years.Count > 0)
        {
            sb.Append("        <div class='year-nav'>Years: ");
            sb.Append(string.Join(" | ", years.Select(y => $"<a href='#year-{y}'>{y}</a>")));
            sb.AppendLine("</div>");
        }

        var groupedByYear = activities
            .OrderBy(a => a.DateStarted.Date)
            .GroupBy(a => a.DateStarted.Year);

        state.GeneratedYears = groupedByYear.Select(g => g.Key).ToList();

        foreach (var yearGroup in groupedByYear)
        {
            sb.AppendLine("        <div class='year-heading-wrapper'>");
            sb.AppendLine($"            <h2 id='year-{yearGroup.Key}' class='year-heading'>{yearGroup.Key}</h2>");
            sb.AppendLine("            <a href='#top' class='back-to-top'>↑ Back to top</a>");
            sb.AppendLine("        </div>");

            if (state.HtmlFormat == HtmlExportFormat.List)
            {
                var groupedByDate = yearGroup.GroupBy(a => a.DateStarted.Date);

                foreach (var dateGroup in groupedByDate)
                {
                    sb.AppendLine("        <div class='day'>");
                    sb.AppendLine($"            <div class='day-date'>{dateGroup.Key:dddd, MMMM dd, yyyy}</div>");
                    sb.AppendLine("            <div class='activities'>");

                    foreach (var activity in dateGroup.OrderBy(a => a.DateStarted))
                    {
                        sb.Append("                <div class='activity-item'>");
                        sb.Append($"<span class='activity-tag'>{System.Net.WebUtility.HtmlEncode(activity.Tag)}</span>");
                        
                        if (!string.IsNullOrWhiteSpace(activity.Description))
                        {
                            sb.Append("<span class='activity-separator'>-</span>");
                            sb.Append($"<span class='activity-desc'>{System.Net.WebUtility.HtmlEncode(activity.Description)}</span>");
                        }
                        
                        sb.AppendLine("</div>");
                    }

                    sb.AppendLine("            </div>");
                    sb.AppendLine("        </div>");
                }
            }
            else
            {
                sb.AppendLine("        <table>");
                sb.AppendLine("            <thead>");
                sb.AppendLine("                <tr>");
                sb.AppendLine("                    <th class='col-date'>Date</th>");
                sb.AppendLine("                    <th class='col-tag'>Tag</th>");
                sb.AppendLine("                    <th class='col-desc'>Description</th>");
                sb.AppendLine("                </tr>");
                sb.AppendLine("            </thead>");
                sb.AppendLine("            <tbody>");

                foreach (var activity in yearGroup.OrderBy(a => a.DateStarted))
                {
                    var showTime = activity.TimeGranularity == 0 || activity.TimeGranularity == 2;
                    var dateFormat = showTime ? "dd/MM HH:mm" : "dd/MM";
                    
                    sb.AppendLine("                <tr>");
                    sb.AppendLine($"                    <td class='col-date'>{activity.DateStarted.ToString(dateFormat)}</td>");
                    sb.AppendLine($"                    <td class='col-tag'>{System.Net.WebUtility.HtmlEncode(activity.Tag)}</td>");
                    sb.AppendLine($"                    <td class='col-desc'>{System.Net.WebUtility.HtmlEncode(activity.Description)}</td>");
                    sb.AppendLine("                </tr>");
                }

                sb.AppendLine("            </tbody>");
                sb.AppendLine("        </table>");
            }
        }

        sb.AppendLine($"        <div class='footer'>Report contains {activities.Count} activities | LogMyDay &copy; {DateTime.Now.Year} | <a href='#top' class='back-to-top'>↑ Back to top</a></div>");
        sb.AppendLine("    </div>");
        sb.AppendLine("</body>");
        sb.AppendLine("</html>");

        return sb.ToString();
    }
}
