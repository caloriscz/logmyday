    private string GetSelectedTagName()
    {
        if (!selectedTagId.HasValue)
            return "";

        var tag = numericTags.FirstOrDefault(t => t.Id == selectedTagId.Value);
        return tag?.Title ?? "";
    }

    private string FormatValue(decimal value)
    {
        if (selectedTagId.HasValue)
        {
            var selectedTag = numericTags.FirstOrDefault(t => t.Id == selectedTagId.Value);
            if (selectedTag?.InputTypeId.HasValue == true && 
                inputTypeNames.ContainsKey(selectedTag.InputTypeId.Value) &&
                inputTypeNames[selectedTag.InputTypeId.Value] == "Decimal")
            {
                return value.ToString("F2");
            }
        }
        return value.ToString("F0");
    }

    private string FormatAverageValue(decimal value)
    {
        return value.ToString("F2");
    }

    // Helper method to get all selected tags
    private List<TagResponse> GetSelectedTags()
    {
        var tags = new List<TagResponse>();
        
        if (selectedTagId.HasValue)
        {
            var tag = numericTags.FirstOrDefault(t => t.Id == selectedTagId.Value);
            if (tag != null)
                tags.Add(tag);
        }
        
        if (selectedTagId2.HasValue)
        {
            var tag = numericTags.FirstOrDefault(t => t.Id == selectedTagId2.Value);
            if (tag != null)
                tags.Add(tag);
        }
        
        if (selectedTagId3.HasValue)
        {
            var tag = numericTags.FirstOrDefault(t => t.Id == selectedTagId3.Value);
            if (tag != null)
                tags.Add(tag);
        }
        
        return tags;
    }

    // Helper method to determine Y-axis range based on InputTypeId
    private (decimal? min, decimal? max) GetYAxisRange()
    {
        if (!allSeriesData.Any())
            return (null, null);

        // Check if all selected tags have the same InputTypeId
        var inputTypeIds = allSeriesData.Select(s => s.InputTypeId).Distinct().ToList();
        
        if (inputTypeIds.Count != 1)
            return (null, null); // Mixed types - use auto-scaling

        var inputTypeId = inputTypeIds.First();
        
        // Force Y-axis ranges for specific types
        if (inputTypeId == InputTypeIds.Rating1To5)
            return (0, 5);
        
        if (inputTypeId == InputTypeIds.Rating1To10)
            return (0, 10);
        
        if (inputTypeId == InputTypeIds.Percentage)
            return (0, 100);
        
        return (null, null); // Auto-scale for other types
    }

    // Helper method to get chart title
    private string GetChartTitle()
    {
        var selectedTags = GetSelectedTags();
        
        if (!selectedTags.Any())
            return "Chart";
        
        if (selectedTags.Count == 1)
            return selectedTags[0].Title;
        
        return string.Join(" vs ", selectedTags.Select(t => t.Title));
    }

    // Data class for multi-series support
    private class SeriesData
    {
        public string TagName { get; set; } = string.Empty;
        public int TagId { get; set; }
        public int InputTypeId { get; set; }
        public SeriesType ChartType { get; set; } = SeriesType.Line;
        public List<ChartDataPoint> DataPoints { get; set; } = new();
    }

    private class ChartDataPoint
    {
        public decimal Value { get; set; }
        public DateTime Date { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("cleanupThemeListener");
                await jsModule.DisposeAsync();
            }
            catch { }
        }
        
        dotNetReference?.Dispose();
    }
