@page "/charts"
@using LogMyDay.Shared.Interfaces
@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@using LogMyDay.Domain.Constants
@inject IActivityApi ActivityApi
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@_pageTitle</PageTitle>

<div class="mx-auto max-w-screen-2xl space-y-8 px-4 py-6 sm:px-6 lg:px-8">
    <div class="space-y-2">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Charts</h2>
        <p class="text-sm text-gray-600 dark:text-slate-300">Visualize numeric tag data with interactive line charts.</p>
    </div>

    <!-- Tag Selection and Date Range Filter Card -->
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="space-y-4">
            <!-- Tag Selection Row with Chart Types -->
            <div class="flex flex-col gap-4">
                <!-- Tag 1 -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
                    <div class="flex-1">
                        <label for="tagSelect1" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Primary tag</label>
                        <select id="tagSelect1" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedTagId" @bind:after="OnTag1Changed">
                            <option value="">-- Select a tag --</option>
                            @foreach (var tag in numericTags)
                            {
                                var inputTypeName = tag.InputTypeId.HasValue && inputTypeNames.ContainsKey(tag.InputTypeId.Value) 
                                    ? inputTypeNames[tag.InputTypeId.Value] 
                                    : "Unknown";
                                <option value="@tag.Id">@tag.Title (@inputTypeName)</option>
                            }
                        </select>
                    </div>
                    <div class="w-full sm:w-32">
                        <label for="chartType1" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Chart</label>
                        <select id="chartType1" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedChartType1" @bind:after="SaveChartType1Preference">
                            <option value="line">Line</option>
                            <option value="bar">Bar</option>
                        </select>
                    </div>
                </div>
                
                <!-- Tag 2 -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
                    <div class="flex-1">
                        <label for="tagSelect2" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Tag 2 (Optional)</label>
                        <select id="tagSelect2" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedTagId2" @bind:after="OnTag2Changed">
                            <option value="">-- Select tag (Optional) --</option>
                            @foreach (var tag in numericTags)
                            {
                                var inputTypeName = tag.InputTypeId.HasValue && inputTypeNames.ContainsKey(tag.InputTypeId.Value) 
                                    ? inputTypeNames[tag.InputTypeId.Value] 
                                    : "Unknown";
                                <option value="@tag.Id">@tag.Title (@inputTypeName)</option>
                            }
                        </select>
                    </div>
                    <div class="w-full sm:w-32">
                        <label for="chartType2" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Chart</label>
                        <select id="chartType2" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedChartType2" @bind:after="SaveChartType2Preference" disabled="@(!selectedTagId2.HasValue)">
                            <option value="line">Line</option>
                            <option value="bar">Bar</option>
                        </select>
                    </div>
                </div>
                
                <!-- Tag 3 -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
                    <div class="flex-1">
                        <label for="tagSelect3" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Tag 3 (Optional)</label>
                        <select id="tagSelect3" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedTagId3" @bind:after="OnTag3Changed">
                            <option value="">-- Select tag (Optional) --</option>
                            @foreach (var tag in numericTags)
                            {
                                var inputTypeName = tag.InputTypeId.HasValue && inputTypeNames.ContainsKey(tag.InputTypeId.Value) 
                                    ? inputTypeNames[tag.InputTypeId.Value] 
                                    : "Unknown";
                                <option value="@tag.Id">@tag.Title (@inputTypeName)</option>
                            }
                        </select>
                    </div>
                    <div class="w-full sm:w-32">
                        <label for="chartType3" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Chart</label>
                        <select id="chartType3" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedChartType3" @bind:after="SaveChartType3Preference" disabled="@(!selectedTagId3.HasValue)">
                            <option value="line">Line</option>
                            <option value="bar">Bar</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <!-- Filter and Options Row -->
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                <div class="w-full sm:w-48">
                    <label for="dateRangeSelect" class="mb-2 block text-sm font-medium text-gray-900 dark:text-slate-100">Date Range</label>
                    <select id="dateRangeSelect" class="form-select w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" @bind="selectedDateRange">
                        <option value="all">All Time</option>
                        <option value="last-month">Last Month</option>
                        <option value="last-quarter">Last Quarter</option>
                        <option value="last-year">Last Year</option>
                        @foreach (var year in availableYears)
                        {
                            <option value="year-@year">@year</option>
                        }
                        @foreach (var month in availableMonths)
                        {
                            <option value="@month.Value">@month.Key</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary flex items-center gap-2 whitespace-nowrap" @onclick="LoadChartData" disabled="@(!CanLoadData)">
                    <Icon Name="chart-bar" Class="w-4 h-4" />
                    Load Chart
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-xl border border-gray-200 bg-white p-12 text-center shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="flex flex-col items-center gap-4">
                <div class="spinner"></div>
                <p class="text-sm text-gray-600 dark:text-slate-300">Loading chart data...</p>
            </div>
        </div>
    }
    else if (dataLoaded && allSeriesData != null && allSeriesData.Any())
    {
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="p-5">
                <div class="mb-4 flex items-center justify-between">
                    <h5 class="text-lg font-semibold text-gray-900 dark:text-slate-100">
                        @GetChartTitle()
                    </h5>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-600 dark:text-slate-400">
                            @(allSeriesData.Sum(s => s.DataPoints.Count)) data point@(allSeriesData.Sum(s => s.DataPoints.Count) != 1 ? "s" : "")
                        </span>
                    </div>
                </div>
                
                @if (chartOptions != null && allSeriesData != null && allSeriesData.Any())
                {
                    <ApexChart TItem="ChartDataPoint" 
                               Options="@chartOptions"
                               @ref="chart">
                        
                        @foreach (var seriesData in allSeriesData)
                        {
                            <ApexPointSeries TItem="ChartDataPoint"
                                            Items="@seriesData.DataPoints"
                                            Name="@seriesData.TagName"
                                            SeriesType="@seriesData.ChartType"
                                            XValue="@(e => e.Date.ToString("yyyy-MM-dd"))"
                                            YValue="@(e => (decimal?)e.Value)"
                                            OrderBy="@(e => e.X)" />
                        }
                    </ApexChart>
                }
            </div>
        </div>

        <!-- Statistics Summary Card -->
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="p-5">
                <h5 class="mb-4 text-sm font-medium opacity-75">Quick Statistics</h5>
                @if (allSeriesData != null && allSeriesData.Any())
                {
                    var allPoints = allSeriesData.SelectMany(s => s.DataPoints).ToList();
                    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                        <div>
                            <div class="text-xs text-gray-600 dark:text-slate-400">Minimum</div>
                            <div class="text-xl font-bold text-gray-900 dark:text-slate-100">@FormatValue(allPoints.Min(d => d.Value))</div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-600 dark:text-slate-400">Maximum</div>
                            <div class="text-xl font-bold text-gray-900 dark:text-slate-100">@FormatValue(allPoints.Max(d => d.Value))</div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-600 dark:text-slate-400">Average</div>
                            <div class="text-xl font-bold text-gray-900 dark:text-slate-100">@FormatAverageValue(allPoints.Average(d => d.Value))</div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-600 dark:text-slate-400">Total Data Points</div>
                            <div class="text-xl font-bold text-gray-900 dark:text-slate-100">@allPoints.Count</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (dataLoaded && (allSeriesData == null || !allSeriesData.Any()))
    {
        <div class="rounded-xl border border-yellow-200 bg-yellow-50 p-4 dark:border-yellow-900 dark:bg-yellow-950">
            <div class="flex items-start gap-3">
                <Icon Name="information-circle" Class="w-5 h-5 text-yellow-600 dark:text-yellow-400" />
                <p class="text-sm text-yellow-800 dark:text-yellow-200">
                    No numeric data found for the selected tag(s) and date range.
                </p>
            </div>
        </div>
    }
    else if (!dataLoaded)
    {
        <div class="rounded-xl border border-blue-200 bg-blue-50 p-4 dark:border-blue-900 dark:bg-blue-950">
            <div class="flex items-start gap-3">
                <Icon Name="information-circle" Class="w-5 h-5 text-blue-600 dark:text-blue-400" />
                <p class="text-sm text-blue-800 dark:text-blue-200">
                    Select a numeric tag and click "Load Chart" to visualize your data.
                </p>
            </div>
        </div>
    }
</div>

@code {
    private string _pageTitle = "Charts";
    private List<TagResponse> numericTags = new();
    private Dictionary<int, string> inputTypeNames = new();
    private int? selectedTagId;
    private int? selectedTagId2;
    private int? selectedTagId3;
    private string selectedChartType1 = "line";
    private string selectedChartType2 = "line";
    private string selectedChartType3 = "line";
    private string selectedDateRange = "all";
    private bool dataLoaded = false;
    private bool isLoading = false;
    private List<SeriesData> allSeriesData = new();
    private List<int> availableYears = new();
    private Dictionary<string, string> availableMonths = new();
    private ApexChart<ChartDataPoint>? chart;
    private ApexChartOptions<ChartDataPoint>? chartOptions;
    private bool isDarkMode = false;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<Charts>? dotNetReference;
    private bool themeDetected = false;

    private bool CanLoadData => selectedTagId.HasValue && themeDetected;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Charts");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadNumericTags();
            await DetectTheme();
            await SetupThemeChangeListener();
            themeDetected = true;
            await LoadPreferences();
            StateHasChanged();
        }
    }

    private async Task SetupThemeChangeListener()
    {
        try
        {
            dotNetReference = DotNetObjectReference.Create(this);
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-listener.js");
            await jsModule.InvokeVoidAsync("setupThemeListener", dotNetReference);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up theme listener: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnThemeChanged(bool isDark)
    {
        Console.WriteLine($"OnThemeChanged called: isDark = {isDark}");
        isDarkMode = isDark;
        
        if (dataLoaded && allSeriesData != null && allSeriesData.Any() && chart != null && chartOptions != null)
        {
            Console.WriteLine($"Updating chart theme to: {(isDark ? "dark" : "light")}");
            
            // Update theme settings on existing options object
            chartOptions.Theme ??= new Theme();
            chartOptions.Theme.Mode = isDark ? Mode.Dark : Mode.Light;
            
            chartOptions.Chart ??= new Chart();
            chartOptions.Chart.Background = isDark ? "#1e293b" : "#ffffff";
            chartOptions.Chart.ForeColor = isDark ? "#e2e8f0" : "#374151";
            
            chartOptions.Grid ??= new Grid();
            chartOptions.Grid.BorderColor = isDark ? "#334155" : "#e2e8f0";
            
            // Update tooltip custom formatter for theme
            UpdateTooltipFormatter();
            
            // Force complete chart re-render with new theme options
            await chart.RenderAsync();
            
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"Chart not ready for theme update. dataLoaded={dataLoaded}, hasData={allSeriesData?.Any()}, hasChart={chart != null}");
        }
    }
    
    private void UpdateTooltipFormatter()
    {
        if (chartOptions?.Tooltip == null) return;
        
        var hasDecimalType = allSeriesData.Any(s => 
            inputTypeNames.ContainsKey(s.InputTypeId) && 
            inputTypeNames[s.InputTypeId] == "Decimal");
        
        chartOptions.Tooltip.Custom = GetTooltipFormatterForMultiSeries(hasDecimalType, isDarkMode);
    }

    private async Task DetectTheme()
    {
        try
        {
            // Check the actual dark class on html element, not localStorage
            isDarkMode = await JS.InvokeAsync<bool>("eval", "document.documentElement.classList.contains('dark')");
            Console.WriteLine($"Theme detected from HTML class: isDarkMode = {isDarkMode}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error detecting theme: {ex.Message}");
            isDarkMode = false;
        }
    }

    private async Task LoadNumericTags()
    {
        try
        {
            // Load all input types to get their names
            var inputTypes = await ActivityApi.GetInputTypesAsync();
            inputTypeNames = inputTypes.ToDictionary(it => it.Id, it => it.Name);
            
            // Find the IDs for numeric input types
            var integerTypeId = inputTypes.FirstOrDefault(it => it.Name == "Integer")?.Id;
            var decimalTypeId = inputTypes.FirstOrDefault(it => it.Name == "Decimal")?.Id;
            var rating5TypeId = inputTypes.FirstOrDefault(it => it.Name == "Rating 1-5")?.Id;
            var rating10TypeId = inputTypes.FirstOrDefault(it => it.Name == "Rating 1-10")?.Id;
            var percentageTypeId = inputTypes.FirstOrDefault(it => it.Name == "Percentage")?.Id;
            
            // Load tags and filter by numeric input types
            var allTags = await ActivityApi.GetTags();
            numericTags = allTags
                .Where(t => t.InputTypeId.HasValue && 
                           (t.InputTypeId == integerTypeId || 
                            t.InputTypeId == decimalTypeId ||
                            t.InputTypeId == rating5TypeId ||
                            t.InputTypeId == rating10TypeId ||
                            t.InputTypeId == percentageTypeId))
                .OrderBy(t => t.Title)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tags: {ex.Message}");
        }
    }

    private async Task LoadPreferences()
    {
        try
        {
            var savedTagIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "charts_selectedTag");
            var savedTagId2Str = await JS.InvokeAsync<string>("localStorage.getItem", "charts_selectedTag2");
            var savedTagId3Str = await JS.InvokeAsync<string>("localStorage.getItem", "charts_selectedTag3");
            var savedDateRange = await JS.InvokeAsync<string>("localStorage.getItem", "charts_dateRange");
            
            if (!string.IsNullOrEmpty(savedTagIdStr) && int.TryParse(savedTagIdStr, out var savedTagId) && 
                numericTags.Any(t => t.Id == savedTagId))
            {
                selectedTagId = savedTagId;
            }

            if (!string.IsNullOrEmpty(savedTagId2Str) && int.TryParse(savedTagId2Str, out var savedTagId2) && 
                numericTags.Any(t => t.Id == savedTagId2))
            {
                selectedTagId2 = savedTagId2;
            }

            if (!string.IsNullOrEmpty(savedTagId3Str) && int.TryParse(savedTagId3Str, out var savedTagId3) && 
                numericTags.Any(t => t.Id == savedTagId3))
            {
                selectedTagId3 = savedTagId3;
            }

            // Load chart types for each tag
            var savedChartType1 = await JS.InvokeAsync<string>("localStorage.getItem", "charts_chartType1");
            if (!string.IsNullOrEmpty(savedChartType1) && (savedChartType1 == "line" || savedChartType1 == "bar"))
            {
                selectedChartType1 = savedChartType1;
            }

            var savedChartType2 = await JS.InvokeAsync<string>("localStorage.getItem", "charts_chartType2");
            if (!string.IsNullOrEmpty(savedChartType2) && (savedChartType2 == "line" || savedChartType2 == "bar"))
            {
                selectedChartType2 = savedChartType2;
            }

            var savedChartType3 = await JS.InvokeAsync<string>("localStorage.getItem", "charts_chartType3");
            if (!string.IsNullOrEmpty(savedChartType3) && (savedChartType3 == "line" || savedChartType3 == "bar"))
            {
                selectedChartType3 = savedChartType3;
            }

            if (!string.IsNullOrEmpty(savedDateRange))
            {
                selectedDateRange = savedDateRange;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading preferences: {ex.Message}");
        }
    }

    private async Task OnTag1Changed()
    {
        await OnTagChanged(selectedTagId, "charts_selectedTag");
    }

    private async Task SaveChartType1Preference()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "charts_chartType1", selectedChartType1);
    }

    private async Task SaveChartType2Preference()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "charts_chartType2", selectedChartType2);
    }

    private async Task SaveChartType3Preference()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "charts_chartType3", selectedChartType3);
    }

    private async Task OnTag2Changed()
    {
        if (await ValidateTagSelection(selectedTagId2, 2))
        {
            await OnTagChanged(selectedTagId2, "charts_selectedTag2");
        }
        else
        {
            selectedTagId2 = null;
        }
    }

    private async Task OnTag3Changed()
    {
        if (await ValidateTagSelection(selectedTagId3, 3))
        {
            await OnTagChanged(selectedTagId3, "charts_selectedTag3");
        }
        else
        {
            selectedTagId3 = null;
        }
    }

    private async Task<bool> ValidateTagSelection(int? tagId, int tagSlot)
    {
        if (!tagId.HasValue) return true;

        // Check for duplicates
        var selectedTags = new[] { selectedTagId, selectedTagId2, selectedTagId3 }
            .Where((t, i) => t.HasValue && i != tagSlot - 1)
            .Select(t => t!.Value)
            .ToList();

        if (selectedTags.Contains(tagId.Value))
        {
            await JS.InvokeVoidAsync("console.warn", $"Tag already selected. Please choose a different tag.");
            return false;
        }

        return true;
    }

    private async Task OnTagChanged(int? tagId, string storageKey)
    {
        try
        {
            if (tagId.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", storageKey, tagId.Value.ToString());
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", storageKey);
            }

            dataLoaded = false;
            allSeriesData = new List<SeriesData>();
            availableYears.Clear();
            availableMonths.Clear();
            selectedDateRange = "all";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving tag preference: {ex.Message}");
        }
    }

    private async Task LoadChartData()
    {
        if (!selectedTagId.HasValue)
            return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var selectedTags = GetSelectedTags();
            allSeriesData = new List<SeriesData>();
            var allCombinedDataPoints = new List<ChartDataPoint>();

            // Chart types for each position
            var chartTypes = new[] { selectedChartType1, selectedChartType2, selectedChartType3 };
            var tagIndex = 0;

            // Load data for each selected tag
            foreach (var tag in selectedTags)
            {
                var result = await ActivityApi.GetActivities(
                    pageNumber: 1,
                    pageSize: 10000,
                    orderBy: "asc",
                    tagId: tag.Id
                );
                
                var activities = result.Items.ToList();
                
                if (!activities.Any())
                    continue;

                // Parse numeric values and create chart data points
                var dataPoints = activities
                    .Where(a => !string.IsNullOrEmpty(a.Description) && 
                               decimal.TryParse(a.Description, System.Globalization.NumberStyles.Float, 
                                              System.Globalization.CultureInfo.InvariantCulture, out _))
                    .Select(a => new ChartDataPoint
                    { 
                        Value = decimal.Parse(a.Description!, System.Globalization.CultureInfo.InvariantCulture),
                        Date = a.DateStarted.Date
                    })
                    .OrderBy(d => d.Date)
                    .ToList();

                if (dataPoints.Any())
                {
                    var chartType = chartTypes[tagIndex] == "bar" ? SeriesType.Bar : SeriesType.Line;
                    
                    allSeriesData.Add(new SeriesData
                    {
                        TagName = tag.Title,
                        TagId = tag.Id,
                        InputTypeId = tag.InputTypeId ?? 0,
                        ChartType = chartType,
                        DataPoints = dataPoints
                    });
                    allCombinedDataPoints.AddRange(dataPoints);
                }
                
                tagIndex++;
            }

            if (!allCombinedDataPoints.Any())
            {
                allSeriesData = new List<SeriesData>();
                dataLoaded = true;
                isLoading = false;
                availableYears.Clear();
                availableMonths.Clear();
                return;
            }

            // Build available years and months from combined data
            availableYears = allCombinedDataPoints
                .Select(v => v.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();

            availableMonths = allCombinedDataPoints
                .GroupBy(v => new { v.Date.Year, v.Date.Month })
                .OrderByDescending(g => g.Key.Year)
                .ThenByDescending(g => g.Key.Month)
                .Take(12)
                .ToDictionary(
                    g => $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key.Month)} {g.Key.Year}",
                    g => $"month-{g.Key.Year}-{g.Key.Month}"
                );

            // Apply date range filter to each series
            foreach (var series in allSeriesData)
            {
                series.DataPoints = ApplyDateRangeFilter(series.DataPoints);
            }

            // Remove series with no data after filtering
            allSeriesData = allSeriesData.Where(s => s.DataPoints.Any()).ToList();

            // Configure chart options based on theme
            ConfigureChartOptions();

            dataLoaded = true;
            isLoading = false;

            // Save preferences
            await JS.InvokeVoidAsync("localStorage.setItem", "charts_dateRange", selectedDateRange);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chart data: {ex.Message}");
            isLoading = false;
        }
    }

    private List<ChartDataPoint> ApplyDateRangeFilter(List<ChartDataPoint> allData)
    {
        if (selectedDateRange == "all")
        {
            return allData;
        }

        var today = DateTime.Today;

        if (selectedDateRange == "last-month")
        {
            return allData.Where(d => d.Date >= today.AddDays(-30) && d.Date <= today).ToList();
        }

        if (selectedDateRange == "last-quarter")
        {
            return allData.Where(d => d.Date >= today.AddDays(-90) && d.Date <= today).ToList();
        }

        if (selectedDateRange == "last-year")
        {
            return allData.Where(d => d.Date >= today.AddDays(-365) && d.Date <= today).ToList();
        }

        if (selectedDateRange.StartsWith("year-"))
        {
            var year = int.Parse(selectedDateRange.Replace("year-", ""));
            return allData.Where(d => d.Date.Year == year).ToList();
        }

        if (selectedDateRange.StartsWith("month-"))
        {
            var parts = selectedDateRange.Replace("month-", "").Split('-');
            var year = int.Parse(parts[0]);
            var month = int.Parse(parts[1]);
            return allData.Where(d => d.Date.Year == year && d.Date.Month == month).ToList();
        }

        return allData;
    }

    private void ConfigureChartOptions()
    {
        // Check if all selected tags have the same InputTypeId for Y-axis range forcing
        var (yMin, yMax) = GetYAxisRange();

        // Determine if we should use decimal or integer formatting
        var hasDecimalType = allSeriesData.Any(s => 
            inputTypeNames.ContainsKey(s.InputTypeId) && 
            inputTypeNames[s.InputTypeId] == "Decimal");
        
        var valueFormatter = hasDecimalType 
            ? @"function(value) { return value.toFixed(2); }"
            : @"function(value) { return value.toFixed(0); }";
        
        // Use multi-series tooltip formatter
        var tooltipFormatter = GetTooltipFormatterForMultiSeries(hasDecimalType, isDarkMode);
        
        chartOptions = new ApexChartOptions<ChartDataPoint>
        {
            Theme = new Theme
            {
                Mode = isDarkMode ? Mode.Dark : Mode.Light,
                Palette = PaletteType.Palette1
            },
            Chart = new Chart
            {
                Background = isDarkMode ? "#1e293b" : "#ffffff",
                ForeColor = isDarkMode ? "#e2e8f0" : "#374151",
                Height = "550px", // Increased height for better visibility
                Toolbar = new Toolbar
                {
                    Show = true,
                    Tools = new Tools
                    {
                        Download = true,
                        Selection = true,
                        Zoom = true,
                        Zoomin = true,
                        Zoomout = true,
                        Pan = true,
                        Reset = true
                    }
                },
                Zoom = new Zoom
                {
                    Enabled = true
                }
            },
            Stroke = new Stroke
            {
                Curve = Curve.Smooth,
                Width = 3
            },
            Markers = new Markers
            {
                Size = 5,
                StrokeWidth = 2
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Title = new AxisTitle
                {
                    Text = "Date"
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Min = yMin,
                    Max = yMax,
                    Title = new AxisTitle
                    {
                        Text = "Value"
                    },
                    Labels = new YAxisLabels
                    {
                        Formatter = valueFormatter
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = isDarkMode ? "#334155" : "#e2e8f0",
                StrokeDashArray = 3
            },
            Legend = new Legend
            {
                Show = true,
                Position = LegendPosition.Top
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                Shared = true, // Enable shared tooltip for multi-series
                Intersect = false, // Required for shared tooltips to work with bar/column charts
                X = new TooltipX
                {
                    Format = "dd MMM yyyy"
                },
                Custom = tooltipFormatter
            },
            Colors = new List<string> { "#0ea5e9", "#f59e0b", "#10b981" } // Auto-assign colors for up to 3 series
        };
    }
    
