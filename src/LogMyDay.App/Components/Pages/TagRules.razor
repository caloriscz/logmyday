@page "/tag-rules"

@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@using Refit
@inject LogMyDay.Shared.Interfaces.ITagRuleApi TagRuleApi
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject ILogger<TagRules> Logger
@inject IPageTitleService PageTitleService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("TagRules", "Manage rules that calculate a tag's daily value from other tags")]

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <PageHeader Title="Rules" Subtitle="Calculate a tag's daily value from other tags, e.g. a daily total from several products.">
        <Actions>
            <div class="flex items-center gap-3">
                <a href="/tags" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                    <Icon Name="tag" Class="h-4 w-4" />
                    Tags
                </a>
                <button type="button" class="inline-flex items-center gap-2 self-start rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:self-auto" @onclick="OpenCreateModal" disabled="@(isBusy || tags == null)">
                    <Icon Name="plus" Class="h-4 w-4" />
                    New Rule
                </button>
            </div>
        </Actions>
    </PageHeader>

    <section class="space-y-4">
        @if (isLoading)
        {
            <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
                <span>Loading rules…</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                @loadError
            </div>
        }
        else if (rules.Count == 0)
        {
            <EmptyState Message="No rules yet. Create a number tag for the result, then a rule that adds up its sources." />
        }
        else
        {
            @foreach (var rule in rules)
            {
                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0 flex-1 space-y-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@rule.Name</h3>
                                @if (rule.IsEnabled)
                                {
                                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-200">Active since @rule.EffectiveFrom.ToString("d")</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700 dark:bg-slate-700 dark:text-slate-200">Paused</span>
                                }
                            </div>
                            <p class="text-sm text-gray-700 dark:text-slate-200">
                                <span class="inline-flex items-center gap-1 font-medium"><ComputedBadge ShowText="false" /> @rule.TargetTagName</span>
                                = @Formula(rule) <span class="text-gray-500 dark:text-slate-400">per day</span>
                            </p>
                            @if (rule.IgnoreZero)
                            {
                                <p class="text-xs text-gray-500 dark:text-slate-400">Zero values are ignored.</p>
                            }
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEditModal(rule)" disabled="@(isBusy || tags == null)">
                                <Icon Name="pencil" Class="h-4 w-4" />
                                <span>Edit</span>
                            </button>
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => pendingDelete = rule" disabled="@isBusy">
                                <Icon Name="trash" Class="h-4 w-4" />
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>

@* Create/Edit Modal *@
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isBusy) CloseModal(); }">
        <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(editingId.HasValue ? "Edit Rule" : "New Rule")</h2>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                    <Icon Name="close" Class="h-5 w-5" />
                </button>
            </div>

            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="mx-6 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @formError
                    </div>
                }

                <div class="px-6 py-5">
                    <TagRuleEditor Tags="tags" Model="formModel" IsEditing="editingId.HasValue" Disabled="isBusy" />
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(editingId.HasValue ? "Save Changes" : "Create Rule")</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (pendingDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete rule</h3>
            </div>
            <div class="px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                Delete rule <strong>@pendingDelete.Name</strong>? Every value it calculated for <strong>@pendingDelete.TargetTagName</strong> is deleted too, and the tag becomes a normal tag again. The source tags are not touched. This cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => pendingDelete = null" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-rose-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500" @onclick="DeleteRule" disabled="@isBusy">
                    <Icon Name="trash" Class="h-4 w-4" />
                    <span>@(isBusy ? "Deleting…" : "Delete")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<TagRuleResponse> rules = new();
    private IList<TagResponse>? tags;
    private TagRuleRequest formModel = new() { Name = string.Empty };

    private string? loadError;
    private string? formError;
    private bool isLoading;
    private bool isBusy;
    private int? editingId;
    private bool showModal;
    private TagRuleResponse? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Rules");
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var rulesTask = TagRuleApi.GetTagRules();
            var tagsTask = ActivityApi.GetTags();
            await Task.WhenAll(rulesTask, tagsTask);

            rules.Clear();
            rules.AddRange(rulesTask.Result);
            tags = tagsTask.Result;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view rules.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load rules: {ex.Message}";
            Logger.LogError(ex, "Failed to load tag rules");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        editingId = null;
        formModel = new TagRuleRequest { Name = string.Empty, Sources = [new TagRuleSourceRequest { Factor = 1 }] };
        formError = null;
        showModal = true;
    }

    private void OpenEditModal(TagRuleResponse rule)
    {
        editingId = rule.Id;
        formModel = new TagRuleRequest
        {
            Name = rule.Name,
            TargetTagId = rule.TargetTagId,
            IgnoreZero = rule.IgnoreZero,
            IsEnabled = rule.IsEnabled,
            Sources = rule.Sources.Select(s => new TagRuleSourceRequest { SourceTagId = s.SourceTagId, Factor = s.Factor }).ToList()
        };
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
    }

    private async Task HandleSubmit()
    {
        formError = Validate();
        if (formError is not null)
        {
            return;
        }

        isBusy = true;
        formModel.Sources = formModel.Sources.Where(s => s.SourceTagId != 0).ToList();

        try
        {
            if (editingId.HasValue)
            {
                await TagRuleApi.UpdateTagRule(editingId.Value, formModel);
            }
            else
            {
                await TagRuleApi.CreateTagRule(formModel);
            }

            CloseModal();
            await LoadDataAsync();
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.NotFound)
        {
            // The server explains what is wrong with the rule in plain words.
            formError = string.IsNullOrWhiteSpace(ex.Content) ? "The rule could not be saved." : ex.Content.Trim('"');
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            formError = "You are not authorized to perform this action.";
        }
        catch (Exception ex)
        {
            formError = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Failed to save tag rule");
        }
        finally
        {
            isBusy = false;
        }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(formModel.Name))
        {
            return "Give the rule a name.";
        }

        if (formModel.TargetTagId == 0)
        {
            return "Choose the result tag.";
        }

        if (!formModel.Sources.Any(s => s.SourceTagId != 0))
        {
            return "Add at least one source tag.";
        }

        return null;
    }

    private async Task DeleteRule()
    {
        if (pendingDelete == null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await TagRuleApi.DeleteTagRule(pendingDelete.Id);
            pendingDelete = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to delete: {ex.Message}";
            Logger.LogError(ex, "Failed to delete tag rule {RuleId}", pendingDelete?.Id);
            pendingDelete = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string Formula(TagRuleResponse rule)
    {
        return string.Join(" + ", rule.Sources.Select(s =>
            $"{s.Factor.ToString("0.####", System.Globalization.CultureInfo.CurrentCulture)} × {s.SourceTagName}"));
    }
}
