@page "/reminders"
@using System.Globalization
@using LogMyDay.App.Services
@using LogMyDay.Shared.Preferences
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Reminders", "View today's activities and required tag reminders")]

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Reminders</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Review required tags and quickly log missing activities.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="RefreshReminders">
                Refresh
            </button>
        </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-1 flex-wrap items-center justify-center gap-2 sm:justify-start">
            <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousMonth" title="Previous month" aria-label="Previous month">&laquo;</button>
            <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousDay" title="Previous day" aria-label="Previous day">&lsaquo;</button>
            <CultureAwareDatePicker Value="@selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="w-40 sm:w-48" Stretch="false" Placeholder="Select date" />
            <button type="button" class="@GetNavButtonClasses()" @onclick="NextDay" title="Next day" aria-label="Next day">&rsaquo;</button>
            <button type="button" class="@GetNavButtonClasses()" @onclick="NextMonth" title="Next month" aria-label="Next month">&raquo;</button>
            <button type="button" class="@GetNavButtonClasses(true)" @onclick="GoToToday" aria-label="Go to today">Today</button>
        </div>
        <div class="hidden sm:flex sm:items-center sm:justify-end sm:gap-2"></div>
    </div>

    <RemindersSection @ref="remindersRef" SelectedDate="selectedDate" />
</div>

@code {
    private RemindersSection? remindersRef;
    private DateTime selectedDate = DateTime.Today;

    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reminders");

        userPreferences = await UserPreferencesService.GetAsync();
        displayCulture = userPreferences.Culture;
        displayTimeZone = userPreferences.TimeZone;

        var today = GetTodayInDisplayZone();
        selectedDate = today;
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, displayTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private async Task RefreshReminders()
    {
        if (remindersRef != null)
        {
            await remindersRef.RefreshAsync();
        }
    }

    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            selectedDate = newDate.Value;
        }

        await Task.CompletedTask;
    }

    private async Task PreviousMonth()
    {
        selectedDate = selectedDate.AddMonths(-1);

        await Task.CompletedTask;
    }

    private async Task NextMonth()
    {
        selectedDate = selectedDate.AddMonths(1);

        await Task.CompletedTask;
    }

    private async Task GoToToday()
    {
        selectedDate = GetTodayInDisplayZone();

        await Task.CompletedTask;
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);

        await Task.CompletedTask;
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);

        await Task.CompletedTask;
    }

    private string GetNavButtonClasses(bool emphasize = false)
    {
        var baseClasses = "inline-flex items-center justify-center rounded-lg border px-4 py-2.5 text-sm font-medium transition-all focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-primary-400 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-50";

        if (emphasize)
        {
            return $"{baseClasses} border-primary-600 bg-primary-600 text-white hover:bg-primary-700 dark:border-primary-400 dark:bg-primary-500 dark:hover:bg-primary-400";
        }

        return $"{baseClasses} border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700";
    }
}
