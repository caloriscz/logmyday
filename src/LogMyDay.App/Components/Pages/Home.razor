@page "/"
@page "/reminders"
@using System.Globalization
@using System.Linq
@using System.Net
@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Components.Shared
@using LogMyDay.App.Services
@using LogMyDay.Shared.Preferences
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Home", "View today's activities and required tag reminders")]

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100">Reminders</h1>
            <p class="text-sm text-gray-600 dark:text-slate-300">Review required tags and quickly log missing activities.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="RefreshReminders">
                Refresh
            </button>
        </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900">
        <div class="flex flex-1 flex-wrap items-center justify-center gap-2 sm:justify-start">
            <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousMonth" title="Previous month" aria-label="Previous month">&laquo;</button>
            <button type="button" class="@GetNavButtonClasses()" @onclick="PreviousDay" title="Previous day" aria-label="Previous day">&lsaquo;</button>
            <CultureAwareDatePicker Value="@selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="w-40 sm:w-48" Stretch="false" Placeholder="Select date" />
            <button type="button" class="@GetNavButtonClasses()" @onclick="NextDay" title="Next day" aria-label="Next day">&rsaquo;</button>
            <button type="button" class="@GetNavButtonClasses()" @onclick="NextMonth" title="Next month" aria-label="Next month">&raquo;</button>
            <button type="button" class="@GetNavButtonClasses(true)" @onclick="GoToToday" aria-label="Go to today">Today</button>
        </div>
        <div class="hidden sm:flex sm:items-center sm:justify-end sm:gap-2"></div>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center gap-3 rounded-xl border border-gray-200 bg-white p-8 text-center shadow-xs dark:border-slate-700 dark:bg-slate-900">
            <span class="h-10 w-10 animate-spin rounded-full border-4 border-primary-200 border-t-primary-600"></span>
            <p class="text-sm text-gray-600 dark:text-slate-300">Loading reminders…</p>
        </div>
    }
    else if (unfilledRequiredTags?.Any() == true)
    {
        <div class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var tag in unfilledRequiredTags)
                {
                    <div class="rounded-xl border border-amber-200 bg-white p-5 shadow-xs transition hover:shadow-md dark:border-amber-500/40 dark:bg-slate-900">
                        <div class="flex items-start justify-between gap-3">
                            <div class="space-y-1">
                                <h2 class="text-lg font-semibold text-gray-900 dark:text-amber-200">@tag.Title</h2>
                            </div>
                            <a class="inline-flex items-center gap-1 rounded-md border border-amber-200 px-3 py-1 text-xs font-semibold text-amber-700 transition hover:bg-amber-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 dark:border-amber-500/40 dark:text-amber-200 dark:hover:bg-amber-500/20 dark:focus-visible:ring-offset-slate-900" href="/tags/edit/@tag.Id" title="Edit tag">
                                <Icon Name="pencil" Class="h-4 w-4" />
                                Edit
                            </a>
                        </div>

                        @{
                            bool hasDefault = HasDefaultCapability(tag);
                            bool hasStep = HasStepCapability(tag);
                            bool showSplit = hasDefault || hasStep;
                            bool actionBusy = IsActionInProgress(tag.Id);
                            bool dropdownOpen = openDropdownTagId == tag.Id;
                        }

                        @if (GetExistingActivity(tag.Id) != null && hasStep)
                        {
                            <div class="mt-3 flex items-center gap-1.5 text-sm text-gray-500 dark:text-slate-400">
                                <span>Current:</span>
                                <span class="font-semibold text-gray-700 dark:text-slate-200">@FormatStepValue(GetCurrentNumericValue(tag.Id))@(tag.UnitSymbol is not null ? $"\u00a0{tag.UnitSymbol}" : "")</span>
                            </div>
                        }

                        <div class="relative mt-5">
                            @if (showSplit)
                            {
                                <div class="flex">
                                    @if (hasDefault)
                                    {
                                        <button type="button"
                                            class="flex-1 inline-flex items-center justify-center gap-2 rounded-l-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-emerald-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
                                            @onclick="@(() => SetDefaultAsync(tag))"
                                            disabled="@actionBusy"
                                            title="Set default value: @GetDefaultValueLabel(tag)">
                                            <Icon Name="check" Class="h-4 w-4" />
                                            Set default (@TruncateLabel(GetDefaultValueLabel(tag)))
                                            @if (actionBusy)
                                            {
                                                <span class="h-3 w-3 animate-spin rounded-full border border-white/60 border-t-white"></span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                            class="flex-1 inline-flex items-center justify-center gap-2 rounded-l-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
                                            @onclick="@(() => PrepareModalForTag(tag.Id))"
                                            disabled="@actionBusy">
                                            <Icon Name="plus" Class="h-4 w-4" />
                                            Add manually
                                        </button>
                                    }
                                    <button type="button"
                                        class="inline-flex items-center justify-center @(hasDefault ? "border-l border-emerald-500 bg-emerald-600 hover:bg-emerald-700 focus-visible:ring-emerald-500" : "border-l border-primary-500 bg-primary-600 hover:bg-primary-700 focus-visible:ring-primary-500") rounded-r-lg px-2.5 py-2 text-white transition focus:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60"
                                        @onclick="@(() => ToggleDropdown(tag.Id))"
                                        disabled="@actionBusy"
                                        aria-haspopup="true"
                                        aria-expanded="@dropdownOpen">
                                        <Icon Name="chevron-down" Class="h-4 w-4" />
                                    </button>
                                </div>

                                @if (dropdownOpen)
                                {
                                    <div class="fixed inset-0 z-10" @onclick="CloseDropdown"></div>
                                    <div class="absolute right-0 z-20 mt-1 min-w-48 rounded-lg border border-gray-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-800">
                                        @if (hasStep)
                                        {
                                            <button type="button"
                                                class="flex w-full items-center gap-2.5 px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-50 dark:text-slate-200 dark:hover:bg-slate-700"
                                                @onclick="@(async () => { CloseDropdown(); await AddStepAsync(tag); })"
                                                disabled="@(!CanStepUp(tag))">
                                                <Icon Name="arrow-up" Class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                                                <span>Add step (+@FormatStepValue(tag.Step!.Value) &rarr; <strong>@FormatStepValue(GetNextStepUpValue(tag))</strong>@(tag.UnitSymbol is not null ? $"\u00a0{tag.UnitSymbol}" : ""))</span>
                                            </button>
                                            <button type="button"
                                                class="flex w-full items-center gap-2.5 px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-50 dark:text-slate-200 dark:hover:bg-slate-700"
                                                @onclick="@(async () => { CloseDropdown(); await RemoveStepAsync(tag); })"
                                                disabled="@(!CanStepDown(tag))">
                                                <Icon Name="arrow-down" Class="h-4 w-4 shrink-0 text-rose-600 dark:text-rose-400" />
                                                <span>Remove step (-@FormatStepValue(tag.Step!.Value) &rarr; <strong>@FormatStepValue(GetNextStepDownValue(tag))</strong>@(tag.UnitSymbol is not null ? $"\u00a0{tag.UnitSymbol}" : ""))</span>
                                            </button>
                                            <div class="my-1 border-t border-gray-200 dark:border-slate-700"></div>
                                        }
                                        <button type="button"
                                            class="flex w-full items-center gap-2.5 px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100 dark:text-slate-200 dark:hover:bg-slate-700"
                                            @onclick="@(() => { CloseDropdown(); PrepareModalForTag(tag.Id); })">
                                            <Icon Name="pencil" Class="h-4 w-4 shrink-0 text-gray-500 dark:text-slate-400" />
                                            Add manually
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <button type="button"
                                    class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900"
                                    @onclick="@(() => PrepareModalForTag(tag.Id))">
                                    <Icon Name="plus" Class="h-4 w-4" />
                                    Add manually
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <p class="text-sm text-gray-600 dark:text-slate-300">You have <span class="font-semibold">@unfilledRequiredTags.Count</span> required tag(s) that still need an activity for @FormatDate(selectedDate).</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-5 text-sm text-emerald-800 shadow-xs dark:border-emerald-500/40 dark:bg-emerald-500/10 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <Icon Name="check" Class="h-5 w-5" />
                <span>All required tags are filled for @FormatDate(selectedDate). Nice work!</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }
</div>

<!-- Add Activity Modal -->
@if (showAddActivityModal && allTags != null && newActivity != null)
{
    <AddActivityModal Activity="newActivity"
                      AvailableTags="allTags"
                      OptionLists="optionLists"
                      OptionListLookup="optionListLookup"
                      DisplayCulture="displayCulture"
                      DisplayTimeZone="displayTimeZone"
                      ErrorMessage="@errorMessage"
                      PreselectedTagId="preselectedTagId"
                      PreselectedDate="selectedDate"
                      OnActivityCreated="OnActivityCreated"
                      OnCanceled="CloseAddActivityModal"
                      OnError="OnError"
                      ModalId="addActivityModal" />
}

@code {
    private List<TagResponse>? unfilledRequiredTags;
    private IList<TagResponse>? allTags;
    private IList<TagOptionListResponse>? optionLists;
    private Dictionary<int, TagOptionListResponse>? optionListLookup;
    private DateTime selectedDate = DateTime.Today;
    private bool isLoading = true;
    private string? errorMessage;
    private ActivityRequest newActivity = new();
    private int? preselectedTagId;
    private bool showAddActivityModal = false;
    private Dictionary<int, ActivityResponse?> existingActivities = new();
    private readonly HashSet<int> operationInProgress = new();
    private int? openDropdownTagId;

    // User preferences and localization
    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reminders");

        // Load user preferences
        userPreferences = await UserPreferencesService.GetAsync();
        displayCulture = userPreferences.Culture;
        displayTimeZone = userPreferences.TimeZone;

        var today = GetTodayInDisplayZone();
        selectedDate = today;

        // Initialize new activity with current date/time
        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load API data AFTER prerendering completes (when HttpContext is available)
            await LoadRequiredTags();
            StateHasChanged();
        }
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, displayTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private async Task LoadRequiredTags()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            // Load both unfilled required tags and all tags for the modal
            var unfilledTask = ActivityApi.GetRequiredDailyTagsNotFilledForDate(selectedDate.ToString("yyyy-MM-dd"));
            var allTagsTask = ActivityApi.GetTags();
            var optionListsTask = ActivityApi.GetTagOptionListsAsync();

            await Task.WhenAll(unfilledTask, allTagsTask, optionListsTask);

            unfilledRequiredTags = await unfilledTask;
            allTags = await allTagsTask;
            optionLists = await optionListsTask;

            if (optionLists is not null)
            {
                optionListLookup = optionLists.ToDictionary(list => list.Id);
            }

            existingActivities.Clear();
            if (unfilledRequiredTags?.Count > 0)
            {
                var activityFetchTasks = unfilledRequiredTags.Select(t =>
                    ActivityApi.GetActivities(tagId: t.Id, startDate: selectedDate.Date, endDate: selectedDate.Date, pageSize: 1));
                var activityResults = await Task.WhenAll(activityFetchTasks);
                for (var i = 0; i < unfilledRequiredTags.Count; i++)
                {
                    existingActivities[unfilledRequiredTags[i].Id] = activityResults[i]?.Items?.FirstOrDefault();
                }
            }

            var today = GetTodayInDisplayZone();
            newActivity.DateStarted = selectedDate.Date == today ? GetCurrentDateTimeInDisplayZone() : selectedDate.Date;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading reminders: {ex.Message}";
            unfilledRequiredTags = new List<TagResponse>();
            allTags = new List<TagResponse>();
            optionLists = new List<TagOptionListResponse>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshReminders()
    {
        await LoadRequiredTags();
    }

    private void NavigateToAddActivity(int tagId)
    {
        Navigation.NavigateTo($"/calendar?tagId={tagId}&date={selectedDate:yyyy-MM-dd}");
    }

    private void PrepareModalForTag(int tagId)
    {
        preselectedTagId = tagId;
        var today = GetTodayInDisplayZone();
        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date,
            PrimaryTagId = tagId
        };
        showAddActivityModal = true;
    }

    private void CloseAddActivityModal()
    {
        showAddActivityModal = false;
        preselectedTagId = null;
        errorMessage = null;
    }

    private async Task OnActivityCreated(ActivityRequest activity)
    {
        // Refresh the reminders list
        await LoadRequiredTags();

        // Close the modal
        showAddActivityModal = false;

        // Reset the form but keep the date
        var today = GetTodayInDisplayZone();
        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date
        };
        preselectedTagId = null;
        errorMessage = null;
    }

    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            selectedDate = newDate.Value;
            await LoadRequiredTags();
        }
    }

    private async Task PreviousMonth()
    {
        selectedDate = selectedDate.AddMonths(-1);
        await LoadRequiredTags();
    }

    private async Task NextMonth()
    {
        selectedDate = selectedDate.AddMonths(1);
        await LoadRequiredTags();
    }

    private async Task GoToToday()
    {
        selectedDate = GetTodayInDisplayZone();
        await LoadRequiredTags();
    }

    private async Task OnError(string error)
    {
        errorMessage = error;
        await Task.CompletedTask;
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadRequiredTags();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        await LoadRequiredTags();
    }

    private string FormatDate(DateTime date)
    {
        var pattern = userPreferences?.Preferences.LongDatePattern ?? displayCulture.DateTimeFormat.LongDatePattern;
        return date.ToString(pattern, displayCulture);
    }

    private string GetNavButtonClasses(bool emphasize = false)
    {
        var baseClasses = "inline-flex items-center justify-center rounded-lg border px-4 py-2.5 text-sm font-medium transition-all focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-primary-400 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-50";

        if (emphasize)
        {
            return $"{baseClasses} border-primary-600 bg-primary-600 text-white hover:bg-primary-700 dark:border-primary-400 dark:bg-primary-500 dark:hover:bg-primary-400";
        }

        return $"{baseClasses} border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700";
    }

    private bool HasDefaultCapability(TagResponse tag)
        => !string.IsNullOrWhiteSpace(ResolveDefaultValue(tag));

    private bool HasStepCapability(TagResponse tag)
        => tag.Step.HasValue && !tag.IsRepeatable;

    private bool IsActionInProgress(int tagId)
        => operationInProgress.Contains(tagId);

    private void ToggleDropdown(int tagId)
    {
        openDropdownTagId = openDropdownTagId == tagId ? null : tagId;
    }

    private void CloseDropdown()
    {
        openDropdownTagId = null;
    }

    private ActivityResponse? GetExistingActivity(int tagId)
        => existingActivities.TryGetValue(tagId, out var act) ? act : null;

    private double GetCurrentNumericValue(int tagId)
    {
        var activity = GetExistingActivity(tagId);
        if (activity?.Description is null)
        {
            return 0;
        }

        return double.TryParse(activity.Description, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var val) ? val : 0;
    }

    private double GetNextStepUpValue(TagResponse tag)
    {
        var next = GetCurrentNumericValue(tag.Id) + tag.Step!.Value;

        return tag.MaxValue.HasValue ? Math.Min(next, tag.MaxValue.Value) : next;
    }

    private double GetNextStepDownValue(TagResponse tag)
    {
        var next = GetCurrentNumericValue(tag.Id) - tag.Step!.Value;
        var min = tag.MinValue ?? 0;

        return Math.Max(next, min);
    }

    private bool CanStepUp(TagResponse tag)
    {
        if (!tag.Step.HasValue)
        {
            return false;
        }

        var current = GetCurrentNumericValue(tag.Id);

        return !tag.MaxValue.HasValue || current < tag.MaxValue.Value;
    }

    private bool CanStepDown(TagResponse tag)
    {
        if (!tag.Step.HasValue)
        {
            return false;
        }

        var current = GetCurrentNumericValue(tag.Id);
        var min = tag.MinValue ?? 0;

        return current > min;
    }

    private string FormatStepValue(double value)
    {
        if (value == Math.Floor(value))
        {
            return ((long)value).ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        return value.ToString("G", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string TruncateLabel(string? label, int maxLength = 13)
    {
        if (string.IsNullOrEmpty(label) || label.Length <= maxLength)
        {
            return label ?? string.Empty;
        }

        return label[..maxLength] + "\u2026";
    }

    private string? GetDefaultValueLabel(TagResponse tag)
    {
        var value = ResolveDefaultValue(tag);
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (tag.OptionListId is int listId && optionListLookup != null && optionListLookup.TryGetValue(listId, out var list))
        {
            var option = list.Options.FirstOrDefault(o => string.Equals(o.Value, value, StringComparison.OrdinalIgnoreCase));
            if (option is not null)
            {
                return option.DisplayName ?? option.Value;
            }
        }

        return value;
    }

    private string? ResolveDefaultValue(TagResponse tag)
    {
        if (!string.IsNullOrWhiteSpace(tag.DefaultValue))
        {
            return tag.DefaultValue;
        }

        return null;
    }

    private async Task RefetchExistingActivityAsync(int tagId)
    {
        var result = await ActivityApi.GetActivities(tagId: tagId, startDate: selectedDate.Date, endDate: selectedDate.Date, pageSize: 1);
        existingActivities[tagId] = result?.Items?.FirstOrDefault();
    }

    private async Task SetDefaultAsync(TagResponse tag)
    {
        var defaultValue = ResolveDefaultValue(tag);
        if (string.IsNullOrWhiteSpace(defaultValue))
        {
            errorMessage = "No default value is configured for this tag.";
            return;
        }

        if (!operationInProgress.Add(tag.Id))
        {
            return;
        }

        errorMessage = null;
        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var existing = GetExistingActivity(tag.Id);
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = defaultValue,
                DateStarted = existing?.DateStarted ?? startDate
            };

            if (existing != null)
            {
                await ActivityApi.UpdateCalendarItem(existing.Id, request);
            }
            else
            {
                await ActivityApi.CreateCalendarItem(request);
            }

            await LoadRequiredTags();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details)
                ? details
                : "The activity could not be created with the default value.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error setting default activity: {ex.Message}";
        }
        finally
        {
            operationInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }

    private async Task AddStepAsync(TagResponse tag)
    {
        if (!CanStepUp(tag))
        {
            return;
        }

        if (!operationInProgress.Add(tag.Id))
        {
            return;
        }

        errorMessage = null;
        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var newValue = GetNextStepUpValue(tag);
            var existing = GetExistingActivity(tag.Id);
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = FormatStepValue(newValue),
                DateStarted = existing?.DateStarted ?? startDate
            };

            if (existing != null)
            {
                await ActivityApi.UpdateCalendarItem(existing.Id, request);
            }
            else
            {
                await ActivityApi.CreateCalendarItem(request);
            }

            await RefetchExistingActivityAsync(tag.Id);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details)
                ? details
                : "Could not update step value.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding step: {ex.Message}";
        }
        finally
        {
            operationInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }

    private async Task RemoveStepAsync(TagResponse tag)
    {
        if (!CanStepDown(tag))
        {
            return;
        }

        if (!operationInProgress.Add(tag.Id))
        {
            return;
        }

        errorMessage = null;
        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var newValue = GetNextStepDownValue(tag);
            var existing = GetExistingActivity(tag.Id);
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = FormatStepValue(newValue),
                DateStarted = existing?.DateStarted ?? startDate
            };

            if (existing != null)
            {
                await ActivityApi.UpdateCalendarItem(existing.Id, request);
            }
            else
            {
                await ActivityApi.CreateCalendarItem(request);
            }

            await RefetchExistingActivityAsync(tag.Id);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details)
                ? details
                : "Could not update step value.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error removing step: {ex.Message}";
        }
        finally
        {
            operationInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }
}
