@page "/units"

@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Services
@using System.Linq
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject ILogger<Units> Logger
@inject IPageTitleService PageTitleService

@attribute [LogMyDay.Shared.Attributes.AiNavigableRoute("Units", "Manage measurement units for numeric tags")]

<div class="mx-auto max-w-(--breakpoint-2xl) space-y-6 px-4 py-6 sm:px-6 lg:px-8">
    <PageHeader Title="Units" Subtitle="Manage measurement units and conversion factors.">
        <Actions>
            <button type="button" class="inline-flex items-center gap-2 self-start rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:self-auto" @onclick="OpenCreateModal" disabled="@isBusy">
                <Icon Name="plus" Class="h-4 w-4" />
                Add Unit
            </button>
        </Actions>
    </PageHeader>

    <section class="space-y-4">
        @if (isLoading)
        {
            <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
                <span>Loading units…</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                @loadError
            </div>
        }
        else if (units.Count == 0)
        {
            <EmptyState Message="No units available yet. Use the button above to add your first unit." />
        }
        else
        {
            <div class="hidden md:block">
                <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
                        <thead class="bg-gray-50 dark:bg-slate-800">
                            <tr>
                                <th scope="col" class="px-1 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300"></th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Key</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Symbol</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Quantity</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Multiplier</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Offset</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-slate-300">Decimals</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                            @foreach (var unit in units)
                            {
                                <tr class="transition-colors hover:bg-gray-50 focus-within:bg-gray-50 dark:even:bg-slate-800/30 dark:hover:bg-slate-800/60 dark:focus-within:bg-slate-800/60">
                                    <td class="px-1 w-[56px] py-3">
                                        <div class="flex">
                                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(unit)" disabled="@(isBusy || unit.IsBaseUnit)">
                                                <Icon Name="trash" Class="h-4 w-4" />
                                            </button>
                                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEditModal(unit)" disabled="@isBusy">
                                                <Icon Name="pencil" Class="h-4 w-4" />
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-slate-100">
                                        @unit.Key
                                        @if (unit.IsBaseUnit)
                                        {
                                            <span class="ml-2 inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-semibold text-sky-900 ring-1 ring-sky-500/20 dark:bg-sky-600/20 dark:text-sky-300 dark:ring-sky-500/30">Base</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@unit.Symbol</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@unit.QuantityKey</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@unit.AToBase</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@unit.BToBase</td>
                                    <td class="px-4 py-3 text-sm text-gray-700 dark:text-slate-200">@unit.Decimals</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="space-y-3 md:hidden">
                @foreach (var unit in units)
                {
                    <div class="rounded-xl border @(unit.IsBaseUnit ? "border-sky-500 dark:border-sky-600" : "border-gray-200 dark:border-slate-700") bg-white p-4 shadow-xs dark:bg-slate-900">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">
                                    @unit.Key
                                    @if (unit.IsBaseUnit)
                                    {
                                        <span class="ml-2 inline-flex items-center rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-semibold text-sky-900 ring-1 ring-sky-500/20 dark:bg-sky-600/20 dark:text-sky-300 dark:ring-sky-500/30">Base</span>
                                    }
                                </h3>
                                <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">@unit.QuantityKey</p>
                            </div>
                        </div>

                        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Symbol</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@unit.Symbol</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Decimals</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@unit.Decimals</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Multiplier</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@unit.AToBase</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-slate-400">Offset</dt>
                                <dd class="text-gray-900 dark:text-slate-200">@unit.BToBase</dd>
                            </div>
                        </dl>

                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEditModal(unit)" disabled="@isBusy">
                                <Icon Name="pencil" Class="h-4 w-4" />
                                <span>Edit</span>
                            </button>
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(unit)" disabled="@(isBusy || unit.IsBaseUnit)">
                                <Icon Name="trash" Class="h-4 w-4" />
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                Total units: @units.Count
            </div>
        }
    </section>
</div>

@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isBusy) CloseModal(); }">
        <div class="w-full max-w-3xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(isEditing ? "Edit Unit" : "Add Unit")</h2>
                    <p class="text-sm text-gray-600 dark:text-slate-400">Configure conversion values and display settings.</p>
                </div>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200 dark:focus-visible:ring-offset-slate-900" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                    <Icon Name="close" Class="h-5 w-5" />
                    <span class="sr-only">Close</span>
                </button>
            </div>

            <EditForm Model="unitForm" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="mx-6 mt-5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200" />

                @if (!string.IsNullOrEmpty(unitError))
                {
                    <div class="mx-6 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @unitError
                    </div>
                }

                <div class="max-h-[70vh] overflow-y-auto px-6 py-5">
                    <div class="space-y-5">
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitKey">Key</label>
                                <InputText id="unitKey" @bind-Value="unitForm.Key" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy" />
                                <p class="text-xs text-gray-500 dark:text-slate-400">Internal identifier (e.g., minute, kilogram).</p>
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitSymbol">Symbol</label>
                                <InputText id="unitSymbol" @bind-Value="unitForm.Symbol" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy" />
                                <p class="text-xs text-gray-500 dark:text-slate-400">Display label (e.g., min, kg).</p>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitQuantity">Quantity</label>
                            <InputSelect id="unitQuantity" @bind-Value="unitForm.QuantityId" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy">
                                <option value="0">Select a quantity…</option>
                                @foreach (var quantity in quantities)
                                {
                                    <option value="@quantity.Id">@quantity.Key</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-3">
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitMultiplier">Multiplier to base</label>
                                <InputNumber id="unitMultiplier" @bind-Value="unitForm.AToBase" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitOffset">Offset to base</label>
                                <InputNumber id="unitOffset" @bind-Value="unitForm.BToBase" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="unitDecimals">Display decimals</label>
                                <InputNumber id="unitDecimals" @bind-Value="unitForm.Decimals" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@isBusy" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="save" Class="h-4 w-4" />
                            <span>@(isEditing ? "Save Changes" : "Create Unit")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (unitPendingDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete unit</h3>
            </div>
            <div class="px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                Delete unit <strong>@unitPendingDelete.Key</strong>? This cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-slate-900" @onclick="CancelDelete" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-rose-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" @onclick="DeleteUnit" disabled="@isBusy">
                    @if (isBusy)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                        <span>Deleting…</span>
                    }
                    else
                    {
                        <Icon Name="trash" Class="h-4 w-4" />
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<UnitResponse> units = new();
    private readonly List<QuantityResponse> quantities = new();
    private UnitRequest unitForm = CreateDefaultUnitRequest();

    private string? loadError;
    private string? unitError;
    private bool isLoading;
    private bool isBusy;
    private bool isEditing;
    private int? editingUnitId;
    private bool showModal;
    private UnitResponse? unitPendingDelete;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Units");
        await LoadUnitsAsync();
    }

    private async Task LoadUnitsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var quantityResults = await ActivityApi.GetQuantitiesAsync();
            quantities.Clear();
            quantities.AddRange(quantityResults.OrderBy(q => q.Key));

            var unitResults = await ActivityApi.GetUnitsAsync();
            units.Clear();
            units.AddRange(unitResults.OrderBy(u => u.QuantityKey).ThenBy(u => u.Key));

            if (unitForm.QuantityId == 0 && quantities.Count > 0)
            {
                unitForm.QuantityId = quantities[0].Id;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view units.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load units: {ex.Message}";
            Logger.LogError(ex, "Failed to load units");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        if (isBusy)
        {
            return;
        }

        isEditing = false;
        editingUnitId = null;
        unitForm = CreateDefaultUnitRequest();
        if (quantities.Count > 0)
        {
            unitForm.QuantityId = quantities[0].Id;
        }

        unitError = null;
        showModal = true;
    }

    private void OpenEditModal(UnitResponse unit)
    {
        if (isBusy)
        {
            return;
        }

        isEditing = true;
        editingUnitId = unit.Id;
        unitForm = new UnitRequest
        {
            Key = unit.Key,
            Symbol = unit.Symbol,
            QuantityId = unit.QuantityId,
            AToBase = unit.AToBase,
            BToBase = unit.BToBase,
            Decimals = unit.Decimals
        };

        unitError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        if (isBusy)
        {
            return;
        }

        showModal = false;
        ResetForm();
    }

    private async Task HandleSubmit()
    {
        if (!ValidateUnitForm())
        {
            return;
        }

        isBusy = true;
        unitError = null;

        try
        {
            if (editingUnitId.HasValue)
            {
                await ActivityApi.UpdateUnit(editingUnitId.Value, unitForm);
            }
            else
            {
                await ActivityApi.CreateUnit(unitForm);
            }

            await LoadUnitsAsync();
            showModal = false;
            ResetForm();
        }
        catch (Refit.ApiException ex)
        {
            unitError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Unit API error");
        }
        catch (Exception ex)
        {
            unitError = ex.Message;
            Logger.LogError(ex, "Unexpected error saving unit");
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool ValidateUnitForm()
    {
        if (string.IsNullOrWhiteSpace(unitForm.Key))
        {
            unitError = "Key is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(unitForm.Symbol))
        {
            unitError = "Symbol is required.";
            return false;
        }

        if (unitForm.QuantityId == 0)
        {
            unitError = "Select a quantity.";
            return false;
        }

        if (Math.Abs(unitForm.AToBase) < double.Epsilon)
        {
            unitError = "Multiplier to base must not be zero.";
            return false;
        }

        unitError = null;
        return true;
    }

    private void ConfirmDelete(UnitResponse unit)
    {
        unitPendingDelete = unit;
    }

    private void CancelDelete()
    {
        unitPendingDelete = null;
    }

    private async Task DeleteUnit()
    {
        if (unitPendingDelete == null)
        {
            return;
        }

        isBusy = true;
        unitError = null;

        try
        {
            await ActivityApi.DeleteUnit(unitPendingDelete.Id);
            await LoadUnitsAsync();
        }
        catch (Refit.ApiException ex)
        {
            unitError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Failed to delete unit");
        }
        catch (Exception ex)
        {
            unitError = ex.Message;
            Logger.LogError(ex, "Unexpected error deleting unit");
        }
        finally
        {
            isBusy = false;
            unitPendingDelete = null;
        }
    }

    private void ResetForm()
    {
        isEditing = false;
        editingUnitId = null;
        unitForm = CreateDefaultUnitRequest();
        if (quantities.Count > 0)
        {
            unitForm.QuantityId = quantities[0].Id;
        }
        unitError = null;
    }

    private static UnitRequest CreateDefaultUnitRequest()
    {
        return new UnitRequest
        {
            Key = string.Empty,
            Symbol = string.Empty,
            QuantityId = 0,
            AToBase = 1,
            BToBase = 0,
            Decimals = 0
        };
    }
}
