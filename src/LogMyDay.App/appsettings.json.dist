{
  "ConnectionStrings": {
    "DefaultConnection": "server=host-and-port;user=user-name;password=your-password;database=db-name;Encrypt=True;TrustServerCertificate=False"
  },
  "Security": {
    "RateLimit": {
      "MaxAttemptsPerWindow": 5,
      "WindowMinutes": 15,
      "LockoutMinutes": 30,
      "TrackByIP": true,
      "TrackByUsername": true
    }
  },
  "Email": {
    "SmtpServer": "smtp.your-provider.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "UserName": "smtp-user",
    "Password": "smtp-password",
    "SenderEmail": "no-reply@your-domain.com",
    "SenderName": "LogMyDay"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Circuit": {
    "DisconnectedRetentionMinutes": 10,
    "ClientTimeoutSeconds": 120,
    "KeepAliveSeconds": 15,
    "HandshakeTimeoutSeconds": 30,
    "MaxRetainedDisconnectedCircuits": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/logmyday.log",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
