# LogMyDay Build Configuration Template
# Copy this file to local.env and fill in your actual deployment credentials
# local.env is gitignored and will not be committed to version control

# Web Deploy Server Configuration
LMD_SERVER=your-server-address.com
LMD_PORT=8172
LMD_SITE=your-site-name
LMD_LOGIN=your-deployment-username
LMD_PASSWORD=your-deployment-password

# Notes:
# - LMD_SERVER: Your web server hostname (e.g., myserver.example.com)
# - LMD_PORT: Web Deploy port (default: 8172, check with your hosting provider)
# - LMD_SITE: IIS site name as configured on the server
# - LMD_LOGIN: Web Deploy authentication username
# - LMD_PASSWORD: Web Deploy authentication password
