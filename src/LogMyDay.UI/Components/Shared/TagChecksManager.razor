@using LogMyDay.Domain.Enums
@using LogMyDay.UI.Formatting
@using Refit
@inject ITagCheckApi TagCheckApi
@inject IActivityApi ActivityApi
@inject ILogger<TagChecksManager> Logger

@* The checks as plain sentences, and the dialogs that create, change and delete them. The web and
   mobile Rules pages host it and call OpenCreate from their own "new" button. *@
<section class="space-y-4">
    @if (isLoading)
    {
        <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
            <span>Loading checks…</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @loadError
        </div>
    }
    else if (checks.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-sm text-gray-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            No checks yet. A check says what should hold on a day, e.g. Fasting and Breakfast are not on the same day.
        </div>
    }
    else
    {
        @foreach (var check in checks)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0 flex-1 space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@check.Name</h3>
                            @if (check.Severity == nameof(TagCheckSeverity.Warn))
                            {
                                <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-500/20 dark:text-amber-200">Warn</span>
                            }
                            else
                            {
                                <span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-500/20 dark:text-sky-200">Flag</span>
                            }
                            @if (!check.IsEnabled)
                            {
                                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700 dark:bg-slate-700 dark:text-slate-200">Paused</span>
                            }
                        </div>
                        <p class="text-sm text-gray-700 dark:text-slate-200">@TagCheckText.Sentence(check)</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEdit(check)" disabled="@(isBusy || tags == null || TagCheckForm.ToRequest(check) is null)" title="@(TagCheckForm.ToRequest(check) is null ? TagCheckForm.NotEditableHint : null)">
                            <Icon Name="pencil" Class="h-4 w-4" />
                            <span>Edit</span>
                        </button>
                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => { pendingDelete = check; deleteError = null; }" disabled="@isBusy">
                            <Icon Name="trash" Class="h-4 w-4" />
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</section>

@* Create/Edit Modal *@
@if (showModal)
{
    <div class="fixed inset-0 z-60 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isBusy) CloseModal(); }">
        <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(editingId.HasValue ? "Edit Check" : "New Check")</h2>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                    <Icon Name="close" Class="h-5 w-5" />
                </button>
            </div>

            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="mx-6 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @formError
                    </div>
                }

                <div class="px-6 py-5">
                    <TagCheckEditor Tags="tags" OptionLists="optionLists" Model="formModel" Disabled="isBusy" />
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(editingId.HasValue ? "Save Changes" : "Create Check")</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (pendingDelete != null)
{
    <div class="fixed inset-0 z-60 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete check</h3>
            </div>
            <div class="space-y-3 px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                <p>Delete check <strong>@pendingDelete.Name</strong>? Its tags and their values are not touched.</p>
                @if (!string.IsNullOrEmpty(deleteError))
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">@deleteError</div>
                }
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => pendingDelete = null" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-rose-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500" @onclick="DeleteCheck" disabled="@isBusy">
                    <Icon Name="trash" Class="h-4 w-4" />
                    <span>@(isBusy ? "Deleting…" : "Delete")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<TagCheckResponse> checks = new();
    private IList<TagResponse>? tags;
    private IList<TagOptionListResponse>? optionLists;
    private TagCheckRequest formModel = new() { Name = string.Empty };

    private string? loadError;
    private string? formError;
    private string? deleteError;
    private bool isLoading;
    private bool isBusy;
    private bool showModal;
    private int? editingId;
    private TagCheckResponse? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>Opens the dialog for a new check, once the tags are loaded.</summary>
    public void OpenCreate()
    {
        if (isBusy || tags == null)
        {
            return;
        }

        editingId = null;
        formModel = new TagCheckRequest
        {
            Name = string.Empty,
            IfOperator = TagRuleOperator.IsLogged,
            ThenOperator = TagRuleOperator.IsNotLogged
        };
        OpenModal();
        StateHasChanged();
    }

    /// <summary>Loads the checks and tags again.</summary>
    public async Task Reload()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var checksTask = TagCheckApi.GetTagChecks();
            var tagsTask = ActivityApi.GetTags();
            var optionListsTask = ActivityApi.GetTagOptionListsAsync();
            await Task.WhenAll(checksTask, tagsTask, optionListsTask);

            checks.Clear();
            checks.AddRange(checksTask.Result);
            tags = tagsTask.Result;
            optionLists = optionListsTask.Result;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view checks.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load checks: {ex.Message}";
            Logger.LogError(ex, "Failed to load tag checks");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEdit(TagCheckResponse check)
    {
        if (TagCheckForm.ToRequest(check) is not { } model)
        {
            return;
        }

        editingId = check.Id;
        formModel = model;
        OpenModal();
    }

    private void OpenModal()
    {
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
    }

    private async Task HandleSubmit()
    {
        formError = Validate();
        if (formError is not null)
        {
            return;
        }

        isBusy = true;
        try
        {
            if (editingId.HasValue)
            {
                await TagCheckApi.UpdateTagCheck(editingId.Value, formModel);
            }
            else
            {
                await TagCheckApi.CreateTagCheck(formModel);
            }

            CloseModal();
            await LoadData();
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.NotFound)
        {
            // The server explains what is wrong in plain words.
            formError = string.IsNullOrWhiteSpace(ex.Content) ? "The check could not be saved." : ex.Content.Trim('"');
        }
        catch (Exception ex)
        {
            formError = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Failed to save tag check");
        }
        finally
        {
            isBusy = false;
        }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(formModel.Name))
        {
            return "Give the check a name.";
        }

        if (formModel.IfTagId == 0 || formModel.ThenTagId == 0)
        {
            return "Choose both tags.";
        }

        if (formModel.IfTagId == formModel.ThenTagId)
        {
            return "Choose two different tags.";
        }

        return null;
    }

    private async Task DeleteCheck()
    {
        if (pendingDelete == null)
        {
            return;
        }

        isBusy = true;
        deleteError = null;
        try
        {
            await TagCheckApi.DeleteTagCheck(pendingDelete.Id);
            pendingDelete = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            deleteError = $"Failed to delete: {ex.Message}";
            Logger.LogError(ex, "Failed to delete tag check {CheckId}", pendingDelete?.Id);
        }
        finally
        {
            isBusy = false;
        }
    }
}
