@using Microsoft.AspNetCore.Components

<div style="display: flex; align-items: center; gap: 3px; flex-wrap: wrap;" role="radiogroup" aria-label="Score">
    @for (int i = 0; i <= MaxScore; i++)
    {
        var scoreValue = i;
        var isSelected = Value == scoreValue;
        var isHovered = _hoverValue == scoreValue;
        var color = GetScoreColor(scoreValue, MaxScore);
        var size = MaxScore > 6 ? "26px" : "38px";
        var fontSize = MaxScore > 6 ? "0.65rem" : "0.8rem";
        <button type="button"
                style="width: @size; height: @size; border-radius: 50%; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: @fontSize; font-weight: 700; transition: transform 0.1s, box-shadow 0.1s; line-height: 1;
                       background: @(isSelected ? color : isHovered ? $"{color}30" : "transparent");
                       border: 2px solid @(isSelected || isHovered ? color : "#9ca3af");
                       color: @(isSelected ? "#ffffff" : isHovered ? color : "#9ca3af");
                       box-shadow: @(isSelected ? "0 0 0 3px #f59e0b80" : "none");"
                @onclick="() => ToggleValue(scoreValue)"
                @onmouseover="() => _hoverValue = scoreValue"
                @onmouseout="() => _hoverValue = null"
                title="@scoreValue"
                aria-label="Score @scoreValue"
                aria-pressed="@isSelected">
            @scoreValue
        </button>
    }
    @if (Value.HasValue)
    {
        <button type="button"
                style="background: none; border: none; cursor: pointer; padding: 4px; margin-left: 2px; color: #9ca3af; display: inline-flex;"
                @onclick="ClearValue" title="Clear score" aria-label="Clear score">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    }
</div>

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int MaxScore { get; set; } = 5;

    private int? _hoverValue;

    private async Task ToggleValue(int value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task ClearValue()
    {
        Value = null;
        await ValueChanged.InvokeAsync(0);
    }

    private static string GetScoreColor(int value, int max)
    {
        if (max == 0) return "#22c55e";
        var ratio = (double)value / max;
        if (ratio <= 0.5)
        {
            // green → yellow
            var t = ratio * 2;
            var r = (int)(0x22 + (0xea - 0x22) * t);
            var g = (int)(0xc5 + (0xb3 - 0xc5) * t);
            var b = (int)(0x5e + (0x08 - 0x5e) * t);
            return $"#{r:x2}{g:x2}{b:x2}";
        }
        else
        {
            // yellow → red
            var t = (ratio - 0.5) * 2;
            var r = (int)(0xea + (0xef - 0xea) * t);
            var g = (int)(0xb3 + (0x44 - 0xb3) * t);
            var b = (int)(0x08 + (0x44 - 0x08) * t);
            return $"#{r:x2}{g:x2}{b:x2}";
        }
    }
}
