@using Microsoft.AspNetCore.Components

@if (!string.IsNullOrEmpty(Color))
{
    <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; padding: 0 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; color: #ffffff; background: @Color;" title="@Text">
        @Text
    </span>
}
else
{
    <span class="tabular-nums text-gray-900 dark:text-slate-100">@Text</span>
}

@code {
    /// <summary>The value text to render (e.g. "45" or "45%").</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Color from the tag's color scheme; when null the value renders as plain text.</summary>
    [Parameter] public string? Color { get; set; }
}
