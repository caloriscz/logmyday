@using LogMyDay.UI.Services
@inject CheckWarningNotices Notices
@inject NavigationManager Navigation
@implements IDisposable

@* The warnings of the latest save: Warn checks it left broken on its day. The value is saved;
   this only says what the day now contradicts. Stays until dismissed. *@
@if (Notices.Current.Count > 0)
{
    <div class="fixed inset-x-0 top-0 z-70 flex justify-center p-3" role="status" aria-live="polite">
        <div class="w-full max-w-lg rounded-xl border border-amber-300 bg-amber-50 p-4 shadow-lg dark:border-amber-500/40 dark:bg-slate-900">
            <div class="flex items-start gap-3">
                <Icon Name="exclamation-triangle" Class="mt-0.5 h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400" />
                <div class="min-w-0 flex-1 space-y-2">
                    <p class="text-sm font-semibold text-amber-900 dark:text-amber-200">Saved, but @(Notices.Current.Count == 1 ? "a check is" : $"{Notices.Current.Count} checks are") broken on that day</p>
                    @foreach (var warning in Notices.Current)
                    {
                        <div class="text-sm">
                            <p class="font-medium text-gray-900 dark:text-slate-100">@warning.CheckName</p>
                            <p class="text-gray-700 dark:text-slate-300">@warning.Sentence</p>
                            <p class="text-xs text-gray-500 dark:text-slate-400">@warning.Found</p>
                        </div>
                    }
                    <button type="button" class="text-sm font-medium text-amber-800 underline hover:no-underline dark:text-amber-300" @onclick="OpenReview">Rule review</button>
                </div>
                <button type="button" class="inline-flex shrink-0 items-center rounded-full p-1.5 text-gray-500 transition-colors hover:bg-amber-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="Notices.Dismiss" aria-label="Dismiss">
                    <Icon Name="close" Class="h-4 w-4" />
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Notices.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenReview()
    {
        Notices.Dismiss();
        Navigation.NavigateTo("/tag-rules/review");
    }

    public void Dispose()
    {
        Notices.Changed -= OnChanged;
    }
}
