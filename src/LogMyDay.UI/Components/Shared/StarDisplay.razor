@using Microsoft.AspNetCore.Components

<span style="display: inline-flex; align-items: center; gap: 1px; vertical-align: middle;">
    @for (int i = 1; i <= MaxStars; i++)
    {
        var isFilled = i <= Value;
        var size = MaxStars > 6 ? "14px" : "18px";
        <svg viewBox="0 0 24 24" style="width: @size; height: @size; flex-shrink: 0;"
             fill="@(isFilled ? "#f59e0b" : "none")"
             stroke="@(isFilled ? "#d97706" : "#9ca3af")"
             stroke-width="@(isFilled ? "0.5" : "1.5")">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
    }
</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public int MaxStars { get; set; } = 5;
}
