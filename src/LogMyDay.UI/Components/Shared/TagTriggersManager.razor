@using LogMyDay.Domain.Enums
@using LogMyDay.UI.Formatting
@using LogMyDay.Shared.Formatting
@using Refit
@inject ITagTriggerApi TagTriggerApi
@inject IActivityApi ActivityApi
@inject IRecordApi RecordApi
@inject ILogger<TagTriggersManager> Logger

@* The triggers as plain sentences, and the dialogs that create, change and delete them. The web
   and mobile Rules pages host it and call OpenCreate from their own "new" button. *@
<section class="space-y-4">
    @if (isLoading)
    {
        <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
            <span>Loading triggers…</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @loadError
        </div>
    }
    else if (triggers.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-sm text-gray-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            No triggers yet. A trigger reminds you to log one tag after another, e.g. how a dose worked a few hours after taking it.
        </div>
    }
    else
    {
        @foreach (var trigger in triggers)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0 flex-1 basis-64 space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">@trigger.Name</h3>
                            @if (trigger.OpenReminderCount > 0)
                            {
                                <span class="rounded-full bg-violet-100 px-2 py-0.5 text-xs font-semibold text-violet-800 dark:bg-violet-500/20 dark:text-violet-200">@trigger.OpenReminderCount open @(trigger.OpenReminderCount == 1 ? "reminder" : "reminders")</span>
                            }
                            @if (!trigger.IsEnabled)
                            {
                                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700 dark:bg-slate-700 dark:text-slate-200">Paused</span>
                            }
                        </div>
                        <p class="text-sm text-gray-700 dark:text-slate-200">@TagTriggerText.Sentence(trigger)</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-all hover:bg-gray-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-gray-500 dark:text-slate-300 dark:hover:bg-slate-800" @onclick="() => OpenEdit(trigger)" disabled="@(isBusy || tags == null || TagTriggerForm.ToRequest(trigger) is null)" title="@(TagTriggerForm.ToRequest(trigger) is null ? TagTriggerForm.NotEditableHint : null)">
                            <Icon Name="pencil" Class="h-4 w-4" />
                            <span>Edit</span>
                        </button>
                        <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 transition-all hover:bg-rose-500/10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => { pendingDelete = trigger; deleteError = null; }" disabled="@isBusy">
                            <Icon Name="trash" Class="h-4 w-4" />
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</section>

@* Create/Edit Modal *@
@if (showModal)
{
    <div class="fixed inset-0 z-60 flex items-center justify-center bg-gray-900/70 p-4" @onclick="() => { if (!isBusy) CloseModal(); }">
        <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100">@(editingId.HasValue ? "Edit Trigger" : "New Trigger")</h2>
                <button type="button" class="inline-flex items-center rounded-full p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                    <Icon Name="close" Class="h-5 w-5" />
                </button>
            </div>

            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="mx-6 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
                        @formError
                    </div>
                }

                <div class="px-6 py-5">
                    <TagTriggerEditor Tags="tags" RecordTypes="recordTypes" OptionLists="optionLists" Model="formModel" Disabled="isBusy" />
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-4 dark:border-slate-700 dark:bg-slate-900">
                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => { if (!isBusy) CloseModal(); }" disabled="@isBusy">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="check" Class="h-4 w-4" />
                            <span>@(editingId.HasValue ? "Save Changes" : "Create Trigger")</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (pendingDelete != null)
{
    <div class="fixed inset-0 z-60 flex items-center justify-center bg-gray-900/70 p-4">
        <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Delete trigger</h3>
            </div>
            <div class="space-y-3 px-6 py-5 text-sm text-gray-700 dark:text-slate-300">
                <p>Delete trigger <strong>@pendingDelete.Name</strong>? Its reminders still to come are deleted with it; done ones and the tags' values stay.</p>
                @if (!string.IsNullOrEmpty(deleteError))
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-rose-700 dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">@deleteError</div>
                }
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 px-6 py-4 dark:border-slate-700">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="() => pendingDelete = null" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-rose-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500" @onclick="DeleteTrigger" disabled="@isBusy">
                    <Icon Name="trash" Class="h-4 w-4" />
                    <span>@(isBusy ? "Deleting…" : "Delete")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<TagTriggerResponse> triggers = new();
    private IList<TagResponse>? tags;
    private IList<RecordTypeResponse>? recordTypes;
    private IList<TagOptionListResponse>? optionLists;
    private TagTriggerRequest formModel = new() { Name = string.Empty };

    private string? loadError;
    private string? formError;
    private string? deleteError;
    private bool isLoading;
    private bool isBusy;
    private bool showModal;
    private int? editingId;
    private TagTriggerResponse? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>Opens the dialog for a new trigger, once the tags are loaded.</summary>
    public void OpenCreate()
    {
        if (isBusy || tags == null)
        {
            return;
        }

        editingId = null;
        formModel = new TagTriggerRequest
        {
            Name = string.Empty,
            IfOperator = TagRuleOperator.IsLogged,
            Timing = TagTriggerTiming.AfterEntry,
            OffsetMinutes = 180
        };
        OpenModal();
        StateHasChanged();
    }

    /// <summary>Loads the triggers and tags again.</summary>
    public async Task Reload()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var triggersTask = TagTriggerApi.GetTagTriggers();
            var tagsTask = ActivityApi.GetTags();
            var recordTypesTask = RecordApi.GetRecordTypes();
            var optionListsTask = ActivityApi.GetTagOptionListsAsync();
            await Task.WhenAll(triggersTask, tagsTask, recordTypesTask, optionListsTask);

            triggers.Clear();
            triggers.AddRange(triggersTask.Result);
            tags = tagsTask.Result;
            recordTypes = recordTypesTask.Result;
            optionLists = optionListsTask.Result;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view triggers.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load triggers: {ex.Message}";
            Logger.LogError(ex, "Failed to load tag triggers");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEdit(TagTriggerResponse trigger)
    {
        if (TagTriggerForm.ToRequest(trigger) is not { } model)
        {
            return;
        }

        editingId = trigger.Id;
        formModel = model;
        OpenModal();
    }

    private void OpenModal()
    {
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
    }

    private async Task HandleSubmit()
    {
        formError = Validate();
        if (formError is not null)
        {
            return;
        }

        isBusy = true;
        try
        {
            if (editingId.HasValue)
            {
                await TagTriggerApi.UpdateTagTrigger(editingId.Value, formModel);
            }
            else
            {
                await TagTriggerApi.CreateTagTrigger(formModel);
            }

            CloseModal();
            await LoadData();
        }
        catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.NotFound)
        {
            // The server explains what is wrong in plain words.
            formError = string.IsNullOrWhiteSpace(ex.Content) ? "The trigger could not be saved." : ex.Content.Trim('"');
        }
        catch (Exception ex)
        {
            formError = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Failed to save tag trigger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(formModel.Name))
        {
            return "Give the trigger a name.";
        }

        if (formModel.IfTagId == 0 || formModel.PromptTagId == 0)
        {
            return "Choose the tag to watch and the one to log.";
        }

        if (formModel.IfTagId == formModel.PromptTagId)
        {
            return "Choose two different tags.";
        }

        if (formModel.Timing == TagTriggerTiming.AfterEntry && formModel.OffsetMinutes is null)
        {
            return "Enter how long after the entry to remind you.";
        }

        if (formModel.Timing == TagTriggerTiming.AtTime && formModel.AtTime is null)
        {
            return "Choose the time of the reminder.";
        }

        return null;
    }

    private async Task DeleteTrigger()
    {
        if (pendingDelete == null)
        {
            return;
        }

        isBusy = true;
        deleteError = null;
        try
        {
            await TagTriggerApi.DeleteTagTrigger(pendingDelete.Id);
            pendingDelete = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            deleteError = $"Failed to delete: {ex.Message}";
            Logger.LogError(ex, "Failed to delete tag trigger {TriggerId}", pendingDelete?.Id);
        }
        finally
        {
            isBusy = false;
        }
    }
}
