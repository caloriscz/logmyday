@using LogMyDay.Domain.Enums
@using LogMyDay.UI.Formatting
@* Form for a Tag Activity Relations rule: a weighted sum (Σ value × factor), an aggregate
   (average, minimum, maximum, count), a presence value or ordered conditional cases, per day,
   written to the rule's own result tag. Presentational only: the host page loads the tags and
   option lists, owns the Model and saves it. Shared by web and mobile. *@
<div class="space-y-5">
    <div class="space-y-2">
        <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="rule-name">Name <span class="text-rose-500">*</span></label>
        <input id="rule-name" type="text" @bind="Model.Name" maxlength="100" placeholder="e.g., Total vitamin B1"
               class="@InputCss" disabled="@Disabled" />
    </div>

    <div class="space-y-2">
        <label class="text-sm font-medium text-gray-700 dark:text-slate-200" for="rule-calculation">What the rule calculates</label>
        @* Template and aggregate kind as one string-valued choice; a select is never bound to a bool or enum directly. *@
        <select id="rule-calculation" class="@InputCss" value="@CalculationValue" @onchange="OnCalculationChanged" disabled="@Disabled">
            <option value="@WeightedSumValue">Weighted sum — each value × its factor, added up</option>
            <option value="@nameof(TagRuleAggregateKind.Average)">Average of the values</option>
            <option value="@nameof(TagRuleAggregateKind.Minimum)">Minimum of the values</option>
            <option value="@nameof(TagRuleAggregateKind.Maximum)">Maximum of the values</option>
            <option value="@nameof(TagRuleAggregateKind.Count)">Count of entries</option>
            <option value="@PresenceValue">A value when a tag is logged</option>
            <option value="@ConditionalValue">A value by conditions</option>
        </select>
        <p class="text-xs text-gray-500 dark:text-slate-400">@CalculationHint</p>
    </div>

    <div class="space-y-2">
        <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Result tag <span class="text-rose-500">*</span></label>
        @if (IsEditing)
        {
            <p class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-800 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">@TagName(Model.TargetTagId)</p>
            <p class="text-xs text-gray-500 dark:text-slate-400">The result tag of a rule cannot change. Delete the rule and create a new one to use another tag.</p>
        }
        else
        {
            <GroupedTagSelect Tags="targetCandidates" Value="@(Model.TargetTagId == 0 ? null : Model.TargetTagId)" ValueChanged="SetTarget" SelectClass="@InputCss" Disabled="@Disabled" TagPlaceholder="-- Result tag --" />
            <p class="text-xs text-gray-500 dark:text-slate-400">@(IsConditional ? "A text, option list, yes/no or number tag" : "A number tag") with no values of its own. The rule owns it: its values are calculated and cannot be logged by hand.</p>
        }
    </div>

    <div class="space-y-3">
        <div class="flex items-center justify-between">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">@(IsConditional ? "Source" : "Sources") <span class="text-rose-500">*</span></label>
            @if (!IsConditional)
            {
                <button type="button" class="inline-flex items-center gap-1 rounded-md border border-gray-300 bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="AddSource" disabled="@Disabled">
                    <Icon Name="plus" Class="h-3.5 w-3.5" />
                    Add source
                </button>
            }
        </div>

        @if (Model.Sources.Count == 0)
        {
            <p class="text-xs text-gray-500 dark:text-slate-400">Add the tags whose values make up the result.</p>
        }

        @foreach (var source in Model.Sources)
        {
            <div class="flex flex-wrap items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
                <div class="min-w-0 flex-1">
                    <GroupedTagSelect Tags="sourceCandidates" Value="@(source.SourceTagId == 0 ? null : source.SourceTagId)" ValueChanged="@((int? id) => source.SourceTagId = id ?? 0)" SelectClass="@InputCss" Disabled="@Disabled" TagPlaceholder="-- Source tag --" />
                </div>
                @if (!IsConditional)
                {
                    <div class="flex items-center gap-2">
                        @if (Model.Template == TagRuleTemplate.WeightedSum)
                        {
                            <span class="text-sm text-gray-500 dark:text-slate-400" aria-hidden="true">×</span>
                            <input type="number" step="any" @bind="source.Factor" class="w-28 rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" disabled="@Disabled" aria-label="Factor" title="Each value of this tag is multiplied by the factor. Use it for unit conversion, e.g. 100 when one pill contains 100 mg; negative values subtract." />
                        }
                        <button type="button" class="inline-flex items-center rounded-md px-2 py-1 text-rose-600 transition-all hover:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => Model.Sources.Remove(source)" disabled="@Disabled" title="Remove source">
                            <Icon Name="trash" Class="h-4 w-4" />
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (CalculationValue == PresenceValue && Model.Cases.Count > 0)
    {
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Value on days the source is logged <span class="text-rose-500">*</span></label>
            @ResultInput(Model.Cases[0])
        </div>
    }
    else if (CalculationValue == ConditionalValue)
    {
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Cases <span class="text-rose-500">*</span></label>
                <button type="button" class="inline-flex items-center gap-1 rounded-md border border-gray-300 bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" @onclick="AddCase" disabled="@Disabled">
                    <Icon Name="plus" Class="h-3.5 w-3.5" />
                    Add case
                </button>
            </div>
            <p class="text-xs text-gray-500 dark:text-slate-400">Checked from the top; the first case that holds gives the value. @(SourceKind == Kind.Number ? "The day's total is compared." : "The day's latest entry is compared.") "Otherwise" can only be last.</p>

            @for (var i = 0; i < Model.Cases.Count; i++)
            {
                var index = i;
                var ruleCase = Model.Cases[index];
                <div class="space-y-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/50">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-semibold text-gray-500 dark:text-slate-400">@(index + 1).</span>
                        <select class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" value="@ruleCase.Operator.ToString()" @onchange="e => SetOperator(ruleCase, e.Value?.ToString())" disabled="@Disabled" aria-label="Condition">
                            @foreach (var (op, label) in OperatorChoices)
                            {
                                <option value="@op.ToString()">@label</option>
                            }
                        </select>
                        @if (NeedsOperand(ruleCase.Operator))
                        {
                            @if (SourceKind == Kind.Number)
                            {
                                <input type="number" step="any" class="w-28 rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" value="@ruleCase.Operand" @onchange="e => ruleCase.Operand = e.Value?.ToString()" disabled="@Disabled" aria-label="Compared value" />
                            }
                            else if (SourceOptions is { } sourceOptions)
                            {
                                <select class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" value="@ruleCase.Operand" @onchange="e => ruleCase.Operand = e.Value?.ToString()" disabled="@Disabled" aria-label="Compared value">
                                    <option value="">-- Option --</option>
                                    @foreach (var option in sourceOptions.Options)
                                    {
                                        <option value="@option.Value">@(option.DisplayName ?? option.Value)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" class="w-40 rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" value="@ruleCase.Operand" @onchange="e => ruleCase.Operand = e.Value?.ToString()" disabled="@Disabled" aria-label="Compared value" />
                            }
                        }
                        <div class="ml-auto flex items-center gap-1">
                            <button type="button" class="rounded-md px-2 py-1 text-gray-600 hover:bg-gray-200 disabled:opacity-40 dark:text-slate-300 dark:hover:bg-slate-700" @onclick="() => MoveCase(index, -1)" disabled="@(Disabled || index == 0)" title="Move up" aria-label="Move up">
                                <Icon Name="chevron-up" Class="h-4 w-4" />
                            </button>
                            <button type="button" class="rounded-md px-2 py-1 text-gray-600 hover:bg-gray-200 disabled:opacity-40 dark:text-slate-300 dark:hover:bg-slate-700" @onclick="() => MoveCase(index, 1)" disabled="@(Disabled || index == Model.Cases.Count - 1)" title="Move down" aria-label="Move down">
                                <Icon Name="chevron-down" Class="h-4 w-4" />
                            </button>
                            <button type="button" class="rounded-md px-2 py-1 text-rose-600 hover:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500/20" @onclick="() => Model.Cases.RemoveAt(index)" disabled="@Disabled" title="Remove case" aria-label="Remove case">
                                <Icon Name="trash" Class="h-4 w-4" />
                            </button>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm text-gray-500 dark:text-slate-400">→ value</span>
                        <div class="min-w-0 flex-1">@ResultInput(ruleCase)</div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Sources.Any(s => s.SourceTagId != 0))
    {
        <p class="rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-sm text-violet-900 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-100">
            Each day: <strong>@TagName(Model.TargetTagId)</strong> = @Formula()
        </p>
    }

    <div class="space-y-2">
        <label class="flex items-start gap-2 text-sm text-gray-700 dark:text-slate-200">
            <input type="checkbox" @bind="Model.IgnoreZero" class="mt-0.5 h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" disabled="@Disabled" />
            <span>Ignore zero values <span class="text-gray-500 dark:text-slate-400">— zeros and "no" entries (e.g. skipped reminders) are left out; a day with only those gets no result</span></span>
        </label>
        <label class="flex items-start gap-2 text-sm text-gray-700 dark:text-slate-200">
            <input type="checkbox" @bind="Model.IsEnabled" class="mt-0.5 h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-800" disabled="@Disabled" />
            <span>Active <span class="text-gray-500 dark:text-slate-400">— a paused rule keeps its values but stops updating them</span></span>
        </label>
    </div>

    @if (!IsEditing)
    {
        <p class="text-xs text-gray-500 dark:text-slate-400">The rule starts today. After saving you can calculate past days too, with a preview of what changes.</p>
    }
</div>

@code {
    private const string InputCss = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs focus:border-transparent focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100";
    private const string SmallInputCss = "w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100";
    private const string WeightedSumValue = "WeightedSum";
    private const string PresenceValue = "Presence";
    private const string ConditionalValue = "Conditional";

    private enum Kind { Number, YesNo, Other }

    /// <summary>All of the user's tags. The editor offers the tags that can take part.</summary>
    [Parameter, EditorRequired] public IList<TagResponse>? Tags { get; set; }

    /// <summary>The user's option lists, for option-list sources and results.</summary>
    [Parameter] public IList<TagOptionListResponse>? OptionLists { get; set; }

    [Parameter, EditorRequired] public TagRuleRequest Model { get; set; } = default!;

    /// <summary>Editing an existing rule: the result tag is shown but cannot change.</summary>
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Formats factors in the preview; the user's culture.</summary>
    [Parameter] public System.Globalization.CultureInfo? Culture { get; set; }

    // Stable lists, rebuilt only when the tags or the calculation change, so the grouped pickers
    // keep their selected group.
    private IList<TagResponse>? targetCandidates;
    private IList<TagResponse>? sourceCandidates;
    private IList<TagResponse>? candidatesSource;
    private string? candidatesCalculation;

    private bool IsConditional => Model.Template == TagRuleTemplate.Conditional;

    private string CalculationValue => Model.Template switch
    {
        TagRuleTemplate.Aggregate => (Model.AggregateKind ?? TagRuleAggregateKind.Average).ToString(),
        TagRuleTemplate.Conditional when Model.Cases.Count == 1 && Model.Cases[0].Operator == TagRuleOperator.IsLogged => PresenceValue,
        TagRuleTemplate.Conditional => ConditionalValue,
        _ => WeightedSumValue
    };

    private string CalculationHint => CalculationValue switch
    {
        nameof(TagRuleAggregateKind.Count) => "How many entries the source tags have that day, of any tag type.",
        WeightedSumValue => "For totals, e.g. a nutrient from several products. Sources are number tags.",
        PresenceValue => "The result tag gets a fixed value on every day the source tag is logged, e.g. Gym → Exercise = yes.",
        ConditionalValue => "The result tag gets the value of the first case that holds, e.g. 'Over limit' when Coffees ≥ 4.",
        _ => "Over all of the day's values of the source tags. Sources are number, rating, score or percentage tags."
    };

    private TagResponse? SourceTag => Tags?.FirstOrDefault(t => t.Id == Model.Sources.FirstOrDefault()?.SourceTagId);
    private TagResponse? TargetTag => Tags?.FirstOrDefault(t => t.Id == Model.TargetTagId);

    private Kind SourceKind => SourceTag switch
    {
        null => Kind.Other,
        { OptionListId: not null } => Kind.Other,
        { InputTypeId: 1 or 6 or 7 or 8 or 9 or 10 or 11 } => Kind.Number,
        { InputTypeId: 3 } => Kind.YesNo,
        _ => Kind.Other
    };

    private TagOptionListResponse? SourceOptions => OptionListOf(SourceTag);
    private TagOptionListResponse? TargetOptions => OptionListOf(TargetTag);

    private TagOptionListResponse? OptionListOf(TagResponse? tag) =>
        tag?.OptionListId is int id ? OptionLists?.FirstOrDefault(l => l.Id == id) : null;

    private IEnumerable<(TagRuleOperator Op, string Label)> OperatorChoices
    {
        get
        {
            yield return (TagRuleOperator.IsLogged, "is logged");
            switch (SourceKind)
            {
                case Kind.Number:
                    yield return (TagRuleOperator.Equal, "=");
                    yield return (TagRuleOperator.NotEqual, "≠");
                    yield return (TagRuleOperator.Greater, ">");
                    yield return (TagRuleOperator.GreaterOrEqual, "≥");
                    yield return (TagRuleOperator.Less, "<");
                    yield return (TagRuleOperator.LessOrEqual, "≤");
                    break;
                case Kind.YesNo:
                    yield return (TagRuleOperator.IsYes, "is yes");
                    yield return (TagRuleOperator.IsNo, "is no");
                    break;
                default:
                    yield return (TagRuleOperator.Equal, "equals");
                    yield return (TagRuleOperator.NotEqual, "does not equal");
                    break;
            }

            yield return (TagRuleOperator.Otherwise, "otherwise");
        }
    }

    private static bool NeedsOperand(TagRuleOperator op) =>
        op is not (TagRuleOperator.IsLogged or TagRuleOperator.Otherwise or TagRuleOperator.IsYes or TagRuleOperator.IsNo);

    // The value input matches the result tag: an option list, yes/no, a number or free text.
    private RenderFragment ResultInput(TagRuleCaseRequest ruleCase) => __builder =>
    {
        if (TargetOptions is { } options)
        {
            <select class="@SmallInputCss" value="@ruleCase.ResultValue" @onchange="e => ruleCase.ResultValue = e.Value?.ToString() ?? string.Empty" disabled="@Disabled" aria-label="Result value">
                <option value="">-- Option --</option>
                @foreach (var option in options.Options)
                {
                    <option value="@option.Value">@(option.DisplayName ?? option.Value)</option>
                }
            </select>
        }
        else if (TargetTag?.InputTypeId == 3)
        {
            <select class="@SmallInputCss" value="@ruleCase.ResultValue" @onchange="e => ruleCase.ResultValue = e.Value?.ToString() ?? string.Empty" disabled="@Disabled" aria-label="Result value">
                <option value="">-- Yes or no --</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        }
        else if (TargetTag?.InputTypeId is 1 or 6)
        {
            <input type="number" step="any" class="@SmallInputCss" value="@ruleCase.ResultValue" @onchange="e => ruleCase.ResultValue = e.Value?.ToString() ?? string.Empty" disabled="@Disabled" aria-label="Result value" />
        }
        else
        {
            <input type="text" maxlength="500" class="@SmallInputCss" value="@ruleCase.ResultValue" @onchange="e => ruleCase.ResultValue = e.Value?.ToString() ?? string.Empty" disabled="@Disabled" aria-label="Result value" placeholder="Text" />
        }
    };

    protected override void OnParametersSet()
    {
        RebuildCandidates();
    }

    private void OnCalculationChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        switch (value)
        {
            case PresenceValue:
                Model.Template = TagRuleTemplate.Conditional;
                Model.AggregateKind = null;
                KeepOneSource();
                Model.Cases = [new TagRuleCaseRequest { Operator = TagRuleOperator.IsLogged, ResultValue = Model.Cases.FirstOrDefault()?.ResultValue ?? string.Empty }];
                break;
            case ConditionalValue:
                Model.Template = TagRuleTemplate.Conditional;
                Model.AggregateKind = null;
                KeepOneSource();
                if (Model.Cases.Count == 0 || CalculationValue == PresenceValue)
                {
                    Model.Cases = [new TagRuleCaseRequest { Operator = SourceKind == Kind.Number ? TagRuleOperator.GreaterOrEqual : TagRuleOperator.Equal }];
                }
                break;
            default:
                Model.Cases = [];
                if (Enum.TryParse<TagRuleAggregateKind>(value, out var kind))
                {
                    Model.Template = TagRuleTemplate.Aggregate;
                    Model.AggregateKind = kind;
                }
                else
                {
                    Model.Template = TagRuleTemplate.WeightedSum;
                    Model.AggregateKind = null;
                }
                break;
        }

        RebuildCandidates();
    }

    // A presence or conditional rule reads exactly one source tag.
    private void KeepOneSource()
    {
        if (Model.Sources.Count == 0)
        {
            Model.Sources.Add(new TagRuleSourceRequest { Factor = 1 });
        }
        else if (Model.Sources.Count > 1)
        {
            Model.Sources = [Model.Sources[0]];
        }
    }

    private void RebuildCandidates()
    {
        if (ReferenceEquals(Tags, candidatesSource) && candidatesCalculation == CalculationValue)
        {
            return;
        }

        candidatesSource = Tags;
        candidatesCalculation = CalculationValue;

        // A computed tag is never offered: a rule owns it, and rules do not feed rules.
        var usable = (Tags ?? []).Where(t => !t.IsComputed).ToList();
        targetCandidates = IsConditional
            ? usable.Where(t => t.OptionListId != null || t.InputTypeId is 1 or 2 or 3 or 6).ToList()
            : usable.Where(t => t.InputTypeId is 1 or 6).ToList();
        sourceCandidates = CalculationValue switch
        {
            WeightedSumValue => usable.Where(t => t.InputTypeId is 1 or 6).ToList(),
            nameof(TagRuleAggregateKind.Count) or PresenceValue or ConditionalValue => usable,
            _ => usable.Where(t => t.InputTypeId is 1 or 6 or 7 or 8 or 9 or 10 or 11).ToList()
        };
    }

    private void SetTarget(int? tagId)
    {
        Model.TargetTagId = tagId ?? 0;
    }

    private void AddSource()
    {
        Model.Sources.Add(new TagRuleSourceRequest { Factor = 1 });
    }

    private void AddCase()
    {
        // A new case goes before a trailing "otherwise", which must stay last.
        var newCase = new TagRuleCaseRequest { Operator = SourceKind == Kind.Number ? TagRuleOperator.GreaterOrEqual : TagRuleOperator.Equal };
        var otherwiseLast = Model.Cases.Count > 0 && Model.Cases[^1].Operator == TagRuleOperator.Otherwise;
        Model.Cases.Insert(otherwiseLast ? Model.Cases.Count - 1 : Model.Cases.Count, newCase);
    }

    private void MoveCase(int index, int step)
    {
        var target = index + step;
        if (target < 0 || target >= Model.Cases.Count)
        {
            return;
        }

        (Model.Cases[index], Model.Cases[target]) = (Model.Cases[target], Model.Cases[index]);
    }

    private static void SetOperator(TagRuleCaseRequest ruleCase, string? value)
    {
        if (Enum.TryParse<TagRuleOperator>(value, out var op))
        {
            ruleCase.Operator = op;
            if (!NeedsOperand(op))
            {
                ruleCase.Operand = null;
            }
        }
    }

    private string TagName(int tagId)
    {
        return Tags?.FirstOrDefault(t => t.Id == tagId)?.Title ?? "result";
    }

    private string Formula()
    {
        var sources = Model.Sources
            .Where(s => s.SourceTagId != 0)
            .Select(s => (TagName(s.SourceTagId), s.Factor))
            .ToList();
        var cases = Model.Cases
            .Select(c => new TagRuleText.Case(c.Operator.ToString(), c.Operand, ResultLabel(c.ResultValue)))
            .ToList();

        return TagRuleText.Formula(Model.Template.ToString(), Model.AggregateKind?.ToString(), sources, cases,
            Culture ?? System.Globalization.CultureInfo.CurrentCulture);
    }

    // An option result reads better by its display name.
    private string ResultLabel(string value) =>
        TargetOptions?.Options.FirstOrDefault(o => o.Value == value)?.DisplayName ?? value;
}
