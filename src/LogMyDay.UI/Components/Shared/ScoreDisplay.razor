@using Microsoft.AspNetCore.Components

<span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.7rem; font-weight: 700; color: #ffffff; background: @GetScoreColor(Value, MaxScore);" title="Score: @Value / @MaxScore">
    @Value
</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public int MaxScore { get; set; } = 5;

    private static string GetScoreColor(int value, int max)
    {
        if (max == 0) return "#22c55e";
        var ratio = (double)value / max;
        if (ratio <= 0.5)
        {
            var t = ratio * 2;
            var r = (int)(0x22 + (0xea - 0x22) * t);
            var g = (int)(0xc5 + (0xb3 - 0xc5) * t);
            var b = (int)(0x5e + (0x08 - 0x5e) * t);
            return $"#{r:x2}{g:x2}{b:x2}";
        }
        else
        {
            var t = (ratio - 0.5) * 2;
            var r = (int)(0xea + (0xef - 0xea) * t);
            var g = (int)(0xb3 + (0x44 - 0xb3) * t);
            var b = (int)(0x08 + (0x44 - 0x08) * t);
            return $"#{r:x2}{g:x2}{b:x2}";
        }
    }
}
