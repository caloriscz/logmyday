@using Microsoft.AspNetCore.Components
@using LogMyDay.Domain.Constants
@using LogMyDay.Domain.Helpers

<span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.7rem; font-weight: 700; color: #ffffff; background: @Background;" title="Score: @Value / @MaxScore">
    @Value
</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public int MaxScore { get; set; } = 5;

    /// <summary>Explicit color from the tag's color scheme; when null the built-in default applies.</summary>
    [Parameter] public string? Color { get; set; }

    private string Background => Color
        ?? DefaultColorSchemes.Resolve(MaxScore > 5 ? InputTypeIds.Score10 : InputTypeIds.Score, Value)
        ?? "#6b7280";
}
