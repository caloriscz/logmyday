<div class="@ContainerClass">
    <select class="@SelectClass" value="@_selectedGroupName" @onchange="OnGroupChangedAsync" @onfocus="OnFocus" disabled="@Disabled">
        @if (ShowAllGroupsOption)
        {
            <option value="">@GroupPlaceholder</option>
        }
        @foreach (var g in _distinctGroups)
        {
            <option value="@g">@g</option>
        }
        @if (_hasUngrouped)
        {
            <option value="@UngroupedKey">(Ungrouped)</option>
        }
    </select>
    <select class="@SelectClass" value="@_tagValueStr" @onchange="OnTagChangedAsync" disabled="@Disabled">
        <option value="">@TagPlaceholder</option>
        @foreach (var tag in _filteredTags)
        {
            <option value="@tag.Id">@GetBareTagName(tag)</option>
        }
    </select>
</div>

@code {
    private const string UngroupedKey = "__ungrouped__";

    [Parameter] public IList<TagResponse>? Tags { get; set; }
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string? ContainerClass { get; set; } = "flex flex-col gap-2 sm:flex-row sm:items-center";
    [Parameter] public string? SelectClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowAllGroupsOption { get; set; } = false;
    [Parameter] public string GroupPlaceholder { get; set; } = "(All groups)";
    [Parameter] public string TagPlaceholder { get; set; } = "-- Tag --";
    [Parameter] public EventCallback OnFocus { get; set; }

    private string? _selectedGroupName;
    private List<string> _distinctGroups = [];
    private bool _hasUngrouped;
    private List<TagResponse> _filteredTags = [];
    private string _tagValueStr => Value?.ToString() ?? "";

    private int? _lastSyncedValue;
    private IList<TagResponse>? _lastTags;

    protected override void OnParametersSet()
    {
        var tagsChanged = !ReferenceEquals(Tags, _lastTags);

        if (tagsChanged)
        {
            _lastTags = Tags;
            BuildGroupList();
        }

        if (Value != _lastSyncedValue)
        {
            _lastSyncedValue = Value;

            if (Value == null)
            {
                _selectedGroupName = ShowAllGroupsOption ? null : DefaultGroupSelection();
            }
            else
            {
                SyncGroupFromValue();
            }

            FilterTags();
        }
        else if (tagsChanged)
        {
            if (Value == null && !ShowAllGroupsOption && _selectedGroupName is null or "")
            {
                _selectedGroupName = DefaultGroupSelection();
            }

            FilterTags();
        }
    }

    private void BuildGroupList()
    {
        if (Tags == null)
        {
            _distinctGroups = [];
            _hasUngrouped = false;

            return;
        }

        _distinctGroups = Tags
            .Where(t => t.GroupName != null)
            .Select(t => t.GroupName!)
            .Distinct()
            .OrderBy(g => g)
            .ToList();

        _hasUngrouped = Tags.Any(t => t.GroupName == null);
    }

    private string? DefaultGroupSelection()
    {
        return _hasUngrouped ? UngroupedKey : _distinctGroups.FirstOrDefault();
    }

    private void SyncGroupFromValue()
    {
        var tag = Tags?.FirstOrDefault(t => t.Id == Value);

        if (tag == null)
        {
            return;
        }

        _selectedGroupName = tag.GroupName ?? UngroupedKey;
    }

    private void FilterTags()
    {
        if (Tags == null)
        {
            _filteredTags = [];

            return;
        }

        _filteredTags = _selectedGroupName switch
        {
            null or "" => [.. Tags],
            UngroupedKey => Tags.Where(t => t.GroupName == null).ToList(),
            _ => Tags.Where(t => t.GroupName == _selectedGroupName).ToList()
        };
    }

    private async Task OnGroupChangedAsync(ChangeEventArgs e)
    {
        _selectedGroupName = e.Value?.ToString();
        FilterTags();
        await ValueChanged.InvokeAsync(null);
    }

    private async Task OnTagChangedAsync(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        var tagId = string.IsNullOrEmpty(str) ? (int?)null : int.Parse(str);
        await ValueChanged.InvokeAsync(tagId);
    }

    private static string GetBareTagName(TagResponse tag)
    {
        if (tag.GroupName == null)
        {
            return tag.Title;
        }

        var prefix = tag.GroupName + ": ";

        return tag.Title.StartsWith(prefix, StringComparison.Ordinal) ? tag.Title[prefix.Length..] : tag.Title;
    }
}
