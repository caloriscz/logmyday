@using System.Globalization
@using LogMyDay.UI.Formatting
@using LogMyDay.Shared.Formatting
@using Refit
@inject ITagCheckApi TagCheckApi
@inject ILogger<TagCheckReview> Logger

@* The Rule review: the days in a range that break an active check, newest first. Computed on
   request; nothing is stored. Shared by the web and mobile review pages. *@
<div class="space-y-4">
    <form class="flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-xs dark:border-slate-700 dark:bg-slate-900" @onsubmit="Load" @onsubmit:preventDefault>
        <div class="space-y-1">
            <label for="review-from" class="text-sm font-medium text-gray-700 dark:text-slate-200">From</label>
            <input id="review-from" type="date" value="@DateValue(from)" @onchange="e => from = ParseDate(e.Value)" disabled="@isLoading"
                   class="block rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
        </div>
        <div class="space-y-1">
            <label for="review-to" class="text-sm font-medium text-gray-700 dark:text-slate-200">To</label>
            <input id="review-to" type="date" value="@DateValue(to)" @onchange="e => to = ParseDate(e.Value)" disabled="@isLoading"
                   class="block rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />
        </div>
        <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 disabled:opacity-60" disabled="@isLoading">
            <Icon Name="search" Class="h-4 w-4" />
            <span>@(isLoading ? "Checking…" : "Review")</span>
        </button>
    </form>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-xs dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">@error</div>
    }
    else if (review == null)
    {
        @if (isLoading)
        {
            <div class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 shadow-xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-transparent dark:border-slate-600"></span>
                <span>Checking the days…</span>
            </div>
        }
    }
    else if (review.CheckCount == 0)
    {
        <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-sm text-gray-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            No active checks. Add one on the Rules page.
        </div>
    }
    else if (review.Items.Count == 0)
    {
        <div class="rounded-xl border border-gray-200 bg-white px-6 py-10 text-center text-sm text-gray-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            No day from @review.From.ToString("d", DisplayCulture) to @review.To.ToString("d", DisplayCulture) breaks @(review.CheckCount == 1 ? "the active check" : $"any of the {review.CheckCount} active checks").
        </div>
    }
    else
    {
        <p class="text-sm text-gray-600 dark:text-slate-400">
            @BrokenCount @(BrokenCount == 1 ? "day breaks" : "days break") a check from @review.From.ToString("d", DisplayCulture) to @review.To.ToString("d", DisplayCulture)@(PendingCount > 0 ? $"; {PendingCount} pending today" : string.Empty).
        </p>
        @foreach (var day in review.Items.GroupBy(i => i.Date))
        {
            <section class="rounded-xl border border-gray-200 bg-white shadow-xs dark:border-slate-700 dark:bg-slate-900">
                <h3 class="border-b border-gray-200 px-4 py-2 text-sm font-semibold text-gray-900 dark:border-slate-700 dark:text-slate-100">@day.Key.ToString("D", DisplayCulture)</h3>
                <ul class="divide-y divide-gray-100 dark:divide-slate-800">
                    @foreach (var item in day)
                    {
                        <li class="space-y-1 px-4 py-3">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-medium text-gray-900 dark:text-slate-100">@item.CheckName</span>
                                @if (item.IsPending)
                                {
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700 dark:bg-slate-700 dark:text-slate-200">Pending today</span>
                                }
                                else if (item.Severity == "Warn")
                                {
                                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-500/20 dark:text-amber-200">Warn</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-500/20 dark:text-sky-200">Flag</span>
                                }
                            </div>
                            <p class="text-sm text-gray-600 dark:text-slate-300">@TagCheckText.Found(item)</p>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    /// <summary>Formats the dates; the user's culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    private TagCheckReviewResponse? review;
    private DateOnly? from;
    private DateOnly? to;
    private bool isLoading;
    private string? error;

    private CultureInfo DisplayCulture => Culture ?? CultureInfo.CurrentCulture;
    private int PendingCount => review?.Items.Count(i => i.IsPending) ?? 0;
    private int BrokenCount => review?.Items.Where(i => !i.IsPending).Select(i => i.Date).Distinct().Count() ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    // Without dates the server reviews the last 30 days; the answer fills in the range it used.
    private async Task Load()
    {
        isLoading = true;
        error = null;

        try
        {
            review = await TagCheckApi.ReviewTagChecks(from, to);
            from = review.From;
            to = review.To;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            error = string.IsNullOrWhiteSpace(ex.Content) ? "This range cannot be reviewed." : ex.Content.Trim('"');
        }
        catch (Exception ex)
        {
            error = $"Failed to review the checks: {ex.Message}";
            Logger.LogError(ex, "Failed to review tag checks");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string DateValue(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    private static DateOnly? ParseDate(object? value) =>
        DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : null;
}
