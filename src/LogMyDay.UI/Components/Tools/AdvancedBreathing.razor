@code {
    [Parameter] public bool ShowSaveControls { get; set; } = true;

    private const string SettingsStorageKey = "logmyday.advancedBreathing.settings";

    private bool isSettingsOpen;
    private bool settingsLoaded;
    private bool settingsReady;

    private int _inhaleSeconds = 4;
    private int _holdSeconds = 7;
    private int _exhaleSeconds = 8;
    private int _hold2Seconds = 4;
    private int _cycleCount = 4;
    private string selectedMode = "triangle";

    private int selectedTagId;

    private IJSObjectReference? module;
    private IJSObjectReference? breathingController;

    private bool isLoading;
    private int saveCountdown;
    private string statusMessage = string.Empty;
    private List<TagResponse>? availableTags;
    private System.Threading.Timer? cooldownTimer;
    private DateTime sessionStartTime;
    private TimeSpan sessionTime = TimeSpan.Zero;
    private int totalCycles;
    private System.Threading.Timer? sessionTimer;

    private TagResponse? SelectedTag => availableTags?.FirstOrDefault(t => t.Id == selectedTagId);

    private bool IsSaveDisabled => selectedTagId == 0 || sessionTime.TotalSeconds < 10 || saveCountdown > 0;

    private int InhaleSeconds
    {
        get => _inhaleSeconds;
        set => SetTiming(ref _inhaleSeconds, value, 1, 120);
    }

    private int HoldSeconds
    {
        get => _holdSeconds;
        set => SetTiming(ref _holdSeconds, value, 1, 120);
    }

    private int ExhaleSeconds
    {
        get => _exhaleSeconds;
        set => SetTiming(ref _exhaleSeconds, value, 1, 120);
    }

    private int Hold2Seconds
    {
        get => _hold2Seconds;
        set => SetTiming(ref _hold2Seconds, value, 1, 120);
    }

    private int CycleCount
    {
        get => _cycleCount;
        set => SetTiming(ref _cycleCount, value, 1, 60);
    }

    private string SelectedMode => selectedMode;

    private int SelectedTagId
    {
        get => selectedTagId;
        set => SetSelectedTagId(value, true);
    }

    protected override async Task OnInitializedAsync()
    {
        if (ShowSaveControls)
        {
            try
            {
                isLoading = true;
                StateHasChanged();

                var allTags = await ActivityApi.GetTags();
                availableTags = allTags?.Where(t => t.TypeId == 1).ToList();

                Logger.LogInformation("Loaded {Count} integer tags for advanced breathing techniques", availableTags?.Count ?? 0);

                if (selectedTagId != 0 && availableTags?.Any(t => t.Id == selectedTagId) != true)
                {
                    SetSelectedTagId(0, false);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load tags for breathing techniques");
                statusMessage = "Failed to load tags. You won't be able to save sessions.";
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!settingsLoaded)
        {
            await LoadStoredSettingsAsync();
            settingsLoaded = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!settingsReady)
        {
            await InitializeBreathingModuleAsync();
        }
    }

    private async Task LoadStoredSettingsAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", SettingsStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var settings = JsonSerializer.Deserialize<BreathingSettingsPayload>(json);
                if (settings is not null)
                {
                    _inhaleSeconds = SanitizeTiming(settings.Inhale, 1, 120);
                    _holdSeconds = SanitizeTiming(settings.Hold, 1, 120);
                    _exhaleSeconds = SanitizeTiming(settings.Exhale, 1, 120);
                    _hold2Seconds = SanitizeTiming(settings.Hold2, 1, 120);
                    _cycleCount = SanitizeTiming(settings.Cycles, 1, 60);
                    selectedMode = settings.Mode?.Equals("box", StringComparison.OrdinalIgnoreCase) == true ? "box" : "triangle";

                    if (ShowSaveControls)
                    {
                        selectedTagId = settings.TagId > 0 ? settings.TagId : 0;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load breathing settings from storage");
        }
    }

    private async Task InitializeBreathingModuleAsync()
    {
        try
        {
            await Task.Delay(75);

            module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/LogMyDay.UI/js/components/breathing.js");
            breathingController = await module.InvokeAsync<IJSObjectReference>("initializeBreathing");

            if (selectedMode == "box")
            {
                await breathingController.InvokeVoidAsync("updateMode", selectedMode);
            }

            if (ShowSaveControls && sessionTimer is null)
            {
                sessionStartTime = DateTime.Now;
                sessionTimer = new System.Threading.Timer(UpdateSessionTimer, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load breathing JavaScript module: {Error}", ex.Message);
        }
        finally
        {
            settingsReady = true;
            _ = PersistUserSettingsAsync();
        }
    }

    private void SetTiming(ref int field, int value, int min, int max)
    {
        var sanitized = SanitizeTiming(value, min, max);
        if (field == sanitized)
        {
            return;
        }

        field = sanitized;

        if (settingsReady)
        {
            _ = PersistUserSettingsAsync();
        }
    }

    private void AdjustTiming(string field, int delta)
    {
        if (delta == 0)
        {
            return;
        }

        switch (field)
        {
            case "inhale":
                InhaleSeconds = SanitizeTiming(InhaleSeconds + delta, 1, 120);
                break;
            case "hold":
                HoldSeconds = SanitizeTiming(HoldSeconds + delta, 1, 120);
                break;
            case "exhale":
                ExhaleSeconds = SanitizeTiming(ExhaleSeconds + delta, 1, 120);
                break;
            case "hold2":
                Hold2Seconds = SanitizeTiming(Hold2Seconds + delta, 1, 120);
                break;
            case "cycles":
                CycleCount = SanitizeTiming(CycleCount + delta, 1, 60);
                break;
            default:
                return;
        }
    }

    private void UpdateMode(string? mode, bool persist)
    {
        var normalized = string.Equals(mode, "box", StringComparison.OrdinalIgnoreCase) ? "box" : "triangle";

        if (selectedMode == normalized && !persist)
        {
            return;
        }

        var changed = selectedMode != normalized;
        selectedMode = normalized;

        if (breathingController is not null && changed)
        {
            _ = breathingController.InvokeVoidAsync("updateMode", selectedMode);
        }

        if (persist && settingsReady)
        {
            _ = PersistUserSettingsAsync();
        }
    }

    private void SetSelectedTagId(int value, bool persist)
    {
        var sanitized = value < 0 ? 0 : value;

        if (selectedTagId == sanitized)
        {
            return;
        }

        selectedTagId = sanitized;

        if (persist && settingsReady)
        {
            _ = PersistUserSettingsAsync();
        }
    }

    private async Task PersistUserSettingsAsync()
    {
        if (!settingsReady)
        {
            return;
        }

        try
        {
            var payload = new BreathingSettingsPayload(
                _inhaleSeconds,
                _holdSeconds,
                _exhaleSeconds,
                _hold2Seconds,
                _cycleCount,
                selectedMode,
                ShowSaveControls ? selectedTagId : 0);

            var json = JsonSerializer.Serialize(payload);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", SettingsStorageKey, json);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to persist breathing settings");
        }
    }

    private static int SanitizeTiming(int value, int min, int max)
    {
        if (value < min)
        {
            return min;
        }

        if (value > max)
        {
            return max;
        }

        return value;
    }

    private void OpenSettings()
    {
        isSettingsOpen = true;
    }

    private async Task CloseSettings()
    {
        isSettingsOpen = false;
        await PersistUserSettingsAsync();
    }

    private void UpdateSessionTimer(object? state)
    {
        if (!ShowSaveControls)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            try
            {
                var isRunning = await JSRuntime.InvokeAsync<bool>("eval", "window.breathingState && window.breathingState.running || false");
                if (isRunning)
                {
                    var jsStartTime = await JSRuntime.InvokeAsync<string>("eval", "window.breathingState && window.breathingState.sessionStartTime ? window.breathingState.sessionStartTime.toISOString() : null");
                    if (DateTime.TryParse(jsStartTime, out var startTime))
                    {
                        sessionStartTime = startTime;
                        sessionTime = DateTime.Now - sessionStartTime;
                    }
                    var currentCycles = await JSRuntime.InvokeAsync<int>("eval", "window.breathingState ? window.breathingState.cycle : 0");
                    totalCycles = currentCycles;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error updating session timer");
            }
        });
    }

    private async Task SaveBreathingSession()
    {
        if (!ShowSaveControls || selectedTagId == 0 || sessionTime.TotalSeconds < 10 || saveCountdown > 0)
        {
            return;
        }

        try
        {
            var sessionMinutes = (int)Math.Round(sessionTime.TotalMinutes);
            if (sessionMinutes < 1)
            {
                sessionMinutes = 1;
            }

            var request = new ActivityRequest
            {
                DateStarted = sessionStartTime,
                Description = sessionMinutes.ToString(),
                PrimaryTagId = selectedTagId
            };

            await ActivityApi.CreateCalendarItem(request);

            var tagName = SelectedTag?.Title ?? "selected tag";
            statusMessage = $"Session saved successfully! Duration: {sessionMinutes} minutes, Cycles: {totalCycles} (Tag: {tagName})";
            Logger.LogInformation("Advanced breathing session saved: {Minutes} minutes, {Cycles} cycles", sessionMinutes, totalCycles);

            saveCountdown = 60;
            cooldownTimer = new System.Threading.Timer(DecrementCooldown, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save breathing session");
            statusMessage = "Failed to save session. Please try again.";
        }

        StateHasChanged();
    }

    private void DecrementCooldown(object? state)
    {
        if (saveCountdown > 0)
        {
            saveCountdown--;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            cooldownTimer?.Dispose();
        }
    }

    public void Dispose()
    {
        cooldownTimer?.Dispose();
        sessionTimer?.Dispose();

        if (module is not null)
        {
            _ = module.DisposeAsync();
        }

        if (breathingController is not null)
        {
            _ = breathingController.DisposeAsync();
        }
    }

    private sealed record BreathingSettingsPayload(int Inhale, int Hold, int Exhale, int Hold2, int Cycles, string? Mode, int TagId);
}
