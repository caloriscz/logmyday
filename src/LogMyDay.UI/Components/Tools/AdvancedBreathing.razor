@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using Microsoft.JSInterop
@using System.Linq
@using System.Text.Json
@inject IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<AdvancedBreathing> Logger

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="app-breathing card" id="app-breathing">
                <div class="breathing-layout">
                    <div class="breathing-header">
                        <div class="mode-toggle" role="radiogroup" aria-label="Breathing mode">
                            <label class="toggle-option">
                                <input type="radio" name="mode" value="triangle" checked="@(SelectedMode == "triangle")" @onchange="@(() => UpdateMode("triangle", true))" />
                                <span>Triangle</span>
                            </label>
                            <label class="toggle-option">
                                <input type="radio" name="mode" value="box" checked="@(SelectedMode == "box")" @onchange="@(() => UpdateMode("box", true))" />
                                <span>Square</span>
                            </label>
                        </div>
                        <button class="btn ghost settings-btn" type="button" @onclick="OpenSettings">
                            <i class="bi bi-sliders me-1"></i>Settings
                        </button>
                    </div>

                    <section class="tri-panel" aria-label="Breathing visualisation">
                        <div class="viz state-inhale" id="viz">
                            <!-- One SVG that can show Triangle or Box (square) -->
                            <svg viewBox="0 0 100 92" preserveAspectRatio="xMidYMid meet" id="shapeSvg" aria-hidden="true">
                                <!-- Backgrounds -->
                                <!-- Triangle (points: left-bottom, top, right-bottom) -->
                                <path id="bg-tri" class="bg" d="M 10 82 L 50 10 L 90 82 Z" stroke="#000000" stroke-opacity="0.28" stroke-width="3" fill="none" stroke-linejoin="round" />
                                <!-- Box (square) outline — its 'd' is also set in JS for safety -->
                                <path id="bg-box" class="bg hidden" d="M 10 82 L 10 10 L 90 10 L 90 82 Z" stroke="#000000" stroke-opacity="0.28" stroke-width="3" fill="none" stroke-linejoin="round" />

                                <!-- Active sides (we swap their 'd' based on mode) -->
                                <path id="side-inhale" class="side inhale" d="M 50 10 L 10 82" />
                                <path id="side-hold" class="side hold" d="M 10 82 L 90 82" />
                                <path id="side-exhale" class="side exhale" d="M 90 82 L 50 10" />
                                <path id="side-hold2" class="side hold2" d="M 50 10 L 10 46" style="display:none" />
                            </svg>

                            <!-- static labels near sides -->
                            <div class="labels">
                                <div class="lab-inhale" id="lab-inhale">Inhale</div>
                                <div class="lab-hold" id="lab-hold">Hold ⏸</div>
                                <div class="lab-exhale" id="lab-exhale">Exhale</div>
                                <div class="lab-hold2 hidden" id="lab-hold2">Hold 2 ⏸</div>
                            </div>

                            <!-- breathing pulse indicator -->
                            <div class="pulse"><div class="dot" id="pulseDot"></div></div>
                        </div>

                        <div class="hud" id="hud">
                            <div class="phase inhale" id="phaseLabel">Inhale</div>
                            <div class="count" id="countdown">4</div>
                            <div class="cycles" id="cycleReadout">Cycle 0/0</div>
                        </div>
                    </section>

                    <div class="primary-controls" aria-label="Session controls">
                        <button class="btn primary" id="startToggleBtn">Start</button>
                        <button class="btn ghost" id="resetBtn" disabled>Reset</button>
                    </div>

                    @if (ShowSaveControls)
                    {
                        <div class="save-panel">
                            @if (SelectedTag is not null)
                            {
                                <button @onclick="SaveBreathingSession" class="btn primary solid save-button" disabled="@(IsSaveDisabled)">
                                    @if (saveCountdown > 0)
                                    {
                                        <span>@saveCountdown s</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-save me-1"></i>@($"Save to {SelectedTag!.Title}")
                                    }
                                </button>

                                @if (sessionTime.TotalSeconds > 0)
                                {
                                    <div class="session-info">
                                        <small class="text-muted">
                                            <strong>Session: </strong>@sessionTime.ToString("mm\\:ss")
                                            @if (totalCycles > 0)
                                            {
                                                <span class="ms-2"><strong>Cycles: </strong>@totalCycles</span>
                                            }
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="save-hint">Open settings to choose a tag before saving breathing sessions.</p>
                            }

                            @if (!string.IsNullOrEmpty(statusMessage))
                            {
                                <div class="alert alert-info mt-2 small">@statusMessage</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (isSettingsOpen)
{
    <div class="breathing-settings-screen" role="dialog" aria-modal="true" aria-labelledby="breathingSettingsTitle">
        <div class="settings-topbar">
            <button type="button" class="topbar-back" aria-label="Back to breathing" @onclick="CloseSettings">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2 id="breathingSettingsTitle">Breathing Settings</h2>
            <span class="topbar-spacer" aria-hidden="true"></span>
        </div>

        <div class="settings-content">
            <section class="settings-card">
                <header>
                    <p class="eyebrow">Mode</p>
                    <h3>@(SelectedMode == "box" ? "Square Breathing" : "Triangle Breathing")</h3>
                </header>
                <div class="mode-toggle expanded" role="radiogroup" aria-label="Breathing mode">
                    <label class="toggle-option">
                        <input type="radio" name="mode-settings" value="triangle" checked="@(SelectedMode == "triangle")" @onchange="@(() => UpdateMode("triangle", true))" />
                        <span>Triangle</span>
                    </label>
                    <label class="toggle-option">
                        <input type="radio" name="mode-settings" value="box" checked="@(SelectedMode == "box")" @onchange="@(() => UpdateMode("box", true))" />
                        <span>Square</span>
                    </label>
                </div>
            </section>

            <section class="settings-card">
                <header>
                    <p class="eyebrow">Timing</p>
                    <h3>Adjust breath intervals</h3>
                </header>

                <div class="settings-grid">
                    <div class="field">
                        <label for="inhaleSec">Inhale (left)</label>
                        <div class="input-stepper">
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("inhale", -1))" aria-label="Decrease inhale">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input id="inhaleSec" type="number" min="1" step="1" @bind-value="InhaleSeconds" @bind-value:event="oninput" class="stepper-input" />
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("inhale", 1))" aria-label="Increase inhale">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="holdSec">Hold (bottom)</label>
                        <div class="input-stepper">
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("hold", -1))" aria-label="Decrease bottom hold">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input id="holdSec" type="number" min="1" step="1" @bind-value="HoldSeconds" @bind-value:event="oninput" class="stepper-input" />
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("hold", 1))" aria-label="Increase bottom hold">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="exhaleSec">Exhale (right)</label>
                        <div class="input-stepper">
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("exhale", -1))" aria-label="Decrease exhale">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input id="exhaleSec" type="number" min="1" step="1" @bind-value="ExhaleSeconds" @bind-value:event="oninput" class="stepper-input" />
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("exhale", 1))" aria-label="Increase exhale">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="field @(SelectedMode == "box" ? string.Empty : "hidden")" id="hold2Field">
                        <label for="hold2Sec">Hold 2 (top)</label>
                        <div class="input-stepper">
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("hold2", -1))" aria-label="Decrease top hold">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input id="hold2Sec" type="number" min="1" step="1" @bind-value="Hold2Seconds" @bind-value:event="oninput" class="stepper-input" />
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("hold2", 1))" aria-label="Increase top hold">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="cycles">Cycles</label>
                        <div class="input-stepper">
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("cycles", -1))" aria-label="Decrease cycles">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input id="cycles" type="number" min="1" step="1" @bind-value="CycleCount" @bind-value:event="oninput" class="stepper-input" />
                            <button type="button" class="stepper-btn" @onclick="@(() => AdjustTiming("cycles", 1))" aria-label="Increase cycles">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            @if (ShowSaveControls)
            {
                <section class="settings-card">
                    <header>
                        <p class="eyebrow">Activity log</p>
                        <h3>Choose the tag for saved sessions</h3>
                    </header>
                    <div class="field">
                        <label for="tagSelect">Save as Tag</label>
                        <select @bind="SelectedTagId" id="tagSelect" class="form-select highlight" disabled="@(isLoading || availableTags == null)">
                            @if (isLoading)
                            {
                                <option>Loading tags...</option>
                            }
                            else if (availableTags?.Any() == true)
                            {
                                <option value="0">Select a tag to save session</option>
                                @foreach (var tag in availableTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                            else
                            {
                                <option>No integer tags available</option>
                            }
                        </select>
                    </div>
                </section>
            }

            <section class="settings-card subtle">
                <header>
                    <p class="eyebrow">Tips</p>
                    <h3>Quick shortcuts</h3>
                </header>
                <p class="tips-line"><span class="kbd">Space</span> pause/resume · <span class="kbd">R</span> reset · <span class="kbd">Enter</span> start</p>
            </section>
        </div>

        <div class="settings-footer">
            <button type="button" class="btn primary solid" @onclick="CloseSettings">Done</button>
        </div>
    </div>
}

<style>
    :root {
        --bg: #0b1020;
        --card: #111a33;
        --muted: #9fb0ff;
        --text: #e9eeff;
        --inhale: #42d392; /* green */
        --hold: #f6c453; /* amber  (bottom hold) */
        --exhale: #61b3ff; /* blue */
        --hold2: #d38bff; /* purple (top hold) */
    }

    .breathing-layout {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .breathing-settings-screen {
        position: fixed;
        inset: 0;
        z-index: 1060;
        background: radial-gradient(circle at top, rgba(23,36,66,.96), rgba(9,14,27,.98));
        backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
    }

    .settings-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,.08);
        background: rgba(10,15,30,.65);
    }

    .settings-topbar h2 {
        flex: 1;
        margin: 0 1rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        text-align: center;
    }

    .settings-topbar .topbar-back,
    .settings-topbar .topbar-spacer {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
    }

    .settings-topbar .topbar-back {
        border-radius: 12px;
        background: rgba(255,255,255,.08);
        color: #d7e2ff;
        border: 1px solid rgba(255,255,255,.12);
        transition: background .2s ease, color .2s ease;
    }

    .settings-topbar .topbar-back:hover {
        background: rgba(255,255,255,.18);
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.1rem;
        display: grid;
        gap: 1rem;
    }

    .settings-card {
        border-radius: 1rem;
        padding: 1rem;
        background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
        border: 1px solid rgba(255,255,255,.12);
        display: grid;
        gap: 0.8rem;
    }

    .settings-card header {
        display: grid;
        gap: 0.2rem;
    }

    .settings-card h3 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: #f2f4ff;
    }

    .settings-card .eyebrow {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(203,213,255,.85);
    }

    .settings-card.subtle {
        background: rgba(14,22,40,.65);
        border: 1px solid rgba(255,255,255,.06);
    }

    .tips-line {
        margin: 0;
        font-size: .92rem;
        color: rgba(223,232,255,.9);
    }

    .settings-footer {
        padding: 0.8rem 1.1rem 1.4rem;
        border-top: 1px solid rgba(255,255,255,.08);
        background: rgba(10,15,30,.65);
    }

    .settings-footer .btn {
        width: 100%;
        font-size: 1.05rem;
    }

    .mode-toggle.expanded {
        width: 100%;
        justify-content: space-between;
    }

    .mode-toggle.expanded .toggle-option span {
        min-width: 120px;
        text-align: center;
    }

    .input-stepper {
        display: grid;
        grid-template-columns: 42px minmax(60px, 1fr) 42px;
        align-items: center;
        background: rgba(15,23,48,.6);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 12px;
        overflow: hidden;
    }

    .stepper-btn {
        height: 42px;
        display: grid;
        place-items: center;
        background: transparent;
        border: none;
        color: #d7e2ff;
        font-size: 1.2rem;
        transition: background .2s ease;
    }

    .stepper-btn:hover {
        background: rgba(255,255,255,.12);
    }

    .stepper-input {
        width: 100%;
        background: transparent;
        border: none;
        text-align: center;
        font-size: 1.05rem;
        font-weight: 600;
        color: #f4f6ff;
        appearance: textfield;
        padding: 0;
    }

    .stepper-input::-webkit-outer-spin-button,
    .stepper-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .form-select.highlight {
        border-radius: 12px;
        background: rgba(15,23,48,.65);
        border: 1px solid rgba(117,134,255,.55);
        color: #f4f6ff;
        font-weight: 600;
    }

    .breathing-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .mode-toggle {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem;
        border-radius: 999px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.12);
        gap: 0.15rem;
    }

    .mode-toggle .toggle-option {
        position: relative;
        display: flex;
        align-items: center;
    }

    .mode-toggle .toggle-option input {
        position: absolute;
        inset: 0;
        opacity: 0;
        pointer-events: none;
    }

    .mode-toggle .toggle-option span {
        display: block;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        font-weight: 600;
        color: var(--muted);
        transition: background .2s ease, color .2s ease, box-shadow .2s ease;
    }

    .mode-toggle .toggle-option input:checked + span {
        background: linear-gradient(180deg, #5d7cff, #4b66e8);
        color: #ffffff;
        box-shadow: 0 8px 18px rgba(64, 99, 231, .35);
    }

    .settings-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
    }

    .primary-controls {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .save-panel {
        display: grid;
        gap: 0.6rem;
        padding: 1rem;
        border-radius: 0.9rem;
        background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
        border: 1px solid rgba(255,255,255,.08);
    }

    .save-panel .save-button {
        width: 100%;
    }

    .save-panel .save-hint {
        margin: 0;
        font-size: .95rem;
        opacity: .85;
        text-align: center;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem;
    }

    .app-breathing {
        width: min(980px, 100%);
    }

    header {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap
    }

    h1 {
        font-size: clamp(1.1rem, 1rem + 1.6vw, 1.7rem);
        margin: 0;
        letter-spacing: .3px
    }

    .subtitle {
        opacity: .8;
        font-size: .95rem
    }

    /* --- Visual --- */
    .tri-panel {
        display: grid;
        gap: .8rem
    }

    .viz {
        position: relative;
        aspect-ratio: 1.1 / 1;
        width: 100%;
        color: #9fb0ff; /* default currentColor fallback */
    }

    /* In dark mode ensure currentColor is bright enough for pulse and labels */
    [data-bs-theme="dark"] .app-breathing .viz {
        color: #9fb0ff;
    }

    svg {
        width: 100%;
        height: 100%;
        display: block
    }

    /* Scope all breathing-specific styles to avoid global conflicts */
    /* Make outlines visible regardless of global theme variables */
    .app-breathing .bg {
        stroke: rgba(0,0,0,.28);
        stroke-opacity: .9;
        stroke-width: 3;
        fill: none;
        stroke-dasharray: none !important;
        stroke-dashoffset: 0 !important
    }

        .app-breathing .bg.hidden {
            display: none
        }

    .app-breathing .side {
        fill: none;
        stroke-width: 6;
        stroke-linecap: round;
        filter: drop-shadow(0 0 12px rgba(97,179,255,.25));
        stroke-dasharray: none;
        stroke-dashoffset: 0
    }

        .app-breathing .side.inhale {
            stroke: var(--inhale)
        }

        .app-breathing .side.hold {
            stroke: var(--hold)
        }

        .app-breathing .side.exhale {
            stroke: var(--exhale)
        }

        .app-breathing .side.hold2 {
            stroke: var(--hold2)
        }

    .app-breathing .labels {
        position: absolute;
        inset: 0;
        pointer-events: none;
        font-weight: 600;
        font-size: clamp(.78rem,.63rem + .6vw,1rem);
        color: #cfd8ff
    }

        .app-breathing .labels div {
            position: absolute;
            text-shadow: 0 2px 8px rgba(0,0,0,.35)
        }
    /* Triangle label anchors */
    .app-breathing .lab-inhale {
        left: 8%;
        top: 30%
    }

    .app-breathing .lab-hold {
        left: 50%;
        transform: translateX(-50%);
        bottom: 6%
    }

    .app-breathing .lab-exhale {
        right: 8%;
        top: 30%;
        text-align: right
    }
    /* Box (square) extra label */
    .app-breathing .lab-hold2 {
        left: 50%;
        transform: translateX(-50%);
        top: 2%;
        opacity: .9
    }

    .app-breathing .pulse {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        pointer-events: none
    }

        .app-breathing .pulse .dot {
            width: 22px;
            height: 22px;
            border-radius: 999px;
            background: currentColor;
            opacity: .12;
            box-shadow: 0 0 60px currentColor, inset 0 0 14px rgba(255,255,255,.25);
            transition: color .2s ease;
        }

    .app-breathing .state-inhale .dot {
        color: var(--inhale)
    }

    .app-breathing .state-hold .dot {
        color: var(--hold)
    }

    .app-breathing .state-exhale .dot {
        color: var(--exhale)
    }

    .app-breathing .state-hold2 .dot {
        color: var(--hold2)
    }

    .app-breathing .hud {
        display: flex;
        gap: 1rem;
        align-items: baseline;
        justify-content: center;
        flex-wrap: wrap;
        padding: .2rem .6rem .8rem;
    }

    .app-breathing .phase {
        font-weight: 800;
        letter-spacing: .5px
    }

        .app-breathing .phase.inhale {
            color: var(--inhale)
        }

        .app-breathing .phase.hold {
            color: var(--hold)
        }

        .app-breathing .phase.exhale {
            color: var(--exhale)
        }

        .app-breathing .phase.hold2 {
            color: var(--hold2)
        }

    .app-breathing .count {
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        font-size: clamp(1.6rem, 1.2rem + 2.2vw, 3rem)
    }

    .app-breathing .cycles {
        opacity: .9
    }

    .app-breathing .btn {
        appearance: none;
        border: none;
        padding: .72rem 1rem;
        font-weight: 700;
        letter-spacing: .3px;
        cursor: pointer;
        background: #223058;
        color: #e9f1ff;
        box-shadow: 0 6px 16px rgba(19,26,44,.35) inset, 0 1px 0 rgba(255,255,255,.08);
        transition: transform .08s ease, filter .2s ease, background .2s ease;
    }

        .app-breathing .btn:hover {
            filter: brightness(1.08)
        }

        .app-breathing .btn:active {
            transform: translateY(1px)
        }

        .app-breathing .btn.primary {
            background: linear-gradient(180deg, #5d7cff, #4b66e8)
        }

        .app-breathing .btn.primary.solid {
            background: linear-gradient(180deg, #6a81ff, #3f5cf3);
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(66, 110, 255, .32), 0 2px 0 rgba(255,255,255,.18) inset;
        }

        .app-breathing .btn.ghost {
            background: transparent;
            border: 1px solid rgba(255,255,255,.16)
        }

        .app-breathing .btn:disabled {
            opacity: .5;
            cursor: not-allowed
        }

    .app-breathing .field {
        display: grid;
        gap: .35rem
    }

        .app-breathing .field label {
            opacity: .9;
            font-size: .92rem
        }

