@inject IJSRuntime JS

<button @onclick="ToggleLayout"
        class="p-2 rounded-lg transition-colors duration-200 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500"
        title="Toggle wide layout"
        aria-label="Toggle wide layout">
    @if (_currentLayout == "wide")
    {
        <Icon Name="arrows-pointing-in" Class="w-5 h-5 text-gray-600 dark:text-gray-400" />
    }
    else
    {
        <Icon Name="arrows-pointing-out" Class="w-5 h-5 text-gray-600 dark:text-gray-400" />
    }
</button>

@code {
    private string _currentLayout = "normal";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _currentLayout = await JS.InvokeAsync<string>("LogMyDayLayout.get");
            StateHasChanged();
        }
    }

    private async Task ToggleLayout()
    {
        _currentLayout = await JS.InvokeAsync<string>("LogMyDayLayout.toggle");
        StateHasChanged();
    }
}
