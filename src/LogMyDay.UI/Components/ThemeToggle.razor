@inject IJSRuntime JS

<button @onclick="ToggleTheme" 
        class="p-2 rounded-lg transition-colors duration-200 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-primary-500"
        title="Toggle theme"
        aria-label="Toggle theme">
    @if (_currentTheme == "dark")
    {
        <Icon Name="sun" Class="w-5 h-5 text-gray-600 dark:text-gray-400" />
    }
    else
    {
        <Icon Name="moon" Class="w-5 h-5 text-gray-600 dark:text-gray-400" />
    }
</button>

@code {
    private string _currentTheme = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _currentTheme = await JS.InvokeAsync<string>("LogMyDayTheme.get");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _currentTheme = await JS.InvokeAsync<string>("LogMyDayTheme.toggle");
        StateHasChanged();
    }
}
