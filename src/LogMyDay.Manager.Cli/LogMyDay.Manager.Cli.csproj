<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Global Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logmyday</ToolCommandName>
    <PackageId>LogMyDay.Manager</PackageId>
    <Version>1.0.0</Version>
    <Authors>LogMyDay Team</Authors>
    <Description>Management CLI tool for LogMyDay - install, update, backup and restore operations</Description>
    <PackageTags>logmyday;manager;cli;tool</PackageTags>
    <PackageProjectUrl>https://github.com/yourusername/logmyday</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourusername/logmyday</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cocona" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogMyDay.Manager.Core\LogMyDay.Manager.Core.csproj" />
  </ItemGroup>

</Project>
