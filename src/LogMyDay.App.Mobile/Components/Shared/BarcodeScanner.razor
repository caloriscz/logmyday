@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="space-y-4">
    @if (!isScanning)
    {
        <button type="button" @onclick="StartScanning" disabled="@isStarting"
                class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 disabled:opacity-50">
            @if (isStarting)
            {
                <span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                <span>Starting camera…</span>
            }
            else
            {
                <i class="bi bi-camera text-base"></i>
                <span>Start Scanner</span>
            }
        </button>
    }
    else
    {
        <button type="button" @onclick="StopScanning"
                class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            <i class="bi bi-x-lg text-base"></i>
            <span>Stop Scanner</span>
        </button>
    }

    <div id="@scannerId" class="@(isScanning ? "rounded-xl overflow-hidden border border-gray-200 dark:border-slate-700" : "hidden")"></div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm dark:border-rose-500/40 dark:bg-rose-500/20 dark:text-rose-200">
            @errorMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<ScanEventArgs> OnScanned { get; set; }

    private string scannerId = $"scanner-{Guid.NewGuid():N}";
    private DotNetObjectReference<BarcodeScanner>? dotNetRef;
    private bool isScanning;
    private bool isStarting;
    private string? errorMessage;

    private async Task StartScanning()
    {
        errorMessage = null;
        isStarting = true;
        StateHasChanged();

        try
        {
            // Request Android runtime camera permission before accessing the camera
            var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.Camera>();
                if (status != PermissionStatus.Granted)
                {
                    errorMessage = "Camera permission is required to scan barcodes. Please allow camera access in Settings.";

                    return;
                }
            }

            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("LogMyDayScanner.start", scannerId, dotNetRef);
            isScanning = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message.Contains("NotAllowedError") || ex.Message.Contains("Permission")
                ? "Camera access was denied. Please allow camera access in your device settings and try again."
                : $"Could not start scanner: {ex.Message}";
        }
        finally
        {
            isStarting = false;
        }
    }

    private async Task StopScanning()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("LogMyDayScanner.stop");
        }
        catch
        {
            // Ignore stop errors
        }

        isScanning = false;
        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    [JSInvokable]
    public async Task OnScanSuccess(string decodedText, string formatName)
    {
        await StopScanning();
        await OnScanned.InvokeAsync(new ScanEventArgs(decodedText, formatName));
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (isScanning)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("LogMyDayScanner.stop");
            }
            catch
            {
                // Ignore during dispose
            }
        }

        dotNetRef?.Dispose();
    }

    public record ScanEventArgs(string DecodedText, string FormatName);
}
