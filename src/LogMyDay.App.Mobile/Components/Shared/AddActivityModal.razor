@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject IJSRuntime JSRuntime
@inject ILogger<AddActivityModal> Logger

<!-- Add New Activity Modal - Full Screen Overlay -->
<div id="@modalId" data-modal class="hidden fixed inset-0 z-[60] bg-white dark:bg-slate-900 transition-opacity duration-300 opacity-0" aria-labelledby="@($"{modalId}Label")">
    <div data-modal-content class="w-full h-full flex flex-col">
        <!-- Modal Header - Fixed at top -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
            <h5 class="text-xl font-semibold text-gray-900 dark:text-gray-100" id="@($"{modalId}Label")">@(IsEditMode ? "Edit Activity" : "Add New Activity")</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors p-3 -mr-2" data-modal-hide="@modalId" @onclick="HandleCloseClicked" aria-label="Close">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        
        <!-- Modal Body - Scrollable content -->
    <div class="flex-1 overflow-y-auto px-6 py-6">
        <EditForm id="@($"{modalId}Form")" Model="Activity" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-red-600 dark:text-red-400 mb-4" />

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Primary Tag:</label>
                        <GroupedTagSelect Tags="AvailableTags" @bind-Value="Activity.PrimaryTagId" @bind-Value:after="HandleTagSelectionChanged" SelectClass="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    </div>

                    <div class="mb-4">
                        @if (selectedOptionList is TagOptionListResponse optionList)
                        {
                            <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Value:</label>
                            <InputSelect @bind-Value="selectedOptionValue"
                                         class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                         @bind-Value:after="OnOptionValueChanged">
                                <option value="">-- Select an option --</option>
                                @foreach (var option in optionList.Options ?? Enumerable.Empty<TagOptionResponse>())
                                {
                                    <option value="@option.Value">@(!string.IsNullOrWhiteSpace(option.DisplayName) ? option.DisplayName : option.Value)</option>
                                }
                            </InputSelect>
                        }
                        else if (selectedTag?.TypeId.HasValue == true)
                        {
                            @switch (selectedTag.TypeId.Value)
                            {
                                case 1: // Integer
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Value:</label>
                                    <input type="number" @bind="integerValue" @bind:after="OnIntegerValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                case 3: // Boolean
                                    <div class="flex items-center">
                                        <input type="checkbox" @bind="booleanValue" @bind:after="OnBooleanValueChanged" class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" id="@($"{modalId}BoolCheck")" />
                                        <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="@($"{modalId}BoolCheck")">
                                            @selectedTag.Title
                                        </label>
                                    </div>
                                    break;
                                case 4: // Date
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Date:</label>
                                    <CultureAwareDatePicker Value="@dateValue" 
                                                          ValueChanged="@OnDateValueInputChanged" 
                                                          EnableTime="false" 
                                                          Placeholder="Select date" />
                                    break;
                                case 5: // Time
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Time:</label>
                                    <input type="time" @bind="timeValue" @bind:after="OnTimeValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                case 6: // Decimal
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Value:</label>
                                    <input type="number" step="0.01" @bind="decimalValue" @bind:after="OnDecimalValueChanged" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                                default:
                                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Description:</label>
                                    <input type="text" @bind="Activity.Description" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                                    break;
                            }
                        }
                        else
                        {
                            <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Description:</label>
                            <input type="text" @bind="Activity.Description" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                        }
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="">
                            <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Start Date & Time:</label>
                            <CultureAwareDatePicker Value="@Activity.DateStarted"
                                                  ValueChanged="@OnDateStartedChanged"
                                                  EnableTime="true"
                                                  Placeholder="Select start date & time" />
                        </div>
                        @if (selectedTag?.IsRange == true)
                        {
                            <div class="">
                                <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">End Date & Time:</label>
                                <CultureAwareDatePicker Value="@Activity.DateFinished" 
                                                      ValueChanged="@((DateTime? v) => { Activity.DateFinished = v; })" 
                                                      EnableTime="true" 
                                                      Placeholder="Select end date & time" />
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }
                    
                    @if (!IsEditMode)
                    {
                        <div class="mb-4">
                            <div class="flex items-center">
                                <input type="checkbox" @bind="AddAnotherAfterSave" @bind:after="OnAddAnotherChanged" class="w-4 h-4 text-primary-600 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500" id="@($"{modalId}AddAnother")" />
                                <label class="ml-2 text-sm text-gray-700 dark:text-gray-300" for="@($"{modalId}AddAnother")">
                                    Add another activity after saving
                                </label>
                            </div>
                            <small class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                Keep the form open with the same tag and date selected for quick entry of multiple activities.
                            </small>
                        </div>
                    }
                </EditForm>
            </div>
            
            <!-- Modal Footer - Fixed at bottom with safe area support -->
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
                <div class="flex items-center justify-between gap-3">
                    <!-- Day navigation -->
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="ShiftDateBack" class="inline-flex items-center gap-1 rounded px-2.5 py-2 text-sm text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-slate-400 dark:hover:bg-gray-700 dark:hover:text-slate-200 min-h-[36px]" title="Previous day">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            <span>-1d</span>
                        </button>
                        <button type="button" @onclick="ShiftDateForward" class="inline-flex items-center gap-1 rounded px-2.5 py-2 text-sm text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-slate-400 dark:hover:bg-gray-700 dark:hover:text-slate-200 min-h-[36px]" title="Next day">
                            <span>+1d</span>
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                    <!-- Cancel + Save -->
                    <div class="flex items-center gap-3">
                        <button type="button" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors text-base font-medium min-h-[48px]" data-modal-hide="@modalId" @onclick="HandleCancelClicked">Cancel</button>
                        <div class="relative">
                            <div class="flex">
                                <button type="submit" form="@($"{modalId}Form")" class="px-6 py-3 bg-primary-600 text-white rounded-l-lg hover:bg-primary-700 active:bg-primary-800 transition-colors text-base font-medium shadow-sm min-h-[48px]">
                                    @(IsEditMode ? "Update" : "Save")
                                </button>
                                <button type="button" @onclick="ToggleSaveDropdown" @onclick:stopPropagation="true" class="px-3 py-3 border-l border-primary-700 bg-primary-600 text-white rounded-r-lg hover:bg-primary-700 active:bg-primary-800 transition-colors min-h-[48px]" aria-label="More save options">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </button>
                            </div>
                            @if (showSaveDropdown)
                            {
                                <div class="fixed inset-0 z-40" @onclick="() => showSaveDropdown = false" @onclick:stopPropagation="true"></div>
                                <div class="absolute bottom-full right-0 z-50 mb-1 min-w-full rounded-lg border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-600 dark:bg-gray-800">
                                    <button type="button" @onclick="HandleSaveAndAdvanceClick" class="w-full whitespace-nowrap px-4 py-3 text-left text-base text-gray-700 transition-colors hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700">
                                        Save &amp; next day
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@code {
    [Parameter] public ActivityRequest Activity { get; set; } = new();
    [Parameter] public IList<TagResponse>? AvailableTags { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IEnumerable<TagOptionListResponse>? OptionLists { get; set; }
    [Parameter] public IReadOnlyDictionary<int, TagOptionListResponse>? OptionListLookup { get; set; }
    [Parameter] public CultureInfo? DisplayCulture { get; set; }
    [Parameter] public TimeZoneInfo? DisplayTimeZone { get; set; }
    [Parameter] public int? PreselectedTagId { get; set; }
    [Parameter] public DateTime? PreselectedDate { get; set; }
    [Parameter] public bool AddAnotherAfterSave { get; set; } = false;
    [Parameter] public EventCallback<bool> AddAnotherAfterSaveChanged { get; set; }
    [Parameter] public EventCallback<ActivityRequest> OnActivityCreated { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }
    [Parameter] public EventCallback OnFormReset { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public string ModalId { get; set; } = "addActivityModal";
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public int? ActivityId { get; set; }
    [Parameter] public EventCallback OnActivityUpdated { get; set; }

    private TagResponse? selectedTag;
    private TagOptionListResponse? selectedOptionList;
    private string? selectedOptionValue;

    // Input type value helpers
    private bool booleanValue = false;
    private DateTime? dateValue = null;
    private int? integerValue = null;
    private TimeOnly? timeValue = null;
    private decimal? decimalValue = null;

    // Split-button state
    private bool showSaveDropdown = false;
    private bool saveAndAdvance = false;

    // State tracking fields
    private bool dateStartedManuallyModified = false;

    private void ShiftDateBack() => ShiftDate(-1);

    private void ShiftDateForward() => ShiftDate(1);

    private void ShiftDate(int days)
    {
        Activity.DateStarted = Activity.DateStarted.AddDays(days);

        if (Activity.DateFinished.HasValue)
        {
            Activity.DateFinished = Activity.DateFinished.Value.AddDays(days);
        }
    }

    private void ToggleSaveDropdown()
    {
        showSaveDropdown = !showSaveDropdown;
    }

    private async Task HandleSaveAndAdvanceClick()
    {
        saveAndAdvance = true;
        showSaveDropdown = false;
        await HandleValidSubmit();
    }
    private int? lastInitializedTagId = null;
    private DateTime? lastAppliedPreselectedDate = null;
    private DateTime? lastObservedPreselectedDate = null;

    private TimeZoneInfo effectiveTimeZone = TimeZoneInfo.Local;

    private string modalId => ModalId;

    protected override void OnParametersSet()
    {
        effectiveTimeZone = DisplayTimeZone ?? TimeZoneInfo.Local;

        if (PreselectedTagId.HasValue && Activity.PrimaryTagId != PreselectedTagId)
        {
            Activity.PrimaryTagId = PreselectedTagId;
        }

        if (IsEditMode)
        {
            AddAnotherAfterSave = false;
        }

        if (!IsEditMode && PreselectedDate.HasValue)
        {
            var today = GetTodayInDisplayZone();
            Activity.DateStarted = PreselectedDate.Value.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : PreselectedDate.Value.Date;
        }
        else if (Activity.DateStarted == default)
        {
            Activity.DateStarted = GetCurrentDateTimeInDisplayZone();
        }

        OnTagSelectionChanged(IsEditMode);
    }

    private void HandleTagSelectionChanged()
    {
        OnTagSelectionChanged();
    }

    private async Task HandleCloseClicked()
    {
        await HideModalAsync();

        if (OnCanceled.HasDelegate)
        {
            await OnCanceled.InvokeAsync();
        }
    }

    private Task HandleCancelClicked() => HandleCloseClicked();

    private async Task HideModalAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("hideModal", modalId);
        }
        catch (InvalidOperationException)
        {
            // Ignore JavaScript interop errors during static rendering
        }
    }

    private Task InvokeFormResetAsync()
        => OnFormReset.HasDelegate ? OnFormReset.InvokeAsync() : Task.CompletedTask;

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, effectiveTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private async Task HandleValidSubmit()
    {
        try
        {
            // Check for duplicates if tag is selected and not repeatable
            if (Activity.PrimaryTagId.HasValue && selectedTag != null && !selectedTag.IsRepeatable)
            {
                // Only skip duplicate check for Exact granularity since it allows precise timing
                if (selectedTag.TimeGranularity != TimeGranularity.Exact)
                {
                    var duplicateCheck = await ActivityApi.CheckDuplicate(Activity.PrimaryTagId.Value, Activity.DateStarted, IsEditMode ? ActivityId : null);
                    if (duplicateCheck.HasDuplicate)
                    {
                        var granularityText = selectedTag.TimeGranularity.ToString().ToLower();
                        await OnError.InvokeAsync($"Activity with tag '{selectedTag.Title}' already exists for this {granularityText}. This tag is not repeatable.");
                        await InvokeFormResetAsync();
                        return;
                    }
                }
            }

            if (IsEditMode && ActivityId.HasValue)
            {
                await ActivityApi.UpdateCalendarItem(ActivityId.Value, Activity);

                if (OnActivityUpdated.HasDelegate)
                {
                    await OnActivityUpdated.InvokeAsync();
                }

                if (saveAndAdvance)
                {
                    saveAndAdvance = false;
                    showSaveDropdown = false;
                    ShiftDate(1);

                    return;
                }

                await HideModalAsync();
                return;
            }

            await ActivityApi.CreateCalendarItem(Activity);
            await OnActivityCreated.InvokeAsync(Activity);

            // Close the modal after successful submission only if not adding another
            if (saveAndAdvance)
            {
                saveAndAdvance = false;
                showSaveDropdown = false;
                ResetFormForAnother();
                ShiftDate(1);
            }
            else if (!AddAnotherAfterSave)
            {
                await HideModalAsync();
            }
            else
            {
                ResetFormForAnother();
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await OnError.InvokeAsync("Authentication failed. Please refresh and try again.");
            await InvokeFormResetAsync();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Handle validation errors from the server
            var content = await ex.GetContentAsAsync<string>();
            Logger.LogWarning("Validation error creating activity: {Content}", content);

            if (content != null && content.Contains("already exists"))
            {
                await OnError.InvokeAsync($"Activity with tag '{selectedTag?.Title}' already exists for this time period. This tag is not repeatable.");
            }
            else
            {
                await OnError.InvokeAsync($"Validation error: {content ?? "Invalid data provided."}");
            }

            await InvokeFormResetAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating activity");
            await OnError.InvokeAsync("An unexpected error occurred while creating the activity. Please try again.");
            await InvokeFormResetAsync();
        }
    }

    private void OnTagSelectionChanged(bool preserveExistingValues = false)
    {
        var existingDescription = Activity.Description;

        selectedOptionList = null;
        selectedOptionValue = null;

        if (Activity.PrimaryTagId.HasValue && AvailableTags != null)
        {
            selectedTag = AvailableTags.FirstOrDefault(t => t.Id == Activity.PrimaryTagId.Value);

            if (selectedTag?.IsRange != true)
            {
                Activity.DateFinished = null;
            }

            ResetInputHelpers(resetDescription: !preserveExistingValues);

            if (selectedTag?.OptionListId is int listId)
            {
                if (OptionListLookup != null && OptionListLookup.TryGetValue(listId, out var lookupList))
                {
                    selectedOptionList = lookupList;
                }
                else if (OptionLists != null)
                {
                    selectedOptionList = OptionLists.FirstOrDefault(list => list.Id == listId);
                }

                if (selectedOptionList is not null)
                {
                    if (selectedOptionList.Options is null || selectedOptionList.Options.Count == 0)
                    {
                        Logger.LogWarning("Tag {TagId} references option list {OptionListId} without any options. Falling back to manual entry.", selectedTag?.Id, selectedOptionList.Id);
                        selectedOptionList = null;
                    }
                    else
                    {
                        if (preserveExistingValues && !string.IsNullOrWhiteSpace(existingDescription))
                        {
                            var match = selectedOptionList.Options.FirstOrDefault(o => string.Equals(o.Value, existingDescription, StringComparison.OrdinalIgnoreCase));
                            if (match is not null)
                            {
                                selectedOptionValue = match.Value;
                            }
                        }

                        selectedOptionValue ??= ResolveDefaultOptionValue(selectedTag, selectedOptionList);
                        Activity.Description = selectedOptionValue ?? string.Empty;
                        return;
                    }
                }
            }

            if (preserveExistingValues)
            {
                ApplyExistingValuesToInputs(existingDescription);
                return;
            }

            switch (selectedTag?.TypeId)
            {
                case 1:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && int.TryParse(selectedTag.DefaultValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var defaultInt))
                    {
                        integerValue = defaultInt;
                        Activity.Description = defaultInt.ToString(CultureInfo.InvariantCulture);
                    }
                    else
                    {
                        Activity.Description = string.Empty;
                    }
                    break;
                case 2:
                    Activity.Description = selectedTag.DefaultValue ?? string.Empty;
                    break;
                case 3:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && bool.TryParse(selectedTag.DefaultValue, out var defaultBool))
                    {
                        booleanValue = defaultBool;
                    }
                    Activity.Description = booleanValue ? "true" : "false";
                    break;
                case 4:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && DateTime.TryParse(selectedTag.DefaultValue, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var defaultDate))
                    {
                        dateValue = defaultDate.Date;
                    }
                    else
                    {
                        dateValue = Activity.DateStarted.Date;
                    }

                    Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
                    break;
                case 5:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && TimeOnly.TryParse(selectedTag.DefaultValue, CultureInfo.InvariantCulture, out var defaultTime))
                    {
                        timeValue = defaultTime;
                    }
                    else
                    {
                        timeValue = TimeOnly.FromDateTime(Activity.DateStarted);
                    }

                    Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
                    break;
                case 6:
                    if (!string.IsNullOrWhiteSpace(selectedTag.DefaultValue) && decimal.TryParse(selectedTag.DefaultValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var defaultDecimal))
                    {
                        decimalValue = defaultDecimal;
                        Activity.Description = defaultDecimal.ToString("0.#############################", CultureInfo.InvariantCulture);
                    }
                    else
                    {
                        Activity.Description = string.Empty;
                    }
                    break;
                default:
                    Activity.Description = string.Empty;
                    break;
            }
        }
        else
        {
            selectedTag = null;
            selectedOptionList = null;
            selectedOptionValue = null;
            Activity.DateFinished = null;
            ResetInputHelpers();
        }
    }

    private void ResetInputHelpers(bool resetDescription = true)
    {
        if (resetDescription)
        {
            Activity.Description = null;
        }

        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
    }

    private void ApplyExistingValuesToInputs(string? description)
    {
        if (selectedTag is null)
        {
            Activity.Description = description ?? string.Empty;
            return;
        }

        description ??= string.Empty;

        if (selectedOptionList is not null)
        {
            if (!string.IsNullOrWhiteSpace(description))
            {
                var match = selectedOptionList.Options?.FirstOrDefault(o => string.Equals(o.Value, description, StringComparison.OrdinalIgnoreCase));
                if (match is not null)
                {
                    selectedOptionValue = match.Value;
                }
            }

            selectedOptionValue ??= ResolveDefaultOptionValue(selectedTag, selectedOptionList);
            Activity.Description = selectedOptionValue ?? string.Empty;
            return;
        }

        switch (selectedTag.TypeId)
        {
            case 1:
                if (int.TryParse(description, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedInt))
                {
                    integerValue = parsedInt;
                    Activity.Description = parsedInt.ToString(CultureInfo.InvariantCulture);
                }
                else
                {
                    Activity.Description = string.Empty;
                }
                break;
            case 2:
                Activity.Description = description;
                break;
            case 3:
                booleanValue = bool.TryParse(description, out var parsedBool) && parsedBool;
                Activity.Description = booleanValue ? "true" : "false";
                break;
            case 4:
                if (DateTime.TryParse(description, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsedDate))
                {
                    dateValue = parsedDate.Date;
                }
                else
                {
                    dateValue = Activity.DateStarted.Date;
                }

                Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
                break;
            case 5:
                if (TimeOnly.TryParse(description, CultureInfo.InvariantCulture, out var parsedTime))
                {
                    timeValue = parsedTime;
                }
                else
                {
                    timeValue = TimeOnly.FromDateTime(Activity.DateStarted);
                }

                Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
                break;
            case 6:
                if (decimal.TryParse(description, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsedDecimal))
                {
                    decimalValue = parsedDecimal;
                    Activity.Description = parsedDecimal.ToString("0.#############################", CultureInfo.InvariantCulture);
                }
                else
                {
                    Activity.Description = description;
                }
                break;
            default:
                Activity.Description = description;
                break;
        }
    }
    
    private void OnIntegerValueChanged()
    {
        Activity.Description = integerValue?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    }
    
    private void OnBooleanValueChanged()
    {
        Activity.Description = booleanValue.ToString().ToLower();
    }
    
    private void OnDateValueChanged()
    {
        Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private void OnDateValueInputChanged(DateTime? value)
    {
        dateValue = value;
        OnDateValueChanged();
    }

    private void OnDateStartedChanged(DateTime? value)
    {
        dateStartedManuallyModified = true;
        Activity.DateStarted = value ?? GetCurrentDateTimeInDisplayZone();
    }
    
    private void OnTimeValueChanged()
    {
        Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
    }
    
    private void OnDecimalValueChanged()
    {
        // Round to 2 decimal places if value has higher precision
        if (decimalValue.HasValue)
        {
            var rounded = Math.Round(decimalValue.Value, 2);
            if (rounded != decimalValue.Value)
            {
                decimalValue = rounded;
            }
            Activity.Description = rounded.ToString("0.#############################", CultureInfo.InvariantCulture);
        }
        else
        {
            Activity.Description = string.Empty;
        }
    }

    private void OnOptionValueChanged()
    {
        Activity.Description = selectedOptionValue ?? string.Empty;
    }

    private static string? ResolveDefaultOptionValue(TagResponse? tag, TagOptionListResponse optionList)
    {
        if (optionList.Options is null || optionList.Options.Count == 0)
        {
            return null;
        }

        if (tag is null)
        {
            return optionList.Options.FirstOrDefault()?.Value;
        }

        if (!string.IsNullOrWhiteSpace(tag.DefaultValue))
        {
            var match = optionList.Options.FirstOrDefault(o => string.Equals(o.Value, tag.DefaultValue, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                return match.Value;
            }
        }

        return optionList.Options.FirstOrDefault()?.Value;
    }

    private async Task OnAddAnotherChanged()
    {
        if (IsEditMode)
        {
            AddAnotherAfterSave = false;
            return;
        }

        if (AddAnotherAfterSaveChanged.HasDelegate)
        {
            await AddAnotherAfterSaveChanged.InvokeAsync(AddAnotherAfterSave);
        }
    }

    private void ResetFormForAnother()
    {
        var keepTagId = Activity.PrimaryTagId;
        var keepDateStarted = Activity.DateStarted;
        var keepDateFinished = Activity.DateFinished;

        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
        selectedOptionValue = null;

        if (selectedOptionList is not null)
        {
            selectedOptionValue = ResolveDefaultOptionValue(selectedTag, selectedOptionList);
            Activity.Description = selectedOptionValue ?? string.Empty;
        }
        else if (selectedTag?.TypeId == 3)
        {
            booleanValue = false;
            Activity.Description = "false";
        }
        else if (selectedTag?.TypeId == 4)
        {
            dateValue = keepDateStarted.Date;
            Activity.Description = dateValue?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
        }
        else if (selectedTag?.TypeId == 5)
        {
            timeValue = TimeOnly.FromDateTime(keepDateStarted);
            Activity.Description = timeValue?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? string.Empty;
        }
        else
        {
            Activity.Description = string.Empty;
        }

        Activity.PrimaryTagId = keepTagId;
        Activity.DateStarted = keepDateStarted;
        Activity.DateFinished = keepDateFinished;
    }

    public void ResetForm()
    {
        selectedTag = null;
        selectedOptionList = null;
        selectedOptionValue = null;
        integerValue = null;
        booleanValue = false;
        dateValue = null;
        timeValue = null;
        decimalValue = null;
        lastInitializedTagId = null;
        lastAppliedPreselectedDate = null;
        lastObservedPreselectedDate = null;
        dateStartedManuallyModified = false;
    }
}


