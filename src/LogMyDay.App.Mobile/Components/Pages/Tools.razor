@page "/tools"
@using Microsoft.AspNetCore.Components
@using LogMyDay.App.Mobile.Components.Layout
@inject NavigationManager Navigation

<PageTitle>Tools - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Tools" ShowReload="false" />
    
    <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="card cursor-pointer hover:shadow-lg transition-shadow" @onclick="@(() => Navigate("/breathing"))">
                <div class="flex items-center justify-between">
                    <div class="flex-grow">
                        <h5 class="font-semibold text-gray-900 dark:text-white mb-1">Breathing Exercises</h5>
                        <small class="text-gray-600 dark:text-gray-400">4-7-8 Triangle and Box breathing</small>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="bi bi-lungs text-primary-600 dark:text-primary-400 text-2xl"></i>
                        <i class="bi bi-arrow-right text-gray-400"></i>
                    </div>
                </div>
            </div>

            <div class="card cursor-pointer hover:shadow-lg transition-shadow" @onclick="@(() => Navigate("/exercise"))">
                <div class="flex items-center justify-between">
                    <div class="flex-grow">
                        <h5 class="font-semibold text-gray-900 dark:text-white mb-1">HIIT Timer</h5>
                        <small class="text-gray-600 dark:text-gray-400">High-intensity interval training timer</small>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="bi bi-stopwatch text-green-600 dark:text-green-400 text-2xl"></i>
                        <i class="bi bi-arrow-right text-gray-400"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void Navigate(string route)
    {
        Navigation.NavigateTo(route);
    }
}
