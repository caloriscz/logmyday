@page "/todos"
@using LogMyDay.Domain.Enums
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using Refit
@implements IDisposable
@inject ITodoApi TodoApi
@inject IActivityApi ActivityApi
@inject ILogger<Todos> Logger

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Todos" ShowReload="true" OnReload="LoadDataAsync" />

    <div class="max-w-7xl mx-auto px-6 py-4">

        @if (_loadError != null)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                @_loadError
            </div>
        }
        else if (_lists == null)
        {
            <div class="flex items-center justify-center gap-3 py-16 text-gray-500 dark:text-gray-400">
                <div class="inline-block animate-spin text-2xl text-primary-600">⟳</div>
                <span class="text-sm">Loading to-do lists…</span>
            </div>
        }
        else
        {
            @* Top bar: Add list button *@
            <div class="mb-4 flex justify-end">
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                        @onclick="OpenAddListModal">
                    <i class="bi bi-plus-lg"></i>
                    New list
                </button>
            </div>

            @* One panel per list, stacked vertically (mobile: 1 col always) *@
            <div class="flex flex-col gap-5">
                @foreach (var list in _lists)
                {
                    var today = DateTime.Today;
                    var listId = list.Id;
                    var activeItems = list.Items
                        .Where(i => !i.IsDone && !i.IsSkipped && (i.StartDate == null || i.StartDate.Value.Date <= today))
                        .OrderBy(i => i.DisplayOrder)
                        .ThenBy(i => i.DueDate ?? DateTime.MaxValue)
                        .ThenBy(i => i.DateCreated)
                        .ToList();
                    var doneItems = list.Items.Where(i => i.IsDone).ToList();
                    var skippedItems = list.Items.Where(i => i.IsSkipped).ToList();
                    var showDoneForThis = _showDonePerList.Contains(listId);
                    var showSkippedForThis = _showSkippedPerList.Contains(listId);

                    <div @key="listId" class="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm" style="min-height: 600px;">

                        @* Panel header *@
                        <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 px-4 py-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <h3 class="truncate text-base font-semibold text-gray-900 dark:text-gray-100">@list.Name</h3>
                                <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">@activeItems.Count</span>
                                @if (list.ListType == TodoListType.Reminder)
                                {
                                    <span class="shrink-0 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/20 dark:text-amber-300">Reminder</span>
                                }
                            </div>
                            <div class="flex items-center gap-1 shrink-0">
                                <button type="button"
                                        class="inline-flex items-center gap-1 rounded-lg bg-primary-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-primary-700 transition-colors disabled:opacity-50"
                                        @onclick="() => OpenAddItemModal(listId)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-plus-lg"></i>
                                    Add
                                </button>
                                <button type="button"
                                        class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                                        title="Edit list"
                                        @onclick="() => OpenEditListModal(list)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-pencil text-sm"></i>
                                </button>
                                <button type="button"
                                        class="p-2 text-gray-400 hover:text-red-500 dark:hover:text-red-400"
                                        title="Delete list"
                                        @onclick="() => ConfirmDeleteList(list)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-trash text-sm"></i>
                                </button>
                            </div>
                        </div>

                        @* Items area — scrollable *@
                        <div class="flex-1 overflow-y-auto px-3 py-3 space-y-1" style="min-height: 480px;">
                            @if (!activeItems.Any())
                            {
                                <p class="py-8 text-center text-sm text-gray-400 dark:text-gray-500">No pending items.</p>
                            }
                            else
                            {
                                @foreach (var item in activeItems)
                                {
                                    var isOverdue = item.DueDate.HasValue && item.DueDate.Value < today;
                                    var isDragging = _draggingItem?.Id == item.Id;
                                    var isDragOver = _dragOverItem?.Id == item.Id && !isDragging;
                                    <div @key="item.Id" class="flex items-start gap-3 rounded-xl px-3 py-3 bg-gray-50 dark:bg-gray-700/50 @(isOverdue ? "border-l-4 border-red-400" : "") @(isDragging ? "opacity-40" : "") @(isDragOver ? "ring-2 ring-primary-400" : "")"
                                         draggable="true"
                                         @ondragstart="() => { _draggingItem = item; _dragFromListId = listId; }"
                                         @ondragover:preventDefault
                                         @ondragover="() => _dragOverItem = item"
                                         @ondrop="() => OnDropItemAsync(item, listId)"
                                         @ondragend="() => { _draggingItem = null; _dragOverItem = null; _dragFromListId = 0; _dragOverLastZoneListId = 0; }">
                                        <i class="bi bi-grip-vertical mt-0.5 shrink-0 cursor-grab text-gray-300 dark:text-gray-600 select-none"></i>
                                        <input type="checkbox"
                                               class="mt-0.5 h-5 w-5 rounded border-gray-300 text-primary-600 dark:border-gray-600 cursor-pointer"
                                               checked="@item.IsDone"
                                               @onchange="() => CompleteItemAsync(item, list)"
                                               disabled="@_isBusy" />
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="text-sm text-gray-900 dark:text-gray-100">@item.Title</span>
                                                @if (list.ListType == TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <span class="text-sm text-gray-500 dark:text-gray-400">@item.Notes</span>
                                                }
                                                @if (isOverdue)
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/20 dark:text-red-300">Overdue</span>
                                                }
                                                @if (item.DueDate.HasValue && !isOverdue)
                                                {
                                                    <span class="text-xs text-gray-400 dark:text-gray-500">due @item.DueDate.Value.ToString("MMM d")</span>
                                                }
                                                @if (item.RecurrenceType != RecurrenceType.None)
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><i class="bi bi-arrow-repeat me-1"></i>@item.RecurrenceType</span>
                                                }
                                            </div>
                                            @if (list.ListType != TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400 truncate">@item.Notes</p>
                                            }
                                        </div>
                                        <div class="flex items-center gap-1 shrink-0">
                                            @if (list.ListType == TodoListType.Basic)
                                            {
                                                <button type="button"
                                                        class="p-2 @(_copiedItemId == item.Id ? "text-green-500" : "text-gray-400 hover:text-gray-600 dark:hover:text-gray-200")"
                                                        title="@(_copiedItemId == item.Id ? "Copied!" : "Copy title")"
                                                        @onclick="() => CopyItemTitleAsync(item)"
                                                        disabled="@_isBusy">
                                                    <i class="bi bi-@(_copiedItemId == item.Id ? "check-lg" : "clipboard") text-sm"></i>
                                                </button>
                                            }
                                            @if (item.RecurrenceType != RecurrenceType.None)
                                            {
                                                <button type="button"
                                                        class="p-2 text-gray-400 hover:text-amber-500 dark:hover:text-amber-400"
                                                        title="Skip for this period"
                                                        @onclick="() => SkipItemAsync(item)"
                                                        disabled="@_isBusy">
                                                    <i class="bi bi-skip-forward text-sm"></i>
                                                </button>
                                            }
                                            <button type="button"
                                                    class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                                                    title="Edit"
                                                    @onclick="() => OpenEditItemModal(item)"
                                                    disabled="@_isBusy">
                                                <i class="bi bi-pencil text-sm"></i>
                                            </button>
                                            <button type="button"
                                                    class="p-2 text-gray-400 hover:text-red-500 dark:hover:text-red-400"
                                                    title="Delete"
                                                    @onclick="() => DeleteItemAsync(item)"
                                                    disabled="@_isBusy">
                                                <i class="bi bi-trash text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                                @* Sentinel drop zone — invisible until drag is active in this list *@
                                <div class="mt-1 transition-all @(_dragFromListId == listId ? (_dragOverLastZoneListId == listId ? "flex h-10 items-center justify-center rounded-xl border-2 border-dashed border-primary-400 bg-primary-50 dark:bg-primary-500/10" : "h-10 rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600") : "h-0 overflow-hidden")"
                                     @ondragover:preventDefault
                                     @ondragover="() => { if (_dragFromListId == listId) _dragOverLastZoneListId = listId; }"
                                     @ondragleave="() => { if (_dragOverLastZoneListId == listId) _dragOverLastZoneListId = 0; }"
                                     @ondrop="() => OnDropLastAsync(listId)">
                                    @if (_dragOverLastZoneListId == listId && _draggingItem != null)
                                    {
                                        <span class="text-xs text-primary-500 select-none">Drop here to place last</span>
                                    }
                                </div>
                            }

                            @* Completed items toggle *@
                            @if (doneItems.Any())
                            {
                                <div class="mt-3 border-t border-gray-200 dark:border-gray-700 pt-2">
                                    <button type="button"
                                            class="text-xs text-gray-500 dark:text-gray-400"
                                            @onclick="() => ToggleShowDone(listId)">
                                        @(showDoneForThis ? "Hide" : "Show") completed (@doneItems.Count)
                                    </button>
                                    @if (showDoneForThis)
                                    {
                                        <div class="mt-2 space-y-1">
                                            @foreach (var item in doneItems.OrderByDescending(i => i.DoneAt))
                                            {
                                                <div @key="item.Id" class="flex items-center gap-3 rounded-xl px-3 py-2.5 bg-gray-50 dark:bg-gray-700/30 opacity-60">
                                                    <input type="checkbox"
                                                           class="h-5 w-5 rounded border-gray-300 dark:border-gray-600 cursor-pointer"
                                                           checked="@item.IsDone"
                                                           @onchange="() => ReopenItemAsync(item)"
                                                           disabled="@_isBusy" />
                                                    <span class="flex-1 text-sm line-through text-gray-500 dark:text-gray-400">@item.Title</span>
                                                    <button type="button"
                                                            class="p-2 text-gray-300 hover:text-red-500 dark:hover:text-red-400"
                                                            @onclick="() => DeleteItemAsync(item)"
                                                            disabled="@_isBusy">
                                                        <i class="bi bi-trash text-sm"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @* Skipped items toggle *@
                            @if (skippedItems.Any())
                            {
                                <div class="mt-3 border-t border-gray-200 dark:border-gray-700 pt-2">
                                    <button type="button"
                                            class="text-xs text-gray-500 dark:text-gray-400"
                                            @onclick="() => ToggleShowSkipped(listId)">
                                        @(showSkippedForThis ? "Hide" : "Show") skipped (@skippedItems.Count)
                                    </button>
                                    @if (showSkippedForThis)
                                    {
                                        <div class="mt-2 space-y-1">
                                            @foreach (var item in skippedItems)
                                            {
                                                <div @key="item.Id" class="flex items-center gap-3 rounded-xl px-3 py-2.5 bg-gray-50 dark:bg-gray-700/30 opacity-60">
                                                    <span class="flex-1 text-sm text-gray-500 dark:text-gray-400">@item.Title</span>
                                                    @if (item.RecurrenceType != RecurrenceType.None)
                                                    {
                                                        <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><i class="bi bi-arrow-repeat me-1"></i>@item.RecurrenceType</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_itemErrorPerList.GetValueOrDefault(listId)))
                        {
                            <div class="flex items-center gap-2 border-t border-gray-200 dark:border-gray-700 px-4 py-2">
                                <span class="flex-1 text-xs text-red-700 dark:text-red-300">@_itemErrorPerList[listId]</span>
                                <button type="button" class="shrink-0 text-xs font-medium text-primary-600 dark:text-primary-400 underline" @onclick="LoadDataAsync">Reload</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (_lists != null && _lists.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-16 gap-4 text-gray-400 dark:text-gray-500">
                <i class="bi bi-check2-square text-5xl"></i>
                <p class="text-sm">No lists yet.</p>
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 transition-colors"
                        @onclick="OpenAddListModal">
                    <i class="bi bi-plus-lg"></i>
                    Create your first list
                </button>
            </div>
        }
    </div>
</div>

@* ── List Create/Edit Modal ── *@
@if (_showListModal)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@(_isEditingList ? "Edit list" : "New list")</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300" @onclick="CloseListModal" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        @* Scrollable body — EditForm lives here, no flex dependency on form element *@
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm EditContext="_listEditContext">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Name <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_listForm.Name"
                                   maxlength="200"
                                   placeholder="e.g. Work tasks" />
                        <ValidationMessage For="@(() => _listForm.Name)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">List type</label>
                        <InputSelect @bind-Value="_listForm.ListType" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <option value="@TodoListType.Basic">Basic</option>
                            <option value="@TodoListType.Reminder">Reminder</option>
                        </InputSelect>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="checkbox" id="chk-show-on-homepage" class="h-5 w-5 rounded border-gray-300 text-primary-600 dark:border-gray-600 cursor-pointer"
                               checked="@_listForm.ShowOnHomepage"
                               @onchange="e => _listForm.ShowOnHomepage = (bool)(e.Value ?? false)" />
                        <label for="chk-show-on-homepage" class="text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">Show on homepage</label>
                    </div>
                </div>
            </EditForm>
        </div>
        @* Sticky footer — plain div, always visible *@
        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4" style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));">
            @if (!string.IsNullOrEmpty(_listError))
            {
                <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                    @_listError
                </div>
            }
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        class="min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="CloseListModal" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-primary-600 px-6 py-3 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SubmitListFormAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    @(_isEditingList ? "Save changes" : "Create list")
                </button>
            </div>
        </div>
    </div>
}

@* ── Item Create/Edit Modal ── *@
@if (_showItemModal)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@(_isEditingItem ? "Edit item" : "New item")</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300" @onclick="CloseItemModal" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        @* Scrollable body — EditForm lives here, no flex dependency on form element *@
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm EditContext="_itemEditContext">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Title <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_itemForm.Title"
                                   maxlength="500"
                                   placeholder="What needs to be done?" />
                        <ValidationMessage For="@(() => _itemForm.Title)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    @if (_currentListForItemModal?.ListType == TodoListType.Reminder)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Value <span class="text-red-500">*</span></label>
                            @if (IsBooleanInputType(_allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId)?.InputTypeId))
                            {
                                <div class="flex gap-3">
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == true ? "border-green-500 bg-green-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-green-50 dark:hover:bg-green-500/10")"
                                            @onclick="() => _booleanBoolValue = _booleanBoolValue == true ? null : true">
                                        <i class="bi bi-check-lg me-1"></i>Yes
                                    </button>
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == false ? "border-red-500 bg-red-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-red-50 dark:hover:bg-red-500/10")"
                                            @onclick="() => { _booleanBoolValue = _booleanBoolValue == false ? (bool?)null : false; }">
                                        <i class="bi bi-x-lg me-1"></i>No
                                    </button>
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == null ? "border-primary-500 bg-primary-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700")"
                                            @onclick="() => _booleanBoolValue = null">
                                        Not specified
                                    </button>
                                </div>
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Logged as activity value when completed. Selecting Yes or No will immediately complete and log this item.</p>
                            }
                            else if (IsNumericInputType(_allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId)?.InputTypeId))
                            {
                                <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Enter a number" />
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Logged as activity value when completed.</p>
                            }
                            else
                            {
                                <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Enter a value" />
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Logged as activity value when completed.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Notes</label>
                            <InputTextArea class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           rows="3"
                                           placeholder="Optional notes" />
                        </div>
                    }
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log tag</label>
                        <select class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                @bind="_itemForm.CompletionTagId">
                            <option value="">— None —</option>
                            @if (_allTags != null)
                            {
                                @foreach (var tag in _allTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </select>
                        @if (_itemForm.CompletionTagId.HasValue && _allTags != null)
                        {
                            var selItemTag = _allTags.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value);
                            @if (selItemTag != null && !selItemTag.IsRepeatable && _itemForm.AutoLogMode != AutoLogMode.Add)
                            {
                                <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">
                                    This tag is not repeatable — completing multiple items on the same day will replace the existing activity.
                                </p>
                            }
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        @if (_currentListForItemModal?.ListType != TodoListType.Reminder)
                        {
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Start date</label>
                                <input type="datetime-local"
                                       class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                       value="@(_itemForm.StartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => _itemForm.StartDate = ParseDateTime(e.Value?.ToString())" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Due date</label>
                                <input type="datetime-local"
                                       class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                       value="@(_itemForm.DueDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => _itemForm.DueDate = ParseDateTime(e.Value?.ToString())" />
                            </div>
                        }
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Recurrence</label>
                        <InputSelect @bind-Value="_itemForm.RecurrenceType" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <option value="@RecurrenceType.None">None (one-time)</option>
                            <option value="@RecurrenceType.Daily">Daily</option>
                            <option value="@RecurrenceType.Weekly">Weekly</option>
                        </InputSelect>
                    </div>
                    @if (_itemForm.CompletionTagId.HasValue && _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value)?.IsRepeatable == false)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log mode</label>
                            <InputSelect @bind-Value="_itemForm.AutoLogMode" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                <option value="@AutoLogMode.Add">Add (accumulate)</option>
                                <option value="@AutoLogMode.ResetIfExists">Replace if exists</option>
                            </InputSelect>
                        </div>
                    }
                    @if (_itemForm.RecurrenceType != RecurrenceType.None && _itemForm.CompletionTagId.HasValue)
                    {
                        <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-4 space-y-3">
                            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Activity monitoring window</p>
                            <div class="flex items-center gap-6">
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                                    <input type="radio" class="text-primary-600" checked="@_monitorUseDaysBack"
                                           @onchange="() => { _monitorUseDaysBack = true; _itemForm.MonitorFromDate = null; _itemForm.MonitorToDate = null; }" />
                                    Last N days
                                </label>
                                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                                    <input type="radio" class="text-primary-600" checked="@(!_monitorUseDaysBack)"
                                           @onchange="() => { _monitorUseDaysBack = false; _itemForm.MonitorDaysBack = null; _itemForm.MonitorFromDate = DateOnly.FromDateTime(DateTime.Today); }" />
                                    Date range
                                </label>
                            </div>
                            @if (_monitorUseDaysBack)
                            {
                                <div>
                                    <label class="mb-1 block text-xs text-gray-500 dark:text-gray-400">Days back from today (0 = today only)</label>
                                    <InputNumber @bind-Value="_itemForm.MonitorDaysBack"
                                                 class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                                                 min="0" />
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="mb-1 block text-xs text-gray-500 dark:text-gray-400">From</label>
                                        <input type="date"
                                               class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                                               value="@(_itemForm.MonitorFromDate?.ToString("yyyy-MM-dd") ?? "")"
                                               @onchange="e => _itemForm.MonitorFromDate = ParseDateOnly(e.Value?.ToString())" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-xs text-gray-500 dark:text-gray-400">To</label>
                                        <input type="date"
                                               class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                                               value="@(_itemForm.MonitorToDate?.ToString("yyyy-MM-dd") ?? "")"
                                               @onchange="e => _itemForm.MonitorToDate = ParseDateOnly(e.Value?.ToString())" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </EditForm>
        </div>
        @* Sticky footer — plain div, always visible *@
        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4" style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));">
            @if (!string.IsNullOrEmpty(_itemModalError))
            {
                <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                    @_itemModalError
                </div>
            }
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        class="min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="CloseItemModal" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-primary-600 px-6 py-3 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SubmitItemFormAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    @(_isEditingItem ? "Save changes" : "Add item")
                </button>
            </div>
        </div>
    </div>
}

@* ── Boolean Quick-Complete Modal ── *@
@if (_showBoolQuickModal && _boolQuickItem != null)
{
    <div class="fixed inset-0 z-[70] flex items-end justify-center bg-gray-900/70 p-4" @onclick="() => { if (!_isBoolQuickBusy) { _showBoolQuickModal = false; } }">
        <div class="w-full max-w-sm overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-2xl" @onclick:stopPropagation="true">
            <div class="px-6 pt-5 pb-1 text-center">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Complete Reminder</p>
                <h3 class="mt-1 text-base font-semibold text-gray-900 dark:text-gray-100">@_boolQuickItem.Title</h3>
            </div>
            <div class="px-6 py-4 space-y-3">
                <div class="flex gap-3">
                    <button type="button"
                            class="flex-1 min-h-[52px] rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_boolQuickValue == true ? "border-green-500 bg-green-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200")"
                            @onclick="() => _boolQuickValue = true">
                        <i class="bi bi-check-lg me-1"></i>Yes
                    </button>
                    <button type="button"
                            class="flex-1 min-h-[52px] rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_boolQuickValue == false ? "border-red-500 bg-red-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200")"
                            @onclick="() => _boolQuickValue = false">
                        <i class="bi bi-x-lg me-1"></i>No
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_boolQuickError))
            {
                <div class="mx-6 mb-3 rounded-lg border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/20 px-4 py-2 text-sm text-red-700 dark:text-red-200">
                    @_boolQuickError
                </div>
            }
            <div class="flex gap-3 border-t border-gray-200 dark:border-gray-700 px-6 py-4" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
                <button type="button"
                        class="flex-1 min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="() => { _showBoolQuickModal = false; _boolQuickItem = null; }"
                        disabled="@_isBoolQuickBusy">
                    Cancel
                </button>
                <button type="button"
                        class="flex-1 min-h-[48px] rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SaveBoolQuickAsync"
                        disabled="@_isBoolQuickBusy">
                    @if (_isBoolQuickBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    Save
                </button>
            </div>
        </div>
    </div>
}

@* ── Delete list confirmation ── *@
@if (_pendingDeleteList != null)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Delete list</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300"
                    @onclick="() => _pendingDeleteList = null" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        @* Body *@
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <p class="text-base text-gray-700 dark:text-gray-300">
                Delete <strong>@_pendingDeleteList.Name</strong> and all its items? This cannot be undone.
            </p>
        </div>
        @* Sticky footer *@
        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4" style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));">
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        class="min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="() => _pendingDeleteList = null" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50"
                        @onclick="DeleteListConfirmedAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IList<TodoListResponse>? _lists;
    private IList<TagResponse>? _allTags;
    private string? _loadError;
    private string? _listError;
    private string? _itemModalError;
    private bool _isBusy;

    // Per-list state
    private readonly HashSet<int> _showDonePerList = new();
    private readonly HashSet<int> _showSkippedPerList = new();
    private readonly Dictionary<int, string?> _itemErrorPerList = new();

    // Drag state
    private TodoItemResponse? _draggingItem;
    private TodoItemResponse? _dragOverItem;
    private int _dragFromListId;
    private int _dragOverLastZoneListId;
    private int _copiedItemId;

    private System.Threading.Timer? _refreshTimer;

    private bool _showListModal;
    private bool _isEditingList;
    private int _editingListId;
    private TodoListRequest _listForm = new() { Name = string.Empty };
    private EditContext _listEditContext = null!;

    private bool _showItemModal;
    private bool _isEditingItem;
    private int _editingItemId;
    private int _addItemToListId;
    private TodoListResponse? _currentListForItemModal;
    private bool _monitorUseDaysBack = true;
    private bool? _booleanBoolValue;
    private TodoItemRequest _itemForm = new() { Title = string.Empty };
    private EditContext _itemEditContext = null!;

    private TodoListResponse? _pendingDeleteList;

    // Boolean quick-complete modal state
    private bool _showBoolQuickModal;
    private TodoItemResponse? _boolQuickItem;
    private bool? _boolQuickValue;
    private bool _isBoolQuickBusy;
    private string? _boolQuickError;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _refreshTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(async () =>
            {
                if (!_showItemModal && !_showListModal && !_isBusy)
                {
                    await LoadDataAsync();
                    StateHasChanged();
                }
            }),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadDataAsync()
    {
        _loadError = null;
        try
        {
            var listsTask = TodoApi.GetTodoLists();
            var tagsTask = ActivityApi.GetTags();
            await Task.WhenAll(listsTask, tagsTask);
            _lists = listsTask.Result;
            _allTags = tagsTask.Result;
            _itemErrorPerList.Clear();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to load todo data");
            _loadError = "Could not load to-do lists. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unexpected error loading todo data");
            _loadError = "Could not load to-do lists. Please try again.";
        }
    }

    private void ToggleShowDone(int listId)
    {
        if (!_showDonePerList.Remove(listId))
        {
            _showDonePerList.Add(listId);
        }
    }

    private void ToggleShowSkipped(int listId)
    {
        if (!_showSkippedPerList.Remove(listId))
        {
            _showSkippedPerList.Add(listId);
        }
    }

    // ── List modal ──

    private void OpenAddListModal()
    {
        _isEditingList = false;
        _listForm = new TodoListRequest { Name = string.Empty };
        _listEditContext = new EditContext(_listForm);
        _listError = null;
        _showListModal = true;
    }

    private void OpenEditListModal(TodoListResponse list)
    {
        _isEditingList = true;
        _editingListId = list.Id;
        _listForm = new TodoListRequest
        {
            Name = list.Name,
            DisplayOrder = list.DisplayOrder,
            ListType = list.ListType,
            ShowOnHomepage = list.ShowOnHomepage
        };
        _listEditContext = new EditContext(_listForm);
        _listError = null;
        _showListModal = true;
    }

    private async Task SubmitListFormAsync()
    {
        if (!_listEditContext.Validate()) return;

        await SaveListAsync();
    }

    private void CloseListModal()
    {
        _showListModal = false;
        _listError = null;
    }

    private async Task SaveListAsync()
    {
        _isBusy = true;
        _listError = null;
        try
        {
            if (_isEditingList)
            {
                await TodoApi.UpdateTodoList(_editingListId, _listForm);
            }
            else
            {
                await TodoApi.CreateTodoList(_listForm);
            }

            _showListModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo list");
            _listError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ConfirmDeleteList(TodoListResponse list)
    {
        _pendingDeleteList = list;
    }

    private async Task DeleteListConfirmedAsync()
    {
        if (_pendingDeleteList == null)
        {
            return;
        }

        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoList(_pendingDeleteList.Id);
            _pendingDeleteList = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo list");
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Item modal ──

    private void OpenAddItemModal(int listId)
    {
        _isEditingItem = false;
        _addItemToListId = listId;
        _currentListForItemModal = _lists?.FirstOrDefault(l => l.Id == listId);
        _monitorUseDaysBack = true;
        _booleanBoolValue = null;
        _itemForm = new TodoItemRequest { Title = string.Empty, ListId = listId, MonitorDaysBack = 0 };
        _itemEditContext = new EditContext(_itemForm);
        _itemModalError = null;
        _showItemModal = true;
    }

    private void OpenEditItemModal(TodoItemResponse item)
    {
        _isEditingItem = true;
        _editingItemId = item.Id;
        _currentListForItemModal = _lists?.FirstOrDefault(l => l.Id == item.ListId);
        _monitorUseDaysBack = item.MonitorFromDate == null;
        _itemForm = new TodoItemRequest
        {
            ListId = item.ListId,
            Title = item.Title,
            Notes = item.Notes,
            StartDate = item.StartDate,
            DueDate = item.DueDate,
            NotifyAt = item.NotifyAt,
            DisplayOrder = item.DisplayOrder,
            RecurrenceType = item.RecurrenceType,
            AutoLogMode = item.AutoLogMode,
            MonitorDaysBack = item.MonitorDaysBack,
            MonitorFromDate = item.MonitorFromDate,
            MonitorToDate = item.MonitorToDate,
            CompletionTagId = item.CompletionTagId
        };
        _itemEditContext = new EditContext(_itemForm);
        _itemModalError = null;
        _booleanBoolValue = item.Notes switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
        _showItemModal = true;
    }

    private async Task SubmitItemFormAsync()
    {
        if (!_itemEditContext.Validate()) return;

        await SaveItemAsync();
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _itemModalError = null;
        _booleanBoolValue = null;
    }

    private async Task SaveItemAsync()
    {
        _isBusy = true;
        _itemModalError = null;
        try
        {
            var isBooleanType = IsBooleanInputType(_allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId)?.InputTypeId)
                && _currentListForItemModal?.ListType == TodoListType.Reminder;

            if (isBooleanType)
            {
                _itemForm.Notes = _booleanBoolValue.HasValue ? (_booleanBoolValue.Value ? "true" : "false") : null;
            }

            if (_isEditingItem)
            {
                await TodoApi.UpdateTodoItem(_editingItemId, _itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await TodoApi.CompleteItem(_editingItemId, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
                }
            }
            else
            {
                var created = await TodoApi.CreateTodoItem(_itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await TodoApi.CompleteItem(created.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
                }
            }

            _showItemModal = false;
            _booleanBoolValue = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo item");
            _itemModalError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CompleteItemAsync(TodoItemResponse item, TodoListResponse list)
    {
        if (list.ListType == TodoListType.Reminder && item.CompletionTagId.HasValue)
        {
            // Resolve InputTypeId from the response or fall back to the cached tag list
            var effectiveInputTypeId = item.CompletionTagInputTypeId
                ?? _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId)?.InputTypeId;

            if (IsBooleanInputType(effectiveInputTypeId))
            {
                _boolQuickItem = item;
                _boolQuickValue = item.Notes switch { "true" => true, "false" => false, _ => null };
                _boolQuickError = null;
                _showBoolQuickModal = true;
                StateHasChanged();
                return;
            }

            // Non-Boolean or untyped completion tag: fall back to full edit modal (old behaviour)
            OpenEditItemModal(item);
            return;
        }

        try
        {
            var updated = await TodoApi.CompleteItem(item.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
            UpdateItemInList(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when completing", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
    }

    private async Task SaveBoolQuickAsync()
    {
        if (_boolQuickItem == null || !_boolQuickValue.HasValue)
        {
            _boolQuickError = "Please select Yes or No.";
            return;
        }
        _isBoolQuickBusy = true;
        _boolQuickError = null;
        try
        {
            var req = new TodoItemRequest
            {
                ListId = _boolQuickItem.ListId,
                Title = _boolQuickItem.Title,
                Notes = _boolQuickValue.HasValue ? (_boolQuickValue.Value ? "true" : "false") : null,
                StartDate = _boolQuickItem.StartDate,
                DueDate = _boolQuickItem.DueDate,
                NotifyAt = _boolQuickItem.NotifyAt,
                DisplayOrder = _boolQuickItem.DisplayOrder,
                RecurrenceType = _boolQuickItem.RecurrenceType,
                AutoLogMode = _boolQuickItem.AutoLogMode,
                MonitorDaysBack = _boolQuickItem.MonitorDaysBack,
                MonitorFromDate = _boolQuickItem.MonitorFromDate,
                MonitorToDate = _boolQuickItem.MonitorToDate,
                CompletionTagId = _boolQuickItem.CompletionTagId
            };
            await TodoApi.UpdateTodoItem(_boolQuickItem.Id, req);
            await TodoApi.CompleteItem(_boolQuickItem.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
            _showBoolQuickModal = false;
            _boolQuickItem = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete Boolean todo item");
            _boolQuickError = "Failed to save. Please try again.";
        }
        finally
        {
            _isBoolQuickBusy = false;
        }
    }

    private async Task ReopenItemAsync(TodoItemResponse item)
    {
        try
        {
            var updated = await TodoApi.ReopenItem(item.Id);
            UpdateItemInList(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when reopening", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to reopen todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
    }

