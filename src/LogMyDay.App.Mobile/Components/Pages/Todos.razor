@page "/todos"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using Refit
@inject ITodoApi TodoApi
@inject IActivityApi ActivityApi
@inject ILogger<Todos> Logger

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="To-Do Lists" ShowReload="true" OnReload="LoadDataAsync" />

    <div class="max-w-7xl mx-auto px-4 py-4">

        @if (_loadError != null)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                @_loadError
            </div>
        }
        else if (_lists == null)
        {
            <div class="flex items-center justify-center gap-3 py-16 text-gray-500 dark:text-gray-400">
                <div class="inline-block animate-spin text-2xl text-primary-600">⟳</div>
                <span class="text-sm">Loading to-do lists…</span>
            </div>
        }
        else
        {
            @* Tab bar *@
            <div class="flex items-center gap-1 border-b border-gray-200 dark:border-gray-700 overflow-x-auto mb-1">
                @foreach (var list in _lists)
                {
                    var isActive = _activeListId == list.Id;
                    <button type="button"
                            class="@(isActive ? "border-b-2 border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400 font-semibold" : "text-gray-600 dark:text-gray-400") whitespace-nowrap px-4 py-3 text-sm transition-colors"
                            @onclick="() => _activeListId = list.Id">
                        @list.Name
                    </button>
                }
                <button type="button"
                        class="whitespace-nowrap px-3 py-3 text-sm text-gray-500 dark:text-gray-400"
                        title="Add list"
                        @onclick="OpenAddListModal">
                    <i class="bi bi-plus-lg text-lg"></i>
                </button>
            </div>

            @if (_activeList != null)
            {
                var activeList = _activeList;
                var today = DateOnly.FromDateTime(DateTime.Today);
                var activeItems = activeList.Items
                    .Where(i => !i.IsDone && (i.StartDate == null || i.StartDate <= today))
                    .OrderBy(i => i.DisplayOrder)
                    .ThenBy(i => i.DueDate ?? DateOnly.MaxValue)
                    .ThenBy(i => i.DateCreated)
                    .ToList();
                var doneItems = activeList.Items.Where(i => i.IsDone).ToList();

                <div class="py-2 space-y-1">
                    @* Header row *@
                    <div class="mb-2 flex items-center justify-between">
                        <span class="text-xs text-gray-500 dark:text-gray-400">
                            @activeItems.Count item@(activeItems.Count == 1 ? "" : "s")
                            @if (activeList.CompletionTagName != null)
                            {
                                <span class="ml-2 inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-xs font-medium text-sky-700 dark:bg-sky-500/20 dark:text-sky-300">
                                    @activeList.CompletionTagName
                                </span>
                            }
                        </span>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                                    @onclick="() => OpenEditListModal(activeList)"
                                    disabled="@_isBusy">
                                <i class="bi bi-pencil"></i>
                                Edit
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors"
                                    @onclick="() => ConfirmDeleteList(activeList)"
                                    disabled="@_isBusy">
                                <i class="bi bi-trash"></i>
                                Delete
                            </button>
                        </div>
                    </div>

                    @* Active items *@
                    @if (!activeItems.Any())
                    {
                        <p class="py-6 text-center text-sm text-gray-400 dark:text-gray-500">No pending items. Add one below.</p>
                    }
                    else
                    {
                        @foreach (var item in activeItems)
                        {
                            var isOverdue = item.DueDate.HasValue && item.DueDate.Value < today;
                            <div class="flex items-start gap-3 rounded-xl px-3 py-3 bg-white dark:bg-gray-800 shadow-sm mb-2 @(isOverdue ? "border-l-4 border-red-400" : "")">
                                <input type="checkbox"
                                       class="mt-0.5 h-5 w-5 rounded border-gray-300 text-primary-600 dark:border-gray-600 cursor-pointer"
                                       checked="@item.IsDone"
                                       @onchange="() => CompleteItemAsync(item)"
                                       disabled="@_isBusy" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-sm text-gray-900 dark:text-gray-100">@item.Title</span>
                                        @if (isOverdue)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/20 dark:text-red-300">
                                                Overdue
                                            </span>
                                        }
                                        @if (item.DueDate.HasValue && !isOverdue)
                                        {
                                            <span class="text-xs text-gray-400 dark:text-gray-500">due @item.DueDate.Value.ToString("MMM d")</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400 truncate">@item.Notes</p>
                                    }
                                </div>
                                <div class="flex items-center gap-1 shrink-0">
                                    <button type="button"
                                            class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                                            title="Edit"
                                            @onclick="() => OpenEditItemModal(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-pencil text-sm"></i>
                                    </button>
                                    <button type="button"
                                            class="p-2 text-gray-400 hover:text-red-500 dark:hover:text-red-400"
                                            title="Delete"
                                            @onclick="() => DeleteItemAsync(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-trash text-sm"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    @* Inline add form *@
                    <form class="mt-3 flex items-center gap-2" @onsubmit="AddItemInlineAsync" @onsubmit:preventDefault>
                        <input type="text"
                               class="flex-1 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
                               placeholder="Add an item…"
                               maxlength="500"
                               @bind="_newItemTitle"
                               @bind:event="oninput"
                               disabled="@_isBusy" />
                        <button type="submit"
                                class="inline-flex items-center gap-1 rounded-xl bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 disabled:opacity-50 transition-colors"
                                disabled="@(string.IsNullOrWhiteSpace(_newItemTitle) || _isBusy)">
                            <i class="bi bi-plus-lg"></i>
                            Add
                        </button>
                        <button type="button"
                                class="inline-flex items-center rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 disabled:opacity-50 transition-colors"
                                title="Add with details"
                                @onclick="() => OpenAddItemModal(activeList.Id)"
                                disabled="@_isBusy">
                            <i class="bi bi-three-dots text-sm"></i>
                        </button>
                    </form>

                    @if (!string.IsNullOrEmpty(_itemError))
                    {
                        <div class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                            @_itemError
                        </div>
                    }

                    @* Completed items toggle *@
                    @if (doneItems.Any())
                    {
                        <div class="mt-4 border-t border-gray-200 dark:border-gray-700 pt-3">
                            <button type="button"
                                    class="text-sm text-gray-500 dark:text-gray-400"
                                    @onclick="() => _showDone = !_showDone">
                                @(_showDone ? "Hide" : "Show") completed (@doneItems.Count)
                            </button>

                            @if (_showDone)
                            {
                                <div class="mt-2 space-y-1">
                                    @foreach (var item in doneItems.OrderByDescending(i => i.DoneAt))
                                    {
                                        <div class="flex items-center gap-3 rounded-xl px-3 py-2.5 bg-white dark:bg-gray-800 shadow-sm mb-1 opacity-60">
                                            <input type="checkbox"
                                                   class="h-5 w-5 rounded border-gray-300 dark:border-gray-600 cursor-pointer"
                                                   checked="@item.IsDone"
                                                   @onchange="() => ReopenItemAsync(item)"
                                                   disabled="@_isBusy" />
                                            <span class="flex-1 text-sm line-through text-gray-500 dark:text-gray-400">@item.Title</span>
                                            <button type="button"
                                                    class="p-2 text-gray-300 hover:text-red-500 dark:hover:text-red-400"
                                                    @onclick="() => DeleteItemAsync(item)"
                                                    disabled="@_isBusy">
                                                <i class="bi bi-trash text-sm"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (_lists.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-16 gap-4 text-gray-400 dark:text-gray-500">
                    <i class="bi bi-check2-square text-5xl"></i>
                    <p class="text-sm">No lists yet.</p>
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 transition-colors"
                            @onclick="OpenAddListModal">
                        <i class="bi bi-plus-lg"></i>
                        Create your first list
                    </button>
                </div>
            }
        }
    </div>
</div>

@* ── List Create/Edit Modal ── *@
@if (_showListModal)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center bg-gray-900/70" @onclick="() => { if (!_isBusy) CloseListModal(); }">
        <div class="w-full max-w-lg rounded-t-2xl border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900 pb-safe" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 px-5 py-4">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@(_isEditingList ? "Edit list" : "New list")</h3>
                <button type="button" class="p-2 text-gray-500 dark:text-gray-400" @onclick="CloseListModal" disabled="@_isBusy">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <EditForm Model="_listForm" OnValidSubmit="SaveListAsync">
                <DataAnnotationsValidator />
                <div class="space-y-4 px-5 py-4">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Name <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_listForm.Name"
                                   maxlength="200"
                                   placeholder="e.g. Work tasks" />
                        <ValidationMessage For="@(() => _listForm.Name)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log activity when done</label>
                        <select class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                @bind="_listForm.CompletionTagId">
                            <option value="">— None —</option>
                            @if (_allTags != null)
                            {
                                @foreach (var tag in _allTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </select>
                        @if (_listForm.CompletionTagId.HasValue && _allTags != null)
                        {
                            var sel = _allTags.FirstOrDefault(t => t.Id == _listForm.CompletionTagId.Value);
                            @if (sel != null && !sel.IsRepeatable)
                            {
                                <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">
                                    This tag is not repeatable — completing multiple items on the same day may conflict.
                                </p>
                            }
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_listError))
                {
                    <div class="mx-5 mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                        @_listError
                    </div>
                }
                <div class="flex items-center justify-end gap-3 border-t border-gray-200 dark:border-gray-700 px-5 py-4">
                    <button type="button"
                            class="rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
                            @onclick="CloseListModal" disabled="@_isBusy">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                            disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <div class="inline-block animate-spin text-sm">⟳</div>
                        }
                        @(_isEditingList ? "Save changes" : "Create list")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ── Item Create/Edit Modal ── *@
@if (_showItemModal)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center bg-gray-900/70" @onclick="() => { if (!_isBusy) CloseItemModal(); }">
        <div class="w-full max-w-lg rounded-t-2xl border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900 pb-safe" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 px-5 py-4">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@(_isEditingItem ? "Edit item" : "New item")</h3>
                <button type="button" class="p-2 text-gray-500 dark:text-gray-400" @onclick="CloseItemModal" disabled="@_isBusy">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <EditForm Model="_itemForm" OnValidSubmit="SaveItemAsync">
                <DataAnnotationsValidator />
                <div class="space-y-4 px-5 py-4">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Title <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_itemForm.Title"
                                   maxlength="500"
                                   placeholder="What needs to be done?" />
                        <ValidationMessage For="@(() => _itemForm.Title)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Notes</label>
                        <InputTextArea class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                       @bind-Value="_itemForm.Notes"
                                       rows="2"
                                       placeholder="Optional notes" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Start date</label>
                            <input type="date"
                                   class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   value="@(_itemForm.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                   @onchange="e => _itemForm.StartDate = ParseDateOnly(e.Value?.ToString())" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Due date</label>
                            <input type="date"
                                   class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   value="@(_itemForm.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                   @onchange="e => _itemForm.DueDate = ParseDateOnly(e.Value?.ToString())" />
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_itemModalError))
                {
                    <div class="mx-5 mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                        @_itemModalError
                    </div>
                }
                <div class="flex items-center justify-end gap-3 border-t border-gray-200 dark:border-gray-700 px-5 py-4">
                    <button type="button"
                            class="rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
                            @onclick="CloseItemModal" disabled="@_isBusy">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                            disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <div class="inline-block animate-spin text-sm">⟳</div>
                        }
                        @(_isEditingItem ? "Save changes" : "Add item")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ── Delete list confirmation ── *@
@if (_pendingDeleteList != null)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center bg-gray-900/70">
        <div class="w-full max-w-lg rounded-t-2xl border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900 pb-safe">
            <div class="border-b border-gray-200 dark:border-gray-700 px-5 py-4">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Delete list</h3>
            </div>
            <div class="px-5 py-4 text-sm text-gray-700 dark:text-gray-300">
                Delete <strong>@_pendingDeleteList.Name</strong> and all its items? This cannot be undone.
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-gray-200 dark:border-gray-700 px-5 py-4">
                <button type="button"
                        class="rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="() => _pendingDeleteList = null" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50"
                        @onclick="DeleteListConfirmedAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IList<TodoListResponse>? _lists;
    private IList<TagResponse>? _allTags;
    private int _activeListId;
    private string? _loadError;
    private string? _listError;
    private string? _itemError;
    private string? _itemModalError;
    private bool _isBusy;
    private bool _showDone;

    private bool _showListModal;
    private bool _isEditingList;
    private int _editingListId;
    private TodoListRequest _listForm = new() { Name = string.Empty };

    private bool _showItemModal;
    private bool _isEditingItem;
    private int _editingItemId;
    private int _addItemToListId;
    private TodoItemRequest _itemForm = new() { Title = string.Empty };
    private string _newItemTitle = string.Empty;

    private TodoListResponse? _pendingDeleteList;

    private TodoListResponse? _activeList =>
        _lists?.FirstOrDefault(l => l.Id == _activeListId);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loadError = null;
        try
        {
            var listsTask = TodoApi.GetTodoLists();
            var tagsTask = ActivityApi.GetTags();
            await Task.WhenAll(listsTask, tagsTask);
            _lists = listsTask.Result;
            _allTags = tagsTask.Result;

            if (_lists.Count > 0 && !_lists.Any(l => l.Id == _activeListId))
            {
                _activeListId = _lists[0].Id;
            }
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to load todo data");
            _loadError = "Could not load to-do lists. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unexpected error loading todo data");
            _loadError = "Could not load to-do lists. Please try again.";
        }
    }

    // ── List modal ──

    private void OpenAddListModal()
    {
        _isEditingList = false;
        _listForm = new TodoListRequest { Name = string.Empty };
        _listError = null;
        _showListModal = true;
    }

    private void OpenEditListModal(TodoListResponse list)
    {
        _isEditingList = true;
        _editingListId = list.Id;
        _listForm = new TodoListRequest
        {
            Name = list.Name,
            CompletionTagId = list.CompletionTagId,
            DisplayOrder = list.DisplayOrder
        };
        _listError = null;
        _showListModal = true;
    }

    private void CloseListModal()
    {
        _showListModal = false;
        _listError = null;
    }

    private async Task SaveListAsync()
    {
        _isBusy = true;
        _listError = null;
        try
        {
            if (_isEditingList)
            {
                await TodoApi.UpdateTodoList(_editingListId, _listForm);
            }
            else
            {
                var created = await TodoApi.CreateTodoList(_listForm);
                _activeListId = created.Id;
            }

            _showListModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo list");
            _listError = "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ConfirmDeleteList(TodoListResponse list)
    {
        _pendingDeleteList = list;
    }

    private async Task DeleteListConfirmedAsync()
    {
        if (_pendingDeleteList == null)
        {
            return;
        }

        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoList(_pendingDeleteList.Id);
            _pendingDeleteList = null;
            await LoadDataAsync();

            if (_lists != null && _lists.Count > 0 && !_lists.Any(l => l.Id == _activeListId))
            {
                _activeListId = _lists[0].Id;
            }
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo list");
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Item modal ──

    private void OpenAddItemModal(int listId)
    {
        _isEditingItem = false;
        _addItemToListId = listId;
        _itemForm = new TodoItemRequest { Title = _newItemTitle.Trim(), ListId = listId };
        _newItemTitle = string.Empty;
        _itemModalError = null;
        _showItemModal = true;
    }

    private void OpenEditItemModal(TodoItemResponse item)
    {
        _isEditingItem = true;
        _editingItemId = item.Id;
        _itemForm = new TodoItemRequest
        {
            ListId = item.ListId,
            Title = item.Title,
            Notes = item.Notes,
            StartDate = item.StartDate,
            DueDate = item.DueDate,
            NotifyAt = item.NotifyAt,
            DisplayOrder = item.DisplayOrder
        };
        _itemModalError = null;
        _showItemModal = true;
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _itemModalError = null;
    }

    private async Task SaveItemAsync()
    {
        _isBusy = true;
        _itemModalError = null;
        try
        {
            if (_isEditingItem)
            {
                await TodoApi.UpdateTodoItem(_editingItemId, _itemForm);
            }
            else
            {
                await TodoApi.CreateTodoItem(_itemForm);
            }

            _showItemModal = false;
            _newItemTitle = string.Empty;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo item");
            _itemModalError = "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task AddItemInlineAsync()
    {
        var title = _newItemTitle.Trim();
        if (string.IsNullOrEmpty(title) || _activeList == null)
        {
            return;
        }

        _isBusy = true;
        _itemError = null;
        try
        {
            await TodoApi.CreateTodoItem(new TodoItemRequest { ListId = _activeList.Id, Title = title });
            _newItemTitle = string.Empty;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to add todo item");
            _itemError = "Failed to add item. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CompleteItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.CompleteItem(item.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete todo item {ItemId}", item.Id);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReopenItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.ReopenItem(item.Id);
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to reopen todo item {ItemId}", item.Id);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteItemAsync(TodoItemResponse item)
    {
        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoItem(item.Id);
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo item {ItemId}", item.Id);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static DateOnly? ParseDateOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateOnly.TryParse(value, out var d) ? d : null;
}
