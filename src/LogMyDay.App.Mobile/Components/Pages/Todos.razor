    }

    private async Task CopyItemTitleAsync(TodoItemResponse item)
    {
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(item.Title);
        _copiedItemId = item.Id;
        await Task.Delay(2000);
        _copiedItemId = 0;
        StateHasChanged();
    }

    private async Task OnDropItemAsync(TodoItemResponse target, int listId)
    {
        var dragging = _draggingItem;
        _draggingItem = null;
        _dragOverItem = null;

        if (dragging == null || dragging.Id == target.Id)
        {
            return;
        }

        var list = _lists?.FirstOrDefault(l => l.Id == listId);

        if (list == null)
        {
            return;
        }

        var today = DateTime.Today;
        var ordered = list.Items
            .Where(i => !i.IsDone && (i.StartDate == null || i.StartDate.Value.Date <= today))
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.DueDate ?? DateTime.MaxValue)
            .ThenBy(i => i.DateCreated)
            .ToList();

        var fromIndex = ordered.FindIndex(i => i.Id == dragging.Id);
        var toIndex = ordered.FindIndex(i => i.Id == target.Id);

        if (fromIndex < 0 || toIndex < 0)
        {
            return;
        }

        ordered.RemoveAt(fromIndex);
        ordered.Insert(toIndex, dragging);

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].DisplayOrder = i;
        }

        _isBusy = true;
        try
        {
            var request = ordered
                .Select((item, idx) => new TodoItemReorderRequest { Id = item.Id, DisplayOrder = idx })
                .ToList();

            await TodoApi.ReorderItems(list.Id, request);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder todo items in list {ListId}", list.Id);
            _itemErrorPerList[list.Id] = "Failed to save order. Please try again.";
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static DateTime? ParseDateTime(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateTime.TryParse(value, out var d) ? d : null;

    private static DateOnly? ParseDateOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateOnly.TryParse(value, out var d) ? d : null;

    private static bool IsNumericInputType(int? inputTypeId) =>
        inputTypeId is 1 or 6 or 7 or 8 or 9 or 10 or 11;

    private static bool IsBooleanInputType(int? inputTypeId) =>
        inputTypeId == 3;

