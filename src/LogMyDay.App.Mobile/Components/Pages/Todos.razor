@page "/todos"
@using LogMyDay.Domain.Constants
@using LogMyDay.Domain.Enums
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using LogMyDay.App.Mobile.Services
@using Refit
@implements IDisposable
@inject ITodoApi TodoApi
@inject IActivityApi ActivityApi
@inject ILogger<Todos> Logger
@inject ReminderNotificationScheduler ReminderScheduler

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Todos" ShowReload="true" OnReload="LoadDataAsync" />

    <div class="px-6 py-4">

        @if (_loadError != null)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                @_loadError
            </div>
        }
        else if (_lists == null)
        {
            <div class="flex items-center justify-center gap-3 py-16 text-gray-500 dark:text-gray-400">
                <div class="inline-block animate-spin text-2xl text-primary-600">⟳</div>
                <span class="text-sm">Loading to-do lists…</span>
            </div>
        }
        else if (_lists.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-16 gap-4 text-gray-400 dark:text-gray-500">
                <i class="bi bi-check2-square text-5xl"></i>
                <p class="text-sm">No lists yet.</p>
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 transition-colors"
                        @onclick="OpenAddListModal">
                    <i class="bi bi-plus-lg"></i>
                    Create your first list
                </button>
            </div>
        }
        else
        {
            var today = DateTime.Today;
            var selectedList = _lists.FirstOrDefault(l => l.Id == _selectedListId) ?? _lists[0];
            var listId = selectedList.Id;
            var filteredItems = selectedList.Items
                .Where(i => !i.IsDone && !i.IsSkipped && (i.StartDate == null || i.StartDate.Value.Date <= today));
            var activeItems = selectedList.ListType == TodoListType.Reminder
                ? filteredItems.OrderBy(i => i.NotifyAt ?? TimeOnly.MaxValue).ThenBy(i => i.DisplayOrder).ThenBy(i => i.DateCreated).ToList()
                : filteredItems.OrderBy(i => i.DisplayOrder).ThenBy(i => i.DueDate ?? DateTime.MaxValue).ThenBy(i => i.DateCreated).ToList();
            var doneItems = selectedList.Items.Where(i => i.IsDone).ToList();
            var skippedItems = selectedList.Items.Where(i => i.IsSkipped).ToList();
            var showDoneForThis = _showDonePerList.Contains(listId);
            var showSkippedForThis = _showSkippedPerList.Contains(listId);

            @* Row 1: list selector (left) + New list (right) *@
            <div class="mb-3 flex items-center gap-3">
                <select class="min-w-0 flex-1 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-base font-semibold text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                        @bind="_selectedListId" @bind:after="PersistSelectedList">
                    @foreach (var l in _lists)
                    {
                        <option value="@l.Id">@l.Name</option>
                    }
                </select>
                <button type="button"
                        class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                        @onclick="OpenAddListModal">
                    <i class="bi bi-plus-lg"></i>
                    New list
                </button>
            </div>

            @* Row 2: count + show toggles (left) — edit / delete / Add (right) *@
            <div class="mb-2 flex items-center justify-between py-1">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="text-sm text-gray-500 dark:text-gray-400">@activeItems.Count @(activeItems.Count == 1 ? "task" : "tasks")</span>
                    @if (doneItems.Any())
                    {
                        <button type="button"
                                class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                                @onclick="() => ToggleShowDone(listId)">
                            @(showDoneForThis ? "Hide" : "Show") done (@doneItems.Count)
                        </button>
                    }
                    @if (skippedItems.Any())
                    {
                        <button type="button"
                                class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                                @onclick="() => ToggleShowSkipped(listId)">
                            @(showSkippedForThis ? "Hide" : "Show") skipped (@skippedItems.Count)
                        </button>
                    }
                </div>
                <div class="flex items-center gap-1 shrink-0">
                    <button type="button"
                            class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                            title="Edit list"
                            @onclick="() => OpenEditListModal(selectedList)"
                            disabled="@_isBusy">
                        <i class="bi bi-pencil text-base"></i>
                    </button>
                    <button type="button"
                            class="p-2 text-gray-400 hover:text-red-500 dark:hover:text-red-400"
                            title="Delete list"
                            @onclick="() => ConfirmDeleteList(selectedList)"
                            disabled="@_isBusy">
                        <i class="bi bi-trash text-base"></i>
                    </button>
                    <button type="button"
                            class="inline-flex items-center gap-1 rounded-lg bg-primary-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-primary-700 transition-colors disabled:opacity-50"
                            @onclick="() => OpenAddItemModal(listId)"
                            disabled="@_isBusy">
                        <i class="bi bi-plus-lg"></i>
                        Add
                    </button>
                </div>
            </div>

            @* Active items — reminder-style cards, no panel background *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                @if (!activeItems.Any())
                {
                    <p class="col-span-full py-8 text-center text-sm text-gray-400 dark:text-gray-500">No pending items.</p>
                }
                else
                {
                    @foreach (var item in activeItems)
                    {
                        var isOverdue = item.DueDate.HasValue && item.DueDate.Value < today;
                        var isCompleting = _completingItemId == item.Id;
                        var isDragging = _draggingItem?.Id == item.Id;
                        var isDragOver = _dragOverItem?.Id == item.Id && !isDragging;
                        <div @key="item.Id" class="rounded-xl border @(isOverdue ? "border-red-400 dark:border-red-500/50" : "border-gray-200 dark:border-gray-700") bg-gray-50 dark:bg-gray-700/50 p-4 flex items-center gap-3 @(isDragging ? "opacity-40" : "") @(isDragOver ? "ring-2 ring-primary-400" : "")"
                             draggable="true"
                             @ondragstart="() => { _draggingItem = item; _dragFromListId = listId; }"
                             @ondragover:preventDefault
                             @ondragover="() => _dragOverItem = item"
                             @ondrop="() => OnDropItemAsync(item, listId)"
                             @ondragend="() => { _draggingItem = null; _dragOverItem = null; _dragFromListId = 0; _dragOverLastZoneListId = 0; }">
                            <button type="button"
                                    class="h-9 w-9 shrink-0 rounded-lg border-2 flex items-center justify-center transition-colors disabled:opacity-50 @(isCompleting ? "border-emerald-500 bg-emerald-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-transparent active:border-emerald-500 active:bg-emerald-500 active:text-white")"
                                    title="Complete"
                                    @onclick="() => CompleteItemAsync(item, selectedList)"
                                    disabled="@_isBusy">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-semibold text-sm text-gray-900 dark:text-gray-100">@item.Title</span>
                                    @if (selectedList.ListType == TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <span class="text-xs text-gray-500 dark:text-gray-400">@item.Notes</span>
                                    }
                                    @if (isOverdue)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/20 dark:text-red-300">Overdue</span>
                                    }
                                    @if (item.DueDate.HasValue && !isOverdue)
                                    {
                                        <span class="text-xs text-gray-400 dark:text-gray-500">due @item.DueDate.Value.ToString("MMM d")</span>
                                    }
                                    @if (item.RecurrenceType != RecurrenceType.None)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><i class="bi bi-arrow-repeat me-1"></i>@item.RecurrenceType</span>
                                    }
                                </div>
                                @if (selectedList.ListType != TodoListType.Reminder && !string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400 truncate">@item.Notes</p>
                                }
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                @if (selectedList.ListType == TodoListType.Basic)
                                {
                                    <button type="button"
                                            class="flex flex-col items-center gap-0.5 @(_copiedItemId == item.Id ? "text-green-500" : "text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200") transition-colors disabled:opacity-50"
                                            title="@(_copiedItemId == item.Id ? "Copied!" : "Copy title")"
                                            @onclick="() => CopyItemTitleAsync(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-@(_copiedItemId == item.Id ? "check-lg" : "clipboard") text-lg"></i>
                                    </button>
                                }
                                @if (item.RecurrenceType != RecurrenceType.None)
                                {
                                    <button type="button"
                                            class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-amber-500 dark:hover:text-amber-400 transition-colors disabled:opacity-50"
                                            title="Skip"
                                            @onclick="() => SkipItemAsync(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-skip-forward text-lg"></i>
                                        <span class="text-xs uppercase tracking-wide">Skip</span>
                                    </button>
                                }
                                <button type="button"
                                        class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200 transition-colors disabled:opacity-50"
                                        title="Edit"
                                        @onclick="() => OpenEditItemModal(item)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-pencil text-lg"></i>
                                    <span class="text-xs uppercase tracking-wide">Edit</span>
                                </button>
                                <button type="button"
                                        class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400 transition-colors disabled:opacity-50"
                                        title="Delete"
                                        @onclick="() => DeleteItemAsync(item)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-trash text-lg"></i>
                                    <span class="text-xs uppercase tracking-wide">Del</span>
                                </button>
                            </div>
                        </div>
                    }
                    @* Sentinel drop zone — invisible until drag is active *@
                    <div class="sm:col-span-2 mt-1 transition-all @(_dragFromListId == listId ? (_dragOverLastZoneListId == listId ? "flex h-10 items-center justify-center rounded-xl border-2 border-dashed border-primary-400 bg-primary-50 dark:bg-primary-500/10" : "h-10 rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600") : "h-0 overflow-hidden")"
                         @ondragover:preventDefault
                         @ondragover="() => { if (_dragFromListId == listId) _dragOverLastZoneListId = listId; }"
                         @ondragleave="() => { if (_dragOverLastZoneListId == listId) _dragOverLastZoneListId = 0; }"
                         @ondrop="() => OnDropLastAsync(listId)">
                        @if (_dragOverLastZoneListId == listId && _draggingItem != null)
                        {
                            <span class="text-xs text-primary-500 select-none">Drop here to place last</span>
                        }
                    </div>
                }
            </div>

            @* Completed items *@
            @if (showDoneForThis && doneItems.Any())
            {
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var item in doneItems.OrderByDescending(i => i.DoneAt))
                    {
                        <div @key="item.Id" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50 p-4 flex items-center gap-3 opacity-60">
                            <button type="button"
                                    class="h-9 w-9 shrink-0 rounded-lg border-2 border-emerald-500 bg-emerald-500 flex items-center justify-center text-white hover:border-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-400 transition-colors disabled:opacity-50"
                                    title="Re-open"
                                    @onclick="() => ReopenItemAsync(item)"
                                    disabled="@_isBusy">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <span class="flex-1 min-w-0 text-sm line-through text-gray-500 dark:text-gray-400">@item.Title</span>
                            <button type="button"
                                    class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400 transition-colors disabled:opacity-50"
                                    title="Delete"
                                    @onclick="() => DeleteItemAsync(item)"
                                    disabled="@_isBusy">
                                <i class="bi bi-trash text-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            }

            @* Skipped items *@
            @if (showSkippedForThis && skippedItems.Any())
            {
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var item in skippedItems)
                    {
                        <div @key="item.Id" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50 p-4 flex items-center gap-3 opacity-60">
                            <span class="flex-1 min-w-0 text-sm text-gray-500 dark:text-gray-400">@item.Title</span>
                            @if (item.RecurrenceType != RecurrenceType.None)
                            {
                                <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><i class="bi bi-arrow-repeat me-1"></i>@item.RecurrenceType</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_itemErrorPerList.GetValueOrDefault(listId)))
            {
                <div class="mt-3 flex items-center gap-2 rounded-lg border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/20 px-3 py-2 text-xs text-red-700 dark:text-red-200">
                    <span class="flex-1">@_itemErrorPerList[listId]</span>
                    <button type="button" class="shrink-0 font-medium underline hover:no-underline" @onclick="LoadDataAsync">Reload</button>
                </div>
            }
        }
    </div>
</div>

@* ── List Create/Edit Modal ── *@
@if (_showListModal)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@(_isEditingList ? "Edit list" : "New list")</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300" @onclick="CloseListModal" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        @* Scrollable body — EditForm lives here, no flex dependency on form element *@
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm EditContext="_listEditContext">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Name <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_listForm.Name"
                                   maxlength="200"
                                   placeholder="e.g. Work tasks" />
                        <ValidationMessage For="@(() => _listForm.Name)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log tag</label>
                        <select class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                @bind="_listForm.CompletionTagId">
                            <option value="">— None —</option>
                            @if (_allTags != null)
                            {
                                @foreach (var tag in _allTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </select>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Completing any item in this list logs an activity to this tag.</p>
                    </div>
                    @if (_listForm.CompletionTagId.HasValue)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log mode</label>
                            <InputSelect @bind-Value="_listForm.AutoLogMode" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                <option value="@AutoLogMode.Add">Add (accumulate)</option>
                                <option value="@AutoLogMode.ResetIfExists">Replace if exists</option>
                            </InputSelect>
                        </div>
                    }
                    <div class="flex items-center gap-3">
                        <input type="checkbox" id="chk-show-on-homepage" class="h-5 w-5 rounded border-gray-300 text-primary-600 dark:border-gray-600 cursor-pointer"
                               checked="@_listForm.ShowOnHomepage"
                               @onchange="e => _listForm.ShowOnHomepage = (bool)(e.Value ?? false)" />
                        <label for="chk-show-on-homepage" class="text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">Show on homepage</label>
                    </div>
                </div>
            </EditForm>
        </div>
        @* Sticky footer — plain div, always visible *@
        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4" style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));">
            @if (!string.IsNullOrEmpty(_listError))
            {
                <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                    @_listError
                </div>
            }
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        class="min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="CloseListModal" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-primary-600 px-6 py-3 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SubmitListFormAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    @(_isEditingList ? "Save changes" : "Create list")
                </button>
            </div>
        </div>
    </div>
}

@* ── Item Create/Edit Modal ── *@
@if (_showItemModal)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        @* Header *@
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@(_isEditingItem ? "Edit item" : "New item")</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300" @onclick="CloseItemModal" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        @* Scrollable body — EditForm lives here, no flex dependency on form element *@
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm EditContext="_itemEditContext">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Title <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_itemForm.Title"
                                   maxlength="500"
                                   placeholder="What needs to be done?" />
                        <ValidationMessage For="@(() => _itemForm.Title)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    @if (_currentListForItemModal?.ListType == TodoListType.Reminder)
                    {
                        @* Tag selector first *@
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Select the tag</label>
                            <select class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                    @bind="_itemForm.CompletionTagId">
                                <option value="">— None —</option>
                                @if (_allTags != null)
                                {
                                    @foreach (var tag in _allTags)
                                    {
                                        <option value="@tag.Id">@tag.Title</option>
                                    }
                                }
                            </select>
                            @if (_itemForm.CompletionTagId.HasValue && _allTags != null)
                            {
                                var selItemTag = _allTags.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value);
                                @if (selItemTag != null && !selItemTag.IsRepeatable && _itemForm.AutoLogMode != AutoLogMode.Add)
                                {
                                    <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">
                                        This tag is not repeatable — completing multiple items on the same day will replace the existing activity.
                                    </p>
                                }
                            }
                        </div>
                        @* Value input — only shown when a tag with a known type is selected *@
                        @if (_itemForm.CompletionTagId.HasValue && _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value) is { } _editTag && _editTag.InputTypeId.HasValue)
                        {
                            var _editTagInputTypeId = _editTag.InputTypeId;
                            <div>
                                @if (_editTagInputTypeId == InputTypeIds.Boolean)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <div class="flex gap-3">
                                        <button type="button"
                                                class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == true ? "border-green-500 bg-green-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-green-50 dark:hover:bg-green-500/10")"
                                                @onclick="() => _booleanBoolValue = _booleanBoolValue == true ? null : true">
                                            <i class="bi bi-check-lg me-1"></i>Yes
                                        </button>
                                        <button type="button"
                                                class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == false ? "border-red-500 bg-red-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-red-50 dark:hover:bg-red-500/10")"
                                                @onclick="() => { _booleanBoolValue = _booleanBoolValue == false ? (bool?)null : false; }">
                                            <i class="bi bi-x-lg me-1"></i>No
                                        </button>
                                        <button type="button"
                                                class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == null ? "border-primary-500 bg-primary-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700")"
                                                @onclick="() => _booleanBoolValue = null">
                                            Not specified
                                        </button>
                                    </div>
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected answer when completing this reminder.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.Integer || _editTagInputTypeId == InputTypeIds.Decimal || _editTagInputTypeId == InputTypeIds.Percentage)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                               @bind-Value="_itemForm.Notes"
                                               placeholder="Pre-filled number (optional)" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-filled when completing this reminder. Can be changed at completion time.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.String)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                               @bind-Value="_itemForm.Notes"
                                               placeholder="Pre-filled text (optional)" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-filled when completing this reminder. Can be changed at completion time.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.StarRating)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <StarRating Value="@(_editIntValue ?? 0)" ValueChanged="v => _editIntValue = v" MaxStars="5" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected rating. Can be changed at completion time.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.StarRating10)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <StarRating Value="@(_editIntValue ?? 0)" ValueChanged="v => _editIntValue = v" MaxStars="10" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected rating. Can be changed at completion time.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.Score)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <ScoreRating Value="@_editIntValue" ValueChanged="v => _editIntValue = v" MaxScore="5" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected score. Can be changed at completion time.</p>
                                }
                                else if (_editTagInputTypeId == InputTypeIds.Score10)
                                {
                                    <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                    <ScoreRating Value="@_editIntValue" ValueChanged="v => _editIntValue = v" MaxScore="10" />
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected score. Can be changed at completion time.</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Notes</label>
                            <InputTextArea class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           rows="3"
                                           placeholder="Optional notes" />
                        </div>
                    }
                    <div class="grid grid-cols-2 gap-4">
                        @if (_currentListForItemModal?.ListType != TodoListType.Reminder)
                        {
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Start date</label>
                                <input type="datetime-local"
                                       class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                       value="@(_itemForm.StartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => _itemForm.StartDate = ParseDateTime(e.Value?.ToString())" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Due date</label>
                                <input type="datetime-local"
                                       class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                       value="@(_itemForm.DueDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => _itemForm.DueDate = ParseDateTime(e.Value?.ToString())" />
                            </div>
