@page "/tags/edit/{Id:int}"

@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Notifications
@using LogMyDay.Domain.Enums
@using System.Globalization
@using System.Linq
@using LogMyDay.App.Mobile.Services
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject ISharedDataCache SharedDataCache
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject ILogger<TagEdit> Logger
@inject IPageTitleService PageTitleService

<PageTitle>Edit Tag - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="@(string.IsNullOrEmpty(tagTitle) ? "Edit Tag" : tagTitle)" BackUrl="/tags" />

    <div class="max-w-3xl mx-auto px-4 py-4 space-y-6">
        @if (isLoading)
        {
            <div class="rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-6 text-center text-gray-600 dark:text-gray-400">
                Loading tag details...
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage) && editTag == null)
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                @errorMessage
            </div>
        }
        else if (editTag != null)
        {
            <!-- Tag Edit Form -->
            <section class="rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-5 space-y-5">
                <EditForm Model="editTag" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="mb-4 rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200" />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                            @errorMessage
                        </div>
                    }

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Title</label>
                            <InputText @bind-Value="editTag.Tag" class="@InputCss" disabled="@isSaving" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Description (optional)</label>
                            <InputTextArea @bind-Value="editTag.Description" rows="3" class="@InputCss" disabled="@isSaving" placeholder="What does this tag measure? How should values be interpreted?" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Type</label>
                            <InputSelect @bind-Value="editTag.TypeId" @bind-Value:after="OnInputTypeChanged" class="@InputCss" disabled="@isSaving">
                                @foreach (var type in inputTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                                <InputCheckbox @bind-Value="editTag.IsRequired"
                                    class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800"
                                    disabled="@isSaving" />
                                Required
                            </label>
                            @if (!IsRepeatableLockedForCurrentType || editTag.IsRepeatable)
                            {
                                <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                                    <InputCheckbox @bind-Value="editTag.IsRepeatable"
                                        class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800"
                                        disabled="@(isSaving || IsRepeatableLockedForCurrentType)" />
                                    Repeatable
                                </label>
                            }
                            <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                                <InputCheckbox @bind-Value="editTag.IsRange"
                                    class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800"
                                    disabled="@isSaving" />
                                Range
                            </label>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Time Granularity</label>
                            <InputSelect @bind-Value="editTag.TimeGranularity" class="@InputCss" disabled="@isSaving">
                                @foreach (var granularity in OrderedGranularityOptions)
                                {
                                    <option value="@granularity">@granularity</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                            <div>
                                <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Default Value</label>
                                <InputText @bind-Value="editTag.DefaultValue" class="@InputCss" disabled="@isSaving" />
                            </div>
                            @if (!IsMinimumLockedForCurrentType || editTag.MinValue.HasValue)
                            {
                                <div>
                                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Min Value</label>
                                    <InputNumber @bind-Value="editTag.MinValue" class="@InputCss" TValue="double?" disabled="@(isSaving || IsMinimumLockedForCurrentType)" />
                                </div>
                            }
                            @if (!IsMaximumLockedForCurrentType || editTag.MaxValue.HasValue)
                            {
                                <div>
                                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Max Value</label>
                                    <InputNumber @bind-Value="editTag.MaxValue" class="@InputCss" TValue="double?" disabled="@(isSaving || IsMaximumLockedForCurrentType)" />
                                </div>
                            }
                            @if (!IsStepLockedForCurrentType || editTag.Step.HasValue)
                            {
                                <div>
                                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Step</label>
                                    <InputNumber @bind-Value="editTag.Step" class="@InputCss" TValue="double?" disabled="@(isSaving || IsStepLockedForCurrentType)" />
                                </div>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Unit (optional)</label>
                            @if (availableUnits.Count > 0)
                            {
                                <InputSelect @bind-Value="editTag.UnitId" class="@InputCss" TValue="int?" disabled="@isSaving">
                                    <option value="">(None)</option>
                                    @foreach (var unit in availableUnits)
                                    {
                                        <option value="@unit.Id">@unit.Symbol (@unit.QuantityKey)</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <div class="rounded-lg border border-sky-200 bg-sky-50 dark:border-sky-500/40 dark:bg-sky-500/20 px-3 py-2 text-sm text-sky-800 dark:text-sky-200">
                                    No units yet. <button type="button" class="font-semibold underline" @onclick='() => Navigation.NavigateTo("/units")'>Create your first unit.</button>
                                </div>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Option List (optional)</label>
                            @if (availableOptionLists.Count > 0)
                            {
                                <InputSelect @bind-Value="editTag.OptionListId" class="@InputCss" TValue="int?" disabled="@isSaving">
                                    <option value="">(None)</option>
                                    @foreach (var list in availableOptionLists)
                                    {
                                        <option value="@list.Id">@list.Name</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <div class="rounded-lg border border-violet-200 bg-violet-50 dark:border-violet-500/40 dark:bg-violet-500/20 px-3 py-2 text-sm text-violet-800 dark:text-violet-200">
                                    No option lists yet. <button type="button" class="font-semibold underline" @onclick='() => Navigation.NavigateTo("/option-lists")'>Create your first list.</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-3 pt-2">
                        <button type="submit"
                            class="px-5 py-2.5 bg-primary-600 text-white rounded-lg text-sm font-semibold hover:bg-primary-700 disabled:opacity-60 disabled:cursor-not-allowed transition-colors flex items-center gap-2"
                            disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                            }
                            Save Changes
                        </button>
                        <button type="button"
                            class="px-5 py-2.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
                            @onclick="GoBack" disabled="@isSaving">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </section>

            <!-- Notifications Section -->
            <section class="rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-5 space-y-4">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Notifications</h2>
                        <p class="text-xs text-gray-600 dark:text-gray-400">Configure reminders that nudge you when this tag is missing.</p>
                    </div>
                    <button type="button"
                        class="px-4 py-2 bg-primary-600 text-white rounded-lg text-sm font-semibold hover:bg-primary-700 transition-colors flex items-center gap-1.5"
                        @onclick="StartAddNotification">
                        <i class="bi bi-plus-lg"></i>
                        Add
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(notificationErrorMessage) && !isNotificationModalOpen)
                {
                    <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                        @notificationErrorMessage
                    </div>
                }

                @if (notifications.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 px-4 py-6 text-center text-sm text-gray-600 dark:text-gray-400">
                        No notifications configured yet. Add one to start receiving reminders.
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var notification in notifications)
                        {
                            <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1 min-w-0 space-y-1">
                                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">
                                            @if (string.IsNullOrWhiteSpace(notification.NotificationText))
                                            {
                                                <em class="text-gray-500 dark:text-gray-400">(Default message)</em>
                                            }
                                            else
                                            {
                                                @notification.NotificationText
                                            }
                                        </p>
                                        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600 dark:text-gray-400">
                                            @if (!string.IsNullOrWhiteSpace(notification.NotBeforeTime) || !string.IsNullOrWhiteSpace(notification.NotAfterTime))
                                            {
                                                <span>Time: @(notification.NotBeforeTime ?? "-") – @(notification.NotAfterTime ?? "-")</span>
                                            }
                                            <span>Max nudges: @notification.MaxNudges</span>
                                            @if (notification.NudgeIntervalMinutes.HasValue)
                                            {
                                                <span>Interval: @notification.NudgeIntervalMinutes min</span>
                                            }
                                            @if (notification.IsActive)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-emerald-100 dark:bg-emerald-500/20 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:text-emerald-200">Active</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700 px-2 py-0.5 text-xs font-semibold text-gray-600 dark:text-gray-300">Inactive</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex gap-2 shrink-0">
                                        <button type="button"
                                            class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-300 transition-all hover:bg-gray-200 dark:hover:bg-gray-700"
                                            @onclick="() => EditNotification(notification)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button"
                                            class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-xs font-medium text-rose-600 dark:text-rose-400 transition-all hover:bg-rose-100 dark:hover:bg-rose-500/20"
                                            @onclick="async () => await DeleteNotificationAsync(notification.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

<!-- Notification Modal - Full Screen Overlay -->
@if (isNotificationModalOpen && editingNotification != null)
{
    <div class="fixed inset-0 z-[60] bg-white dark:bg-slate-900 flex flex-col" role="dialog" aria-modal="true">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shrink-0">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                @(!editingNotification.Id.HasValue ? "Add Notification" : "Edit Notification")
            </h3>
            <button type="button"
                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors p-2"
                @onclick="CancelNotificationEdit">
                <i class="bi bi-x-lg text-xl"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="flex-1 overflow-y-auto px-5 py-5">
            <EditForm id="notifForm" Model="editingNotification" OnValidSubmit="SaveNotificationAsync">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Notification Text</label>
                        <InputText @bind-Value="editingNotification.NotificationText" class="@InputCss" placeholder="Optional custom message" />
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Not Before Time</label>
                            <InputText @bind-Value="editingNotification.NotBeforeTime" class="@InputCss" placeholder="08:00" />
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Supports offsets beyond 24h (e.g., 32:00 = next day 08:00).</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Not After Time</label>
                            <InputText @bind-Value="editingNotification.NotAfterTime" class="@InputCss" placeholder="Optional end" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Max Nudges</label>
                            <InputNumber @bind-Value="editingNotification.MaxNudges" class="@InputCss" min="0" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Nudge Interval (min)</label>
                            <InputNumber @bind-Value="editingNotification.NudgeIntervalMinutes" class="@InputCss" min="0" />
                        </div>
                    </div>

                    <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                        <InputCheckbox @bind-Value="editingNotification.IsActive"
                            class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800" />
                        Active
                    </label>

                    @if (!string.IsNullOrEmpty(notificationErrorMessage))
                    {
                        <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                            @notificationErrorMessage
                        </div>
                    }
                </div>
            </EditForm>
        </div>

        <!-- Modal Footer -->
        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shrink-0"
             style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                    class="px-5 py-2.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[44px]"
                    @onclick="CancelNotificationEdit" disabled="@isNotificationSaving">
                    Cancel
                </button>
                <button type="submit" form="notifForm"
                    class="px-5 py-2.5 bg-primary-600 text-white rounded-lg text-sm font-semibold hover:bg-primary-700 disabled:opacity-60 disabled:cursor-not-allowed transition-colors flex items-center gap-2 min-h-[44px]"
                    disabled="@isNotificationSaving">
                    @if (isNotificationSaving)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    }
                    Save Notification
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private static readonly IReadOnlyList<TimeGranularity> OrderedGranularityOptions = Enum
        .GetValues<TimeGranularity>()
        .OrderBy(g => g == TimeGranularity.Daily ? 0 : g == TimeGranularity.Exact ? 2 : 1)
        .ThenBy(g => g.ToString())
        .ToArray();

    private const string InputCss = "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-primary-500 focus:border-transparent focus:outline-none";

    private TagRequest? editTag;
    private List<InputTypeDto> inputTypes = new();
    private List<UnitResponse> availableUnits = new();
    private List<TagOptionListResponse> availableOptionLists = new();
    private string? tagTitle;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;

    private List<NotificationViewModel> notifications = new();
    private NotificationEditModel? editingNotification;
    private bool isNotificationModalOpen;
    private string? notificationErrorMessage;
    private bool isNotificationSaving;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        PageTitleService.SetTitle("Edit Tag");

        try
        {
            inputTypes = await ActivityApi.GetInputTypesAsync();
            var tag = await ActivityApi.GetTagById(Id);

            var bareName = tag.GroupName != null && tag.Title.StartsWith(tag.GroupName + ": ", StringComparison.Ordinal)
                ? tag.Title[(tag.GroupName.Length + 2)..]
                : tag.Title;

            editTag = new TagRequest
            {
                Tag = bareName,
                Description = tag.Description,
                TypeId = ResolveTypeId(tag.TypeId),
                IsRequired = tag.IsRequired,
                IsRepeatable = tag.IsRepeatable,
                TimeGranularity = tag.TimeGranularity,
                IsRange = tag.IsRange,
                UnitId = tag.UnitId,
                MinValue = tag.MinValue,
                MaxValue = tag.MaxValue,
                Step = tag.Step,
                DefaultValue = tag.DefaultValue,
                OptionListId = tag.OptionListId
            };

            EnsureValidTypeSelection();

            tagTitle = tag.Title;
            PageTitleService.SetTitle(tag.Title);

            await LoadSupportingData();
            await LoadNotifications();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tag: {ex.Message}";
            Logger.LogError(ex, "Error loading tag {TagId}", Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSupportingData()
    {
        try
        {
            availableUnits = (await ActivityApi.GetUnitsAsync())
                .OrderBy(u => u.QuantityKey)
                .ThenBy(u => u.Key)
                .ToList();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load units");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load units");
        }

        try
        {
            availableOptionLists = (await ActivityApi.GetTagOptionListsAsync())
                .OrderBy(l => l.Name)
                .ToList();
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Not authorized to load option lists");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load option lists");
        }
    }

    private async Task LoadNotifications()
    {
        try
        {
            var items = await ActivityApi.GetNotificationsByTag(Id);
            notifications = items.Select(MapToViewModel).ToList();
            notificationErrorMessage = null;
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error loading notifications: {ex.Message}";
            Logger.LogError(ex, "Error loading notifications for tag {TagId}", Id);
        }
    }

    private void StartAddNotification()
    {
        editingNotification = new NotificationEditModel
        {
            TagId = Id,
            MaxNudges = 3,
            NudgeIntervalMinutes = 15,
            IsActive = true
        };
        notificationErrorMessage = null;
        isNotificationModalOpen = true;
    }

    private void EditNotification(NotificationViewModel notification)
    {
        editingNotification = new NotificationEditModel
        {
            Id = notification.Id,
            TagId = notification.TagId,
            NotificationText = notification.NotificationText,
            NotBeforeTime = notification.NotBeforeTime,
            NotAfterTime = notification.NotAfterTime,
            MaxNudges = notification.MaxNudges,
            NudgeIntervalMinutes = notification.NudgeIntervalMinutes,
            IsActive = notification.IsActive
        };
        notificationErrorMessage = null;
        isNotificationModalOpen = true;
    }

    private void CancelNotificationEdit()
    {
        editingNotification = null;
        isNotificationModalOpen = false;
        notificationErrorMessage = null;
    }

    private async Task SaveNotificationAsync()
    {
        if (editingNotification is null)
        {
            return;
        }

        notificationErrorMessage = null;

        if (!TryBuildRequest(editingNotification, out var request, out var error))
        {
            notificationErrorMessage = error;
            return;
        }

        isNotificationSaving = true;

        try
        {
            if (editingNotification.Id.HasValue)
            {
                await ActivityApi.UpdateNotification(editingNotification.Id.Value, request);
            }
            else
            {
                await ActivityApi.CreateNotification(request);
            }

            await LoadNotifications();
            CancelNotificationEdit();
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error saving notification: {ex.Message}";
            Logger.LogError(ex, "Error saving notification");
        }
        finally
        {
            isNotificationSaving = false;
        }
    }

    private async Task DeleteNotificationAsync(int notificationId)
    {
        try
        {
            await ActivityApi.DeleteNotification(notificationId);
            notifications.RemoveAll(n => n.Id == notificationId);
            notificationErrorMessage = null;
        }
        catch (Exception ex)
        {
            notificationErrorMessage = $"Error deleting notification: {ex.Message}";
            Logger.LogError(ex, "Error deleting notification {NotificationId}", notificationId);
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;

        try
        {
            await ActivityApi.UpdateTag(Id, editTag!);
            SharedDataCache.Invalidate();
            Navigation.NavigateTo("/tags");
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving tag: {ex.Message}";
            Logger.LogError(ex, "Error saving tag {TagId}", Id);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/tags");
    }

    private NotificationViewModel MapToViewModel(NotificationResponse response)
    {
        return new NotificationViewModel
        {
            Id = response.Id,
            TagId = response.TagId,
            NotificationText = response.NotificationText,
            NotBeforeTime = FormatTimeSpan(response.NotBeforeTime),
            NotAfterTime = FormatTimeSpan(response.NotAfterTime),
            MaxNudges = response.MaxNudges,
            NudgeIntervalMinutes = response.NudgeInterval.HasValue
                ? (int?)Math.Round(response.NudgeInterval.Value.TotalMinutes)
                : null,
            IsActive = response.IsActive,
            DateCreated = response.DateCreated
        };
    }

    private bool TryBuildRequest(NotificationEditModel model, out NotificationRequest request, out string? error)
    {
        request = new NotificationRequest
        {
            TagId = Id,
            NotificationText = string.IsNullOrWhiteSpace(model.NotificationText) ? null : model.NotificationText.Trim(),
            MaxNudges = model.MaxNudges,
            IsActive = model.IsActive
        };

        if (!TryParseTime(model.NotBeforeTime, out var notBefore, out error))
        {
            return false;
        }

        if (!TryParseTime(model.NotAfterTime, out var notAfter, out error))
        {
            return false;
        }

        if (model.MaxNudges < 0)
        {
            error = "Max nudges must be zero or greater.";
            return false;
        }

        if (model.NudgeIntervalMinutes.HasValue)
        {
            if (model.NudgeIntervalMinutes.Value < 0)
            {
                error = "Nudge interval must be zero or greater.";
                return false;
            }

            if (model.NudgeIntervalMinutes.Value > 0 && model.NudgeIntervalMinutes.Value < NotificationScheduleCalculator.MinimumIntervalMinutes)
            {
                error = $"Nudge interval must be at least {NotificationScheduleCalculator.MinimumIntervalMinutes} minutes.";
                return false;
            }
        }

        request.NotBeforeTime = notBefore;
        request.NotAfterTime = notAfter;
        request.NudgeInterval = model.NudgeIntervalMinutes.HasValue ? TimeSpan.FromMinutes(model.NudgeIntervalMinutes.Value) : null;

        return true;
    }

    private static bool TryParseTime(string? value, out TimeSpan? time, out string? error)
    {
        time = null;
        error = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var parsed))
        {
            time = parsed;
            return true;
        }

        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var hoursOnly))
        {
            time = TimeSpan.FromHours(hoursOnly);
            return true;
        }

        error = "Time values must use HH:mm format or a total hour value (e.g., 32).";

        return false;
    }

    private static string? FormatTimeSpan(TimeSpan? timeSpan)
    {
        if (!timeSpan.HasValue)
        {
            return null;
        }

        var totalHours = (int)Math.Floor(timeSpan.Value.TotalHours);
        var minutes = Math.Abs(timeSpan.Value.Minutes);
        return $"{totalHours:D2}:{minutes:D2}";
    }

    private void EnsureValidTypeSelection()
    {
        if (editTag is null)
        {
            return;
        }

        editTag.TypeId = ResolveTypeId(editTag.TypeId);
    }

    private int ResolveTypeId(int? typeId)
    {
        if (typeId.HasValue && inputTypes.Any(it => it.Id == typeId.Value))
        {
            return typeId.Value;
        }

        return GetDefaultInputTypeId();
    }

    private int GetDefaultInputTypeId()
    {
        var integerType = inputTypes.FirstOrDefault(it => string.Equals(it.Name, "Integer", StringComparison.OrdinalIgnoreCase));
        return integerType?.Id ?? inputTypes.FirstOrDefault()?.Id ?? 0;
    }

    private bool IsRangeLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsRangeEditable;
        }
    }

    private bool IsStepLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsStepEditable;
        }
    }

    private bool IsMinimumLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsMinimumEditable;
        }
    }

    private bool IsMaximumLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsMaximumEditable;
        }
    }

    private bool IsRepeatableLockedForCurrentType
    {
        get
        {
            if (editTag == null) return false;
            var currentType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
            return currentType != null && !currentType.IsRepeatableEditable;
        }
    }

    private void OnInputTypeChanged()
    {
        if (editTag == null) return;

        var selectedType = inputTypes.FirstOrDefault(it => it.Id == editTag.TypeId);
        if (selectedType != null && !selectedType.IsRangeEditable)
        {
            var constraints = LogMyDay.Domain.Helpers.InputTypeDefaults.GetConstraintsForType(editTag.TypeId);
            editTag.MinValue = constraints.MinValue;
            editTag.MaxValue = constraints.MaxValue;
            editTag.Step = constraints.Step;
        }
        else
        {
            if (!editTag.MinValue.HasValue) editTag.MinValue = null;
            if (!editTag.MaxValue.HasValue) editTag.MaxValue = null;
            if (!editTag.Step.HasValue) editTag.Step = null;
        }

        if (selectedType != null && !selectedType.IsRepeatableEditable)
        {
            editTag.IsRepeatable = false;
        }
    }

