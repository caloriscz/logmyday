@page "/units"

@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Mobile.Services
@using System.Net
@using System.Linq
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject ILogger<Units> Logger
@inject IPageTitleService PageTitleService

<PageTitle>Units - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Units" ShowReload="true" OnReload="LoadUnitsAsync" />
    <TagSectionNav />

    <div class="max-w-3xl mx-auto px-4 py-4 space-y-4">
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                @loadError
            </div>
        }

        @if (isLoading)
        {
            <p class="text-gray-600 dark:text-gray-400"><em>Loading...</em></p>
        }
        else if (units.Count == 0 && string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-dashed border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-8 text-center text-sm text-gray-600 dark:text-gray-400">
                <i class="bi bi-rulers text-4xl block mb-2 text-gray-400"></i>
                <p>No units available yet. Add your first unit.</p>
            </div>
        }
        else
        {
            <div class="hidden md:block overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xs">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Key</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Symbol</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Quantity</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Multiplier</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Offset</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Dec.</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var unit in units)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">
                                    @unit.Key
                                    @if (unit.IsBaseUnit)
                                    {
                                        <span class="ml-1 inline-flex items-center rounded-full bg-sky-100 dark:bg-sky-600/20 px-2 py-0.5 text-xs font-semibold text-sky-900 dark:text-sky-300">Base</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@unit.Symbol</td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@unit.QuantityKey</td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@unit.AToBase</td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@unit.BToBase</td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">@unit.Decimals</td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 mr-1" @onclick="() => OpenEditModal(unit)" disabled="@isBusy">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(unit)" disabled="@(isBusy || unit.IsBaseUnit)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="md:hidden space-y-3">
                @foreach (var unit in units)
                {
                    <div class="rounded-xl border @(unit.IsBaseUnit ? "border-sky-200 dark:border-sky-700" : "border-gray-200 dark:border-gray-700") bg-white dark:bg-gray-800 p-4 shadow-xs">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                                    @unit.Key
                                    @if (unit.IsBaseUnit)
                                    {
                                        <span class="ml-2 inline-flex items-center rounded-full bg-sky-100 dark:bg-sky-600/20 px-2.5 py-0.5 text-xs font-semibold text-sky-900 dark:text-sky-300">Base</span>
                                    }
                                </h3>
                                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">@unit.QuantityKey</p>
                            </div>
                        </div>
                        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-gray-400">Symbol</dt>
                                <dd class="text-gray-900 dark:text-gray-200">@unit.Symbol</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-gray-400">Decimals</dt>
                                <dd class="text-gray-900 dark:text-gray-200">@unit.Decimals</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-gray-400">Multiplier</dt>
                                <dd class="text-gray-900 dark:text-gray-200">@unit.AToBase</dd>
                            </div>
                            <div>
                                <dt class="font-medium text-gray-600 dark:text-gray-400">Offset</dt>
                                <dd class="text-gray-900 dark:text-gray-200">@unit.BToBase</dd>
                            </div>
                        </dl>
                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" @onclick="() => OpenEditModal(unit)" disabled="@isBusy">
                                <i class="bi bi-pencil"></i>
                                <span>Edit</span>
                            </button>
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(unit)" disabled="@(isBusy || unit.IsBaseUnit)">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<button type="button" class="fab" @onclick="OpenAddModal" title="Add Unit">
    <i class="bi bi-plus-lg"></i>
</button>

@if (isModalOpen)
{
    <div class="fixed inset-0 z-60 bg-white dark:bg-slate-900 flex flex-col" role="dialog" aria-modal="true">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700 shrink-0">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">@(isEditing ? "Edit Unit" : "Add Unit")</h3>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 p-2" @onclick="CloseModal">
                <i class="bi bi-x-lg text-xl"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto px-5 py-5">
            <EditForm id="unitEditForm" Model="unitForm" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(unitError))
                {
                    <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                        @unitError
                    </div>
                }
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Key</label>
                        <InputText @bind-Value="unitForm.Key" class="@InputCss" />
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Internal identifier (e.g. minute, kilogram).</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Symbol</label>
                        <InputText @bind-Value="unitForm.Symbol" class="@InputCss" />
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">What users will see (e.g. min, kg).</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Quantity</label>
                        <InputSelect @bind-Value="unitForm.QuantityId" class="@InputCss">
                            <option value="0">Select a quantity…</option>
                            @foreach (var quantity in quantities)
                            {
                                <option value="@quantity.Id">@quantity.Key</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Multiplier to base</label>
                            <InputNumber @bind-Value="unitForm.AToBase" class="@InputCss" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Offset to base</label>
                            <InputNumber @bind-Value="unitForm.BToBase" class="@InputCss" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Display decimals</label>
                        <InputNumber @bind-Value="unitForm.Decimals" class="@InputCss" />
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-700 shrink-0"
             style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                    class="px-5 py-2.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[44px]"
                    @onclick="CloseModal" disabled="@isBusy">
                    Cancel
                </button>
                <button type="submit" form="unitEditForm"
                    class="px-5 py-2.5 bg-primary-600 text-white rounded-lg text-sm font-semibold hover:bg-primary-700 disabled:opacity-60 transition-colors flex items-center gap-2 min-h-[44px]"
                    disabled="@isBusy">
                    @if (isBusy)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    }
                    @(isEditing ? "Save" : "Add")
                </button>
            </div>
        </div>
    </div>
}

@if (unitPendingDelete != null)
{
    <div class="fixed inset-0 z-70 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-gray-900/60" @onclick="CancelDelete"></div>
        <div class="relative z-10 w-full max-w-sm rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-2xl space-y-4" @onclick:stopPropagation="true">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Delete Unit</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Delete unit <strong class="text-gray-900 dark:text-white">@unitPendingDelete.Key</strong>? This cannot be undone.</p>
            <div class="flex justify-end gap-3">
                <button type="button"
                    class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
                    @onclick="CancelDelete" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button"
                    class="px-4 py-2 bg-rose-600 text-white rounded-lg text-sm font-semibold hover:bg-rose-700 disabled:opacity-60 transition-colors"
                    @onclick="DeleteUnit" disabled="@isBusy">
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<UnitResponse> units = new();
    private readonly List<QuantityResponse> quantities = new();
    private UnitRequest unitForm = new()
    {
        Key = string.Empty,
        Symbol = string.Empty,
        QuantityId = 0,
        AToBase = 1,
        BToBase = 0,
        Decimals = 0
    };

    private const string InputCss = "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-primary-500 focus:border-transparent focus:outline-hidden";

    private string? loadError;
    private string? unitError;
    private bool isLoading;
    private bool isBusy;
    private bool isEditing;
    private bool isModalOpen;
    private int? editingUnitId;
    private UnitResponse? unitPendingDelete;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Units");
        await LoadUnitsAsync();
    }

    private async Task LoadUnitsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var quantityResults = await ActivityApi.GetQuantitiesAsync();
            quantities.Clear();
            quantities.AddRange(quantityResults);

            var unitResults = await ActivityApi.GetUnitsAsync();
            units.Clear();
            units.AddRange(unitResults.OrderBy(u => u.QuantityKey).ThenBy(u => u.Key));

            if (unitForm.QuantityId == 0 && quantities.Count > 0)
            {
                unitForm.QuantityId = quantities[0].Id;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view units.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load units: {ex.Message}";
            Logger.LogError(ex, "Failed to load units");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        ResetForm();
        isModalOpen = true;
    }

    private void OpenEditModal(UnitResponse unit)
    {
        BeginEdit(unit);
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        ResetForm();
    }

    private async Task HandleSubmit()
    {
        if (!ValidateUnitForm())
        {
            return;
        }

        isBusy = true;
        unitError = null;

        try
        {
            if (editingUnitId.HasValue)
            {
                await ActivityApi.UpdateUnit(editingUnitId.Value, unitForm);
            }
            else
            {
                await ActivityApi.CreateUnit(unitForm);
            }

            await LoadUnitsAsync();
            CloseModal();
        }
        catch (Refit.ApiException ex)
        {
            unitError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Unit API error");
        }
        catch (Exception ex)
        {
            unitError = ex.Message;
            Logger.LogError(ex, "Unexpected error saving unit");
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool ValidateUnitForm()
    {
        if (string.IsNullOrWhiteSpace(unitForm.Key))
        {
            unitError = "Key is required.";
            
            return false;
        }

        if (string.IsNullOrWhiteSpace(unitForm.Symbol))
        {
            unitError = "Symbol is required.";
            
            return false;
        }

        if (unitForm.QuantityId == 0)
        {
            unitError = "Select a quantity.";
            
            return false;
        }

        if (Math.Abs(unitForm.AToBase) < double.Epsilon)
        {
            unitError = "Multiplier to base must not be zero.";
            
            return false;
        }

        unitError = null;
        
        return true;
    }

    private void BeginEdit(UnitResponse unit)
    {
        isEditing = true;
        editingUnitId = unit.Id;
        unitForm = new UnitRequest
        {
            Key = unit.Key,
            Symbol = unit.Symbol,
            QuantityId = unit.QuantityId,
            AToBase = unit.AToBase,
            BToBase = unit.BToBase,
            Decimals = unit.Decimals
        };
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        isEditing = false;
        editingUnitId = null;
        unitForm = new UnitRequest
        {
            Key = string.Empty,
            Symbol = string.Empty,
            QuantityId = quantities.FirstOrDefault()?.Id ?? 0,
            AToBase = 1,
            BToBase = 0,
            Decimals = 0
        };
    }

    private void ConfirmDelete(UnitResponse unit)
    {
        unitPendingDelete = unit;
    }

    private void CancelDelete()
    {
        unitPendingDelete = null;
    }

    private async Task DeleteUnit()
    {
        if (unitPendingDelete == null)
        {
            return;
        }

        isBusy = true;
        unitError = null;

        try
        {
            await ActivityApi.DeleteUnit(unitPendingDelete.Id);
            await LoadUnitsAsync();
        }
        catch (Refit.ApiException ex)
        {
            unitError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Failed to delete unit");
        }
        catch (Exception ex)
        {
            unitError = ex.Message;
            Logger.LogError(ex, "Unexpected error deleting unit");
        }
        finally
        {
            isBusy = false;
            unitPendingDelete = null;
        }
    }
}
