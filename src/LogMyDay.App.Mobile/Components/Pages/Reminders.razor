@page "/reminders"
@using System.Globalization
@using System.Net
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Constants
@using LogMyDay.App.Mobile.Components.Shared
@using LogMyDay.App.Mobile.Services
@using LogMyDay.Shared.Preferences
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject NavigationManager Navigation
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService
@inject ISharedDataCache SharedDataCache
@inject IJSRuntime JSRuntime
@inject ISystemNotificationService SystemNotificationService

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Reminders" ShowReload="true" OnReload="RefreshReminders" />
    <RemindersSectionNav RequiredCount="@(unfilledRequiredTags?.Count ?? 0)" />

    <div class="max-w-7xl mx-auto px-6 py-4">
        <!-- Date Navigation -->
        <div class="flex items-center justify-center gap-2 mb-6">
            <button class="btn-secondary" @onclick="PreviousDay" title="Previous Day">
                &lt;
            </button>
            <CultureAwareDatePicker Value="@selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="inline-block" Placeholder="Select date" />
            <button class="btn-secondary" @onclick="NextDay" title="Next Day">
                &gt;
            </button>
        </div>

        @if (isLoading)
        {
            <div class="text-center">
                <div class="inline-block animate-spin text-2xl text-primary-600">⟳</div>
                <p class="mt-2 text-gray-600 dark:text-gray-400">Loading reminders...</p>
            </div>
        }
        else if (unfilledRequiredTags?.Any() == true)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var tag in unfilledRequiredTags)
                {
                    <div @key="tag.Id" class="card border-l-4 border-yellow-500 transition duration-300 @(_dismissingTagIds.Contains(tag.Id) ? "opacity-0 scale-95 pointer-events-none" : "")">
                        <div class="flex justify-between items-start mb-2">
                            <h5 class="font-semibold text-yellow-600 dark:text-yellow-400 flex items-center gap-2">
                                <i class="bi bi-exclamation-triangle"></i>
                                @tag.Title
                            </h5>
                        </div>

                        @if (tag.TypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10)
                        {
                            <div class="mb-3">
                                <StarRating Value="@GetStarPickerValue(tag.Id)"
                                            ValueChanged="@(async v => await QuickAddWithValueAsync(tag, v))"
                                            MaxStars="@(tag.TypeId == InputTypeIds.StarRating10 ? 10 : 5)" />
                            </div>
                        }
                        else if (tag.TypeId is InputTypeIds.Score or InputTypeIds.Score10)
                        {
                            <div class="mb-3">
                                <ScoreRating Value="@GetScorePickerValue(tag.Id)"
                                             ValueChanged="@(async v => { if (v.HasValue) await QuickAddWithValueAsync(tag, v.Value); })"
                                             MaxScore="@(tag.TypeId == InputTypeIds.Score10 ? 10 : 5)" />
                            </div>
                        }
                        else if (tag.TypeId == InputTypeIds.Boolean)
                        {
                            <div class="mb-3">
                                <BooleanToggle Value="@GetBoolPickerValue(tag.Id)"
                                               ValueChanged="@(async v => await QuickAddBoolAsync(tag, v))" />
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(GetDefaultValueLabel(tag)))
                        {
                            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                                Default: <span class="font-medium text-gray-800 dark:text-gray-200">@GetDefaultValueLabel(tag)</span>
                            </div>
                        }

                        @{ var isRatingTag = tag.TypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10 or InputTypeIds.Boolean; }
                        @if (!isRatingTag)
                        {
                        <div class="mt-3 grid gap-2 @(HasDefaultValue(tag) && !isRatingTag ? "grid-cols-2" : "grid-cols-1")">
                            <button class="px-3 py-2 bg-primary-600 text-white rounded-md hover:bg-primary-700 active:bg-primary-800 transition-colors flex items-center justify-center gap-1"
                                    @onclick="@(() => PrepareModalForTag(tag.Id))">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Activity</span>
                            </button>
                            @if (HasDefaultValue(tag) && !isRatingTag)
                            {
                                <button class="@GetQuickAddButtonClasses(tag)"
                                        @onclick="@(() => QuickAddDefaultAsync(tag))"
                                        disabled="@IsQuickAddDisabled(tag)">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Use Default</span>
                                    @if (IsQuickAddInProgress(tag.Id))
                                    {
                                        <div class="inline-block animate-spin text-lg">⟳</div>
                                    }
                                </button>
                            }
                        </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert-success">
                <i class="bi bi-check-circle"></i>
                Great! All required tags have been filled for @FormatDate(selectedDate).
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-danger mt-4">
                <i class="bi bi-exclamation-triangle"></i>
                @errorMessage
            </div>
        }
    </div>
</div>

<!-- Add Activity Modal -->
@if (showAddActivityModal && allTags != null && newActivity != null)
{
    <AddActivityModal Activity="newActivity"
                      AvailableTags="allTags"
                      OptionLists="optionLists"
                      OptionListLookup="optionListLookup"
                      DisplayCulture="displayCulture"
                      DisplayTimeZone="displayTimeZone"
                      ErrorMessage="@errorMessage"
                      PreselectedTagId="preselectedTagId"
                      PreselectedDate="selectedDate"
                      OnActivityCreated="OnActivityCreated"
                      OnCanceled="CloseAddActivityModal"
                      OnError="OnError"
                      ModalId="addActivityModal" />
}

@code {
    [SupplyParameterFromQuery(Name = "tagId")] [Parameter] public int? QueryTagId { get; set; }
    [SupplyParameterFromQuery(Name = "date")] [Parameter] public string? QueryDate { get; set; }

    private List<TagResponse>? unfilledRequiredTags;
    private IList<TagResponse>? allTags;
    private IList<TagOptionListResponse>? optionLists;
    private Dictionary<int, TagOptionListResponse>? optionListLookup;
    private DateTime selectedDate = DateTime.Today;
    private bool isLoading = true;
    private string? errorMessage;
    private ActivityRequest newActivity = new();
    private int? preselectedTagId;
    private bool showAddActivityModal = false;
    private bool shouldShowModalAfterRender = false;
    private readonly HashSet<int> quickAddInProgress = new();
    private readonly HashSet<int> _dismissingTagIds = new();
    private readonly Dictionary<int, int> _inlinePickerValues = new();
    private readonly Dictionary<int, bool> _boolPickerValues = new();
    private readonly Dictionary<int, ActivityResponse?> existingActivities = new();

    // User preferences and localization
    private UserPreferencesSnapshot? userPreferences;
    private CultureInfo displayCulture = CultureInfo.CurrentCulture;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Local;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reminders");
        userPreferences = await UserPreferencesService.GetAsync();
        displayCulture = userPreferences.Culture;
        displayTimeZone = userPreferences.TimeZone;

        var today = GetTodayInDisplayZone();

        if (!string.IsNullOrWhiteSpace(QueryDate) && DateOnly.TryParse(QueryDate, out var parsedDate))
        {
            selectedDate = parsedDate.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            selectedDate = today;
        }

        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date
        };

        await LoadRequiredTags();
    }

    private DateTime GetCurrentDateTimeInDisplayZone()
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, displayTimeZone);

    private DateTime GetTodayInDisplayZone() => GetCurrentDateTimeInDisplayZone().Date;

    private async Task LoadRequiredTags()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            // Load both unfilled required tags and all tags for the modal
            var unfilledTask = ActivityApi.GetRequiredDailyTagsNotFilledForDate(selectedDate.ToString("yyyy-MM-dd"));
            var allTagsTask = SharedDataCache.GetTagsAsync();
            var optionListsTask = SharedDataCache.GetOptionListsAsync();

            await Task.WhenAll(unfilledTask, allTagsTask, optionListsTask);

            unfilledRequiredTags = await unfilledTask;
            allTags = await allTagsTask;
            optionLists = await optionListsTask;

            if (optionLists is not null)
            {
                optionListLookup = optionLists.ToDictionary(list => list.Id);
            }

            existingActivities.Clear();
            if (unfilledRequiredTags?.Count > 0)
            {
                // Only fetch existing activities for multi-day granularities (weekly/monthly/yearly).
                // Daily/Exact/Hourly tags were confirmed unfilled by the server so their fetches would always return empty.
                var tagsNeedingFetch = unfilledRequiredTags
                    .Where(t => t.TimeGranularity is Domain.Enums.TimeGranularity.Weekly
                                                  or Domain.Enums.TimeGranularity.Monthly
                                                  or Domain.Enums.TimeGranularity.Yearly)
                    .ToList();

                if (tagsNeedingFetch.Count > 0)
                {
                    var activityFetchTasks = tagsNeedingFetch.Select(t =>
                    {
                        var (fetchStart, fetchEnd) = GetGranularityDateRange(t, selectedDate);
                        return ActivityApi.GetActivities(tagId: t.Id, startDate: fetchStart, endDate: fetchEnd, pageSize: 1);
                    });
                    var activityResults = await Task.WhenAll(activityFetchTasks);
                    for (var i = 0; i < tagsNeedingFetch.Count; i++)
                    {
                        existingActivities[tagsNeedingFetch[i].Id] = activityResults[i]?.Items?.FirstOrDefault();
                    }
                }
            }

            // Update new activity with the selected date
            var today = GetTodayInDisplayZone();
            newActivity.DateStarted = selectedDate.Date == today ? GetCurrentDateTimeInDisplayZone() : selectedDate.Date;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Authentication expired (e.g., password changed)
            // DynamicAuthHandler will trigger automatic logout and redirect
            errorMessage = "Your session has expired. Redirecting to login...";
            unfilledRequiredTags = new List<TagResponse>();
            allTags = new List<TagResponse>();
            optionLists = new List<TagOptionListResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading reminders: {ex.Message}";
            unfilledRequiredTags = new List<TagResponse>();
            allTags = new List<TagResponse>();
            optionLists = new List<TagOptionListResponse>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshReminders()
    {
        await LoadRequiredTags();
    }

    private void NavigateToAddActivity(int tagId)
    {
        Navigation.NavigateTo($"/calendar?tagId={tagId}&date={selectedDate:yyyy-MM-dd}");
    }

    private void PrepareModalForTag(int tagId)
    {
        preselectedTagId = tagId;
        var today = GetTodayInDisplayZone();
        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date,
            PrimaryTagId = tagId
        };
        showAddActivityModal = true;
        shouldShowModalAfterRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldShowModalAfterRender && showAddActivityModal)
        {
            shouldShowModalAfterRender = false;
            try
            {
                await Task.Delay(50); // Small delay to ensure DOM is ready
                await JSRuntime.InvokeVoidAsync("showModal", "addActivityModal");
            }
            catch (Exception ex)
            {
                // Log but don't throw - modal might still work via Blazor rendering
                Console.WriteLine($"Error showing modal via JS: {ex.Message}");
            }
        }
    }

    private async Task CloseAddActivityModal()
    {
        // Hide modal via JavaScript first
        try
        {
            await JSRuntime.InvokeVoidAsync("hideModal", "addActivityModal");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error hiding modal via JS: {ex.Message}");
        }

        showAddActivityModal = false;
        preselectedTagId = null;
        errorMessage = null;
    }

    private async Task OnActivityCreated(ActivityRequest activity)
    {
        showAddActivityModal = false;

        if (activity?.PrimaryTagId.HasValue == true)
        {
            SystemNotificationService.MarkTagFulfilled(activity.PrimaryTagId.Value, DateOnly.FromDateTime(selectedDate));
            _dismissingTagIds.Add(activity.PrimaryTagId.Value);
            StateHasChanged();
            await Task.Delay(300);
            unfilledRequiredTags = unfilledRequiredTags?.Where(t => t.Id != activity.PrimaryTagId.Value).ToList();
            _dismissingTagIds.Remove(activity.PrimaryTagId.Value);
        }

        // Reset the form but keep the date
        var today = GetTodayInDisplayZone();
        newActivity = new ActivityRequest
        {
            DateStarted = selectedDate.Date == today
                ? GetCurrentDateTimeInDisplayZone()
                : selectedDate.Date
        };
        preselectedTagId = null;
        errorMessage = null;
    }

    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            selectedDate = newDate.Value;
            await LoadRequiredTags();
        }
    }

    private async Task OnError(string error)
    {
        errorMessage = error;
        await Task.CompletedTask;
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadRequiredTags();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        await LoadRequiredTags();
    }

    private string FormatDate(DateTime date)
    {
        var pattern = userPreferences?.Preferences.LongDatePattern ?? displayCulture.DateTimeFormat.LongDatePattern;
        return date.ToString(pattern, displayCulture);
    }

    private bool HasDefaultValue(TagResponse tag)
        => !string.IsNullOrWhiteSpace(ResolveDefaultValue(tag));

    private bool IsQuickAddDisabled(TagResponse tag)
        => !HasDefaultValue(tag) || quickAddInProgress.Contains(tag.Id);

    private bool IsQuickAddInProgress(int tagId)
        => quickAddInProgress.Contains(tagId);

    private string GetQuickAddButtonClasses(TagResponse tag)
    {
        var baseClasses = "px-3 py-2 rounded-md transition-colors flex items-center justify-center gap-1";

        if (IsQuickAddDisabled(tag))
        {
            return $"{baseClasses} bg-gray-300 dark:bg-gray-600 text-gray-500 dark:text-gray-400 cursor-not-allowed opacity-50";
        }

        return $"{baseClasses} bg-emerald-600 text-white hover:bg-emerald-700 active:bg-emerald-800";
    }

    private string? GetDefaultValueLabel(TagResponse tag)
    {
        var value = ResolveDefaultValue(tag);
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (tag.OptionListId is int listId && optionListLookup != null && optionListLookup.TryGetValue(listId, out var list))
        {
            var option = list.Options.FirstOrDefault(o => string.Equals(o.Value, value, StringComparison.OrdinalIgnoreCase));
            if (option is not null)
            {
                return option.DisplayName ?? option.Value;
            }
        }

        return value;
    }

    private string? ResolveDefaultValue(TagResponse tag)
    {
        if (!string.IsNullOrWhiteSpace(tag.DefaultValue))
        {
            return tag.DefaultValue;
        }

        return null;
    }

    private async Task QuickAddBoolAsync(TagResponse tag, bool value)
    {
        _boolPickerValues[tag.Id] = value;

        if (!quickAddInProgress.Add(tag.Id))
        {
            return;
        }

        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var existing = GetExistingActivity(tag.Id);
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = value ? "true" : "false",
                DateStarted = startDate
            };

            if (existing != null)
            {
                await ActivityApi.UpdateCalendarItem(existing.Id, request);
            }
            else
            {
                await ActivityApi.CreateCalendarItem(request);
            }

            StateHasChanged();
            await Task.Delay(300);
            _boolPickerValues.Remove(tag.Id);
            _dismissingTagIds.Add(tag.Id);
            StateHasChanged();
            await Task.Delay(300);
            unfilledRequiredTags = unfilledRequiredTags?.Where(t => t.Id != tag.Id).ToList();
            _dismissingTagIds.Remove(tag.Id);
            SystemNotificationService.MarkTagFulfilled(tag.Id, DateOnly.FromDateTime(selectedDate));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            _boolPickerValues.Remove(tag.Id);
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _boolPickerValues.Remove(tag.Id);
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details) ? details : "The activity could not be created.";
        }
        catch (Exception ex)
        {
            _boolPickerValues.Remove(tag.Id);
            errorMessage = $"Error adding activity: {ex.Message}";
        }
        finally
        {
            quickAddInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }

    private async Task QuickAddDefaultAsync(TagResponse tag)
    {
        var defaultValue = ResolveDefaultValue(tag);
        if (string.IsNullOrWhiteSpace(defaultValue))
        {
            errorMessage = "No default value is configured for this tag.";
            return;
        }

        if (!quickAddInProgress.Add(tag.Id))
        {
            return;
        }

        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = defaultValue,
                DateStarted = startDate
            };

            await ActivityApi.CreateCalendarItem(request);
            SystemNotificationService.MarkTagFulfilled(tag.Id, DateOnly.FromDateTime(selectedDate));
            _dismissingTagIds.Add(tag.Id);
            StateHasChanged();
            await Task.Delay(300);
            unfilledRequiredTags = unfilledRequiredTags?.Where(t => t.Id != tag.Id).ToList();
            _dismissingTagIds.Remove(tag.Id);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details)
                ? details
                : "The activity could not be created with the default value.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding default activity: {ex.Message}";
        }
        finally
        {
            quickAddInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }

    private int GetStarPickerValue(int tagId) =>
        _inlinePickerValues.TryGetValue(tagId, out var v) ? v : 0;

    private int? GetScorePickerValue(int tagId) =>
        _inlinePickerValues.TryGetValue(tagId, out var v) ? v : (int?)null;

    private bool? GetBoolPickerValue(int tagId)
    {
        if (_boolPickerValues.TryGetValue(tagId, out var v))
        {
            return v;
        }

        var existing = GetExistingActivity(tagId);

        return existing != null ? BooleanDisplay.Parse(existing.PrimaryTagValue ?? existing.Description) : null;
    }

    private ActivityResponse? GetExistingActivity(int tagId)
        => existingActivities.TryGetValue(tagId, out var act) ? act : null;

    private static (DateTime start, DateTime end) GetGranularityDateRange(TagResponse tag, DateTime date)
    {
        var dayStart = date.Date;

        return tag.TimeGranularity switch
        {
            Domain.Enums.TimeGranularity.Weekly =>
                (GetStartOfWeek(dayStart), GetStartOfWeek(dayStart).AddDays(7).AddTicks(-1)),
            Domain.Enums.TimeGranularity.Monthly =>
                (new DateTime(dayStart.Year, dayStart.Month, 1), new DateTime(dayStart.Year, dayStart.Month, 1).AddMonths(1).AddTicks(-1)),
            Domain.Enums.TimeGranularity.Yearly =>
                (new DateTime(dayStart.Year, 1, 1), new DateTime(dayStart.Year + 1, 1, 1).AddTicks(-1)),
            _ => (dayStart, dayStart.AddDays(1).AddTicks(-1))
        };
    }

    private static DateTime GetStartOfWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;

        return date.AddDays(-diff);
    }

    private async Task QuickAddWithValueAsync(TagResponse tag, int value)
    {
        _inlinePickerValues[tag.Id] = value;

        if (!quickAddInProgress.Add(tag.Id))
        {
            return;
        }

        var today = GetTodayInDisplayZone();
        var startDate = selectedDate.Date == today
            ? GetCurrentDateTimeInDisplayZone()
            : selectedDate.Date;

        try
        {
            var existing = GetExistingActivity(tag.Id);
            var request = new ActivityRequest
            {
                PrimaryTagId = tag.Id,
                Description = value.ToString(),
                DateStarted = startDate
            };

            if (existing != null)
            {
                await ActivityApi.UpdateCalendarItem(existing.Id, request);
            }
            else
            {
                await ActivityApi.CreateCalendarItem(request);
            }

            StateHasChanged();
            await Task.Delay(300);
            _inlinePickerValues.Remove(tag.Id);
            _dismissingTagIds.Add(tag.Id);
            StateHasChanged();
            await Task.Delay(300);
            unfilledRequiredTags = unfilledRequiredTags?.Where(t => t.Id != tag.Id).ToList();
            _dismissingTagIds.Remove(tag.Id);
            SystemNotificationService.MarkTagFulfilled(tag.Id, DateOnly.FromDateTime(selectedDate));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            _inlinePickerValues.Remove(tag.Id);
            errorMessage = "Authentication failed. Please refresh and try again.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _inlinePickerValues.Remove(tag.Id);
            var details = await ex.GetContentAsAsync<string>();
            errorMessage = !string.IsNullOrWhiteSpace(details)
                ? details
                : "The activity could not be created.";
        }
        catch (Exception ex)
        {
            _inlinePickerValues.Remove(tag.Id);
            errorMessage = $"Error adding activity: {ex.Message}";
        }
        finally
        {
            quickAddInProgress.Remove(tag.Id);
            StateHasChanged();
        }
    }
}
