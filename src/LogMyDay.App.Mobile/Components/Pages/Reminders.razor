@page "/reminders"
@using System.Globalization
@using LogMyDay.Domain.Constants
@using LogMyDay.Domain.Enums
@using LogMyDay.Shared.DTOs
@using LogMyDay.Shared.Interfaces
@using LogMyDay.Shared.Preferences
@using Refit
@implements IDisposable
@inject IReminderApi ReminderApi
@inject IActivityApi ActivityApi
@inject ILogger<Reminders> Logger
@inject IPageTitleService PageTitleService
@inject IUserPreferencesService UserPreferencesService
@inject ReminderNotificationScheduler ReminderScheduler
@inject LogMyDay.App.Mobile.Services.Diagnostics.IDiagnosticStore Diag

@{
    var effectiveDate = _selectedDate.Date;
    var activeItems = _reminders?
        .Where(i => !i.IsDone && (!i.IsSkipped || i.IsTagDayLocked)
            && !IsOutsideMonitoringWindow(i, effectiveDate))
        .OrderBy(i => i.NotifyAt ?? TimeOnly.MaxValue)
        .ThenBy(i => i.DisplayOrder)
        .ThenBy(i => i.DateCreated)
        .ToList()
        ?? new List<ReminderResponse>();
    var doneItems = _reminders?.Where(i => i.IsDone && !IsOutsideMonitoringWindow(i, effectiveDate)).ToList() ?? new List<ReminderResponse>();
}

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Reminders" ShowReload="true" OnReload="LoadDataAsync" />
    <RemindersSectionNav />

    <div class="px-6 py-4">

        <div class="flex items-center justify-center gap-2 mb-6">
            <button class="btn-secondary" @onclick="PreviousDay" title="Previous Day">&lt;</button>
            <CultureAwareDatePicker Value="@_selectedDate" ValueChanged="@OnDatePickerValueChanged" CssClass="inline-block" Placeholder="Select date" />
            <button class="btn-secondary" @onclick="NextDay" title="Next Day">&gt;</button>
        </div>

        @if (_loadError != null)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                @_loadError
            </div>
        }
        else if (_reminders == null)
        {
            <div class="flex items-center justify-center gap-3 py-16 text-gray-500 dark:text-gray-400">
                <div class="inline-block animate-spin text-2xl text-primary-600">⟳</div>
                <span class="text-sm">Loading reminders…</span>
            </div>
        }
        else
        {
            <div>
                <div class="flex items-center justify-between py-3">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="text-sm text-gray-500 dark:text-gray-400">@activeItems.Count @(activeItems.Count == 1 ? "task" : "tasks")</span>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        @if (doneItems.Any())
                        {
                            <button type="button"
                                    class="text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 px-1 transition-colors"
                                    @onclick="() => _showDone = !_showDone">
                                @(_showDone ? "Hide" : "Show") done (@doneItems.Count)
                            </button>
                        }
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded-lg bg-primary-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-primary-700 transition-colors disabled:opacity-50"
                                @onclick="OpenAddItemModal"
                                disabled="@_isBusy">
                            <i class="bi bi-plus-lg"></i>
                            Add
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @if (!activeItems.Any())
                    {
                        <p class="col-span-full py-8 text-center text-sm text-gray-400 dark:text-gray-500">No pending reminders.</p>
                    }
                    else
                    {
                        @foreach (var item in activeItems)
                        {
                            var isHighlighted = _highlightedItemId == item.Id;
                            var isCompleting = _completingItemId == item.Id;
                            <div @key="item.Id" class="rounded-xl border border-gray-200 dark:border-gray-700 @(isHighlighted ? "ring-2 ring-blue-500" : "") bg-gray-50 dark:bg-gray-700/50 p-4 flex items-center gap-3">
                                <button type="button"
                                        class="h-9 w-9 shrink-0 rounded-lg border-2 flex items-center justify-center transition-colors disabled:opacity-50 @(isCompleting ? "border-emerald-500 bg-emerald-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-transparent active:border-emerald-500 active:bg-emerald-500 active:text-white")"
                                        title="Complete"
                                        @onclick="() => CompleteItemAsync(item)"
                                        disabled="@_isBusy">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="font-semibold text-sm text-gray-900 dark:text-gray-100">@item.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="text-xs text-gray-500 dark:text-gray-400">@item.Notes</span>
                                        }
                                        @if (item.IsTagDayLocked)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/20 dark:text-amber-300"><i class="bi bi-lock-fill me-1"></i>Tag locked</span>
                                        }
                                    </div>
                                    @{
                                        // DEBUG: notification fire-time readout (matches web). Shows today's NotifyAt while
                                        // still upcoming; blank once passed. Active grid only, so no completed chip appears.
                                        var debugFireTime = NextFireTimeToday(item);
                                    }
                                    @if (item.RecurrenceType != RecurrenceType.None || debugFireTime != null)
                                    {
                                        <div class="mt-1 flex items-center gap-2">
                                            @if (item.RecurrenceType != RecurrenceType.None)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-500/20 dark:text-blue-300"><i class="bi bi-arrow-repeat me-1"></i>@item.RecurrenceType</span>
                                            }
                                            @if (debugFireTime != null)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300" title="Scheduled notification time (debug)"><i class="bi bi-clock me-1"></i>@debugFireTime.Value.ToString("HH:mm")</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="flex items-center gap-3 shrink-0">
                                    @if (item.RecurrenceType != RecurrenceType.None)
                                    {
                                        <button type="button"
                                                class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-amber-500 dark:hover:text-amber-400 transition-colors disabled:opacity-50"
                                                title="Skip"
                                                @onclick="() => SkipItemAsync(item)"
                                                disabled="@_isBusy">
                                            <i class="bi bi-skip-forward text-lg"></i>
                                            <span class="text-xs uppercase tracking-wide">Skip</span>
                                        </button>
                                    }
                                    <button type="button"
                                            class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200 transition-colors disabled:opacity-50"
                                            title="Edit"
                                            @onclick="() => OpenEditItemModal(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-pencil text-lg"></i>
                                        <span class="text-xs uppercase tracking-wide">Edit</span>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (_showDone && doneItems.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
                        @foreach (var item in doneItems.OrderByDescending(i => i.DoneAt))
                        {
                            var isHighlightedDone = _highlightedItemId == item.Id;
                            <div @key="item.Id" class="rounded-xl border border-gray-200 dark:border-gray-700 @(isHighlightedDone ? "ring-2 ring-blue-500" : "") bg-gray-50 dark:bg-gray-700/50 p-4 flex items-center gap-3 opacity-60">
                                    <button type="button"
                                            class="h-9 w-9 shrink-0 rounded-lg border-2 border-emerald-500 bg-emerald-500 flex items-center justify-center text-white hover:border-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-400 transition-colors disabled:opacity-50"
                                            title="Re-open"
                                            @onclick="() => ReopenItemAsync(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <div class="flex-1 min-w-0">
                                        <span class="font-semibold text-sm text-gray-500 dark:text-gray-400 line-through">@item.Title</span>
                                    </div>
                                    <button type="button"
                                            class="flex flex-col items-center gap-0.5 text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200 transition-colors disabled:opacity-50"
                                            title="Edit"
                                            @onclick="() => OpenEditItemModal(item)"
                                            disabled="@_isBusy">
                                        <i class="bi bi-pencil text-lg"></i>
                                        <span class="text-xs uppercase tracking-wide">Edit</span>
                                    </button>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_itemError))
                {
                    <div class="mt-3 flex items-center gap-2 rounded-lg border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/20 px-3 py-2 text-xs text-red-700 dark:text-red-200">
                        <span class="flex-1">@_itemError</span>
                        <button type="button" class="shrink-0 font-medium underline hover:no-underline" @onclick="LoadDataAsync">Reload</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ── Quick-Complete Modal ── *@
@if (_showQuickModal && _quickItem != null)
{
    <div class="fixed inset-0 z-[70] flex items-end justify-center bg-gray-900/70 p-4" @onclick="() => { if (!_isQuickBusy) { _showQuickModal = false; } }">
        <div class="w-full max-w-sm overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-2xl" @onclick:stopPropagation="true">
            <div class="px-6 pt-5 pb-1 text-center">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Complete Reminder</p>
                <h3 class="mt-1 text-base font-semibold text-gray-900 dark:text-gray-100">@_quickItem.Title</h3>
            </div>
            <div class="px-6 py-4 space-y-3">
                @if (_quickInputTypeId == InputTypeIds.Boolean)
                {
                    <div class="flex gap-3">
                        <button type="button"
                                class="flex-1 min-h-[52px] rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_quickBoolValue == true ? "border-green-500 bg-green-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200")"
                                @onclick="() => _quickBoolValue = true">
                            <i class="bi bi-check-lg me-1"></i>Yes
                        </button>
                        <button type="button"
                                class="flex-1 min-h-[52px] rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_quickBoolValue == false ? "border-red-500 bg-red-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200")"
                                @onclick="() => _quickBoolValue = false">
                            <i class="bi bi-x-lg me-1"></i>No
                        </button>
                    </div>
                }
                else if (_quickInputTypeId == InputTypeIds.String)
                {
                    <textarea class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"
                              rows="3" placeholder="Enter value…"
                              @bind="_quickStringValue"></textarea>
                }
                else if (_quickInputTypeId == InputTypeIds.Integer || _quickInputTypeId == InputTypeIds.Decimal || _quickInputTypeId == InputTypeIds.Percentage)
                {
                    @if (!_quickAllowUnfilled)
                    {
                        <input type="number" step="any"
                               class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                               placeholder="Value"
                               @bind="_quickDecimalValue" />
                    }
                    @if (_quickItem?.AllowUnfilled == true)
                    {
                        <label class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 cursor-pointer select-none">
                            <input type="checkbox" class="rounded" @bind="_quickAllowUnfilled" />
                            Leave unfilled
                        </label>
                    }
                }
                else if (_quickInputTypeId == InputTypeIds.StarRating)
                {
                    <StarRating Value="@(_quickIntValue ?? 0)" ValueChanged="v => _quickIntValue = v" MaxStars="5" />
                }
                else if (_quickInputTypeId == InputTypeIds.StarRating10)
                {
                    <StarRating Value="@(_quickIntValue ?? 0)" ValueChanged="v => _quickIntValue = v" MaxStars="10" />
                }
                else if (_quickInputTypeId == InputTypeIds.Score)
                {
                    <ScoreRating Value="@_quickIntValue" ValueChanged="v => _quickIntValue = v" MaxScore="5" />
                }
                else if (_quickInputTypeId == InputTypeIds.Score10)
                {
                    <ScoreRating Value="@_quickIntValue" ValueChanged="v => _quickIntValue = v" MaxScore="10" />
                }
            </div>
            @if (!string.IsNullOrEmpty(_quickError))
            {
                <div class="mx-6 mb-3 rounded-lg border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/20 px-4 py-2 text-sm text-red-700 dark:text-red-200">
                    @_quickError
                </div>
            }
            <div class="flex gap-3 border-t border-gray-200 dark:border-gray-700 px-6 py-4" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
                <button type="button"
                        class="flex-1 min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="() => { _showQuickModal = false; _quickItem = null; }"
                        disabled="@_isQuickBusy">
                    Cancel
                </button>
                <button type="button"
                        class="flex-1 min-h-[48px] rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SaveQuickAsync"
                        disabled="@_isQuickBusy">
                    @if (_isQuickBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    Save
                </button>
            </div>
        </div>
    </div>
}

@* ── Item Create/Edit Modal ── *@
@if (_showItemModal)
{
    <div class="fixed inset-0 z-[60] flex flex-col bg-white dark:bg-gray-900">
        <div class="flex shrink-0 items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">@(_isEditingItem ? "Edit reminder" : "New reminder")</h3>
            <button type="button" class="-mr-2 p-3 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-gray-300" @onclick="CloseItemModal" disabled="@_isBusy">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <EditForm EditContext="_itemEditContext">
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Title <span class="text-red-500">*</span></label>
                        <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                   @bind-Value="_itemForm.Title"
                                   maxlength="500"
                                   placeholder="What needs to be done?" />
                        <ValidationMessage For="@(() => _itemForm.Title)" class="mt-1 text-xs text-red-600 dark:text-red-400" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Select the tag</label>
                        <select class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                @bind="_itemForm.CompletionTagId">
                            <option value="">— None —</option>
                            @if (_allTags != null)
                            {
                                @foreach (var tag in _allTags)
                                {
                                    <option value="@tag.Id">@tag.Title</option>
                                }
                            }
                        </select>
                        @if (_itemForm.CompletionTagId.HasValue && _allTags != null)
                        {
                            var selTag = _allTags.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value);
                            @if (selTag != null && !selTag.IsRepeatable && _itemForm.AutoLogMode != AutoLogMode.Add)
                            {
                                <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">
                                    This tag is not repeatable — completing multiple items on the same day will replace the existing activity.
                                </p>
                            }
                        }
                    </div>
                    @if (_itemForm.CompletionTagId.HasValue && _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value) is { } _editTag && _editTag.InputTypeId.HasValue)
                    {
                        var _editTagInputTypeId = _editTag.InputTypeId;
                        <div>
                            @if (_editTagInputTypeId == InputTypeIds.Boolean)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <div class="flex gap-3">
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == true ? "border-green-500 bg-green-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-green-50 dark:hover:bg-green-500/10")"
                                            @onclick="() => _booleanBoolValue = _booleanBoolValue == true ? null : true">
                                        <i class="bi bi-check-lg me-1"></i>Yes
                                    </button>
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == false ? "border-red-500 bg-red-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-red-50 dark:hover:bg-red-500/10")"
                                            @onclick="() => { _booleanBoolValue = _booleanBoolValue == false ? (bool?)null : false; }">
                                        <i class="bi bi-x-lg me-1"></i>No
                                    </button>
                                    <button type="button"
                                            class="flex-1 rounded-xl border px-4 py-3 text-sm font-semibold transition-colors @(_booleanBoolValue == null ? "border-primary-500 bg-primary-500 text-white" : "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700")"
                                            @onclick="() => _booleanBoolValue = null">
                                        Not specified
                                    </button>
                                </div>
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Pre-selected answer when completing this reminder.</p>
                            }
                            else if (_editTagInputTypeId == InputTypeIds.Integer || _editTagInputTypeId == InputTypeIds.Decimal || _editTagInputTypeId == InputTypeIds.Percentage)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Pre-filled number (optional)" />
                            }
                            else if (_editTagInputTypeId == InputTypeIds.String)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <InputText class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-base text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           @bind-Value="_itemForm.Notes"
                                           placeholder="Pre-filled text (optional)" />
                            }
                            else if (_editTagInputTypeId == InputTypeIds.StarRating)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <StarRating Value="@(_editIntValue ?? 0)" ValueChanged="v => _editIntValue = v" MaxStars="5" />
                            }
                            else if (_editTagInputTypeId == InputTypeIds.StarRating10)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <StarRating Value="@(_editIntValue ?? 0)" ValueChanged="v => _editIntValue = v" MaxStars="10" />
                            }
                            else if (_editTagInputTypeId == InputTypeIds.Score)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <ScoreRating Value="@_editIntValue" ValueChanged="v => _editIntValue = v" MaxScore="5" />
                            }
                            else if (_editTagInputTypeId == InputTypeIds.Score10)
                            {
                                <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Default value</label>
                                <ScoreRating Value="@_editIntValue" ValueChanged="v => _editIntValue = v" MaxScore="10" />
                            }
                        </div>
                    }
                    @if (_itemForm.CompletionTagId.HasValue)
                    {
                        <div>
                            <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Auto-log mode</label>
                            <InputSelect @bind-Value="_itemForm.AutoLogMode" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                <option value="@AutoLogMode.Add">Add (accumulate)</option>
                                <option value="@AutoLogMode.ResetIfExists">Replace if exists</option>
                            </InputSelect>
                        </div>
                    }
                    @if (_itemForm.CompletionTagId.HasValue && _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId.Value) is { InputTypeId: InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage })
                    {
                        <div>
                            <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer select-none">
                                <InputCheckbox @bind-Value="_itemForm.AllowUnfilled" class="rounded" />
                                Allow leaving value unfilled at completion
                            </label>
                        </div>
                    }
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Remind me at</label>
                        <input type="time"
                               class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
                               value="@(_itemForm.NotifyAt?.ToString("HH:mm") ?? "")"
                               @onchange="e => _itemForm.NotifyAt = ParseTimeOnly(e.Value?.ToString())" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Recurrence</label>
                        <InputSelect @bind-Value="_itemForm.RecurrenceType" class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <option value="@RecurrenceType.Daily">Daily</option>
                            <option value="@RecurrenceType.Weekly">Weekly</option>
                        </InputSelect>
                    </div>
                    @if (_itemForm.RecurrenceType != RecurrenceType.None && _itemForm.CompletionTagId.HasValue)
                    {
                        <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-4 space-y-3">
                            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Activity monitoring window</p>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="mb-1 block text-xs text-gray-500 dark:text-gray-400">From <span class="text-rose-500">*</span></label>
                                    <input type="date"
                                           class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           value="@(_itemForm.MonitorFromDate?.ToString("yyyy-MM-dd") ?? "")"
                                           @onchange="e => _itemForm.MonitorFromDate = ParseDateOnly(e.Value?.ToString())" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-xs text-gray-500 dark:text-gray-400">To <span class="font-normal text-gray-400">(optional)</span></label>
                                    <input type="date"
                                           class="w-full rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                                           value="@(_itemForm.MonitorToDate?.ToString("yyyy-MM-dd") ?? "")"
                                           @onchange="e => _itemForm.MonitorToDate = ParseDateOnly(e.Value?.ToString())" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </EditForm>
        </div>
        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4" style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));">
            @if (!string.IsNullOrEmpty(_itemModalError))
            {
                <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/20 dark:text-red-300">
                    @_itemModalError
                </div>
            }
            <div class="flex items-center justify-end gap-3">
                @if (_isEditingItem)
                {
                    <button type="button"
                            class="min-h-[48px] rounded-xl border border-red-200 dark:border-red-500/40 bg-white dark:bg-gray-800 px-5 py-3 text-sm font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 disabled:opacity-50"
                            @onclick="DeleteEditingItemAsync" disabled="@_isBusy">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                }
                <button type="button"
                        class="min-h-[48px] rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-200"
                        @onclick="CloseItemModal" disabled="@_isBusy">
                    Cancel
                </button>
                <button type="button"
                        class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-primary-600 px-6 py-3 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50"
                        @onclick="SubmitItemFormAsync" disabled="@_isBusy">
                    @if (_isBusy) { <div class="inline-block animate-spin text-sm">⟳</div> }
                    @(_isEditingItem ? "Save changes" : "Add reminder")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReminderResponse>? _reminders;
    private IList<TagResponse>? _allTags;
    private DateTime _selectedDate = DateTime.Today;
    private string? _loadError;
    private string? _itemError;
    private bool _isBusy;
    private bool _showDone;
    private int? _completingItemId;

    private bool _showItemModal;
    private bool _isEditingItem;
    private int _editingItemId;
    private ReminderRequest _itemForm = new() { Title = string.Empty };
    private EditContext _itemEditContext = default!;
    private string? _itemModalError;
    private bool? _booleanBoolValue;
    private int? _editIntValue;

    private bool _showQuickModal;
    private ReminderResponse? _quickItem;
    private int? _quickInputTypeId;
    private bool? _quickBoolValue;
    private string? _quickStringValue;
    private decimal? _quickDecimalValue;
    private int? _quickIntValue;
    private bool _quickAllowUnfilled;
    private bool _isQuickBusy;
    private string? _quickError;

    private System.Threading.Timer? _refreshTimer;
    private int _loadGeneration;

    [SupplyParameterFromQuery]
    public int? TodoItemId { get; set; }
    [SupplyParameterFromQuery]
    public bool AutoComplete { get; set; }
    private int? _highlightedItemId;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reminders");
        _itemEditContext = new EditContext(_itemForm);
        await LoadDataAsync();

        if (AutoComplete && TodoItemId.HasValue)
        {
            _highlightedItemId = TodoItemId;
            await AutoCompleteItemAsync(TodoItemId.Value);
        }

        _refreshTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () =>
            {
                if (_isBusy || _showItemModal || _showQuickModal)
                {
                    return;
                }

                await LoadDataAsync();
                StateHasChanged();
            }),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    protected override async Task OnParametersSetAsync()
    {
        _highlightedItemId = TodoItemId;

        if (AutoComplete && _highlightedItemId.HasValue && _reminders != null)
        {
            await AutoCompleteItemAsync(_highlightedItemId.Value);
        }
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private async Task LoadDataAsync()
    {
        _loadError = null;
        Exception? lastError = null;

        var myGeneration = ++_loadGeneration;

        for (var attempt = 0; attempt < 2; attempt++)
        {
            if (attempt > 0)
            {
                await Task.Delay(1500);
            }

            try
            {
                var dateParam = _selectedDate.ToString("yyyy-MM-dd");
                var all = await ReminderApi.GetReminders(dateParam);

                if (myGeneration != _loadGeneration)
                {
                    return;
                }

                _reminders = all.ToList();
                if (_allTags == null)
                {
                    _allTags = await ActivityApi.GetTags();
                }

                if (_selectedDate.Date == DateTime.Today)
                {
                    ReminderScheduler.ScheduleAll(_reminders, "page-load");

                    var liveIds = all.Select(i => i.Id).ToHashSet();
                    ReminderScheduler.SweepGhostAlarms(liveIds);

                    // Flush any locally-recorded diag (incl. alarms fired / re-armed while the app
                    // was closed) to the server now that we have an authenticated session.
                    _ = Diag.FlushAsync();
                }

                return;
            }
            catch (ApiException ex)
            {
                Logger.LogWarning(ex, "Failed to load reminders");
                if (_reminders == null)
                {
                    _loadError = "Failed to load reminders. Tap reload to try again.";
                }

                return;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load reminders (attempt {Attempt})", attempt + 1);
                lastError = ex;
            }
        }

        if (lastError != null && _reminders == null)
        {
            _loadError = "Failed to load reminders. Tap reload to try again.";
        }
    }

    private async Task PreviousDay() { _selectedDate = _selectedDate.AddDays(-1); await LoadDataAsync(); }
    private async Task NextDay()     { _selectedDate = _selectedDate.AddDays(1);  await LoadDataAsync(); }
    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue) { _selectedDate = newDate.Value; await LoadDataAsync(); }
    }

    private static bool IsOutsideMonitoringWindow(ReminderResponse item, DateTime effectiveDate)
    {
        if (item.MonitorFromDate.HasValue && effectiveDate.Date < item.MonitorFromDate.Value.ToDateTime(TimeOnly.MinValue).Date) return true;
        if (item.MonitorToDate.HasValue   && effectiveDate.Date > item.MonitorToDate.Value.ToDateTime(TimeOnly.MinValue).Date)   return true;

        return false;
    }

    private async Task CompleteItemAsync(ReminderResponse item)
    {
        _completingItemId = item.Id;
        try
        {
        if (item.CompletionTagId.HasValue)
        {
            var completionTag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
            var effectiveInputTypeId = item.CompletionTagInputTypeId ?? completionTag?.InputTypeId;

            if (IsQuickCompleteInputType(effectiveInputTypeId))
            {
                if (HasValidPrefilledValue(effectiveInputTypeId, completionTag?.DefaultValue, item.Notes))
                {
                    _isBusy = true;
                    try
                    {
                        var updated = await ReminderApi.CompleteReminder(item.Id, new ReminderCompleteRequest { DoneAt = EffectiveDoneAt() });
                        ReminderScheduler.CancelItem(item.Id);
                        UpdateItem(updated);
                    }
                    catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
                    {
                        Logger.LogWarning(ex, "Reminder {ItemId} not found when completing", item.Id);
                        _itemError = "Item no longer exists. Reload to refresh.";
                    }
                    catch (ApiException ex)
                    {
                        Logger.LogWarning(ex, "Failed to complete reminder {ItemId}", item.Id);
                        _itemError = SurfaceErrorMessage(ex, "Failed to update. Please try again.");
                    }
                    finally
                    {
                        _isBusy = false;
                    }

                    await LoadDataAsync();
                    return;
                }

                OpenQuickCompleteModal(item, effectiveInputTypeId);
                return;
            }

            OpenEditItemModal(item);
            return;
        }

        _isBusy = true;
        try
        {
            var updated = await ReminderApi.CompleteReminder(item.Id, new ReminderCompleteRequest { DoneAt = EffectiveDoneAt() });
            ReminderScheduler.CancelItem(item.Id);
            UpdateItem(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Reminder {ItemId} not found when completing", item.Id);
            _itemError = "Item no longer exists. Reload to refresh.";
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete reminder {ItemId}", item.Id);
            _itemError = SurfaceErrorMessage(ex, "Failed to update. Please try again.");
        }
        finally
        {
            _isBusy = false;
        }

        await LoadDataAsync();
        }
        finally
        {
            _completingItemId = null;
        }
    }

    private async Task ReopenItemAsync(ReminderResponse item)
    {
        _isBusy = true;
        try
        {
            var updated = await ReminderApi.ReopenReminder(item.Id);
            UpdateItem(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _itemError = "Item no longer exists. Reload to refresh.";
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to reopen reminder {ItemId}", item.Id);
            _itemError = "Failed to update. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }

        await LoadDataAsync();
    }

    private async Task SkipItemAsync(ReminderResponse item)
    {
        _isBusy = true;
        try
        {
            var updated = await ReminderApi.SkipReminder(item.Id, _selectedDate.ToString("yyyy-MM-dd"));
            UpdateItem(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _itemError = "Item no longer exists. Reload to refresh.";
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to skip reminder {ItemId}", item.Id);
            _itemError = "Failed to update. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }

        await LoadDataAsync();
    }

    private void UpdateItem(ReminderResponse updated)
    {
        if (_reminders == null) return;
        for (var i = 0; i < _reminders.Count; i++)
        {
            if (_reminders[i].Id == updated.Id)
            {
                _reminders[i] = updated;
                return;
            }
        }
    }

    private async Task AutoCompleteItemAsync(int reminderId)
    {
        var item = _reminders?.FirstOrDefault(i => i.Id == reminderId && !i.IsDone && !i.IsSkipped);
        if (item == null) return;

        try
        {
            var updated = await ReminderApi.CompleteReminder(item.Id, new ReminderCompleteRequest { DoneAt = DateTime.UtcNow });
            ReminderScheduler.CancelItem(item.Id);
            ReminderScheduler.DismissItem(item.Id);
            UpdateItem(updated);
            _showDone = true;
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to auto-complete reminder {ItemId} from notification", item.Id);
            _itemError = "Failed to mark done. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to auto-complete reminder {ItemId} from notification — network error", item.Id);
            _itemError = "Failed to mark done. Please try again.";
        }

        StateHasChanged();
    }

    private void OpenQuickCompleteModal(ReminderResponse item, int? inputTypeId)
    {
        _quickItem = item;
        _quickInputTypeId = inputTypeId;
        _quickBoolValue = null;
        _quickStringValue = null;
        _quickDecimalValue = null;
        _quickIntValue = null;
        _quickAllowUnfilled = false;
        _quickError = null;

        var tag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
        var defaultValue = tag?.DefaultValue;

        switch (inputTypeId)
        {
            case InputTypeIds.Boolean:
                _quickBoolValue = defaultValue switch { "true" => true, "false" => false, _ => null };
                break;
            case InputTypeIds.String:
                _quickStringValue = defaultValue;
                break;
            case InputTypeIds.Integer:
            case InputTypeIds.Decimal:
            case InputTypeIds.Percentage:
                if (!string.IsNullOrWhiteSpace(item.Notes) &&
                    decimal.TryParse(item.Notes, System.Globalization.NumberStyles.Any, CultureInfo.InvariantCulture, out var d))
                {
                    _quickDecimalValue = d;
                }
                break;
            case InputTypeIds.StarRating:
            case InputTypeIds.StarRating10:
            case InputTypeIds.Score:
            case InputTypeIds.Score10:
                if (!string.IsNullOrWhiteSpace(defaultValue) && int.TryParse(defaultValue, out var iv))
                {
                    _quickIntValue = iv;
                }
                break;
        }

        _showQuickModal = true;
    }

    private async Task SaveQuickAsync()
    {
        if (_quickItem == null) return;

        string? notes;
        switch (_quickInputTypeId)
        {
            case InputTypeIds.Boolean:
                if (!_quickBoolValue.HasValue) { _quickError = "Please select Yes or No."; return; }
                notes = _quickBoolValue.Value ? "true" : "false";
                break;
            case InputTypeIds.String:
                notes = string.IsNullOrWhiteSpace(_quickStringValue) ? null : _quickStringValue.Trim();
                break;
            case InputTypeIds.Integer:
            case InputTypeIds.Decimal:
            case InputTypeIds.Percentage:
                if (_quickAllowUnfilled)
                {
                    notes = null;
                }
                else if (!_quickDecimalValue.HasValue)
                {
                    _quickError = "Please enter a value.";
                    return;
                }
                else
                {
                    notes = _quickDecimalValue.Value.ToString("0.#############################", CultureInfo.InvariantCulture);
                }
                break;
            case InputTypeIds.StarRating:
            case InputTypeIds.StarRating10:
            case InputTypeIds.Score:
            case InputTypeIds.Score10:
                notes = _quickIntValue?.ToString(CultureInfo.InvariantCulture);
                break;
            default:
                notes = null;
                break;
        }

        _isQuickBusy = true;
        _quickError = null;
        try
        {
            await ReminderApi.CompleteReminder(_quickItem.Id, new ReminderCompleteRequest { DoneAt = EffectiveDoneAt(), CompletionValue = notes });
            ReminderScheduler.CancelItem(_quickItem.Id);
            _showQuickModal = false;
            _quickItem = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete reminder via quick modal");
            _quickError = SurfaceErrorMessage(ex, "Failed to save. Please try again.");
        }
        finally
        {
            _isQuickBusy = false;
        }
    }

    private static string SurfaceErrorMessage(ApiException ex, string fallback)
    {
        if ((ex.StatusCode == System.Net.HttpStatusCode.BadRequest
            || ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            && !string.IsNullOrWhiteSpace(ex.Content))
        {
            var content = ex.Content.Trim();

            if (content.StartsWith("{") && content.EndsWith("}"))
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(content);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("code", out var codeEl) &&
                        codeEl.GetString() == "tag-day-locked" &&
                        root.TryGetProperty("date", out var dateEl))
                    {
                        return $"This tag is locked for {dateEl.GetString()}. Unlock it first to add another value.";
                    }

                    if (root.TryGetProperty("message", out var messageEl) &&
                        !string.IsNullOrWhiteSpace(messageEl.GetString()))
                    {
                        return messageEl.GetString()!;
                    }
                }
                catch (System.Text.Json.JsonException)
                {
                }
            }

            return content.Trim('"');
        }

        return fallback;
    }

    private void OpenAddItemModal()
    {
        _isEditingItem = false;
        _editingItemId = 0;
        _itemForm = new ReminderRequest
        {
            Title = string.Empty,
            RecurrenceType = RecurrenceType.Daily,
            MonitorFromDate = DateOnly.FromDateTime(DateTime.Today)
        };
        _itemEditContext = new EditContext(_itemForm);
        _booleanBoolValue = null;
        _editIntValue = null;
        _itemModalError = null;
        _showItemModal = true;
    }

    private void OpenEditItemModal(ReminderResponse item)
    {
        _isEditingItem = true;
        _editingItemId = item.Id;
        _itemForm = new ReminderRequest
        {
            Title = item.Title,
            Notes = item.Notes,
            NotifyAt = item.NotifyAt,
            DisplayOrder = item.DisplayOrder,
            RecurrenceType = item.RecurrenceType,
            AutoLogMode = item.AutoLogMode,
            MonitorFromDate = item.MonitorFromDate,
            MonitorToDate = item.MonitorToDate,
            CompletionTagId = item.CompletionTagId,
            AllowUnfilled = item.AllowUnfilled
        };
        _itemEditContext = new EditContext(_itemForm);

        var tag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
        if (IsBooleanInputType(tag?.InputTypeId))
        {
            _booleanBoolValue = item.Notes switch { "true" => true, "false" => false, _ => null };
            _itemForm.Notes = null;
        }
        else if (tag?.InputTypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10)
        {
            _editIntValue = int.TryParse(item.Notes, out var v) ? v : null;
            _itemForm.Notes = null;
        }
        else
        {
            _booleanBoolValue = null;
            _editIntValue = null;
        }

        _itemModalError = null;
        _showItemModal = true;
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _itemModalError = null;
        _booleanBoolValue = null;
        _editIntValue = null;
    }

    private async Task SubmitItemFormAsync()
    {
        if (!_itemEditContext.Validate()) return;
        await SaveItemAsync();
    }

    private async Task SaveItemAsync()
    {
        _isBusy = true;
        _itemModalError = null;
        try
        {
            var tag = _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId);
            var isBooleanType = IsBooleanInputType(tag?.InputTypeId);
            var isStarScoreType = tag?.InputTypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10;

            if (isBooleanType)
            {
                _itemForm.Notes = _booleanBoolValue.HasValue ? (_booleanBoolValue.Value ? "true" : "false") : null;
            }
            else if (isStarScoreType)
            {
                _itemForm.Notes = _editIntValue?.ToString(CultureInfo.InvariantCulture);
            }

            if (_isEditingItem)
            {
                await ReminderApi.UpdateReminder(_editingItemId, _itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await ReminderApi.CompleteReminder(_editingItemId, new ReminderCompleteRequest { DoneAt = EffectiveDoneAt() });
                }
            }
            else
            {
                var created = await ReminderApi.CreateReminder(_itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await ReminderApi.CompleteReminder(created.Id, new ReminderCompleteRequest { DoneAt = EffectiveDoneAt() });
                }
            }

            _showItemModal = false;
            _booleanBoolValue = null;
            _editIntValue = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save reminder");
            _itemModalError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteEditingItemAsync()
    {
        if (!_isEditingItem) return;
        _isBusy = true;
        try
        {
            await ReminderApi.DeleteReminder(_editingItemId);
            _showItemModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete reminder {ItemId}", _editingItemId);
            _itemModalError = "Failed to delete. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private DateTime EffectiveDoneAt() =>
        DateTime.SpecifyKind(_selectedDate.Date.AddHours(12), DateTimeKind.Local).ToUniversalTime();

    private static bool IsQuickCompleteInputType(int? id) => id is
        InputTypeIds.Boolean or InputTypeIds.String or
        InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage or
        InputTypeIds.StarRating or InputTypeIds.StarRating10 or
        InputTypeIds.Score or InputTypeIds.Score10;

    private static bool HasValidPrefilledValue(int? inputTypeId, string? tagDefaultValue, string? itemNotes = null)
    {
        if (inputTypeId is InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage)
        {
            return decimal.TryParse(itemNotes, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) && n != 0;
        }

        if (string.IsNullOrWhiteSpace(tagDefaultValue)) return false;

        return inputTypeId switch
        {
            InputTypeIds.Boolean => false,
            InputTypeIds.String => true,
            InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10 =>
                int.TryParse(tagDefaultValue, out var v) && v > 0,
            _ => false
        };
    }

    private static bool IsBooleanInputType(int? inputTypeId) => inputTypeId == InputTypeIds.Boolean;

    // DEBUG aid: today's scheduled notification time while it is still upcoming (matches web panel).
    // Mirrors ReminderNotificationScheduler.CalculateFireTime — fire today at NotifyAt; null once passed.
    private static TimeOnly? NextFireTimeToday(ReminderResponse item)
    {
        if (item.NotifyAt is not { } notifyAt)
        {
            return null;
        }

        if (DateTime.Today + notifyAt.ToTimeSpan() <= DateTime.Now)
        {
            return null;
        }

        return notifyAt;
    }

    private static DateOnly? ParseDateOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateOnly.TryParse(value, out var d) ? d : null;

    private static TimeOnly? ParseTimeOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : TimeOnly.TryParse(value, out var t) ? t : null;
}
