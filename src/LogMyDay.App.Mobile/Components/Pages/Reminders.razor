@code {
    // ── State ────────────────────────────────────────────────────────────────
    private List<TodoListResponse>? _lists;
    private IList<TagResponse>? _allTags;
    private DateTime _selectedDate = DateTime.Today;
    private string? _loadError;
    private bool _isBusy;

    private readonly HashSet<int> _showDonePerList = new();
    private readonly Dictionary<int, string?> _itemErrorPerList = new();

    // Item modal
    private bool _showItemModal;
    private bool _isEditingItem;
    private int _editingItemId;
    private int _itemModalListId;
    private TodoItemRequest _itemForm = new() { Title = string.Empty };
    private EditContext _itemEditContext = default!;
    private string? _itemModalError;
    private bool? _booleanBoolValue;
    private int? _editIntValue;
    private bool _monitorUseDaysBack;

    // Quick-complete modal
    private bool _showQuickModal;
    private TodoItemResponse? _quickItem;
    private int? _quickInputTypeId;
    private bool? _quickBoolValue;
    private string? _quickStringValue;
    private decimal? _quickDecimalValue;
    private int? _quickIntValue;
    private bool _quickAllowUnfilled;
    private bool _isQuickBusy;
    private string? _quickError;

    // List modal
    private bool _showListModal;
    private int _editingListId;
    private TodoListRequest _listForm = new() { Name = string.Empty };
    private EditContext _listEditContext = default!;
    private string? _listError;

    // Delete list
    private TodoListResponse? _pendingDeleteList;

    // Auto-refresh
    private System.Threading.Timer? _refreshTimer;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Reminders");
        _itemEditContext = new EditContext(_itemForm);
        _listEditContext = new EditContext(_listForm);
        await LoadDataAsync();
        _refreshTimer = new System.Threading.Timer(
            _ => InvokeAsync(async () => { await LoadDataAsync(); StateHasChanged(); }),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    public void Dispose() => _refreshTimer?.Dispose();

    // ── Data ──────────────────────────────────────────────────────────────────
    private async Task LoadDataAsync()
    {
        _loadError = null;
        try
        {
            var dateParam = _selectedDate.ToString("yyyy-MM-dd");
            var all = await TodoApi.GetTodoLists(dateParam);
            _lists = all.Where(l => l.ListType == TodoListType.Reminder).ToList();
            if (_allTags == null)
            {
                _allTags = await ActivityApi.GetTags();
            }
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to load reminder todo lists");
            _loadError = "Failed to load reminders. Tap reload to try again.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load reminder todo lists");
            _loadError = "Failed to load reminders. Tap reload to try again.";
        }
    }

    // ── Date navigation ───────────────────────────────────────────────────────
    private async Task PreviousDay() { _selectedDate = _selectedDate.AddDays(-1); await LoadDataAsync(); }
    private async Task NextDay()     { _selectedDate = _selectedDate.AddDays(1);  await LoadDataAsync(); }
    private async Task OnDatePickerValueChanged(DateTime? newDate)
    {
        if (newDate.HasValue) { _selectedDate = newDate.Value; await LoadDataAsync(); }
    }

    // ── Toggle show-done ──────────────────────────────────────────────────────
    private void ToggleShowDone(int listId)
    {
        if (!_showDonePerList.Remove(listId))
        {
            _showDonePerList.Add(listId);
        }
    }

    // ── Monitoring window filter ───────────────────────────────────────────────
    private static bool IsOutsideMonitoringWindow(TodoItemResponse item, DateTime effectiveDate)
    {
        if (item.MonitorFromDate.HasValue && effectiveDate.Date < item.MonitorFromDate.Value.ToDateTime(TimeOnly.MinValue).Date) return true;
        if (item.MonitorToDate.HasValue   && effectiveDate.Date > item.MonitorToDate.Value.ToDateTime(TimeOnly.MinValue).Date)   return true;
        if (item.MonitorDaysBack.HasValue)
        {
            var windowStart = effectiveDate.AddDays(-item.MonitorDaysBack.Value).Date;
            if (effectiveDate.Date < windowStart) return true;
        }

        return false;
    }

    // ── Complete / Reopen / Skip ───────────────────────────────────────────────
    private async Task CompleteItemAsync(TodoItemResponse item, TodoListResponse list)
    {
        if (list.ListType == TodoListType.Reminder && item.CompletionTagId.HasValue)
        {
            var completionTag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
            var effectiveInputTypeId = item.CompletionTagInputTypeId ?? completionTag?.InputTypeId;

            if (IsQuickCompleteInputType(effectiveInputTypeId))
            {
                if (HasValidPrefilledValue(effectiveInputTypeId, completionTag?.DefaultValue))
                {
                    try
                    {
                        var updated = await TodoApi.CompleteItem(item.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
                        UpdateItemInList(updated);
                    }
                    catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
                    {
                        Logger.LogWarning(ex, "Todo item {ItemId} not found when completing", item.Id);
                        _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
                        await LoadDataAsync();
                    }
                    catch (ApiException ex)
                    {
                        Logger.LogWarning(ex, "Failed to complete todo item {ItemId}", item.Id);
                        _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
                    }

                    return;
                }

                OpenQuickCompleteModal(item, effectiveInputTypeId);

                return;
            }

            // Unrecognized type: fall back to full edit modal
            OpenEditItemModal(item);

            return;
        }

        try
        {
            var updated = await TodoApi.CompleteItem(item.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
            UpdateItemInList(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when completing", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
    }

    private async Task ReopenItemAsync(TodoItemResponse item)
    {
        try
        {
            var updated = await TodoApi.ReopenItem(item.Id);
            UpdateItemInList(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when reopening", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to reopen todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
    }

    private async Task SkipItemAsync(TodoItemResponse item)
    {
        try
        {
            var updated = await TodoApi.SkipItem(item.Id, _selectedDate.ToString("yyyy-MM-dd"));
            UpdateItemInList(updated);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning(ex, "Todo item {ItemId} not found when skipping", item.Id);
            _itemErrorPerList[item.ListId] = "Item no longer exists. Reload to refresh.";
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to skip todo item {ItemId}", item.Id);
            _itemErrorPerList[item.ListId] = "Failed to update. Please try again.";
        }
    }

    private void UpdateItemInList(TodoItemResponse updated)
    {
        var list = _lists?.FirstOrDefault(l => l.Id == updated.ListId);
        if (list == null) return;

        for (var i = 0; i < list.Items.Count; i++)
        {
            if (list.Items[i].Id == updated.Id)
            {
                list.Items[i] = updated;

                return;
            }
        }
    }

    // ── Quick-complete modal ───────────────────────────────────────────────────
    private void OpenQuickCompleteModal(TodoItemResponse item, int? inputTypeId)
    {
        _quickItem = item;
        _quickInputTypeId = inputTypeId;
        _quickBoolValue = null;
        _quickStringValue = null;
        _quickDecimalValue = null;
        _quickIntValue = null;
        _quickAllowUnfilled = false;
        _quickError = null;

        var tag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
        var defaultValue = tag?.DefaultValue;

        switch (inputTypeId)
        {
            case InputTypeIds.Boolean:
                _quickBoolValue = defaultValue switch { "true" => true, "false" => false, _ => null };
                break;
            case InputTypeIds.String:
                _quickStringValue = defaultValue;
                break;
            case InputTypeIds.Integer:
            case InputTypeIds.Decimal:
            case InputTypeIds.Percentage:
                if (!string.IsNullOrWhiteSpace(defaultValue) &&
                    decimal.TryParse(defaultValue, System.Globalization.NumberStyles.Any, CultureInfo.InvariantCulture, out var d))
                {
                    _quickDecimalValue = d;
                }
                break;
            case InputTypeIds.StarRating:
            case InputTypeIds.StarRating10:
            case InputTypeIds.Score:
            case InputTypeIds.Score10:
                if (!string.IsNullOrWhiteSpace(defaultValue) && int.TryParse(defaultValue, out var iv))
                {
                    _quickIntValue = iv;
                }
                break;
        }

        _showQuickModal = true;
    }

    private async Task SaveQuickAsync()
    {
        if (_quickItem == null) return;

        string? notes;
        switch (_quickInputTypeId)
        {
            case InputTypeIds.Boolean:
                if (!_quickBoolValue.HasValue) { _quickError = "Please select Yes or No."; return; }
                notes = _quickBoolValue.Value ? "true" : "false";
                break;
            case InputTypeIds.String:
                notes = string.IsNullOrWhiteSpace(_quickStringValue) ? null : _quickStringValue.Trim();
                break;
            case InputTypeIds.Integer:
            case InputTypeIds.Decimal:
            case InputTypeIds.Percentage:
                if (_quickAllowUnfilled)
                {
                    notes = null;
                }
                else if (!_quickDecimalValue.HasValue)
                {
                    _quickError = "Please enter a value.";
                    return;
                }
                else
                {
                    notes = _quickDecimalValue.Value.ToString("0.#############################", CultureInfo.InvariantCulture);
                }
                break;
            case InputTypeIds.StarRating:
            case InputTypeIds.StarRating10:
            case InputTypeIds.Score:
            case InputTypeIds.Score10:
                notes = _quickIntValue?.ToString(CultureInfo.InvariantCulture);
                break;
            default:
                notes = null;
                break;
        }

        _isQuickBusy = true;
        _quickError = null;
        try
        {
            await TodoApi.CompleteItem(_quickItem.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow, CompletionValue = notes });
            _showQuickModal = false;
            _quickItem = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to complete todo item via quick modal");
            _quickError = "Failed to save. Please try again.";
        }
        finally
        {
            _isQuickBusy = false;
        }
    }

    // ── Item create/edit modal ─────────────────────────────────────────────────
    private void OpenAddItemModal(int listId)
    {
        _isEditingItem = false;
        _editingItemId = 0;
        _itemModalListId = listId;
        _itemForm = new TodoItemRequest
        {
            Title = string.Empty,
            ListId = listId,
            RecurrenceType = RecurrenceType.None
        };
        _itemEditContext = new EditContext(_itemForm);
        _booleanBoolValue = null;
        _editIntValue = null;
        _monitorUseDaysBack = true;
        _itemModalError = null;
        _showItemModal = true;
    }

    private void OpenEditItemModal(TodoItemResponse item)
    {
        _isEditingItem = true;
        _editingItemId = item.Id;
        _itemModalListId = item.ListId;
        _itemForm = new TodoItemRequest
        {
            ListId = item.ListId,
            Title = item.Title,
            Notes = item.Notes,
            StartDate = item.StartDate,
            DueDate = item.DueDate,
            NotifyAt = item.NotifyAt,
            DisplayOrder = item.DisplayOrder,
            RecurrenceType = item.RecurrenceType,
            AutoLogMode = item.AutoLogMode,
            MonitorDaysBack = item.MonitorDaysBack,
            MonitorFromDate = item.MonitorFromDate,
            MonitorToDate = item.MonitorToDate,
            CompletionTagId = item.CompletionTagId
        };
        _itemEditContext = new EditContext(_itemForm);

        // Restore boolean / int for boolean/score tags
        var tag = _allTags?.FirstOrDefault(t => t.Id == item.CompletionTagId);
        if (IsBooleanInputType(tag?.InputTypeId))
        {
            _booleanBoolValue = item.Notes switch { "true" => true, "false" => false, _ => null };
            _itemForm.Notes = null; // controlled by _booleanBoolValue
        }
        else if (tag?.InputTypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10)
        {
            _editIntValue = int.TryParse(item.Notes, out var v) ? v : null;
            _itemForm.Notes = null;
        }
        else
        {
            _booleanBoolValue = null;
            _editIntValue = null;
        }

        _monitorUseDaysBack = item.MonitorDaysBack.HasValue || (!item.MonitorFromDate.HasValue && !item.MonitorToDate.HasValue);
        _itemModalError = null;
        _showItemModal = true;
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _itemModalError = null;
        _booleanBoolValue = null;
        _editIntValue = null;
    }

    private async Task SubmitItemFormAsync()
    {
        if (!_itemEditContext.Validate()) return;
        await SaveItemAsync();
    }

    private async Task SaveItemAsync()
    {
        _isBusy = true;
        _itemModalError = null;
        try
        {
            var tag = _allTags?.FirstOrDefault(t => t.Id == _itemForm.CompletionTagId);
            var isBooleanType = IsBooleanInputType(tag?.InputTypeId);
            var isStarScoreType = tag?.InputTypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10;

            if (isBooleanType)
            {
                _itemForm.Notes = _booleanBoolValue.HasValue ? (_booleanBoolValue.Value ? "true" : "false") : null;
            }
            else if (isStarScoreType)
            {
                _itemForm.Notes = _editIntValue?.ToString(CultureInfo.InvariantCulture);
            }

            if (_isEditingItem)
            {
                await TodoApi.UpdateTodoItem(_editingItemId, _itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await TodoApi.CompleteItem(_editingItemId, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
                }
            }
            else
            {
                var created = await TodoApi.CreateTodoItem(_itemForm);

                if (isBooleanType && _booleanBoolValue.HasValue)
                {
                    await TodoApi.CompleteItem(created.Id, new TodoItemCompleteRequest { DoneAt = DateTime.UtcNow });
                }
            }

            _showItemModal = false;
            _booleanBoolValue = null;
            _editIntValue = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo item");
            _itemModalError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteEditingItemAsync()
    {
        if (!_isEditingItem) return;
        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoItem(_editingItemId);
            _showItemModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo item {ItemId}", _editingItemId);
            _itemModalError = "Failed to delete. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── List edit modal ────────────────────────────────────────────────────────
    private void OpenEditListModal(TodoListResponse list)
    {
        _editingListId = list.Id;
        _listForm = new TodoListRequest
        {
            Name = list.Name,
            ListType = TodoListType.Reminder,
            ShowOnHomepage = list.ShowOnHomepage
        };
        _listEditContext = new EditContext(_listForm);
        _listError = null;
        _showListModal = true;
    }

    private void CloseListModal()
    {
        _showListModal = false;
        _listError = null;
    }

    private async Task SubmitListFormAsync()
    {
        if (!_listEditContext.Validate()) return;
        await SaveListAsync();
    }

    private async Task SaveListAsync()
    {
        _isBusy = true;
        _listError = null;
        try
        {
            await TodoApi.UpdateTodoList(_editingListId, _listForm);
            _showListModal = false;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to save todo list");
            _listError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(ex.Content)
                ? ex.Content.Trim('"')
                : "Failed to save. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Delete list ───────────────────────────────────────────────────────────
    private void ConfirmDeleteList(TodoListResponse list) => _pendingDeleteList = list;

    private async Task DeleteListConfirmedAsync()
    {
        if (_pendingDeleteList == null) return;
        _isBusy = true;
        try
        {
            await TodoApi.DeleteTodoList(_pendingDeleteList.Id);
            _pendingDeleteList = null;
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Failed to delete todo list {ListId}", _pendingDeleteList?.Id);
            _pendingDeleteList = null;
            _loadError = "Failed to delete list. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Static helpers ────────────────────────────────────────────────────────
    private static bool IsQuickCompleteInputType(int? id) => id is
        InputTypeIds.Boolean or InputTypeIds.String or
        InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage or
        InputTypeIds.StarRating or InputTypeIds.StarRating10 or
        InputTypeIds.Score or InputTypeIds.Score10;

    private static bool HasValidPrefilledValue(int? inputTypeId, string? tagDefaultValue)
    {
        if (string.IsNullOrWhiteSpace(tagDefaultValue)) return false;

        return inputTypeId switch
        {
            InputTypeIds.Boolean => false,
            InputTypeIds.String => true,
            InputTypeIds.Integer or InputTypeIds.Decimal or InputTypeIds.Percentage =>
                decimal.TryParse(tagDefaultValue, System.Globalization.NumberStyles.Any, CultureInfo.InvariantCulture, out _),
            InputTypeIds.StarRating or InputTypeIds.StarRating10 or InputTypeIds.Score or InputTypeIds.Score10 =>
                int.TryParse(tagDefaultValue, out var v) && v > 0,
            _ => false
        };
    }

    private static bool IsBooleanInputType(int? inputTypeId) => inputTypeId == InputTypeIds.Boolean;

    private static DateTime? ParseDateTime(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateTime.TryParse(value, out var d) ? d : null;

    private static DateOnly? ParseDateOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateOnly.TryParse(value, out var d) ? d : null;

    private static TimeOnly? ParseTimeOnly(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : TimeOnly.TryParse(value, out var t) ? t : null;
}

