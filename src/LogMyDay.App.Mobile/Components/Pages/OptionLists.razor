@page "/option-lists"

@using LogMyDay.Shared.DTOs
@using LogMyDay.App.Mobile.Services
@using System.Net
@using System.Linq
@using Refit
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.App.Mobile.Services.ISharedDataCache SharedDataCache
@inject ILogger<OptionLists> Logger
@inject IPageTitleService PageTitleService

<PageTitle>Option Lists - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Option Lists" ShowReload="true" OnReload="LoadListsAsync" />
    <TagSectionNav />

    <div class="max-w-3xl mx-auto px-4 py-4 space-y-4">
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                @loadError
            </div>
        }

        @if (isLoading)
        {
            <p class="text-gray-600 dark:text-gray-400"><em>Loading...</em></p>
        }
        else if (lists.Count == 0 && string.IsNullOrEmpty(loadError))
        {
            <div class="rounded-lg border border-dashed border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-8 text-center text-sm text-gray-600 dark:text-gray-400">
                <i class="bi bi-list-ul text-4xl block mb-2 text-gray-400"></i>
                <p>No option lists yet. Create your first list to reuse values in tags.</p>
            </div>
        }
        else
        {
            <div class="hidden md:block overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xs">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Scope</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Options</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var list in lists)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">@list.Name</td>
                                <td class="px-4 py-3 text-sm">
                                    @if (list.IsGlobal)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-sky-100 dark:bg-sky-600/20 px-2.5 py-0.5 text-xs font-semibold text-sky-900 dark:text-sky-300">Global</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-600/40 px-2.5 py-0.5 text-xs font-semibold text-gray-700 dark:text-gray-300">Personal</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400">@list.Options.Count</td>
                                <td class="px-4 py-3 text-right">
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 mr-1" @onclick="() => OpenEditModal(list)" disabled="@(isBusy || list.IsGlobal)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(list)" disabled="@(isBusy || list.IsGlobal)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="md:hidden space-y-3">
                @foreach (var list in lists)
                {
                    <div class="rounded-xl border @(list.IsGlobal ? "border-sky-200 dark:border-sky-700" : "border-gray-200 dark:border-gray-700") bg-white dark:bg-gray-800 p-4 shadow-xs">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                                    @list.Name
                                    @if (list.IsGlobal)
                                    {
                                        <span class="ml-2 inline-flex items-center rounded-full bg-sky-100 dark:bg-sky-600/20 px-2.5 py-0.5 text-xs font-semibold text-sky-900 dark:text-sky-300">Global</span>
                                    }
                                    else
                                    {
                                        <span class="ml-2 inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-600/40 px-2.5 py-0.5 text-xs font-semibold text-gray-700 dark:text-gray-300">Personal</span>
                                    }
                                </h3>
                                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">@list.Options.Count option(s)</p>
                            </div>
                        </div>
                        @if (list.Options.Any())
                        {
                            <div class="mt-3 flex flex-wrap gap-1.5">
                                @foreach (var option in list.Options.Take(5))
                                {
                                    <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700 px-2.5 py-0.5 text-xs text-gray-800 dark:text-gray-200">
                                        @(string.IsNullOrWhiteSpace(option.DisplayName) ? option.Value : option.DisplayName)
                                    </span>
                                }
                                @if (list.Options.Count > 5)
                                {
                                    <span class="inline-flex items-center rounded-full bg-gray-200 dark:bg-gray-600 px-2.5 py-0.5 text-xs text-gray-700 dark:text-gray-300">
                                        +@(list.Options.Count - 5) more
                                    </span>
                                }
                            </div>
                        }
                        <div class="mt-4 flex justify-end gap-2">
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" @onclick="() => OpenEditModal(list)" disabled="@(isBusy || list.IsGlobal)">
                                <i class="bi bi-pencil"></i>
                                <span>Edit</span>
                            </button>
                            <button type="button" class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20" @onclick="() => ConfirmDelete(list)" disabled="@(isBusy || list.IsGlobal)">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<button type="button" class="fab" @onclick="OpenAddModal" title="Add Option List">
    <i class="bi bi-plus-lg"></i>
</button>

@if (isModalOpen)
{
    <div class="fixed inset-0 z-60 bg-white dark:bg-slate-900 flex flex-col" role="dialog" aria-modal="true">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700 shrink-0">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">@(isEditing ? "Edit Option List" : "Add Option List")</h3>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 p-2" @onclick="CloseModal">
                <i class="bi bi-x-lg text-xl"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto px-5 py-5">
            <EditForm id="optionListForm" Model="listForm" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-500/40 dark:bg-rose-500/20 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
                        @formError
                    </div>
                }
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Name</label>
                        <InputText @bind-Value="listForm.Name" class="@InputCss" />
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Options</label>
                            <button type="button"
                                class="px-3 py-1.5 text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
                                @onclick="AddOption" disabled="@isBusy">
                                + Add Option
                            </button>
                        </div>
                        @if (listForm.Options.Count == 0)
                        {
                            <p class="text-sm text-gray-500 dark:text-gray-400">Add at least one option.</p>
                        }
                        else
                        {
                            <div class="space-y-3">
                                @foreach (var option in listForm.Options)
                                {
                                    <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3 space-y-2" @key="option">
                                        <div class="grid grid-cols-2 gap-2">
                                            <div>
                                                <label class="block text-xs font-medium mb-1 text-gray-600 dark:text-gray-400">Value</label>
                                                <InputText @bind-Value="option.Value" class="@InputCss" />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-medium mb-1 text-gray-600 dark:text-gray-400">Display Name</label>
                                                <InputText @bind-Value="option.DisplayName" class="@InputCss" />
                                            </div>
                                        </div>
                                        <div class="flex justify-end">
                                            <button type="button"
                                                class="px-3 py-1 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 rounded-sm transition-colors"
                                                @onclick="() => RemoveOption(option)" disabled="@isBusy">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-700 shrink-0"
             style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
            <div class="flex items-center justify-end gap-3">
                <button type="button"
                    class="px-5 py-2.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors min-h-[44px]"
                    @onclick="CloseModal" disabled="@isBusy">
                    Cancel
                </button>
                <button type="submit" form="optionListForm"
                    class="px-5 py-2.5 bg-primary-600 text-white rounded-lg text-sm font-semibold hover:bg-primary-700 disabled:opacity-60 transition-colors flex items-center gap-2 min-h-[44px]"
                    disabled="@isBusy">
                    @if (isBusy)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                    }
                    @(isEditing ? "Save" : "Add")
                </button>
            </div>
        </div>
    </div>
}

@if (listPendingDelete != null)
{
    <div class="fixed inset-0 z-70 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-gray-900/60" @onclick="CancelDelete"></div>
        <div class="relative z-10 w-full max-w-sm rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-2xl space-y-4" @onclick:stopPropagation="true">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Delete Option List</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Delete <strong class="text-gray-900 dark:text-white">@listPendingDelete.Name</strong>? This cannot be undone.</p>
            <div class="flex justify-end gap-3">
                <button type="button"
                    class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
                    @onclick="CancelDelete" disabled="@isBusy">
                    Cancel
                </button>
                <button type="button"
                    class="px-4 py-2 bg-rose-600 text-white rounded-lg text-sm font-semibold hover:bg-rose-700 disabled:opacity-60 transition-colors"
                    @onclick="DeleteList" disabled="@isBusy">
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<TagOptionListResponse> lists = new();
    private TagOptionListRequest listForm = new()
    {
        Name = string.Empty,
        Options = new List<TagOptionRequest>
        {
            new() { Value = string.Empty, DisplayName = string.Empty }
        }
    };

    private const string InputCss = "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-primary-500 focus:border-transparent focus:outline-hidden";

    private string? loadError;
    private string? formError;
    private bool isLoading;
    private bool isBusy;
    private bool isEditing;
    private bool isModalOpen;
    private int? editingListId;
    private TagOptionListResponse? listPendingDelete;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Option Lists");
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var results = await SharedDataCache.GetOptionListsAsync();
            lists.Clear();
            lists.AddRange(results.OrderBy(l => l.Name));
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loadError = "You are not authorized to view option lists.";
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load option lists: {ex.Message}";
            Logger.LogError(ex, "Failed to load option lists");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        ResetForm();
        isModalOpen = true;
    }

    private void OpenEditModal(TagOptionListResponse list)
    {
        BeginEdit(list);
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        ResetForm();
    }

    private async Task HandleSubmit()
    {
        if (!ValidateForm())
        {
            return;
        }

        isBusy = true;
        formError = null;

        try
        {
            if (editingListId.HasValue)
            {
                await ActivityApi.UpdateTagOptionList(editingListId.Value, listForm);
            }
            else
            {
                await ActivityApi.CreateTagOptionList(listForm);
            }

            SharedDataCache.Invalidate();
            await LoadListsAsync();
            CloseModal();
        }
        catch (Refit.ApiException ex)
        {
            formError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Option list API error");
        }
        catch (Exception ex)
        {
            formError = ex.Message;
            Logger.LogError(ex, "Unexpected error saving option list");
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(listForm.Name))
        {
            formError = "Name is required.";
            return false;
        }

        if (listForm.Options.Count == 0)
        {
            formError = "Add at least one option.";
            return false;
        }

        if (listForm.Options.Any(o => string.IsNullOrWhiteSpace(o.Value)))
        {
            formError = "Each option must have a value.";
            return false;
        }

        formError = null;
        return true;
    }

    private void AddOption()
    {
        listForm.Options.Add(new TagOptionRequest { Value = string.Empty, DisplayName = string.Empty });
    }

    private void RemoveOption(TagOptionRequest option)
    {
        if (listForm.Options.Contains(option))
        {
            listForm.Options.Remove(option);
        }
    }

    private void BeginEdit(TagOptionListResponse list)
    {
        if (list.IsGlobal)
        {
            return;
        }

        isEditing = true;
        editingListId = list.Id;
        listForm = new TagOptionListRequest
        {
            Name = list.Name,
            Options = list.Options
                .Select(o => new TagOptionRequest { Id = o.Id, Value = o.Value, DisplayName = o.DisplayName })
                .ToList()
        };
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        isEditing = false;
        editingListId = null;
        listForm = new TagOptionListRequest
        {
            Name = string.Empty,
            Options = new List<TagOptionRequest>
            {
                new() { Value = string.Empty, DisplayName = string.Empty }
            }
        };
    }

    private void ConfirmDelete(TagOptionListResponse list)
    {
        if (list.IsGlobal)
        {
            return;
        }

        listPendingDelete = list;
    }

    private void CancelDelete()
    {
        listPendingDelete = null;
    }

    private async Task DeleteList()
    {
        if (listPendingDelete == null)
        {
            return;
        }

        isBusy = true;
        formError = null;

        try
        {
            await ActivityApi.DeleteTagOptionList(listPendingDelete.Id);
            SharedDataCache.Invalidate();
            await LoadListsAsync();
        }
        catch (Refit.ApiException ex)
        {
            formError = ex.Content ?? ex.Message;
            Logger.LogError(ex, "Failed to delete option list");
        }
        catch (Exception ex)
        {
            formError = ex.Message;
            Logger.LogError(ex, "Unexpected error deleting option list");
        }
        finally
        {
            isBusy = false;
            listPendingDelete = null;
        }
    }
}
