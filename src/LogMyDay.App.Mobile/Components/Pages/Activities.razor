    private async Task SaveFilterPreferences()
    {
        try
        {
            if (currentUserId == null)
            {
                return;
            }

            var request = new UpdateUserDto(null, null, null, null, null, displayType, orderBy, periodSort);
            await UsersApi.UpdateUserAsync(currentUserId.Value, request);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save filter preferences");
        }
    }

    private bool IsSaving(int id) => _savingIds.Contains(id);

    private static bool IsStarRatingTag(TagResponse? tag) =>
        tag?.TypeId is InputTypeIds.StarRating or InputTypeIds.StarRating10;

    private static bool IsScoreTag(TagResponse? tag) =>
        tag?.TypeId is InputTypeIds.Score or InputTypeIds.Score10;

