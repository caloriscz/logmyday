@page "/activities"
@using LogMyDay.Shared.DTOs
@using LogMyDay.Domain.Enums
@using LogMyDay.Domain.Constants
@using LogMyDay.App.Mobile.Components.Shared
@using Microsoft.AspNetCore.Components
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using LogMyDay.Shared.Preferences
@inject LogMyDay.Shared.Interfaces.IActivityApi ActivityApi
@inject LogMyDay.Shared.Interfaces.IUsersApi UsersApi
@inject LogMyDay.Shared.Interfaces.IAuthApi AuthApi
@inject LogMyDay.App.Mobile.Services.AuthenticationService AuthService
@inject LogMyDay.App.Mobile.Services.ISharedDataCache SharedDataCache
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Activities> Logger
@implements IAsyncDisposable

<PageTitle>Activities - LogMyDay</PageTitle>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pb-20">
    <TopBar Title="Activities" ShowReload="true" OnReload="LoadData" />

    <div class="px-6 py-4">
        <!-- Filter and Sort Controls -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" class="btn-secondary" data-modal-show="filterModal" title="Open filters">
                    <i class="bi bi-funnel"></i> Filters
                </button>
            </div>
            <div class="flex items-center gap-3 shrink-0">

                @if (displayType != "daily")
                {
                    <div class="flex items-center gap-2">
                        <button class="btn-secondary btn-sm" @onclick="PrevPage" disabled="@(GetCurrentPageNumber() == 1)">
                            Previous
                        </button>
                        <span class="text-sm text-gray-600 dark:text-gray-400">Page @GetCurrentPageNumber() of @totalPages</span>
                        <button class="btn-secondary btn-sm" @onclick="NextPage" disabled="@(GetCurrentPageNumber() == totalPages)">
                            Next
                        </button>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-danger mb-4" role="alert">
                @errorMessage
            </div>
        }

        @if (pagedResult == null)
        {
            <div class="text-gray-600 dark:text-gray-400">
                <em>Loading...</em>
            </div>
        }
        else if (displayType == "daily")
        {
            <!-- Daily view with date navigation -->
            <div class="flex items-center mb-4">
                <div class="flex items-center gap-2 mx-auto sm:mx-0">
                    <button class="btn-secondary" @onclick="PreviousDay" title="Previous Day">&lt;</button>
                    <CultureAwareDatePicker Value="@selectedDate"
                                            ValueChanged="@OnDatePickerValueChanged"
                                            EnableTime="false"
                                            CssClass="date-picker-compact"
                                            Placeholder="Select date" />
                    <button class="btn-secondary" @onclick="NextDay" title="Next Day">&gt;</button>
                </div>
            </div>

            @if (!pagedResult.Items.Any())
            {
                <div class="alert-info">
                    No activities found for @selectedDate.ToString("yyyy-MM-dd").
                </div>
            }
            else
            {
                @foreach (var activity in pagedResult.Items.OrderByDescending(a => a.DateStarted))
                {
                    <div class="card mb-3 rounded-lg p-3 shadow-xs">
                        <div class="flex justify-between items-start mb-1">
                            <h6 class="text-base font-semibold text-gray-900 dark:text-white">@activity.PrimaryTagName</h6>
                            <div class="flex items-center gap-2">
                                <button @onclick="() => OpenEditActivityModal(activity)" type="button" title="Edit activity"
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-primary-500 text-white focus:outline-hidden focus:ring-2 focus:ring-primary-300">
                                    <i class="bi bi-pencil text-base"></i>
                                </button>
                                <button @onclick="() => DeleteActivity(activity.Id)" type="button" title="Delete activity"
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-rose-500 text-white focus:outline-hidden focus:ring-2 focus:ring-rose-300">
                                    <i class="bi bi-trash text-base"></i>
                                </button>
                            </div>
                        </div>

                        @{ var mobTag1 = tags?.FirstOrDefault(t => t.Id == activity.PrimaryTagId); }
                        @if (IsStarRatingTag(mobTag1))
                        {
                            <div class="mb-2"><StarDisplay Value="@GetIntegerValue(activity)" MaxStars="@GetStarMax(mobTag1!)" /></div>
                            <div class="mb-2">
                                <IntegerStepper Value="@GetIntegerValue(activity)" Step="1" Min="0" Max="@GetStarMax(mobTag1!)"
                                    ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                    OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag1!, v))" />
                            </div>
                        }
                        else if (IsScoreTag(mobTag1))
                        {
                            <div class="mb-2"><ScoreDisplay Value="@GetIntegerValue(activity)" MaxScore="@GetStarMax(mobTag1!)" /></div>
                            <div class="mb-2">
                                <IntegerStepper Value="@GetIntegerValue(activity)" Step="1" Min="0" Max="@GetStarMax(mobTag1!)"
                                    ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                    OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag1!, v))" />
                            </div>
                        }
                        else if (mobTag1?.TypeId == InputTypeIds.Boolean)
                        {
                            <div class="mb-2"><BooleanDisplay Value="@GetBoolValue(activity)" /></div>
                            <div class="mb-2">
                                <BooleanSwitch Value="@GetBoolValue(activity)" Disabled="@IsSaving(activity.Id)"
                                    OnValueChanged="@(v => OnBooleanToggleChanged(activity, v))" />
                            </div>
                        }
                        else if (mobTag1?.TypeId == InputTypeIds.Integer)
                        {
                            <p class="mb-2 text-gray-700 dark:text-gray-300">@GetIntegerValue(activity)@(mobTag1.UnitSymbol is not null ? " " + mobTag1.UnitSymbol : "")</p>
                            <div class="mb-2">
                                <IntegerStepper Value="@GetIntegerValue(activity)" Step="@(mobTag1.Step ?? 1)"
                                    Min="@mobTag1.MinValue" Max="@mobTag1.MaxValue" Unit="@mobTag1.UnitSymbol"
                                    ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                    OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag1, v))" />
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(activity.PrimaryTagValue ?? activity.Description))
                        {
                            <p class="mb-2 text-gray-700 dark:text-gray-300">@(activity.PrimaryTagValue ?? activity.Description)</p>
                        }
                    </div>
                }
            }
        }
        else if (!pagedResult.Items.Any())
        {
            <div class="alert-danger">
                No activities found for the selected criteria.
            </div>
        }
        else
        {
            @foreach (var group in (periodSort == "asc" ? pagedResult.Items.GroupBy(a => a.DateStarted.Date).OrderBy(g => g.Key) : pagedResult.Items.GroupBy(a => a.DateStarted.Date).OrderByDescending(g => g.Key)))
            {
                <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">@group.Key.ToString("yyyy-MM-dd")</h5>

                <div class="md:hidden">
                    @foreach (var activity in group)
                    {
                        <div class="card mb-3">
                            <div class="flex justify-between items-start mb-2">
                                <h6 class="text-base font-semibold text-gray-900 dark:text-white mb-0">@activity.PrimaryTagName</h6>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => OpenEditActivityModal(activity)"
                                            class="btn-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button @onclick="() => DeleteActivity(activity.Id)"
                                            class="btn-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            @{ var mobTag2 = tags?.FirstOrDefault(t => t.Id == activity.PrimaryTagId); }
                            @if (IsStarRatingTag(mobTag2))
                            {
                                <div class="mb-2"><StarDisplay Value="@GetIntegerValue(activity)" MaxStars="@GetStarMax(mobTag2!)" /></div>
                                <div class="mb-2">
                                    <IntegerStepper Value="@GetIntegerValue(activity)" Step="1" Min="0" Max="@GetStarMax(mobTag2!)"
                                        ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                        OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag2!, v))" />
                                </div>
                            }
                            else if (IsScoreTag(mobTag2))
                            {
                                <div class="mb-2"><ScoreDisplay Value="@GetIntegerValue(activity)" MaxScore="@GetStarMax(mobTag2!)" /></div>
                                <div class="mb-2">
                                    <IntegerStepper Value="@GetIntegerValue(activity)" Step="1" Min="0" Max="@GetStarMax(mobTag2!)"
                                        ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                        OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag2!, v))" />
                                </div>
                            }
                            else if (mobTag2?.TypeId == InputTypeIds.Boolean)
                            {
                                <div class="mb-2"><BooleanDisplay Value="@GetBoolValue(activity)" /></div>
                                <div class="mb-2">
                                    <BooleanSwitch Value="@GetBoolValue(activity)" Disabled="@IsSaving(activity.Id)"
                                        OnValueChanged="@(v => OnBooleanToggleChanged(activity, v))" />
                                </div>
                            }
                            else if (mobTag2?.TypeId == InputTypeIds.Integer)
                            {
                                <p class="mb-2 text-gray-700 dark:text-gray-300">@GetIntegerValue(activity)@(mobTag2.UnitSymbol is not null ? " " + mobTag2.UnitSymbol : "")</p>
                                <div class="mb-2">
                                    <IntegerStepper Value="@GetIntegerValue(activity)" Step="@(mobTag2.Step ?? 1)"
                                        Min="@mobTag2.MinValue" Max="@mobTag2.MaxValue" Unit="@mobTag2.UnitSymbol"
                                        ShowValue="false" Disabled="@IsSaving(activity.Id)"
                                        OnValueChanged="@(v => OnIntegerStepperChanged(activity, mobTag2, v))" />
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(activity.PrimaryTagValue ?? activity.Description))
                            {
                                <p class="text-gray-700 dark:text-gray-300 mb-2">@(activity.PrimaryTagValue ?? activity.Description)</p>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Floating Action Button -->
<button class="fab" data-modal-show="addActivityModal" title="Add Activity">
    <i class="bi bi-plus-lg"></i>
</button>

<!-- Filter Modal - Full Screen Overlay -->
<div id="filterModal" data-modal class="hidden fixed inset-0 z-60 bg-white dark:bg-slate-900 transition-opacity duration-300 opacity-0" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div data-modal-content class="w-full h-full flex flex-col">
        <!-- Modal Header - Fixed at top -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
            <h5 class="text-xl font-semibold text-gray-900 dark:text-gray-100" id="filterModalLabel">Filters & Navigation</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors p-3 -mr-2" data-modal-hide="filterModal" aria-label="Close">
                <i class="bi bi-x-lg text-2xl"></i>
            </button>
        </div>

        <!-- Modal Body - Scrollable content -->
        <div class="flex-1 overflow-y-auto px-6 py-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Display Type -->
                <div>
                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Display Type:</label>
                    <select value="@displayType" @onchange="OnDisplayTypeChanged"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                    </select>
                </div>

                <!-- Description Filter -->
                <div>
                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Description Filter:</label>
                    <input value="@descriptionFilter" @onchange="OnFilterChanged"
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                           placeholder="Search description..." />
                </div>

                <!-- Activity Sort (within day) -->
                <div>
                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Activity Sort:</label>
                    <select value="@orderBy" @onchange="@(e => ChangeOrder(e.Value?.ToString() ?? "desc"))"
                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                        <option value="desc">Date (newest first)</option>
                        <option value="asc">Date (oldest first)</option>
                        <option value="group-asc">Group A-Z, then date</option>
                        <option value="group-desc">Group Z-A, then date</option>
                    </select>
                </div>

                <!-- Period Sort (day ordering within week/month) -->
                @if (displayType != "daily")
                {
                    <div>
                        <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Day Order:</label>
                        <select value="@periodSort" @onchange="@(e => ChangePeriodSort(e.Value?.ToString() ?? "desc"))"
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                            <option value="desc">Newest day first</option>
                            <option value="asc">Oldest day first</option>
                        </select>
                    </div>
                }

                <!-- Calendar Navigation -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Date Navigation:</label>

                    <!-- Navigation Controls -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <!-- Daily navigation -->
                        <button class="btn-secondary" @onclick="PreviousCalendarPeriod" title="Previous Day">
                            &lt;
                        </button>

                        <div class="grow text-center">
                            <strong class="text-gray-900 dark:text-gray-100">@GetCurrentPeriodDisplay()</strong>
                        </div>

                        <button class="btn-secondary" @onclick="NextCalendarPeriod" title="Next Day">
                            &gt;
                        </button>
                        <button class="px-4 py-2 bg-primary-600 text-white rounded-md hover:bg-primary-700 active:bg-primary-800 transition-colors" @onclick="GoToToday">
                            @GetTodayButtonText()
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Footer - Fixed at bottom -->
        <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900">
            <div class="flex items-center justify-end">
                <button type="button" class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 active:bg-primary-800 transition-colors text-base font-medium" data-modal-hide="filterModal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add New Activity Modal Component -->
<AddActivityModal
    Activity="newActivity"
    AvailableTags="tags"
    OptionLists="optionLists"
    OptionListLookup="optionListLookup"
    IsEditMode="isEditMode"
    ActivityId="editingActivityId"
    OnActivityCreated="@HandleActivityCreated"
    OnActivityUpdated="@HandleActivityUpdated"
    OnCanceled="@HandleActivityCanceled"
    OnFormReset="@HandleActivityFormReset"
    OnError="@HandleActivityError"
    ErrorMessage="@errorMessage" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "tagId")]
    public int? QueryTagId { get; set; }

    private PagedResult<LogMyDay.Shared.DTOs.ActivityResponse>? pagedResult;
    private IList<LogMyDay.Shared.DTOs.TagResponse>? tags;
    private IList<LogMyDay.Shared.DTOs.TagOptionListResponse>? optionLists;
    private Dictionary<int, LogMyDay.Shared.DTOs.TagOptionListResponse>? optionListLookup;
    private LogMyDay.Shared.DTOs.ActivityRequest newActivity = new();
    private bool isEditMode = false;
    private int? editingActivityId;
    private string? errorMessage;

    [Parameter]
    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? QuerySource { get; set; }

    private bool _pendingNotificationModal;
    private int? _pendingNotificationTagId;
    private DateOnly? _pendingNotificationDate;

    // Inline edit state
    private Dictionary<int, int> _pendingValues = new();
    private Dictionary<int, bool?> _pendingBoolValues = new();
    private HashSet<int> _savingIds = new();

    // Display and filtering
    private string displayType = "daily";
    private string? descriptionFilter;
    private DateTime selectedDate = DateTime.Today;
    private int pageNumber = 1;
    private int weekPageNumber = 1;
    private int monthPageNumber = 1;
    private int weeksPerPage = 1;
    private int monthsPerPage = 1;
    private int totalPages = 1;
    private string orderBy = "desc";
    private string periodSort = "desc";
    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        // Redirect to login if not authenticated
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            
            return;
        }

        selectedDate = DateTime.Today;
        InitializeNewActivity();

        // Load persisted filter preferences
        try
        {
            var currentUser = await AuthApi.GetCurrentUserAsync();
            currentUserId = currentUser.Id;
            displayType = ActivityFilterPreferences.NormalizeDisplayType(currentUser.ActivityDisplayType);
            orderBy = ActivityFilterPreferences.NormalizeActivitySortOrder(currentUser.ActivitySortOrder);
            periodSort = ActivityFilterPreferences.NormalizePeriodSort(currentUser.ActivityPeriodSort);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load filter preferences");
        }

        await LoadData();
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(QuerySource, "notification", StringComparison.OrdinalIgnoreCase) && QueryTagId.HasValue)
        {
            _pendingNotificationTagId = QueryTagId;
            _pendingNotificationDate = ParseDateFromQuery(QueryDate);
            _pendingNotificationModal = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }

    private async Task LoadData()
    {
        try
        {
            // Start cached tag/option-list fetches in parallel with the activities query
            var tagsTask = SharedDataCache.GetTagsAsync();
            var optionListsTask = SharedDataCache.GetOptionListsAsync();

            DateTime? startDate = null;
            DateTime? endDate = null;

            // Set date range based on display type and selected date/period
            displayType = ActivityFilterPreferences.NormalizeDisplayType(displayType);
            orderBy = ActivityFilterPreferences.NormalizeActivitySortOrder(orderBy);
            periodSort = ActivityFilterPreferences.NormalizePeriodSort(periodSort);

            switch (displayType)
            {
                case "daily":
                    startDate = selectedDate.Date;
                    endDate = selectedDate.Date.AddDays(1).AddTicks(-1);
                    // For daily, get all activities for the day (no pagination)
                    pagedResult = await ActivityApi.GetActivities(1, 1000, orderBy, null, startDate, endDate, descriptionFilter);
                    totalPages = 1;
                    break;

                case "weekly":
                    var weekStart = GetStartOfWeek(selectedDate);
                    var weekEnd = weekStart.AddDays(7).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByWeeks(weekPageNumber, weeksPerPage, orderBy, null, null, null,
                    descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / weeksPerPage);
                    break;

                case "monthly":
                    var monthStart = new DateTime(selectedDate.Year, selectedDate.Month, 1);
                    var monthEnd = monthStart.AddMonths(1).AddTicks(-1);
                    pagedResult = await ActivityApi.GetActivitiesByMonths(monthPageNumber, monthsPerPage, orderBy, null, null, null,
                    descriptionFilter);
                    totalPages = (int)Math.Ceiling((double)(pagedResult?.TotalCount ?? 0) / monthsPerPage);
                    break;
            }

            // Await the parallel tag/option-list fetches
            tags = await tagsTask;
            optionLists = await optionListsTask;

            if (optionLists is not null && optionLists.Count > 0)
            {
                optionListLookup = optionLists.ToDictionary(list => list.Id);
            }
            else
            {
                optionListLookup = null;
            }
            errorMessage = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // DynamicAuthHandler will trigger automatic logout and redirect to login
            errorMessage = "Your session has expired. Redirecting to login...";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            errorMessage = $"Error loading data: {ex.Message}";
        }

        await ProcessPendingNotificationIntentAsync();
    }

    private async Task OnDatePickerValueChanged(DateTime? value)
    {
        if (value.HasValue)
        {
            selectedDate = value.Value;
            InitializeNewActivity();
            await LoadData();
        }
    }

    private static DateOnly? ParseDateFromQuery(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }

        return null;
    }

    private async Task OnDisplayTypeChanged(ChangeEventArgs e)
    {
        displayType = e.Value?.ToString() ?? "daily";
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        selectedDate = DateTime.Today;
        await SaveFilterPreferences();
        await LoadData();
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        descriptionFilter = e.Value?.ToString();
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        await LoadData();
    }

    private string GetCurrentPeriodDisplay()
    {
        return displayType switch
        {
            "daily" => selectedDate.ToString("MMMM dd, yyyy"),
            "weekly" => $"Week of {GetStartOfWeek(selectedDate):MMMM dd, yyyy}",
            "monthly" => selectedDate.ToString("MMMM yyyy"),
            _ => selectedDate.ToString("MMMM dd, yyyy")
        };
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        InitializeNewActivity();
        await LoadData();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        InitializeNewActivity();
        await LoadData();
    }

    private string GetTodayButtonText()
    {
        return displayType switch
        {
            "daily" => "Today",
            "weekly" => "This Week",
            "monthly" => "This Month",
            _ => "Today"
        };
    }

    private async Task PreviousCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(-1),
            "weekly" => selectedDate.AddDays(-7),
            "monthly" => selectedDate.AddMonths(-1),
            _ => selectedDate.AddDays(-1)
        };

        InitializeNewActivity();
        await LoadData();
    }

    private async Task NextCalendarPeriod()
    {
        selectedDate = displayType switch
        {
            "daily" => selectedDate.AddDays(1),
            "weekly" => selectedDate.AddDays(7),
            "monthly" => selectedDate.AddMonths(1),
            _ => selectedDate.AddDays(1)
        };

        InitializeNewActivity();
        await LoadData();
    }

    private async Task GoToToday()
    {
        selectedDate = DateTime.Today;
        pageNumber = 1;
        weekPageNumber = 1;
        monthPageNumber = 1;
        InitializeNewActivity();
        await LoadData();
    }

    private DateTime GetStartOfWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-1 * diff).Date;
    }

    private int GetCurrentPageNumber()
    {
        return displayType switch
        {
            "weekly" => weekPageNumber,
            "monthly" => monthPageNumber,
            _ => pageNumber
        };
    }

    private async Task HandleActivityCreated(LogMyDay.Shared.DTOs.ActivityRequest activity)
    {
        errorMessage = null;
        // Refresh the activities list when a new activity is created
        await LoadData();
        // Reset the activity for next use
        newActivity = new LogMyDay.Shared.DTOs.ActivityRequest();
        ResetEditState();
        InitializeNewActivity();
    }

    private async Task HandleActivityUpdated()
    {
        await LoadData();
        await HideAddActivityModalAsync();
        ResetEditState();
        InitializeNewActivity();
        StateHasChanged();
    }

    private async Task HandleActivityCanceled()
    {
        await HideAddActivityModalAsync();
        ResetEditState();
        InitializeNewActivity();
        StateHasChanged();
    }

    private Task HandleActivityFormReset()
    {
        errorMessage = null;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task HandleActivityError(string error)
    {
        errorMessage = error;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private async Task OpenEditActivityModal(LogMyDay.Shared.DTOs.ActivityResponse activity)
    {
        if (activity is null)
        {
            return;
        }

        isEditMode = true;
        editingActivityId = activity.Id;

        var startLocal = NormalizeToLocal(activity.DateStarted);

        newActivity = new LogMyDay.Shared.DTOs.ActivityRequest
        {
            PrimaryTagId = activity.PrimaryTagId,
            Description = activity.Description,
            DateStarted = startLocal,
            DateFinished = activity.DateFinished.HasValue ? NormalizeToLocal(activity.DateFinished.Value) : null
        };

        selectedDate = startLocal.Date;
        errorMessage = null;

        StateHasChanged();
        await ShowAddActivityModalAsync();
    }

    private async Task ProcessPendingNotificationIntentAsync()
    {
        if (!_pendingNotificationModal)
        {
            return;
        }

        if (tags == null || tags.Count == 0)
        {
            return;
        }

        var tagId = _pendingNotificationTagId;
        if (tagId.HasValue && !tags.Any(t => t.Id == tagId.Value))
        {
            _pendingNotificationModal = false;
            _pendingNotificationTagId = null;
            _pendingNotificationDate = null;

            return;
        }

        var targetDate = _pendingNotificationDate ?? DateOnly.FromDateTime(DateTime.Today);
        selectedDate = targetDate.ToDateTime(TimeOnly.MinValue);

        InitializeNewActivity(tagId, targetDate);
        StateHasChanged();
        await ShowAddActivityModalAsync();

        _pendingNotificationModal = false;
        _pendingNotificationTagId = null;
        _pendingNotificationDate = null;

        Navigation.NavigateTo("/activities", forceLoad: false, replace: true);
    }

    private async Task ShowAddActivityModalAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("showModal", "addActivityModal");
