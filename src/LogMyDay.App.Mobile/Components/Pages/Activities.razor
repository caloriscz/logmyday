    private void InitializeNewActivity(int? tagId = null, DateOnly? targetDate = null)
    {
        ResetEditState();

        var referenceDate = DetermineActivityDate(targetDate);

        newActivity ??= new LogMyDay.Shared.DTOs.ActivityRequest();
        newActivity.DateStarted = referenceDate;
        newActivity.DateFinished = null;
        newActivity.Description = null;

        if (tagId.HasValue)
        {
            newActivity.PrimaryTagId = tagId.Value;
        }

        selectedDate = referenceDate.Date;
    }

    private DateTime DetermineActivityDate(DateOnly? targetDate)
    {
        if (targetDate.HasValue)
        {
            return targetDate.Value == DateOnly.FromDateTime(DateTime.Today)
                ? DateTime.Now
                : targetDate.Value.ToDateTime(TimeOnly.MinValue);
        }

        return selectedDate.Date == DateTime.Today
            ? DateTime.Now
            : selectedDate.Date;
    }

    private void ResetEditState()
    {
        isEditMode = false;
        editingActivityId = null;
    }

    private async Task DeleteActivity(int id)
    {
        try
        {
            await ActivityApi.Delete(id);
            await LoadData();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting activity with ID {ActivityId}", id);
            errorMessage = $"Error deleting activity: {ex.Message}";
        }
    }

    private async Task PrevPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber > 1)
                {
                    weekPageNumber--;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber > 1)
                {
                    monthPageNumber--;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber > 1)
                {
                    pageNumber--;
                    await LoadData();
                }
                break;
        }
    }

    private async Task NextPage()
    {
        switch (displayType)
        {
            case "weekly":
                if (weekPageNumber < totalPages)
                {
                    weekPageNumber++;
                    await LoadData();
                }
                break;
            case "monthly":
                if (monthPageNumber < totalPages)
                {
                    monthPageNumber++;
                    await LoadData();
                }
                break;
            default:
                if (pageNumber < totalPages)
                {
                    pageNumber++;
                    await LoadData();
                }
                break;
        }
    }

    private string GetActivityDateDisplay(LogMyDay.Shared.DTOs.ActivityResponse activity)
    {
        var culture = CultureInfo.CurrentCulture;
        var timePattern = culture.DateTimeFormat.ShortTimePattern;
        var datePattern = culture.DateTimeFormat.ShortDatePattern;

        var startLocal = NormalizeToLocal(activity.DateStarted);
        var startTime = startLocal.ToString(timePattern, culture);

        if (!activity.DateFinished.HasValue)
        {
            return startTime;
        }

        var endLocal = NormalizeToLocal(activity.DateFinished.Value);
        var endTime = endLocal.ToString(timePattern, culture);

        if (startLocal.Date == endLocal.Date)
        {
            return $"{startTime} – {endTime}";
        }

        var startDateTime = $"{startLocal.ToString(datePattern, culture)} {startTime}";
        var endDateTime = $"{endLocal.ToString(datePattern, culture)} {endTime}";

        return $"{startDateTime} – {endDateTime}";
    }

    private static DateTime NormalizeToLocal(DateTime value)
    {
        return value.Kind switch
        {
            DateTimeKind.Utc => value.ToLocalTime(),
            DateTimeKind.Unspecified => DateTime.SpecifyKind(value, DateTimeKind.Local),
            _ => value
        };
    }

