        tag.TypeId is InputTypeIds.StarRating10 or InputTypeIds.Score10 ? 10 : 5;

    private int GetIntegerValue(ActivityResponse activity)
    {
        if (_pendingValues.TryGetValue(activity.Id, out var pending))
        {
            return pending;
        }

        var raw = activity.PrimaryTagValue ?? activity.Description ?? "0";

        return int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : 0;
    }

    private bool? GetBoolValue(ActivityResponse activity)
    {
        if (_pendingBoolValues.TryGetValue(activity.Id, out var pending))
        {
            return pending;
        }

        var raw = activity.PrimaryTagValue ?? activity.Description;
        if (string.IsNullOrWhiteSpace(raw)) return null;

        return bool.TryParse(raw, out var v) ? v : null;
    }

    private async Task OnBooleanToggleChanged(ActivityResponse activity, bool newValue)
    {
        _pendingBoolValues[activity.Id] = newValue;
        _savingIds.Add(activity.Id);

        try
        {
            var request = new ActivityRequest
            {
                PrimaryTagId = activity.PrimaryTagId,
                Description = newValue.ToString(),
                DateStarted = activity.DateStarted,
                DateFinished = activity.DateFinished
            };

            var updated = await ActivityApi.UpdateCalendarItem(activity.Id, request);

            var returnedRaw = updated.PrimaryTagValue ?? updated.Description;
            _pendingBoolValues[activity.Id] = bool.TryParse(returnedRaw, out var returnedBool) ? returnedBool : null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating activity {ActivityId} boolean value inline", activity.Id);
            _pendingBoolValues.Remove(activity.Id);
        }
        finally
        {
            _savingIds.Remove(activity.Id);
            StateHasChanged();
        }
    }

    private async Task OnIntegerStepperChanged(ActivityResponse activity, TagResponse tag, int newValue)
    {
        _pendingValues[activity.Id] = newValue;
        _savingIds.Add(activity.Id);

        try
        {
            var request = new ActivityRequest
            {
                PrimaryTagId = activity.PrimaryTagId,
                Description = newValue.ToString(CultureInfo.InvariantCulture),
                DateStarted = activity.DateStarted,
                DateFinished = activity.DateFinished
            };

            var updated = await ActivityApi.UpdateCalendarItem(activity.Id, request);

            var returnedRaw = updated.PrimaryTagValue ?? updated.Description ?? "0";
            if (int.TryParse(returnedRaw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var returnedInt))
            {
                _pendingValues[activity.Id] = returnedInt;
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating activity {ActivityId} value inline", activity.Id);
            _pendingValues.Remove(activity.Id);
        }
        finally
        {
            _savingIds.Remove(activity.Id);
            StateHasChanged();
        }
    }

