<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>LogMyDay.App.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<ApplicationDisplayVersion>0.6.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
		<ApplicationId>com.logmyday.mobile</ApplicationId>
		<ApplicationTitle>LogMyDay Mobile</ApplicationTitle>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		
		<!-- DEBUGGING FIX: Disable Hot Reload - causes debugger to hang when stopping -->
		<HotReloadEnabled>false</HotReloadEnabled>
	</PropertyGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0b1220" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\AppIcon\appicon.png" IsAppIcon="true">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</MauiImage>
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		
		<!-- Include wwwroot files as MAUI assets -->
		<MauiAsset Include="wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Explicitly include Android resource files -->
		<AndroidResource Include="Platforms\Android\Resources\values\styles.xml" />
		<AndroidResource Include="Platforms\Android\Resources\values\colors.xml" />
		<AndroidResource Include="Platforms\Android\Resources\drawable\notification_icon.xml" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.json.dist" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.10" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.10" />
		<PackageReference Include="Refit" Version="8.0.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogMyDay.Shared\LogMyDay.Shared.csproj" />
		<ProjectReference Include="..\LogMyDay.UI\LogMyDay.UI.csproj" />
	</ItemGroup>

	<!-- Copy Tailwind CSS assets from ui/dist -->
	<Target Name="CopyTailwindAssets" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<TailwindCSSFiles Include="$(ProjectDir)..\ui\dist\css\*.css" />
			<TailwindJSFiles Include="$(ProjectDir)..\ui\dist\js\*.js" />
			<TailwindVendorFiles Include="$(ProjectDir)..\ui\dist\vendor\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(TailwindCSSFiles)" DestinationFolder="$(ProjectDir)wwwroot\css" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(TailwindJSFiles)" DestinationFolder="$(ProjectDir)wwwroot\js" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(TailwindVendorFiles)" DestinationFiles="@(TailwindVendorFiles->'$(ProjectDir)wwwroot\\vendor\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
